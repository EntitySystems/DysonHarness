<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Dyson Harness"
    Manufacturer="Entity Systems"
    Version="$(ProductVersion)"
    UpgradeCode="$(var.UpgradeCode)"
    Scope="perUserOrMachine"
    UpgradeStrategy="majorUpgrade">

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="$(var.StartMenuFolderName)" />
    </StandardDirectory>

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.exe" SourceFile="..\..\src\Harness\DysonHarness.UI.Windows\Assets\dyson.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />

    <Feature Id="Main" Title="Dyson Harness" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder" Guid="$(var.ShortcutComponentGuid)">
      <Shortcut
        Id="AppStartMenuShortcut"
        Name="$(var.StartMenuFolderName)"
        Target="[INSTALLFOLDER]DysonHarness.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AppIcon.exe" />
      <RemoveFolder Id="RemoveAppStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Entity Systems\Dyson Harness"
        Name="$(var.ShortcutKeyPathName)"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- NOT Installed also covers major upgrade: ProductCode is new each MSI build. -->
    <CustomAction
      Id="LaunchApplication"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]DysonHarness.exe&quot;"
      Impersonate="yes"
      Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
