@namespace Harness.UI.Components.Chat
@using System.Globalization
@using DysonHarness
@using Harness.UI.Demo
@inject IJSRuntime Js
@inject DysonUiHost Host

<div class="chat-panel" style="--tools-col-width: @(Host.ToolPanelWidthPercent.ToString("0.##", CultureInfo.InvariantCulture))%">
    <div @ref="_turnsEl"
         class="chat-panel__turns">
        @{
            var timeline = BuildTimeline();
            var lastTurnId = Turns.Count > 0 ? Turns[^1].Id : (Guid?)null;
        }
        @if (timeline.Count == 0)
        {
            @if (Host.Session is null)
            {
                var canCreate = CanCreateSession && !SessionBusy;
                <div class="chat-panel__empty">
                    <p class="chat-panel__empty-message">No session selected. Start one to begin chatting.</p>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(!canCreate)"
                            title="@(CanCreateSession ? "Start new session" : "New disabled until a workdir is selected")"
                            @onclick="OnNewSessionAsync">
                        Start new session
                    </button>
                    @if (!CanCreateSession)
                    {
                        <p class="chat-panel__empty-hint">New disabled until a workdir is selected</p>
                    }
                </div>
            }
            else
            {
                <div class="empty-state empty-state--session">
                    <p class="empty-state__message">Send a prompt to begin.</p>
                    <div class="btn-row empty-state__actions">
                        <button type="button"
                                class="btn"
                                disabled="@SessionBusy"
                                @onclick="OnCreatePlanAsync">
                            Create plan
                        </button>
                        <button type="button"
                                class="btn"
                                disabled="@SessionBusy"
                                @onclick="OnAskQuestionAsync">
                            Ask question
                        </button>
                        <button type="button"
                                class="btn"
                                disabled="@SessionBusy"
                                @onclick="OnSwitchModel">
                            Switch model
                        </button>
                        <button type="button"
                                class="btn"
                                disabled="@SessionBusy"
                                @onclick="OnBrowseSkills">
                            Browse skills
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            @foreach (var item in timeline)
            {
                if (item.Turn is { } turn)
                {
                    <TurnBlock Turn="turn"
                               SessionBusy="SessionBusy"
                               IsLatestTurn="@(lastTurnId == turn.Id)"
                               IsExpanded="@(!_collapsedIds.Contains(turn.Id))"
                               OnToggleExpand="() => ToggleExpand(turn.Id)"
                               OnCancel="OnCancelPrompt"
                               OnResubmit="HandleSubmitAsync" />
                }
                else if (item.Event is { } evt)
                {
                    <SubagentEventBlock Item="evt" />
                }
            }
        }
    </div>
    <Composer @ref="_composer"
              Disabled="@(Disabled || Host.PendingAskUi is not null || Host.PendingUserDialogUi is not null)"
              SelectedSlugId="SelectedSlugId"
              SelectedSlugIdChanged="SelectedSlugIdChanged"
              ReasoningEffort="@ReasoningEffort"
              ReasoningEffortChanged="ReasoningEffortChanged"
              MaxTargetContextTokens="MaxTargetContextTokens"
              MaxTargetContextTokensChanged="MaxTargetContextTokensChanged"
              OutgoingContextTokens="OutgoingContextTokens"
              LastReportedPromptTokens="LastReportedPromptTokens"
              SelectedAgentMode="@SelectedAgentMode"
              SelectedAgentModeChanged="SelectedAgentModeChanged"
              GitBranch="@GitBranch"
              OnSubmit="HandleSubmitAsync"
              OnNewSession="OnNewSession"
              Ask="Host.PendingAskUi"
              OnAskSubmit="HandleAskSubmitAsync" />
</div>

@code {
    private ElementReference _turnsEl;
    private Composer? _composer;
    private bool _forceStick;
    private bool _attached;
    private int _lastTurnCount;
    private Guid? _firstTurnId;
    private readonly HashSet<Guid> _collapsedIds = [];

    private const string CreatePlanDisplayInfo = "Let's harness your ideas, tell me your goals";
    private const string AskQuestionDisplayInfo = "Ask me anything";

    [Parameter] public IReadOnlyList<DysonAgentTurn> Turns { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Host busy (prompt in flight) — drives the latest-turn prompt spinner.</summary>
    [Parameter] public bool SessionBusy { get; set; }
    /// <summary>Cancel in-flight prompt (latest busy turn spinner).</summary>
    [Parameter] public EventCallback OnCancelPrompt { get; set; }
    [Parameter] public Guid? SelectedSlugId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedSlugIdChanged { get; set; }
    [Parameter] public string? ReasoningEffort { get; set; }
    [Parameter] public EventCallback<string?> ReasoningEffortChanged { get; set; }
    [Parameter] public int MaxTargetContextTokens { get; set; } = DysonMaxTargetContextTokens.HarnessDefault;
    [Parameter] public EventCallback<int> MaxTargetContextTokensChanged { get; set; }
    [Parameter] public int OutgoingContextTokens { get; set; }
    [Parameter] public int? LastReportedPromptTokens { get; set; }
    [Parameter] public string SelectedAgentMode { get; set; } = DysonAgentModes.Work;
    [Parameter] public EventCallback<string> SelectedAgentModeChanged { get; set; }
    [Parameter] public string? GitBranch { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }
    /// <summary>Same gate as SessionList New — workdir must be selected.</summary>
    [Parameter] public bool CanCreateSession { get; set; }

    private IEnumerable<DysonSubagentEventUiItem> FocusedSubagentEvents
    {
        get
        {
            var id = Host.ActiveSessionId;
            if (id is null)
                return [];

            return Host.SubagentEventUi.Where(e => e.ParentPersistenceId == id.Value);
        }
    }

    /// <summary>
    /// Turns and focused Subagent events ordered by time; turns win ties.
    /// </summary>
    private List<(DysonAgentTurn? Turn, DysonSubagentEventUiItem? Event)> BuildTimeline()
    {
        var events = FocusedSubagentEvents.ToList();
        var list = new List<(DateTime Utc, int Rank, DysonAgentTurn? Turn, DysonSubagentEventUiItem? Event)>(
            Turns.Count + events.Count);
        foreach (var turn in Turns)
            list.Add((turn.StartedUtc, 0, turn, null));
        foreach (var evt in events)
            list.Add((evt.Timestamp.UtcDateTime, 1, null, evt));

        list.Sort(static (a, b) =>
        {
            var cmp = a.Utc.CompareTo(b.Utc);
            return cmp != 0 ? cmp : a.Rank.CompareTo(b.Rank);
        });

        return list.ConvertAll(static x => (x.Turn, x.Event));
    }

    protected override async Task OnInitializedAsync() =>
        await Host.EnsureToolPanelWidthLoadedAsync();

    protected override void OnParametersSet()
    {
        var firstId = Turns.Count > 0 ? Turns[0].Id : (Guid?)null;
        var identityChanged = firstId != _firstTurnId || Turns.Count != _lastTurnCount;
        if (identityChanged)
        {
            if (Turns.Count > _lastTurnCount)
                _forceStick = true;
            _firstTurnId = firstId;
            _lastTurnCount = Turns.Count;
            RebuildCollapsedDefaults();
        }
    }

    private void RebuildCollapsedDefaults()
    {
        _collapsedIds.Clear();
        if (Turns.Count <= 1)
            return;

        var lastId = Turns[^1].Id;
        for (var i = 0; i < Turns.Count - 1; i++)
            _collapsedIds.Add(Turns[i].Id);
        _collapsedIds.Remove(lastId);
    }

    private void ToggleExpand(Guid id)
    {
        if (!_collapsedIds.Add(id))
            _collapsedIds.Remove(id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!_attached)
            {
                await Js.InvokeVoidAsync("dysonChat.attach", _turnsEl);
                _attached = true;
            }

            if (_forceStick)
            {
                _forceStick = false;
                await Js.InvokeVoidAsync("dysonChat.setStick", _turnsEl, true);
            }

            // JS owns stick; no-op when user has scrolled away.
            await Js.InvokeVoidAsync("dysonChat.scrollToBottom", _turnsEl);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task HandleSubmitAsync(string prompt)
    {
        _forceStick = true;
        await OnSubmit.InvokeAsync(prompt);
    }

    private Task OnNewSessionAsync() => OnNewSession.InvokeAsync();

    private Task HandleAskSubmitAsync(IReadOnlyList<DysonAskQuestionAnswer> answers)
    {
        Host.SubmitAskUiAnswers(answers);
        return Task.CompletedTask;
    }

    private async Task OnCreatePlanAsync()
    {
        if (SessionBusy)
            return;

        await SelectedAgentModeChanged.InvokeAsync(DysonAgentModes.Plan);
        var mode = await Host.SetSessionAgentModeAsync(DysonAgentModes.Plan);
        if (mode.IsError)
            return;

        await Host.AppendDisplayInfoTurnAsync(CreatePlanDisplayInfo);
        if (_composer is not null)
            await _composer.FocusPromptAsync();
    }

    private async Task OnAskQuestionAsync()
    {
        if (SessionBusy)
            return;

        await SelectedAgentModeChanged.InvokeAsync(DysonAgentModes.Ask);
        var mode = await Host.SetSessionAgentModeAsync(DysonAgentModes.Ask);
        if (mode.IsError)
            return;

        await Host.AppendDisplayInfoTurnAsync(AskQuestionDisplayInfo);
        if (_composer is not null)
            await _composer.FocusPromptAsync();
    }

    private void OnSwitchModel() => _composer?.OpenModelPicker();

    private void OnBrowseSkills() => _composer?.OpenSkillSearch();
}
