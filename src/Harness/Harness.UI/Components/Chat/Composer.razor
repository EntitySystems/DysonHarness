@namespace Harness.UI.Components.Chat
@using DysonHarness
@using Harness.UI.Components.Models
@using Harness.UI.Components.Skills
@using Harness.UI.Demo
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IDysonModelRepository ModelStore
@inject DysonUiHost Host
@inject IJSRuntime Js

<div class="composer">
    <AskQuestionPopover Ask="Ask" OnSubmit="OnAskSubmit" />
    <PlanReadyPopover Pending="Host.PendingPlanReady" />
    <SkillSearchModal @ref="_skillSearch" />
    <ComposerHelpModal @ref="_helpModal" OnInsert="OnHelpInsert" />
    <div @ref="_shell"
         class="composer-shell @(_dragOver ? "is-drop-target" : null)">
        <div class="composer__prompt">
            @if (_slashOpen && _suggestions.Count > 0)
            {
                <div class="composer-slash" role="listbox" aria-label="Slash commands">
                    @for (var i = 0; i < _suggestions.Count; i++)
                    {
                        var suggestion = _suggestions[i];
                        var index = i;
                        <button type="button"
                                class="composer-slash__item @(index == _highlight ? "is-active" : null)"
                                role="option"
                                aria-selected="@(index == _highlight)"
                                @onmousedown:preventDefault="true"
                                @onclick="() => ApplySuggestionAsync(suggestion)">
                            <span class="composer-slash__token">@suggestion.Token</span>
                            <span class="composer-slash__desc">@suggestion.Label</span>
                        </button>
                    }
                </div>
            }
            else if (Host.QueuedPrompts.Count > 0)
            {
                var queueCount = Host.QueuedPrompts.Count;
                <div class="composer-queue" aria-label="Queued prompts">
                    <button type="button"
                            class="composer-queue__toggle"
                            aria-expanded="@_queueExpanded"
                            @onmousedown:preventDefault="true"
                            @onclick="ToggleQueueExpanded">
                        <span class="composer-queue__chevron" aria-hidden="true">@(_queueExpanded ? "▾" : "▸")</span>
                        <span>@(queueCount == 1 ? "1 pending action" : $"{queueCount} pending actions")</span>
                    </button>
                    @if (_queueExpanded)
                    {
                        <div class="composer-queue__list" role="list">
                            @foreach (var item in Host.QueuedPrompts)
                            {
                                var queued = item;
                                <div class="composer-queue__item" role="listitem">
                                    <span class="composer-queue__text" title="@queued.FirstLine">@queued.FirstLine</span>
                                    <button type="button"
                                            class="composer-queue__remove"
                                            title="Remove from queue"
                                            aria-label="Remove queued prompt"
                                            @onmousedown:preventDefault="true"
                                            @onclick="() => Host.RemoveQueuedPrompt(queued.Id)">
                                        ×
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            @if (Host.PendingSkillNames.Count > 0 || Host.PendingImages.Count > 0 || Host.PendingFilePaths.Count > 0)
            {
                <div class="composer-context" aria-label="Pending attachments">
                    @foreach (var skillName in Host.PendingSkillNames)
                    {
                        var name = skillName;
                        var display = ResolveSkillDisplay(name);
                        <span class="composer-context__chip" title="@name">
                            <span class="composer-context__label">Skill · @display</span>
                            <button type="button"
                                    class="composer-context__remove"
                                    title="Remove pending skill"
                                    aria-label="@($"Remove pending skill {display}")"
                                    @onmousedown:preventDefault="true"
                                    @onclick="() => Host.RemovePendingSkill(name)">
                                ×
                            </button>
                        </span>
                    }
                    @foreach (var filePath in Host.PendingFilePaths)
                    {
                        var path = filePath;
                        var fileLabel = System.IO.Path.GetFileName(path.Replace('/', System.IO.Path.DirectorySeparatorChar));
                        if (string.IsNullOrWhiteSpace(fileLabel))
                            fileLabel = path;
                        <span class="composer-context__chip" title="@path">
                            <button type="button"
                                    class="composer-context__label composer-context__open"
                                    title="@($"Preview {fileLabel}")"
                                    @onclick="() => OpenPendingFileAsync(path)">
                                File · @fileLabel
                            </button>
                            <button type="button"
                                    class="composer-context__remove"
                                    title="Remove pending file"
                                    aria-label="@($"Remove pending file {fileLabel}")"
                                    @onmousedown:preventDefault="true"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => Host.RemovePendingFilePath(path)">
                                ×
                            </button>
                        </span>
                    }
                    @foreach (var image in Host.PendingImages)
                    {
                        var pending = image;
                        <span class="composer-context__thumb" title="@pending.FileName">
                            <button type="button"
                                    class="composer-context__thumb-open"
                                    title="@($"Preview {pending.FileName}")"
                                    aria-label="@($"Preview image {pending.FileName}")"
                                    @onclick="() => Host.OpenPendingImageViewer(pending)">
                                <img src="@pending.DataUrl" alt="@pending.FileName" />
                            </button>
                            <button type="button"
                                    class="composer-context__remove"
                                    title="Remove image"
                                    aria-label="@($"Remove image {pending.FileName}")"
                                    @onmousedown:preventDefault="true"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => Host.RemovePendingImage(pending.Id)">
                                ×
                            </button>
                        </span>
                    }
                </div>
            }
            <textarea @ref="_textarea"
                      @bind="_text"
                      @bind:event="oninput"
                      @bind:after="OnTextChanged"
                      @onkeydown="OnKeyDown"
                      placeholder="Prompt the agent…"
                      disabled="@Disabled"
                      data-slash-open="@(_slashOpen ? "1" : null)"></textarea>
        </div>
        <div class="composer__footer">
            <div class="composer__toolbar">
                <InputFile @key="_fileInputKey"
                           OnChange="OnFilesSelectedAsync"
                           multiple
                           class="composer-attach__input"
                           disabled="@Disabled" />
                <button type="button"
                        class="composer-attach"
                        title="Attach files or images"
                        aria-label="Attach files or images"
                        disabled="@Disabled"
                        @onclick="OpenFilePickerAsync">
                    <span class="composer-attach__icon" aria-hidden="true"></span>
                </button>
                <ModelSlugPicker @ref="_modelPicker"
                                 SelectedSlugId="SelectedSlugId"
                                 SelectedSlugIdChanged="SelectedSlugIdChanged" />
                <label class="composer-effort" title="Session reasoning_effort (None = omit)">
                    <span class="composer-effort__label">Effort</span>
                    <select @key="SelectedSlugId"
                            class="composer-effort__input composer-effort__select"
                            value="@(_effortDraft)"
                            disabled="@Disabled"
                            @onchange="OnEffortSelectedAsync">
                        <option value="">None</option>
                        @foreach (var mode in EffortOptions)
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </label>
                <AgentModePicker SelectedMode="@SelectedAgentMode"
                                 SelectedModeChanged="SelectedAgentModeChanged" />
                <span class="composer-chip composer-chip--branch @(string.IsNullOrEmpty(GitBranch) ? "is-muted" : null)"
                      title="@(GitBranch ?? "No git repo")">
                    @(string.IsNullOrEmpty(GitBranch) ? "No git repo" : GitBranch)
                </span>
            </div>
            <button type="button"
                    class="btn btn-primary composer__send"
                    disabled="@(Disabled || !CanSubmit)"
                    @onclick="SubmitAsync">
                Send
            </button>
        </div>
    </div>
    <div class="composer__hint">
        <span class="list-item__meta">Ctrl+Enter to send · paste/drop files or images · /help for commands</span>
    </div>
</div>

@code {
    private string _text = "";
    private ElementReference _textarea;
    private ElementReference _shell;
    private ModelSlugPicker? _modelPicker;
    private SkillSearchModal? _skillSearch;
    private ComposerHelpModal? _helpModal;
    private bool _textareaBound;
    private bool _imageCaptureBound;
    private bool _dragOver;
    private DotNetObjectReference<Composer>? _dotNetRef;
    private int _fileInputKey;
    private readonly List<ComposerSlashCommands.ModelOption> _models = [];
    private readonly List<ComposerSlashCommands.SkillOption> _skills = [];
    private IReadOnlyList<ComposerSlashCommands.Suggestion> _suggestions = [];
    private bool _slashOpen;
    private int _highlight;
    private int _slashRefreshGeneration;
    private bool _queueExpanded;

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Guid? SelectedSlugId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedSlugIdChanged { get; set; }
    [Parameter] public string? ReasoningEffort { get; set; }
    [Parameter] public EventCallback<string?> ReasoningEffortChanged { get; set; }
    [Parameter] public string SelectedAgentMode { get; set; } = DysonAgentModes.Work;
    [Parameter] public EventCallback<string> SelectedAgentModeChanged { get; set; }
    [Parameter] public string? GitBranch { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }
    [Parameter] public DysonAskUiState? Ask { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<DysonAskQuestionAnswer>> OnAskSubmit { get; set; }

    private string _effortDraft = "";
    private readonly Dictionary<Guid, IReadOnlyList<string>> _slugReasoningModes = new();

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_text)
        || Host.PendingImages.Count > 0
        || Host.PendingFilePaths.Count > 0;

    private IEnumerable<string> EffortOptions
    {
        get
        {
            IReadOnlyList<string> modes = [];
            if (SelectedSlugId is Guid slugId
                && _slugReasoningModes.TryGetValue(slugId, out var registered))
            {
                modes = registered;
            }

            foreach (var mode in modes)
                yield return mode;

            var current = string.IsNullOrWhiteSpace(ReasoningEffort) ? null : ReasoningEffort.Trim();
            if (current is not null
                && !modes.Contains(current, StringComparer.Ordinal))
            {
                yield return current;
            }
        }
    }

    protected override void OnInitialized() => Host.Changed += OnHostChanged;

    protected override void OnParametersSet()
    {
        _effortDraft = ReasoningEffort ?? "";
    }

    private async Task OnEffortSelectedAsync(ChangeEventArgs e)
    {
        var next = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim();
        _effortDraft = next ?? "";
        var current = string.IsNullOrWhiteSpace(ReasoningEffort) ? null : ReasoningEffort.Trim();
        if (string.Equals(next, current, StringComparison.Ordinal))
            return;

        await ReasoningEffortChanged.InvokeAsync(next);
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshModelsAsync();
        await RefreshSkillsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_textareaBound)
        {
            try
            {
                await Js.InvokeVoidAsync("dysonComposer.attachSlashGuard", _textarea);
                _textareaBound = true;
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        if (!_imageCaptureBound)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await Js.InvokeVoidAsync("dysonComposer.attachImageCapture", _shell, _dotNetRef);
                _imageCaptureBound = true;
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    private void OnHostChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshSkillsAsync();
        StateHasChanged();
    });

    private async Task RefreshModelsAsync()
    {
        _models.Clear();
        _slugReasoningModes.Clear();
        var result = await ModelStore.ListProvidersAsync();
        if (result.IsError)
            return;

        foreach (var provider in result.Value)
        {
            foreach (var slug in provider.Slugs)
            {
                _slugReasoningModes[slug.Id] = slug.ReasoningModes;
                if (!slug.IsEnabled)
                    continue;

                _models.Add(new ComposerSlashCommands.ModelOption(
                    slug.Id,
                    slug.DisplayAlias,
                    provider.DisplayName,
                    slug.Slug,
                    $"{slug.DisplayAlias} · {provider.DisplayName}"));
            }
        }
    }

    private async Task RefreshSkillsAsync()
    {
        _skills.Clear();
        var catalog = await Host.ListSkillCatalogAsync();
        foreach (var entry in catalog)
            _skills.Add(ComposerSlashCommands.ToSkillOption(entry));
    }

    private string ResolveSkillDisplay(string skillName)
    {
        foreach (var skill in _skills)
        {
            if (string.Equals(skill.Name, skillName, StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(skill.DisplayName))
                    return skill.DisplayName;
                if (!string.IsNullOrWhiteSpace(skill.Label))
                    return skill.Label;
                break;
            }
        }

        return skillName;
    }

    private Task OnTextChanged() => RefreshSlashStateAsync();

    private void ToggleQueueExpanded() => _queueExpanded = !_queueExpanded;

    private async Task RefreshSlashStateAsync()
    {
        var generation = ++_slashRefreshGeneration;

        if (!ComposerSlashCommands.TryGetActiveToken(_text, out var token))
        {
            if (generation != _slashRefreshGeneration)
                return;

            _slashOpen = false;
            _suggestions = [];
            _highlight = 0;
            return;
        }

        if (ComposerSlashCommands.IsSkillCatalogToken(token))
        {
            await RefreshSkillsAsync();
            if (generation != _slashRefreshGeneration)
                return;

            if (!ComposerSlashCommands.TryGetActiveToken(_text, out token))
            {
                _slashOpen = false;
                _suggestions = [];
                _highlight = 0;
                return;
            }
        }

        if (generation != _slashRefreshGeneration)
            return;

        _suggestions = ComposerSlashCommands.Filter(token, _models, _skills);
        _slashOpen = _suggestions.Count > 0;
        _highlight = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_slashOpen && _suggestions.Count > 0)
        {
            if (e.Key == "ArrowDown")
            {
                _highlight = (_highlight + 1) % _suggestions.Count;
                return;
            }

            if (e.Key == "ArrowUp")
            {
                _highlight = (_highlight - 1 + _suggestions.Count) % _suggestions.Count;
                return;
            }

            if (e.Key == "Enter" && !e.CtrlKey && !e.ShiftKey)
            {
                await ApplySuggestionAsync(_suggestions[_highlight]);
                return;
            }

            if (e.Key == "Escape")
            {
                _slashOpen = false;
                _suggestions = [];
                _highlight = 0;
                return;
            }
        }

        if (e.Key == "Enter" && e.CtrlKey)
            await SubmitAsync();
    }

    private async Task ApplySuggestionAsync(ComposerSlashCommands.Suggestion suggestion)
    {
        await ApplyKindAsync(suggestion);

        if (ComposerSlashCommands.TryGetLeadingToken(_text, out _, out var remainder))
            _text = remainder;
        else
            _text = "";

        _slashOpen = false;
        _suggestions = [];
        _highlight = 0;
    }

    private async Task ApplyKindAsync(ComposerSlashCommands.Suggestion suggestion)
    {
        switch (suggestion.Kind)
        {
            case ComposerSlashCommands.Kind.Mode when suggestion.Mode is not null:
                await SelectedAgentModeChanged.InvokeAsync(suggestion.Mode);
                break;
            case ComposerSlashCommands.Kind.NewSession:
                await OnNewSession.InvokeAsync();
                break;
            case ComposerSlashCommands.Kind.Model when suggestion.ModelSlugId is Guid id:
                await SelectedSlugIdChanged.InvokeAsync(id);
                break;
            case ComposerSlashCommands.Kind.Skill when suggestion.SkillName is not null:
                Host.QueuePendingSkill(suggestion.SkillName);
                break;
            case ComposerSlashCommands.Kind.SkillSearch:
                OpenSkillSearch();
                break;
            case ComposerSlashCommands.Kind.Help:
                OpenHelp();
                break;
        }
    }

    private void OnHelpInsert(string template)
    {
        _text = template;
        _slashOpen = false;
        _suggestions = [];
        _highlight = 0;
    }

    private async Task OpenFilePickerAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("dysonComposer.openFileInput", _shell);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task OpenPendingFileAsync(string path) => Host.OpenFileViewerAsync(path);

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (Disabled)
        {
            Host.ReportError("Cannot attach files while the composer is busy.");
            _fileInputKey++;
            return;
        }

        var maxCount = Math.Max(DysonUserImageFactory.MaxPendingImages, DysonComposerUploads.MaxPendingFiles);
        foreach (var file in e.GetMultipleFiles(maxCount))
        {
            try
            {
                await using var stream = file.OpenReadStream(DysonComposerUploads.MaxRawBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                if (DysonComposerUploads.LooksLikeImage(file.ContentType, file.Name))
                    Host.QueuePendingImageFromBytes(file.Name, bytes);
                else
                    await Host.QueuePendingFileFromBytesAsync(file.Name, bytes);
            }
            catch (Exception ex)
            {
                Host.ReportError($"Could not read file: {ex.Message}");
            }
        }

        _fileInputKey++;
    }

    [JSInvokable]
    public Task SetDragOver(bool value)
    {
        if (_dragOver == value)
            return Task.CompletedTask;
        _dragOver = value;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SubmitAsync()
    {
        if (Disabled || !CanSubmit)
            return;

        var raw = _text;

        if (ComposerSlashCommands.TryResolve(raw, _models, out var parsed, _skills) && parsed is not null)
        {
            await ApplyKindAsync(parsed.Suggestion);
            raw = parsed.Remainder;
        }

        _text = "";
        _slashOpen = false;
        _suggestions = [];
        _highlight = 0;

        // Empty after strip: apply-only (mode/model/new/skill) unless images/files are pending.
        if (string.IsNullOrWhiteSpace(raw)
            && Host.PendingImages.Count == 0
            && Host.PendingFilePaths.Count == 0)
            return;

        await OnSubmit.InvokeAsync(raw?.Trim() ?? "");
    }

    /// <summary>Opens the model selector modal (empty-state CTA).</summary>
    public void OpenModelPicker() => _modelPicker?.Open();

    /// <summary>Opens the skill search modal (<c>/skill-search</c>).</summary>
    public void OpenSkillSearch() => _skillSearch?.Open();

    /// <summary>Opens the composer command help modal (<c>/help</c>).</summary>
    public void OpenHelp() => _helpModal?.Open();

    /// <summary>Focuses the prompt textarea (empty-state CTAs).</summary>
    public ValueTask FocusPromptAsync() => _textarea.FocusAsync();

    public async ValueTask DisposeAsync()
    {
        Host.Changed -= OnHostChanged;
        if (_imageCaptureBound)
        {
            try
            {
                await Js.InvokeVoidAsync("dysonComposer.detachImageCapture", _shell);
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
