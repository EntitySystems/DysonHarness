@namespace Harness.UI.Components.Chat
@using DysonHarness
@using Harness.UI.Components.Models
@using Harness.UI.Demo
@inject DysonModelStore ModelStore
@inject DysonUiHost Host
@inject IJSRuntime Js

<div class="composer">
    <AskQuestionPopover Ask="Ask" OnSubmit="OnAskSubmit" />
    <PlanReadyPopover Pending="Host.PendingPlanReady" />
    <div class="composer__prompt">
        @if (_slashOpen && _suggestions.Count > 0)
        {
            <div class="composer-slash" role="listbox" aria-label="Slash commands">
                @for (var i = 0; i < _suggestions.Count; i++)
                {
                    var suggestion = _suggestions[i];
                    var index = i;
                    <button type="button"
                            class="composer-slash__item @(index == _highlight ? "is-active" : null)"
                            role="option"
                            aria-selected="@(index == _highlight)"
                            @onmousedown:preventDefault="true"
                            @onclick="() => ApplySuggestionAsync(suggestion)">
                        <span class="composer-slash__token">@suggestion.Token</span>
                        <span class="composer-slash__desc">@suggestion.Label</span>
                    </button>
                }
            </div>
        }
        else if (Host.QueuedPrompts.Count > 0)
        {
            <div class="composer-queue" role="list" aria-label="Queued prompts">
                @foreach (var item in Host.QueuedPrompts)
                {
                    var queued = item;
                    <div class="composer-queue__item" role="listitem">
                        <span class="composer-queue__text" title="@queued.FirstLine">@queued.FirstLine</span>
                        <button type="button"
                                class="composer-queue__remove"
                                title="Remove from queue"
                                aria-label="Remove queued prompt"
                                @onmousedown:preventDefault="true"
                                @onclick="() => Host.RemoveQueuedPrompt(queued.Id)">
                            ×
                        </button>
                    </div>
                }
            </div>
        }
        <textarea @ref="_textarea"
                  @bind="_text"
                  @bind:event="oninput"
                  @bind:after="OnTextChanged"
                  @onkeydown="OnKeyDown"
                  placeholder="Prompt the agent…"
                  disabled="@Disabled"
                  data-slash-open="@(_slashOpen ? "1" : null)"></textarea>
    </div>
    <div class="composer__toolbar">
        <ModelSlugPicker SelectedSlugId="SelectedSlugId"
                         SelectedSlugIdChanged="SelectedSlugIdChanged" />
        <label class="composer-effort" title="Session reasoning_effort (None = omit)">
            <span class="composer-effort__label">Effort</span>
            <select class="composer-effort__input composer-effort__select"
                    value="@(_effortDraft)"
                    disabled="@Disabled"
                    @onchange="OnEffortSelectedAsync">
                <option value="">None</option>
                @foreach (var mode in EffortOptions)
                {
                    <option value="@mode">@mode</option>
                }
            </select>
        </label>
        <AgentModePicker SelectedMode="@SelectedAgentMode"
                         SelectedModeChanged="SelectedAgentModeChanged" />
        <span class="composer-chip composer-chip--branch @(string.IsNullOrEmpty(GitBranch) ? "is-muted" : null)"
              title="@(GitBranch ?? "No git repo")">
            @(string.IsNullOrEmpty(GitBranch) ? "No git repo" : GitBranch)
        </span>
    </div>
    <div class="composer__actions">
        <span class="list-item__meta">Ctrl+Enter to send · / for commands</span>
        <button type="button" class="btn btn-primary" disabled="@(Disabled || string.IsNullOrWhiteSpace(_text))" @onclick="SubmitAsync">
            Send
        </button>
    </div>
</div>

@code {
    private string _text = "";
    private ElementReference _textarea;
    private bool _textareaBound;
    private readonly List<ComposerSlashCommands.ModelOption> _models = [];
    private IReadOnlyList<ComposerSlashCommands.Suggestion> _suggestions = [];
    private bool _slashOpen;
    private int _highlight;

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Guid? SelectedSlugId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedSlugIdChanged { get; set; }
    [Parameter] public string? ReasoningEffort { get; set; }
    [Parameter] public EventCallback<string?> ReasoningEffortChanged { get; set; }
    [Parameter] public string SelectedAgentMode { get; set; } = DysonAgentModes.Work;
    [Parameter] public EventCallback<string> SelectedAgentModeChanged { get; set; }
    [Parameter] public string? GitBranch { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }
    [Parameter] public DysonAskUiState? Ask { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<DysonAskQuestionAnswer>> OnAskSubmit { get; set; }

    private string _effortDraft = "";
    private readonly Dictionary<Guid, IReadOnlyList<string>> _slugReasoningModes = new();

    private IEnumerable<string> EffortOptions
    {
        get
        {
            IReadOnlyList<string> modes = [];
            if (SelectedSlugId is Guid slugId
                && _slugReasoningModes.TryGetValue(slugId, out var registered))
            {
                modes = registered;
            }

            foreach (var mode in modes)
                yield return mode;

            var current = string.IsNullOrWhiteSpace(ReasoningEffort) ? null : ReasoningEffort.Trim();
            if (current is not null
                && !modes.Contains(current, StringComparer.Ordinal))
            {
                yield return current;
            }
        }
    }

    protected override void OnParametersSet()
    {
        _effortDraft = ReasoningEffort ?? "";
    }

    private async Task OnEffortSelectedAsync(ChangeEventArgs e)
    {
        var next = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim();
        _effortDraft = next ?? "";
        var current = string.IsNullOrWhiteSpace(ReasoningEffort) ? null : ReasoningEffort.Trim();
        if (string.Equals(next, current, StringComparison.Ordinal))
            return;

        await ReasoningEffortChanged.InvokeAsync(next);
    }

    protected override async Task OnInitializedAsync() => await RefreshModelsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_textareaBound)
            return;

        try
        {
            await Js.InvokeVoidAsync("dysonComposer.attachSlashGuard", _textarea);
            _textareaBound = true;
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task RefreshModelsAsync()
    {
        _models.Clear();
        _slugReasoningModes.Clear();
        var result = await ModelStore.ListProvidersAsync();
        if (result.IsError)
            return;

        foreach (var provider in result.Value)
        {
            foreach (var slug in provider.Slugs)
            {
                _slugReasoningModes[slug.Id] = slug.ReasoningModes;
                _models.Add(new ComposerSlashCommands.ModelOption(
                    slug.Id,
                    slug.DisplayAlias,
                    provider.DisplayName,
                    slug.Slug,
                    $"{slug.DisplayAlias} · {provider.DisplayName}"));
            }
        }
    }

    private void OnTextChanged()
    {
        RefreshSlashState();
    }

    private void RefreshSlashState()
    {
        if (!ComposerSlashCommands.TryGetActiveToken(_text, out var token))
        {
            _slashOpen = false;
            _suggestions = [];
            _highlight = 0;
            return;
        }

        _suggestions = ComposerSlashCommands.Filter(token, _models);
        _slashOpen = _suggestions.Count > 0;
        _highlight = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_slashOpen && _suggestions.Count > 0)
        {
            if (e.Key == "ArrowDown")
            {
                _highlight = (_highlight + 1) % _suggestions.Count;
                return;
            }

            if (e.Key == "ArrowUp")
            {
                _highlight = (_highlight - 1 + _suggestions.Count) % _suggestions.Count;
                return;
            }

            if (e.Key == "Enter" && !e.CtrlKey && !e.ShiftKey)
            {
                await ApplySuggestionAsync(_suggestions[_highlight]);
                return;
            }

            if (e.Key == "Escape")
            {
                _slashOpen = false;
                _suggestions = [];
                _highlight = 0;
                return;
            }
        }

        if (e.Key == "Enter" && e.CtrlKey)
            await SubmitAsync();
    }

    private async Task ApplySuggestionAsync(ComposerSlashCommands.Suggestion suggestion)
    {
        await ApplyKindAsync(suggestion);

        if (ComposerSlashCommands.TryGetLeadingToken(_text, out _, out var remainder))
            _text = remainder;
        else
            _text = "";

        _slashOpen = false;
        _suggestions = [];
        _highlight = 0;
    }

    private async Task ApplyKindAsync(ComposerSlashCommands.Suggestion suggestion)
    {
        switch (suggestion.Kind)
        {
            case ComposerSlashCommands.Kind.Mode when suggestion.Mode is not null:
                await SelectedAgentModeChanged.InvokeAsync(suggestion.Mode);
                break;
            case ComposerSlashCommands.Kind.NewSession:
                await OnNewSession.InvokeAsync();
                break;
            case ComposerSlashCommands.Kind.Model when suggestion.ModelSlugId is Guid id:
                await SelectedSlugIdChanged.InvokeAsync(id);
                break;
        }
    }

    private async Task SubmitAsync()
    {
        if (Disabled || string.IsNullOrWhiteSpace(_text))
            return;

        var raw = _text;

        if (ComposerSlashCommands.TryResolve(raw, _models, out var parsed) && parsed is not null)
        {
            await ApplyKindAsync(parsed.Suggestion);
            raw = parsed.Remainder;
        }

        _text = "";
        _slashOpen = false;
        _suggestions = [];
        _highlight = 0;

        // Empty after strip: apply-only (mode/model/new); composer never sends blank prompts.
        if (string.IsNullOrWhiteSpace(raw))
            return;

        await OnSubmit.InvokeAsync(raw.Trim());
    }
}
