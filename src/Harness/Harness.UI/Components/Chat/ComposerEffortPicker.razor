@namespace Harness.UI.Components.Chat

<div class="effort-picker @(OpenUp ? "effort-picker--up" : null)" @onkeydown="HandleKeyDown">
    <button type="button"
            class="btn btn--xs effort-picker__trigger composer-effort__trigger"
            disabled="@Disabled"
            title="@Title"
            aria-haspopup="true"
            aria-expanded="@_open"
            @onclick="Toggle">
        @if (ShowTriggerLabel)
        {
            <span class="models-panel__effort-label">effort</span>
        }
        <span class="effort-picker__value mono">@(string.IsNullOrWhiteSpace(Value) ? EmptyLabel : Value)</span>
        <span class="effort-picker__caret">▾</span>
    </button>

    @if (_open)
    {
        <div class="effort-picker__backdrop" @onclick="Close"></div>
        <div class="effort-picker__panel" tabindex="0">
            <div class="effort-picker__section-label">@SectionLabel</div>
            <button type="button"
                    class="effort-picker__option @(string.IsNullOrWhiteSpace(Value) ? "is-selected" : null)"
                    @onclick="() => PickAsync(null)">
                <span class="mono">@EmptyLabel</span>
            </button>
            @foreach (var mode in Options)
            {
                var m = mode;
                <button type="button"
                        class="effort-picker__option @(string.Equals(Value, m, StringComparison.OrdinalIgnoreCase) ? "is-selected" : null)"
                        @onclick="() => PickAsync(m)">
                    <span class="mono">@m</span>
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _open;

    /// <summary>Available effort modes for the selected slug (may be empty — then only <see cref="EmptyLabel"/> shows).</summary>
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    /// <summary>Current effort draft value; null/empty = <see cref="EmptyLabel"/>.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Fired with the picked effort; null = empty/<see cref="EmptyLabel"/>.</summary>
    [Parameter] public EventCallback<string?> OnPick { get; set; }
    /// <summary>First-option and empty-value label. Composer uses omit; Agent behavior uses Default.</summary>
    [Parameter] public string EmptyLabel { get; set; } = "omit";
    [Parameter] public string SectionLabel { get; set; } = "Session reasoning effort";
    [Parameter] public string Title { get; set; } = "Session reasoning_effort (omit = provider default)";
    [Parameter] public bool ShowTriggerLabel { get; set; } = true;
    [Parameter] public bool OpenUp { get; set; } = true;

    private void Toggle()
    {
        if (Disabled)
            return;
        _open = !_open;
    }

    private void Close() => _open = false;

    private async Task PickAsync(string? effort)
    {
        _open = false;
        await OnPick.InvokeAsync(effort);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _open = false;
    }
}
