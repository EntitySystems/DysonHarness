@namespace Harness.UI.Components.Chat

<div class="effort-picker effort-picker--up" @onkeydown="HandleKeyDown">
    <button type="button"
            class="btn btn--xs effort-picker__trigger composer-effort__trigger"
            disabled="@Disabled"
            title="Session reasoning_effort (omit = provider default)"
            aria-haspopup="true"
            aria-expanded="@_open"
            @onclick="Toggle">
        <span class="models-panel__effort-label">effort</span>
        <span class="effort-picker__value mono">@(string.IsNullOrWhiteSpace(Value) ? "omit" : Value)</span>
        <span class="effort-picker__caret">▾</span>
    </button>

    @if (_open)
    {
        <div class="effort-picker__backdrop" @onclick="Close"></div>
        <div class="effort-picker__panel" tabindex="0">
            <div class="effort-picker__section-label">Session reasoning effort</div>
            <button type="button"
                    class="effort-picker__option @(string.IsNullOrWhiteSpace(Value) ? "is-selected" : null)"
                    @onclick="() => PickAsync(null)">
                <span class="mono">omit</span>
            </button>
            @foreach (var mode in Options)
            {
                var m = mode;
                <button type="button"
                        class="effort-picker__option @(string.Equals(Value, m, StringComparison.OrdinalIgnoreCase) ? "is-selected" : null)"
                        @onclick="() => PickAsync(m)">
                    <span class="mono">@m</span>
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _open;

    /// <summary>Available effort modes for the selected slug (may be empty — then only "omit" and the current value show).</summary>
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    /// <summary>Current effort draft value; null/empty = omit.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Fired with the picked effort; null = omit.</summary>
    [Parameter] public EventCallback<string?> OnPick { get; set; }

    private void Toggle()
    {
        if (Disabled)
            return;
        _open = !_open;
    }

    private void Close() => _open = false;

    private async Task PickAsync(string? effort)
    {
        _open = false;
        await OnPick.InvokeAsync(effort);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _open = false;
    }
}
