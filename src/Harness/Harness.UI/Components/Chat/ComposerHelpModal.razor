@namespace Harness.UI.Components.Chat
@using Microsoft.AspNetCore.Components.Web

<DysonTransition Item="_open" ExitMs="140" RestoreFocus="true" OnEntered="FocusBackdropAsync" Context="ctx">
    <div class="composer-help-modal-backdrop dyson-fade-scale @ctx.StateClass"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => { if (!ctx.IsExiting) Close(); }"
         @onkeydown="OnBackdropKeyDown">
        <div class="composer-help-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="composer-help-modal-title"
             @onclick:stopPropagation="true">
            <div class="composer-help-modal__header">
                <h3 id="composer-help-modal-title">Composer commands</h3>
                <button type="button"
                        class="btn btn-ghost composer-help-modal__close"
                        @onclick="() => { if (!ctx.IsExiting) Close(); }"
                        aria-label="Close">×</button>
            </div>

            <div class="composer-help-modal__body">
                <p class="composer-help-modal__note">
                    Typing <span class="mono">/</span> in the composer shows live matches (models and skills are not listed here).
                </p>

                <h4 class="composer-help-modal__section">Built-in</h4>
                <div class="composer-help-modal__list" role="list">
                    @foreach (var entry in BuiltIns)
                    {
                        <div class="composer-help-modal__row" role="listitem">
                            <div class="composer-help-modal__meta">
                                <span class="composer-help-modal__token mono">@entry.Template</span>
                                <span class="composer-help-modal__desc">@entry.Description</span>
                            </div>
                            <button type="button"
                                    class="btn btn-ghost composer-help-modal__insert"
                                    @onclick="() => ctx.IsExiting ? Task.CompletedTask : InsertAsync(entry.Template)">
                                Insert
                            </button>
                        </div>
                    }
                </div>

                @if (PluginCommands.Count > 0)
                {
                    <h4 class="composer-help-modal__section">Plugin commands</h4>
                    <div class="composer-help-modal__list" role="list">
                        @foreach (var command in PluginCommands)
                        {
                            <div class="composer-help-modal__row" role="listitem">
                                <div class="composer-help-modal__meta">
                                    <span class="composer-help-modal__token mono">@command.Token</span>
                                    <span class="composer-help-modal__desc">@command.Label</span>
                                </div>
                                <button type="button"
                                        class="btn btn-ghost composer-help-modal__insert"
                                        @onclick="() => ctx.IsExiting ? Task.CompletedTask : InsertAsync(command.Token)">
                                    Insert
                                </button>
                            </div>
                        }
                    </div>
                }

                <h4 class="composer-help-modal__section">Patterns</h4>
                <div class="composer-help-modal__list" role="list">
                    @foreach (var entry in Patterns)
                    {
                        <div class="composer-help-modal__row" role="listitem">
                            <div class="composer-help-modal__meta">
                                <span class="composer-help-modal__token mono">@entry.Template</span>
                                <span class="composer-help-modal__desc">@entry.Description</span>
                            </div>
                            <button type="button"
                                    class="btn btn-ghost composer-help-modal__insert"
                                    @onclick="() => ctx.IsExiting ? Task.CompletedTask : InsertAsync(entry.Template)">
                                Insert
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    private bool _open;
    private ElementReference _backdropEl;

    [Parameter] public EventCallback<string> OnInsert { get; set; }

    [Parameter] public IReadOnlyList<ComposerSlashCommands.PluginCommandOption> PluginCommands { get; set; } = [];

    private static IEnumerable<ComposerSlashCommands.HelpEntry> BuiltIns =>
        ComposerSlashCommands.HelpCatalog
            .Where(e => e.Section == ComposerSlashCommands.HelpSection.BuiltIn);

    private static IEnumerable<ComposerSlashCommands.HelpEntry> Patterns =>
        ComposerSlashCommands.HelpCatalog
            .Where(e => e.Section == ComposerSlashCommands.HelpSection.Pattern);

    /// <summary>Opens the help modal (<c>/help</c>).</summary>
    public void Open()
    {
        _open = true;
        StateHasChanged();
    }

    private void Close() => _open = false;

    private async Task InsertAsync(string template)
    {
        await OnInsert.InvokeAsync(template);
        Close();
    }

    private void OnBackdropKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Close();
    }

    private async Task FocusBackdropAsync()
    {
        try { await _backdropEl.FocusAsync(); }
        catch { /* overlay may already be gone */ }
    }
}
