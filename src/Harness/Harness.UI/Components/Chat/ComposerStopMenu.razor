@namespace Harness.UI.Components.Chat
@using Harness.UI.Demo
@inject DysonUiHost Host

<div class="composer-stop">
    <button type="button"
            class="btn btn--xs btn-ghost composer-stop__trigger"
            disabled="@(!CanStop)"
            aria-busy="@CanStop"
            title="Halt this session tree (prompt, queue, and subagents)"
            @onclick="StopAll">
        @if (CanStop)
        {
            <span class="composer-stop__spinner" aria-hidden="true"></span>
        }
        Stop
    </button>
</div>

@code {
    private bool CanStop => Host.IsBusy || Host.HasActiveSubagents();

    private Task StopAll()
    {
        if (!CanStop)
            return Task.CompletedTask;
        return Host.StopAllExecution();
    }
}
