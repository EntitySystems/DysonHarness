@namespace Harness.UI.Components.Chat
@using Harness.UI.Demo
@implements IDisposable
@inject DysonUiHost Host
@inject DysonMessageBus Bus

<div class="composer-stop">
    <button type="button"
            class="btn btn--xs btn-ghost composer-stop__trigger @(CanStop ? "composer-stop__trigger--live" : null)"
            disabled="@(!CanStop)"
            aria-busy="@CanStop"
            title="Halt this session tree (prompt, queue, and subagents)"
            @onclick="StopAll">
        @if (CanStop)
        {
            <span class="composer-stop__spinner" aria-hidden="true"></span>
        }
        Stop
    </button>
</div>

@code {
    private bool CanStop => Host.CanStopExecution();
    private IDisposable? _hostSub;

    protected override void OnInitialized()
    {
        var sub = Bus.Subscribe<DysonHostStateChangedEvent>(Host.BusScopeKey, OnHostChanged);
        if (sub.IsSuccess)
            _hostSub = sub.Value;
    }

    private const DysonHostChangeKind HostChangeFilter =
        DysonHostChangeKind.Busy | DysonHostChangeKind.SessionGraph | DysonHostChangeKind.Transcript;

    private void OnHostChanged(DysonHostStateChangedEvent evt)
    {
        if ((evt.Kind & HostChangeFilter) == 0)
            return;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task StopAll()
    {
        if (!CanStop)
            return Task.CompletedTask;
        return Host.StopAllExecution();
    }

    public void Dispose()
    {
        _hostSub?.Dispose();
        _hostSub = null;
    }
}
