@namespace Harness.UI.Components.Chat
@using DysonHarness
@using Harness.UI.Demo
@inject DysonUiHost Host

@if (Pending is not null)
{
    <div class="composer-plan-ready" role="status" aria-label="Plan ready">
        <div class="composer-plan-ready__meta">
            <div class="composer-plan-ready__title">Plan ready — @Pending.Title</div>
            <div class="composer-plan-ready__path mono" title="@Pending.Path">@Pending.Path</div>
        </div>
        <div class="composer-plan-ready__actions">
            <button type="button"
                    class="btn"
                    disabled="@_busy"
                    @onclick="ViewAsync"
                    @onclick:stopPropagation="true">
                View plan file
            </button>
            <button type="button"
                    class="btn btn-primary"
                    disabled="@(_busy || Host.IsBusy)"
                    @onclick="BuildAsync"
                    @onclick:stopPropagation="true">
                Build plan
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public DysonPlanReadyInfo? Pending { get; set; }

    private bool _busy;

    private async Task ViewAsync()
    {
        if (Pending is null || _busy)
            return;

        _busy = true;
        try
        {
            await Host.OpenFileViewerAsync(Pending.Path);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BuildAsync()
    {
        if (Pending is null || _busy || Host.IsBusy)
            return;

        _busy = true;
        try
        {
            await Host.BuildPendingPlanAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
