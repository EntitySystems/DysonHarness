@namespace Harness.UI.Components.Chat
@using DysonHarness
@using Harness.UI.Demo
@inject DysonUiHost Host

<DysonTransition TItem="DysonPlanReadyInfo" Item="Pending" ExitMs="140" Context="ctx">
    <div class="composer-plan-ready dyson-fade @ctx.StateClass" role="status" aria-label="Plan ready">
        <div class="composer-plan-ready__meta">
            <div class="composer-plan-ready__title">Plan ready — @ctx.Item.Title</div>
            <div class="composer-plan-ready__path mono" title="@ctx.Item.Path">@ctx.Item.Path</div>
        </div>
        <div class="composer-plan-ready__actions">
            <button type="button"
                    class="btn"
                    disabled="@(ctx.IsExiting || _busy)"
                    @onclick="ViewAsync"
                    @onclick:stopPropagation="true">
                View plan file
            </button>
            <button type="button"
                    class="btn btn-primary"
                    disabled="@(ctx.IsExiting || _busy || Host.IsBusy)"
                    @onclick="BuildAsync"
                    @onclick:stopPropagation="true">
                Build plan
            </button>
        </div>
    </div>
</DysonTransition>

@code {
    [Parameter] public DysonPlanReadyInfo? Pending { get; set; }

    private bool _busy;

    private async Task ViewAsync()
    {
        if (Pending is null || _busy)
            return;

        _busy = true;
        try
        {
            await Host.OpenFileViewerAsync(Pending.Path);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BuildAsync()
    {
        if (Pending is null || _busy || Host.IsBusy)
            return;

        _busy = true;
        try
        {
            await Host.BuildPendingPlanAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
