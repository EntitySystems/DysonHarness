@namespace Harness.UI.Components.Chat
@using DysonHarness
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject IDysonSpeechToText SpeechToText
@inject IDysonSpeechModelRepository SpeechModels
@inject IDysonSubjectSettingsRepository SpeechSettings

@* Meta Agent push-to-talk, shared by Composer and the /meta page composer. *@
@if (State == DysonPushToTalkState.NotInstalled)
{
    <a class="composer-mic composer-mic--off"
       href="@DysonPushToTalkGate.VoiceSettingsHref"
       title="@Title"
       aria-label="@Title"
       @onclick="OpenVoiceSettingsAsync"
       @onclick:preventDefault="true">
        <span class="composer-mic__icon" aria-hidden="true"></span>
    </a>
}
else if (State == DysonPushToTalkState.Ready)
{
    <button type="button"
            class="composer-mic @(_recording ? "is-recording" : null) @(_busy ? "is-busy" : null)"
            title="@Title"
            aria-label="@Title"
            aria-pressed="@_recording"
            disabled="@(Disabled || _busy)"
            @onpointerdown="DownAsync"
            @onpointerup="UpAsync"
            @onpointerleave="UpAsync">
        <span class="composer-mic__icon" aria-hidden="true"></span>
    </button>
}

@code {
    private static readonly TimeSpan StartCap = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan StopCap = TimeSpan.FromSeconds(10);

    private IReadOnlyList<DysonSpeechModelEntity> _rows = [];
    private string? _inputPreference;
    private DotNetObjectReference<PushToTalkButton>? _ref;
    private bool _hotkeyBound;
    private bool _recording;
    private bool _busy;
    private Task<bool>? _start;
    private bool _disposed;

    /// <summary>Session agent mode; anything but Meta Agent renders nothing.</summary>
    [Parameter] public string? AgentMode { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The prompt textarea: Ctrl+M hotkey target and caret source.</summary>
    [Parameter] public ElementReference Textarea { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private DysonPushToTalkState State => DysonPushToTalkGate.Evaluate(AgentMode, _rows, _inputPreference);

    private string Title => State == DysonPushToTalkState.NotInstalled
        ? "Speech to text is not installed. Open Settings → Voice."
        : _busy ? "Transcribing…" : _recording ? "Recording… release to transcribe" : "Hold to talk (or hold Ctrl+M)";

    protected override async Task OnInitializedAsync()
    {
        var rows = await SpeechModels.ListAsync();
        if (rows.IsSuccess)
            _rows = rows.Value;
        var pref = await SpeechSettings.GetSettingAsync(DysonAppSettingKeys.SpeechInputModelId);
        _inputPreference = pref.IsSuccess ? pref.Value : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Textarea.Id is null)
            return;

        var want = State != DysonPushToTalkState.Hidden;
        if (want && !_hotkeyBound)
        {
            _ref ??= DotNetObjectReference.Create(this);
            if (await DysonCircuitJs.InvokeVoidAsync(Js, "dysonMic.attachHotkey", Textarea, _ref) is null)
                _hotkeyBound = true;
        }
        else if (!want && _hotkeyBound)
        {
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonMic.detachHotkey", Textarea);
            _hotkeyBound = false;
        }
    }

    [JSInvokable]
    public Task MicDown() => InvokeAsync(async () =>
    {
        await DownAsync();
        StateHasChanged();
    });

    [JSInvokable]
    public Task MicUp() => InvokeAsync(async () =>
    {
        await UpAsync();
        StateHasChanged();
    });

    private Task OpenVoiceSettingsAsync() =>
        DysonCircuitJs.NavigateAsync(Js, DysonPushToTalkGate.VoiceSettingsHref).AsTask();

    private async Task DownAsync()
    {
        if (State == DysonPushToTalkState.NotInstalled)
        {
            await OpenVoiceSettingsAsync();
            return;
        }

        if (State != DysonPushToTalkState.Ready || Disabled || _recording || _busy)
            return;

        _recording = true;
        _start = DysonCircuitJs.InvokeAsync<bool>(Js, "dysonMic.start", StartCap, CancellationToken.None).AsTask();
        if (!await _start)
        {
            _recording = false;
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonMic.cancel");
            await OnError.InvokeAsync("Microphone is not available (permission denied or no input device).");
        }
    }

    private async Task UpAsync()
    {
        if (!_recording)
            return;
        if (_start is { } start && !await start)
            return;

        _recording = false;
        _busy = true;
        StateHasChanged();
        try
        {
            var caret = await DysonCircuitJs.InvokeAsync<int?>(Js, "dysonMic.caret", Textarea) ?? Text.Length;
            var wav = await DysonCircuitJs.InvokeAsync<IJSStreamReference>(Js, "dysonMic.stop", StopCap, CancellationToken.None);
            if (wav is null)
                return;

            using var clip = new MemoryStream();
            await using (wav)
            {
                try
                {
                    await using var stream = await wav.OpenReadStreamAsync(DysonPhononSpeech.MaxAudioBytes);
                    await stream.CopyToAsync(clip);
                }
                catch (Exception ex) when (DysonCircuitJs.IsBenign(ex) || ex is IOException)
                {
                    await OnError.InvokeAsync($"Could not read the recording: {ex.Message}");
                    return;
                }
            }

            clip.Position = 0;
            string? transcript = null;
            await foreach (var chunk in SpeechToText.TranscribeAsync(clip, CancellationToken.None))
            {
                if (chunk.IsError)
                {
                    await OnError.InvokeAsync(chunk.Error);
                    return;
                }

                if (chunk.Value.IsFinal)
                    transcript = chunk.Value.Text;
            }

            if (_disposed)
                return;
            var (text, next) = DysonPushToTalkGate.InsertAtCaret(Text, caret, transcript);
            await TextChanged.InvokeAsync(text);
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonMic.setCaret", Textarea, next);
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_recording)
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonMic.cancel");
        if (_hotkeyBound && Textarea.Id is not null)
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonMic.detachHotkey", Textarea);
        _ref?.Dispose();
        _ref = null;
    }
}
