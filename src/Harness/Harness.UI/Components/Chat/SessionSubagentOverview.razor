@namespace Harness.UI.Components.Chat
@using DysonHarness
@implements IDisposable
@inject DysonMessageBus Bus

@if (_children.Count > 0)
{
    <div class="session-subagents">
        <button type="button"
                class="session-overview-actions__button session-subagents__toggle @(_open ? "is-open" : null)"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <span>@_children.Count subagents (@_activeCount active)</span>
        </button>
        <SessionSubagentsModal IsOpen="_open"
                               ChildIds="_children"
                               ActiveCount="_activeCount"
                               OnClose="Close" />
    </div>
}

@code {
    [Parameter] public DysonAgentSession? Session { get; set; }

    private Guid? _boundSessionId;
    private bool _open;
    private List<Guid> _children = [];
    private int _activeCount;
    private IDisposable? _sub;

    protected override void OnParametersSet()
    {
        var sessionId = Session?.PersistenceId;
        if (sessionId != _boundSessionId)
        {
            DisposeSubscriptions();
            _boundSessionId = sessionId;
            _open = false;
            SubscribeIfNeeded();
        }

        RefreshChildren();
    }

    private void SubscribeIfNeeded()
    {
        if (Session is null || Session.PersistenceId == Guid.Empty)
            return;

        var scope = DysonBusScopes.Session(Session.PersistenceId);
        IDisposable? spawned = null;
        IDisposable? status = null;

        var spawnedSub = Bus.Subscribe<DysonSubagentSpawnedEvent>(scope, OnSpawned);
        if (spawnedSub.IsSuccess)
            spawned = spawnedSub.Value;

        var statusSub = Bus.Subscribe<DysonSubagentStatusChangedEvent>(scope, OnStatus);
        if (statusSub.IsSuccess)
            status = statusSub.Value;

        if (spawned is null && status is null)
            return;

        _sub = new CompositeDisposable(spawned, status);
    }

    private void OnSpawned(DysonSubagentSpawnedEvent evt) => _ = InvokeAsync(() =>
    {
        RefreshChildren();
        StateHasChanged();
    });

    private void OnStatus(DysonSubagentStatusChangedEvent evt) => _ = InvokeAsync(() =>
    {
        RefreshChildren();
        StateHasChanged();
    });

    private void RefreshChildren()
    {
        _children = [];
        _activeCount = 0;
        if (Session is null)
            return;

        foreach (var child in Session.SubSessions.OrderByDescending(c => c.Id))
        {
            if (child.PersistenceId == Guid.Empty)
                continue;

            _children.Add(child.PersistenceId);
            if (child.Status == DysonSessionStatus.Active)
                _activeCount++;
        }
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void DisposeSubscriptions()
    {
        _sub?.Dispose();
        _sub = null;
    }

    public void Dispose() => DisposeSubscriptions();

    private sealed class CompositeDisposable : IDisposable
    {
        private readonly IDisposable? _first;
        private readonly IDisposable? _second;

        public CompositeDisposable(IDisposable? first, IDisposable? second)
        {
            _first = first;
            _second = second;
        }

        public void Dispose()
        {
            _first?.Dispose();
            _second?.Dispose();
        }
    }
}
