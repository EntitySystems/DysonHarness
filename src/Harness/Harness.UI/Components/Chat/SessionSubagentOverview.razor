@namespace Harness.UI.Components.Chat
@using DysonHarness
@using Harness.UI.Demo
@implements IDisposable
@inject DysonUiHost Host

@if (_children.Count > 0)
{
    <div class="session-subagents">
        <button type="button"
                class="session-subagents__toggle"
                aria-haspopup="dialog"
                aria-expanded="@_open"
                @onclick="Toggle">
            <span>@_children.Count subagents (@_activeCount active)</span>
        </button>
        <SessionSubagentsModal IsOpen="_open"
                               ChildIds="_children"
                               ActiveCount="_activeCount"
                               OnClose="Close" />
    </div>
}

@code {
    [Parameter] public DysonAgentSession? Session { get; set; }

    private Guid? _boundSessionId;
    private bool _open;
    private List<Guid> _children = [];
    private int _activeCount;

    protected override void OnInitialized() => Host.Changed += OnHostChanged;

    protected override void OnParametersSet()
    {
        var sessionId = Session?.PersistenceId;
        if (sessionId != _boundSessionId)
        {
            _boundSessionId = sessionId;
            _open = false;
        }

        RefreshChildren();
    }

    private void OnHostChanged() => _ = InvokeAsync(() =>
    {
        RefreshChildren();
        StateHasChanged();
    });

    private void RefreshChildren()
    {
        _children = [];
        _activeCount = 0;
        if (Session is null)
            return;

        foreach (var child in Session.SubSessions.OrderBy(c => c.Id))
        {
            if (child.PersistenceId == Guid.Empty)
                continue;

            _children.Add(child.PersistenceId);
            if (child.Status == DysonSessionStatus.Active)
                _activeCount++;
        }
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    public void Dispose() => Host.Changed -= OnHostChanged;
}
