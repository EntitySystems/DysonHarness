@namespace Harness.UI.Components.Chat
@using Microsoft.AspNetCore.Components.Web

<DysonTransition Item="IsOpen" ExitMs="140" RestoreFocus="true"
                 OnEntered="FocusBackdropAsync" Context="ctx">
    <div class="confirm-dialog-backdrop dyson-fade-scale @ctx.StateClass"
         role="presentation"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => ctx.IsExiting ? Task.CompletedTask : CloseAsync()"
         @onkeydown="args => { if (!ctx.IsExiting) OnKeyDown(args); }">
        <div class="confirm-dialog session-subagents-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="session-subagents-modal-title"
             @onclick:stopPropagation="true">
            <div class="confirm-dialog__header">
                <div class="session-subagents-modal__title-row">
                    <h3 id="session-subagents-modal-title">Subagents</h3>
                    <span class="session-subagents-modal__counts">
                        @ChildIds.Count total · @ActiveCount active
                    </span>
                </div>
                <button type="button"
                        class="btn btn-ghost session-subagents-modal__close"
                        @onclick="() => ctx.IsExiting ? Task.CompletedTask : CloseAsync()"
                        aria-label="Close">×</button>
            </div>

            <div class="confirm-dialog__body session-subagents-modal__body">
                @if (ChildIds.Count == 0)
                {
                    <p class="session-subagents-modal__empty">No subagents for this session.</p>
                }
                else
                {
                    <div class="session-subagents-modal__list">
                        @foreach (var id in ChildIds)
                        {
                            <SubagentCard PersistenceId="id" AfterNavigate="CloseAsync" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public IReadOnlyList<Guid> ChildIds { get; set; } = [];

    [Parameter] public int ActiveCount { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _backdropEl;

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task FocusBackdropAsync()
    {
        try { await _backdropEl.FocusAsync(); }
        catch { /* overlay may already be gone */ }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            _ = CloseAsync();
    }
}
