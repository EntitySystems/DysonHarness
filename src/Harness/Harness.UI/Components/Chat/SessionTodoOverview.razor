@namespace Harness.UI.Components.Chat
@using DysonHarness

@if (_todos.Count > 0)
{
    <div class="session-todos">
        <button type="button"
                class="session-todos__toggle session-overview-actions__button @(_open ? "is-open" : null)"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            <span>@_completeCount/@_todos.Count tasks done</span>
        </button>
        <SessionTodosModal IsOpen="_open"
                           Todos="_todos"
                           CompleteCount="_completeCount"
                           OnClose="Close" />
    </div>
}

@code {
    [Parameter] public DysonAgentSession? Session { get; set; }

    private Guid? _boundSessionId;
    private bool _open;
    private IReadOnlyList<DysonSessionTodo> _todos = [];
    private int _completeCount;

    protected override void OnParametersSet()
    {
        var sessionId = Session?.PersistenceId;
        if (sessionId != _boundSessionId)
        {
            _boundSessionId = sessionId;
            _open = false;
        }

        RefreshTodos();
    }

    private void RefreshTodos()
    {
        _todos = Session?.Todos is { Count: > 0 } todos
            ? todos.OrderByDescending(t => t.Sequence).ToArray()
            : [];
        _completeCount = 0;
        foreach (var t in _todos)
        {
            if (t.Status == DysonSessionTodoStatus.Complete)
                _completeCount++;
        }
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;
}
