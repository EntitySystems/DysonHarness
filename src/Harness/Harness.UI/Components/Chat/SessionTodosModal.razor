@namespace Harness.UI.Components.Chat
@using Microsoft.AspNetCore.Components.Web
@using DysonHarness

<DysonTransition Item="IsOpen" ExitMs="140" RestoreFocus="true"
                 OnEntered="FocusBackdropAsync" Context="ctx">
    <div class="confirm-dialog-backdrop dyson-fade-scale @ctx.StateClass"
         role="presentation"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => ctx.IsExiting ? Task.CompletedTask : CloseAsync()"
         @onkeydown="args => { if (!ctx.IsExiting) OnKeyDown(args); }">
        <div class="confirm-dialog session-todos-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="session-todos-modal-title"
             @onclick:stopPropagation="true">
            <div class="confirm-dialog__header">
                <div class="session-todos-modal__title-row">
                    <h3 id="session-todos-modal-title">Tasks</h3>
                    <span class="session-todos-modal__counts">
                        @CompleteCount/@Todos.Count done
                    </span>
                </div>
                <button type="button"
                        class="btn btn-ghost session-todos-modal__close"
                        @onclick="() => ctx.IsExiting ? Task.CompletedTask : CloseAsync()"
                        aria-label="Close">×</button>
            </div>

            <div class="confirm-dialog__body session-todos-modal__body">
                @{
                    var pending = Todos.Where(t => t.Status == DysonSessionTodoStatus.Pending).ToList();
                    var ongoing = Todos.Where(t => t.Status == DysonSessionTodoStatus.Ongoing).ToList();
                    var complete = Todos.Where(t => t.Status == DysonSessionTodoStatus.Complete).ToList();
                }
                <div class="session-todos__board">
                    <section class="session-todos__column" aria-label="pending">
                        <header class="session-todos__column-header session-todos__column-header--pending">
                            pending
                            <span class="session-todos__column-count">@pending.Count</span>
                        </header>
                        <div class="session-todos__column-body">
                            @if (pending.Count == 0)
                            {
                                <p class="session-todos__column-empty">None</p>
                            }
                            else
                            {
                                <ul class="session-todos__list">
                                    @foreach (var todo in pending)
                                    {
                                        <li class="session-todos__item">
                                            <span class="session-todos__name">@todo.DisplayName</span>
                                            <span class="session-todos__code mono">@todo.TaskCode</span>
                                            @if (todo.Comments.Count > 0)
                                            {
                                                <ul class="session-todos__comments">
                                                    @foreach (var comment in todo.Comments)
                                                    {
                                                        <li>@comment</li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </section>
                    <section class="session-todos__column" aria-label="ongoing">
                        <header class="session-todos__column-header session-todos__column-header--ongoing">
                            ongoing
                            <span class="session-todos__column-count">@ongoing.Count</span>
                        </header>
                        <div class="session-todos__column-body">
                            @if (ongoing.Count == 0)
                            {
                                <p class="session-todos__column-empty">None</p>
                            }
                            else
                            {
                                <ul class="session-todos__list">
                                    @foreach (var todo in ongoing)
                                    {
                                        <li class="session-todos__item">
                                            <span class="session-todos__name">@todo.DisplayName</span>
                                            <span class="session-todos__code mono">@todo.TaskCode</span>
                                            @if (todo.Comments.Count > 0)
                                            {
                                                <ul class="session-todos__comments">
                                                    @foreach (var comment in todo.Comments)
                                                    {
                                                        <li>@comment</li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </section>
                    <section class="session-todos__column" aria-label="complete">
                        <header class="session-todos__column-header session-todos__column-header--complete">
                            complete
                            <span class="session-todos__column-count">@complete.Count</span>
                        </header>
                        <div class="session-todos__column-body">
                            @if (complete.Count == 0)
                            {
                                <p class="session-todos__column-empty">None</p>
                            }
                            else
                            {
                                <ul class="session-todos__list">
                                    @foreach (var todo in complete)
                                    {
                                        <li class="session-todos__item">
                                            <span class="session-todos__name">@todo.DisplayName</span>
                                            <span class="session-todos__code mono">@todo.TaskCode</span>
                                            @if (todo.Comments.Count > 0)
                                            {
                                                <ul class="session-todos__comments">
                                                    @foreach (var comment in todo.Comments)
                                                    {
                                                        <li>@comment</li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public IReadOnlyList<DysonSessionTodo> Todos { get; set; } = [];

    [Parameter] public int CompleteCount { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _backdropEl;

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task FocusBackdropAsync()
    {
        try { await _backdropEl.FocusAsync(); }
        catch { /* overlay may already be gone */ }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            _ = CloseAsync();
    }
}
