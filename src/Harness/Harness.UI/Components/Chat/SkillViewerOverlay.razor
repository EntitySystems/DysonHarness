@namespace Harness.UI.Components.Chat
@using Harness.UI.Demo
@using Harness.UI.Markdown
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject DysonUiHost Host
@inject DysonMessageBus Bus

<DysonTransition TItem="DysonSkillViewerState" Item="Host.SkillViewer" ExitMs="140" RestoreFocus="true" OnEntered="FocusBackdropAsync" Context="ctx">
    <div class="file-viewer-modal-backdrop dyson-fade-scale @ctx.StateClass"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => { if (!ctx.IsExiting) Close(); }"
         @onkeydown="OnKeyDown">
        <div class="file-viewer-modal skill-viewer-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="skill-viewer-modal-title"
             @onclick:stopPropagation="true">
            <div class="file-viewer-modal__header">
                <div class="file-viewer-modal__titles">
                    <h3 id="skill-viewer-modal-title">@ctx.Item.DisplayName</h3>
                    @if (!string.IsNullOrWhiteSpace(ctx.Item.ResolvedPath))
                    {
                        <div class="file-viewer-modal__path mono">@ctx.Item.ResolvedPath</div>
                    }
                </div>
                <div class="file-viewer-modal__actions">
                    <button type="button"
                            class="btn btn-ghost file-viewer-modal__close"
                            @onclick="() => { if (!ctx.IsExiting) Close(); }"
                            aria-label="Close">×</button>
                </div>
            </div>

            <div class="file-viewer-modal__body">
                <div class="file-viewer-modal__content">
                    <div class="file-viewer-modal__markdown turn-block__body">
                        @MarkdownRenderer.ToHtml(ctx.Item.Markdown)
                    </div>
                </div>
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    private IDisposable? _hostSub;
    private ElementReference _backdropEl;

    protected override void OnInitialized()
    {
        var sub = Bus.Subscribe<DysonHostStateChangedEvent>(Host.BusScopeKey, OnHostChanged);
        if (sub.IsSuccess)
            _hostSub = sub.Value;
    }

    private void OnHostChanged(DysonHostStateChangedEvent evt)
    {
        if ((evt.Kind & DysonHostChangeKind.Overlay) == 0)
            return;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Close() => Host.CloseSkillViewer();

    private async Task FocusBackdropAsync()
    {
        try { await _backdropEl.FocusAsync(); }
        catch { /* overlay may already be gone */ }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Close();
    }

    public void Dispose()
    {
        _hostSub?.Dispose();
        _hostSub = null;
    }
}
