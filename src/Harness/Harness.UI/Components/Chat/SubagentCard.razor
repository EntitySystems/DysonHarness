@namespace Harness.UI.Components.Chat
@using DysonHarness
@using Harness.UI.Demo
@implements IDisposable
@inject DysonUiHost Host
@inject DysonMessageBus Bus

@if (PersistenceId != Guid.Empty)
{
    var icon = ResolveModeIcon(_state?.AgentMode);
    <button type="button"
            class="subagent-card"
            title="@CardAccessibleName"
            aria-label="@CardAccessibleName"
            @onclick="NavigateAsync">
        <span class="subagent-card__icon @icon.ColorClass"
              style="--subagent-mode-icon: url('@icon.Url')"
              aria-hidden="true"></span>
        <div class="subagent-card__text">
            <div class="subagent-card__title">
                <span class="subagent-card__name">@(_state?.Title ?? "Subagent")</span>
                @if (_state is { RuntimeId: > 0 })
                {
                    <span class="subagent-card__id mono">#@_state.RuntimeId</span>
                }
                @if (!string.IsNullOrWhiteSpace(_state?.LatestTurnStepTitle))
                {
                    <span class="subagent-card__step">@_state.LatestTurnStepTitle</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_state?.ModelLabel))
            {
                <div class="subagent-card__model">@_state.ModelLabel</div>
            }
        </div>
        @if (_state?.IsRunning == true)
        {
            <span class="subagent-card__spinner" aria-hidden="true"></span>
        }
    </button>
}

@code {
    [Parameter, EditorRequired] public Guid PersistenceId { get; set; }

    /// <summary>Invoked after a successful navigate (e.g. close a parent modal).</summary>
    [Parameter] public EventCallback AfterNavigate { get; set; }

    private DysonSubagentCardState? _state;
    private Guid? _boundPersistenceId;
    private IDisposable? _sub;

    private string CardAccessibleName
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(_state?.Title) ? "Subagent" : _state.Title.Trim();
            if (_state is { RuntimeId: > 0 })
                name += $" #{_state.RuntimeId}";
            if (!string.IsNullOrWhiteSpace(_state?.LatestTurnStepTitle))
                name += $" {_state.LatestTurnStepTitle.Trim()}";
            return name;
        }
    }

    protected override void OnParametersSet()
    {
        if (PersistenceId == _boundPersistenceId)
            return;

        DisposeSubscriptions();
        _boundPersistenceId = PersistenceId;
        RefreshState();
        SubscribeIfNeeded();
    }

    private void RefreshState() =>
        _state = PersistenceId == Guid.Empty
            ? null
            : Host.GetSubagentCardState(PersistenceId);

    private void SubscribeIfNeeded()
    {
        if (PersistenceId == Guid.Empty)
            return;

        var scope = DysonBusScopes.Session(PersistenceId);
        IDisposable? activity = null;
        IDisposable? status = null;

        var activitySub = Bus.Subscribe<DysonSubagentActivityChangedEvent>(scope, OnActivity);
        if (activitySub.IsSuccess)
            activity = activitySub.Value;

        var statusSub = Bus.Subscribe<DysonSubagentStatusChangedEvent>(scope, OnStatus);
        if (statusSub.IsSuccess)
            status = statusSub.Value;

        if (activity is null && status is null)
            return;

        _sub = new CompositeDisposable(activity, status);
    }

    private void OnActivity(DysonSubagentActivityChangedEvent evt) => _ = InvokeAsync(() =>
    {
        if (evt.PersistenceId != PersistenceId)
            return;
        if (_state is null)
            RefreshState();
        if (_state is null || _state.PersistenceId != evt.PersistenceId)
            return;

        _state = new DysonSubagentCardState
        {
            PersistenceId = evt.PersistenceId,
            RuntimeId = evt.RuntimeId,
            Title = evt.Title,
            LatestTurnStepTitle = evt.LatestTurnStepTitle,
            ModelLabel = _state.ModelLabel,
            AgentMode = _state.AgentMode,
            IsRunning = evt.IsRunning,
            Status = _state.Status,
        };
        StateHasChanged();
    });

    private void OnStatus(DysonSubagentStatusChangedEvent evt) => _ = InvokeAsync(() =>
    {
        if (evt.PersistenceId != PersistenceId)
            return;
        if (_state is null)
            RefreshState();
        if (_state is null || _state.PersistenceId != evt.PersistenceId)
            return;

        _state = new DysonSubagentCardState
        {
            PersistenceId = evt.PersistenceId,
            RuntimeId = evt.RuntimeId,
            Title = _state.Title,
            LatestTurnStepTitle = _state.LatestTurnStepTitle,
            ModelLabel = _state.ModelLabel,
            AgentMode = _state.AgentMode,
            IsRunning = evt.IsRunning,
            Status = evt.Status,
        };
        StateHasChanged();
    });

    private async Task NavigateAsync()
    {
        if (PersistenceId == Guid.Empty)
            return;

        await Host.NavigateToSessionAsync(PersistenceId);
        await AfterNavigate.InvokeAsync();
    }

    private static (string Url, string ColorClass) ResolveModeIcon(string? agentMode)
    {
        if (string.IsNullOrWhiteSpace(agentMode))
            return ("icons/agent-modes/custom.svg", "subagent-card__icon--other");

        if (string.Equals(agentMode, DysonAgentModes.Explore, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/explore.svg", "subagent-card__icon--explore");
        if (string.Equals(agentMode, DysonAgentModes.Drone, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/drone.svg", "subagent-card__icon--drone");
        if (string.Equals(agentMode, DysonAgentModes.SecurityReview, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/security-review.svg", "subagent-card__icon--review");
        if (string.Equals(agentMode, DysonAgentModes.BugReview, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/bug-review.svg", "subagent-card__icon--review");
        if (string.Equals(agentMode, DysonAgentModes.Ask, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/ask.svg", "subagent-card__icon--other");
        if (string.Equals(agentMode, DysonAgentModes.Plan, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/plan.svg", "subagent-card__icon--other");
        if (string.Equals(agentMode, DysonAgentModes.Work, StringComparison.OrdinalIgnoreCase))
            return ("icons/agent-modes/work.svg", "subagent-card__icon--other");

        return ("icons/agent-modes/custom.svg", "subagent-card__icon--other");
    }

    private void DisposeSubscriptions()
    {
        _sub?.Dispose();
        _sub = null;
    }

    public void Dispose() => DisposeSubscriptions();

    private sealed class CompositeDisposable : IDisposable
    {
        private readonly IDisposable? _first;
        private readonly IDisposable? _second;

        public CompositeDisposable(IDisposable? first, IDisposable? second)
        {
            _first = first;
            _second = second;
        }

        public void Dispose()
        {
            _first?.Dispose();
            _second?.Dispose();
        }
    }
}
