@namespace Harness.UI.Components.Chat
@using System.Text.Json
@using DysonHarness
@using Harness.UI.Components.Tools
@using Harness.UI.Demo
@using Harness.UI.Markdown
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject DysonUiHost Host

<article class="turn-block @(IsExpanded ? null : "turn-block--collapsed") @(Turn.IsExcludedFromContext ? "turn-block--dropped" : null) @(Enter ? "turn-block--enter" : null)"
         @oncontextmenu="OnContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    <div @ref="_stickySentinel" class="turn-block__sticky-sentinel" aria-hidden="true"></div>
    <header @ref="_headerEl"
            class="turn-block__header"
            role="button"
            tabindex="0"
            aria-expanded="@IsExpanded"
            @onclick="OnToggleExpand"
            @onkeydown="HandleHeaderKeyDown">
        <span class="turn-block__icons" aria-hidden="false">
            <span class="turn-block__role-icon @(IsUserTurn ? "turn-block__role-icon--user" : "turn-block__role-icon--agent")"
                  role="img"
                  title="@(IsUserTurn ? "User" : "Agent")"
                  aria-label="@(IsUserTurn ? "User turn" : "Agent turn")"></span>
            <span class="turn-block__kind-icon"
                  role="img"
                  title="@DysonAgentTurnKindDisplay.GetDisplayName(Turn.Kind)"
                  aria-label="@DysonAgentTurnKindDisplay.GetDisplayName(Turn.Kind)"
                  style="--turn-kind-icon: url('@DysonAgentTurnKindIcons.GetIconUrl(Turn.Kind)')"></span>
        </span>
        <div class="turn-block__header-main">
            <div class="turn-block__title-row">
                <div class="turn-block__title">@(Turn.AgentTitle ?? DysonAgentTurnKindDisplay.GetDisplayName(Turn.Kind))</div>
                @if (Turn.Kind == DysonAgentTurnKind.WorktreeCreating && Turn.CompletedUtc is null)
                {
                    <span class="turn-block__spinner" aria-hidden="true"></span>
                }
                @if (Turn.IsExcludedFromContext)
                {
                    <span class="turn-block__dropped-badge">Dropped</span>
                    <button type="button"
                            class="turn-block__restore"
                            title="Restore this turn to model context"
                            aria-label="Restore turn to context"
                            @onclick:stopPropagation="true"
                            @onclick="HandleRestoreAsync">
                        Restore
                    </button>
                }
                else if (IsSummarizing)
                {
                    <span class="turn-block__summarizing-badge">
                        <span class="turn-block__spinner" aria-hidden="true"></span>
                        Summarizing…
                    </span>
                }
                else if (DysonTurnSummarizer.HasSummary(Turn))
                {
                    <span class="turn-block__summarized-badge">Summarized</span>
                }
            </div>
            <div class="turn-block__kind mono">@DysonAgentTurnKindDisplay.GetDisplayName(Turn.Kind) · @ShortId(Turn.Id)</div>
        </div>
        @if (Turn.StartedUtc != default)
        {
            <div class="turn-block__timestamp mono">@FormatTurnTimes()</div>
        }
    </header>
    @* Always mounted: collapse animates this wrapper's height instead of destroying the
       subtree, so a new prompt no longer tears down and rebuilds every prior turn's body
       (and with it TurnBlock's sticky-header / tools-resizer JS attach). `inert` keeps the
       collapsed body out of the tab order and the accessibility tree. *@
    <div class="turn-block__collapsible @(IsExpanded ? null : "turn-block__collapsible--collapsed")"
         inert="@(!IsExpanded)">
        @if (IsUserTurn && (!string.IsNullOrWhiteSpace(Turn.Instruction) || Turn.ContextFiles.Count > 0 || Turn.UserImages.Count > 0))
        {
            <div class="turn-block__user">
                <div class="turn-block__user-main">
                    @if (Turn.ContextFiles.Count > 0)
                    {
                        <div class="turn-block__skills">
                            @foreach (var contextFile in Turn.ContextFiles)
                            {
                                var entry = contextFile;
                                var chipKind = entry.Kind == DysonContextFileKind.File ? "file" : "skill";
                                <button type="button"
                                        class="turn-block__skill-chip"
                                        title="@(entry.ResolvedPath ?? entry.DisplayName)"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Host.OpenSkillViewer(entry)">
                                    Used @chipKind @entry.DisplayName
                                </button>
                            }
                        </div>
                    }
                    @if (Turn.UserImages.Count > 0)
                    {
                        <div class="turn-block__images" aria-label="Attached images">
                            @foreach (var image in Turn.UserImages)
                            {
                                var img = image;
                                <figure class="turn-block__image" title="@img.FileName">
                                    <img src="@($"data:{img.MimeType};base64,{img.Base64Data}")"
                                         alt="@img.FileName" />
                                    <figcaption class="turn-block__image-caption mono">@img.FileName</figcaption>
                                </figure>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Turn.Instruction))
                    {
                        <div class="turn-block__user-prompt">@MarkdownRenderer.ToHtml(Turn.Instruction)</div>
                    }
                </div>
                @if (ShowPromptSpinner)
                {
                    <button type="button"
                            class="turn-block__user-spinner turn-block__cancel"
                            disabled="@(!CanCancel)"
                            title="Cancel"
                            aria-label="Cancel prompt"
                            @onclick="HandleCancelAsync">
                        <span class="turn-block__spinner" aria-hidden="true"></span>
                        <img class="turn-block__cancel-icon" src="icons/cancel.svg" alt="" />
                    </button>
                }
                else if (ShowResubmit)
                {
                    <button type="button"
                            class="turn-block__user-retry"
                            disabled="@SessionBusy"
                            title="Resubmit prompt"
                            aria-label="Resubmit prompt"
                            @onclick="HandleResubmitAsync">
                        <img class="turn-block__retry-icon" src="icons/retry.svg" alt="" />
                    </button>
                }
            </div>
        }
        else if (Turn.Kind == DysonAgentTurnKind.PlanResult)
        {
            <PlanResultBlock Turn="Turn" />
        }
        else if (Turn.Kind == DysonAgentTurnKind.DisplayInfo
                 && !string.IsNullOrWhiteSpace(Turn.AssistantText))
        {
            <div class="turn-block__display-info">@MarkdownRenderer.ToHtml(Turn.AssistantText)</div>
        }
        else if (Turn.Kind == DysonAgentTurnKind.ModeSwitch
                 && !string.IsNullOrWhiteSpace(Turn.AssistantText))
        {
            <div class="turn-block__display-info">@MarkdownRenderer.ToHtml(Turn.AssistantText)</div>
        }
        else if (Turn.Kind == DysonAgentTurnKind.WorktreeCreating)
        {
            <div class="turn-block__display-info">
                @if (Turn.CompletedUtc is null)
                {
                    <span class="turn-block__spinner" aria-hidden="true"></span>
                }
                @if (!string.IsNullOrWhiteSpace(Turn.AssistantText))
                {
                    @MarkdownRenderer.ToHtml(Turn.AssistantText)
                }
            </div>
        }
        else if (IsHarnessInstructionTurn && !string.IsNullOrWhiteSpace(Turn.Instruction))
        {
            <div class="turn-block__instruction">@MarkdownRenderer.ToHtml(Turn.Instruction)</div>
        }

        @if (ShowsContentColumn)
        {
            <div @ref="_contentEl" class="turn-block__content">
                <div class="turn-block__main">
                    @if (HasReasoning)
                    {
                        <div class="turn-block__thinking-history">
                            @{
                                var thoughtOrdinal = 0;
                                var interimOrdinal = 0;
                                var commentOrdinal = 0;
                                var thoughtCount = Turn.ReasoningLog.Count(s =>
                                    s.Kind == DysonReasoningSegmentKind.Thought);
                                var interimCount = Turn.ReasoningLog.Count(s =>
                                    s.Kind == DysonReasoningSegmentKind.InterimText
                                    && !string.IsNullOrWhiteSpace(s.Text));
                                var liveStreaming = DysonReasoningHistoryUi.IsLiveReasoningStreaming(Turn);
                            }
                            @foreach (var segment in Turn.ReasoningLog)
                            {
                                if (segment.Kind == DysonReasoningSegmentKind.Thought)
                                {
                                    var key = $"t:{thoughtOrdinal}";
                                    var fallback = DysonReasoningHistoryUi.ThoughtFallback(
                                        thoughtOrdinal, thoughtCount, liveStreaming);
                                    var (title, body) = DysonReasoningHistoryUi.SplitSegmentTitle(segment.Text, fallback);
                                    <div class="@SegmentClass(key)" @key="@($"{Turn.Id}:{key}")">
                                        <button type="button"
                                                class="turn-block__reasoning-summary"
                                                aria-expanded="@IsSegmentExpanded(key)"
                                                @onclick="() => ToggleSegment(key)"
                                                @onclick:stopPropagation="true">
                                            <span class="turn-block__reasoning-chevron" aria-hidden="true">▸</span>
                                            <span>@title</span>
                                        </button>
                                        <div class="@SegmentBodyClass(key)" inert="@(!IsSegmentExpanded(key))">
                                            <div class="turn-block__body">@MarkdownRenderer.ToHtml(body)</div>
                                        </div>
                                    </div>
                                    thoughtOrdinal++;
                                }
                                else if (segment.Kind == DysonReasoningSegmentKind.InterimText
                                         && !string.IsNullOrWhiteSpace(segment.Text))
                                {
                                    var key = $"i:{interimOrdinal}";
                                    var fallback = DysonReasoningHistoryUi.InterimFallback(
                                        interimOrdinal, interimCount);
                                    var (title, body) = DysonReasoningHistoryUi.SplitSegmentTitle(segment.Text, fallback);
                                    <div class="@SegmentClass(key) turn-block__reasoning--interim" @key="@($"{Turn.Id}:{key}")">
                                        <button type="button"
                                                class="turn-block__reasoning-summary"
                                                aria-expanded="@IsSegmentExpanded(key)"
                                                @onclick="() => ToggleSegment(key)"
                                                @onclick:stopPropagation="true">
                                            <span class="turn-block__reasoning-chevron" aria-hidden="true">▸</span>
                                            <span>@title</span>
                                        </button>
                                        <div class="@SegmentBodyClass(key)" inert="@(!IsSegmentExpanded(key))">
                                            <div class="turn-block__body">@MarkdownRenderer.ToHtml(body)</div>
                                        </div>
                                    </div>
                                    interimOrdinal++;
                                }
                                else if (segment.Kind == DysonReasoningSegmentKind.UserComment
                                         && !string.IsNullOrWhiteSpace(segment.Text))
                                {
                                    var key = $"c:{commentOrdinal}";
                                    var title = DysonReasoningHistoryUi.UserCommentFallback(commentOrdinal);
                                    <div class="@SegmentClass(key) turn-block__reasoning--comment" @key="@($"{Turn.Id}:{key}")">
                                        <button type="button"
                                                class="turn-block__reasoning-summary"
                                                aria-expanded="@IsSegmentExpanded(key)"
                                                @onclick="() => ToggleSegment(key)"
                                                @onclick:stopPropagation="true">
                                            <span class="turn-block__reasoning-chevron" aria-hidden="true">▸</span>
                                            <span>@title</span>
                                        </button>
                                        <div class="@SegmentBodyClass(key)" inert="@(!IsSegmentExpanded(key))">
                                            <div class="turn-block__body">@MarkdownRenderer.ToHtml(segment.Text)</div>
                                        </div>
                                    </div>
                                    commentOrdinal++;
                                }
                            }

                            @if (liveStreaming)
                            {
                                const string liveKey = "live";
                                var liveTitle = DysonReasoningHistoryUi.LiveThoughtTitle(thoughtCount);
                                <div class="@SegmentClass(liveKey) turn-block__reasoning--live" @key="@($"{Turn.Id}:{liveKey}")">
                                    <button type="button"
                                            class="turn-block__reasoning-summary"
                                            aria-expanded="@IsSegmentExpanded(liveKey)"
                                            @onclick="() => ToggleSegment(liveKey)"
                                            @onclick:stopPropagation="true">
                                        <span class="turn-block__reasoning-chevron" aria-hidden="true">▸</span>
                                        <span>@liveTitle</span>
                                    </button>
                                    <div class="@SegmentBodyClass(liveKey)" inert="@(!IsSegmentExpanded(liveKey))">
                                        <div @ref="_reasoningStreamEl" class="turn-block__body turn-block__body--streaming">
                                            @if (_streamTextUnavailable)
                                            {
                                                @Turn.ReasoningStreamingPreview
                                            }
                                            <span class="turn-block__caret" aria-hidden="true"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (Turn.ReasoningLog.Count == 0 && !string.IsNullOrWhiteSpace(Turn.ReasoningText))
                            {
                                @* Legacy blob without ReasoningLog (should be rare after restore synthesis). *@
                                const string legacyKey = "legacy";
                                var (legacyTitle, legacyBody) = DysonReasoningHistoryUi.SplitSegmentTitle(
                                    Turn.ReasoningText, "Thinking");
                                <div class="@SegmentClass(legacyKey)" @key="@($"{Turn.Id}:{legacyKey}")">
                                    <button type="button"
                                            class="turn-block__reasoning-summary"
                                            aria-expanded="@IsSegmentExpanded(legacyKey)"
                                            @onclick="() => ToggleSegment(legacyKey)"
                                            @onclick:stopPropagation="true">
                                        <span class="turn-block__reasoning-chevron" aria-hidden="true">▸</span>
                                        <span>@legacyTitle</span>
                                    </button>
                                    <div class="@SegmentBodyClass(legacyKey)" inert="@(!IsSegmentExpanded(legacyKey))">
                                        <div class="turn-block__body">@MarkdownRenderer.ToHtml(legacyBody)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (Turn.IsStreaming && !string.IsNullOrEmpty(Turn.StreamingPreview))
                    {
                        @* Text is declared here only as the fallback for a failed stream-text.js
                           load. Normally wwwroot/stream-text.js owns this div's children so each
                           delta can fade in as its own span; Blazor never re-renders children it
                           did not declare, which is what keeps those spans alive. *@
                        <div @ref="_streamEl" class="turn-block__body turn-block__body--streaming">
                            @if (_streamTextUnavailable)
                            {
                                @Turn.StreamingPreview
                            }
                            <span class="turn-block__caret" aria-hidden="true"></span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Turn.AssistantText))
                    {
                        @* --final only after this instance streamed, so a session load does not
                           fade in every historic reply. *@
                        <div class="turn-block__body @(_streamed ? "turn-block__body--final" : null)">@MarkdownRenderer.ToHtml(Turn.AssistantText)</div>
                    }

                    @if (HasVisualizations)
                    {
                        <TurnVisualizations Turn="Turn" />
                    }

                    @if (HasGeneratedImages)
                    {
                        <TurnGeneratedImages Turn="Turn" />
                    }

                    @if (ShowThinkingIdleDots)
                    {
                        <div class="turn-block__thinking-idle" role="status" aria-label="Waiting for model">
                            <span></span><span></span><span></span>
                        </div>
                    }
                </div>

                @if (HasTools)
                {
                    <div @ref="_resizerEl"
                         class="turn-block__tools-resizer"
                         role="separator"
                         aria-orientation="vertical"
                         aria-label="Resize tools column"
                         tabindex="0"></div>
                    <div class="turn-block__tools">
                        <ToolCallPanel Turn="Turn"
                                       SessionBusy="SessionBusy"
                                       IsLatestTurn="IsLatestTurn"
                                       OnCancel="OnCancel" />
                    </div>
                }
            </div>
        }

        @if (CanInjectComment)
        {
            <div class="turn-block__inject">
                @if (!_injectOpen)
                {
                    <button type="button"
                            class="turn-block__inject-toggle"
                            title="Inject a comment into this running turn"
                            @onclick="OpenInject"
                            @onclick:stopPropagation="true">
                        Inject comment
                    </button>
                }
                else
                {
                    <div class="turn-block__inject-form">
                        <textarea @ref="_injectInput"
                                  class="turn-block__inject-input"
                                  rows="2"
                                  placeholder="Steer this turn…"
                                  aria-label="Inject comment"
                                  @bind="_injectText"
                                  @bind:event="oninput"
                                  @onkeydown="HandleInjectKeyDown"
                                  @onkeydown:stopPropagation="true"
                                  @onclick:stopPropagation="true"></textarea>
                        <button type="button"
                                class="turn-block__inject-send"
                                title="Send comment"
                                @onclick="SubmitInjectComment"
                                @onclick:stopPropagation="true">
                            Send
                        </button>
                    </div>
                }
            </div>
        }

        @if (CollectSubagentPersistenceIds() is { Count: > 0 } subagentIds)
        {
            <div class="turn-block__subagents">
                @foreach (var id in subagentIds)
                {
                    <SubagentCard PersistenceId="id" />
                }
            </div>
        }
    </div>
</article>

<DysonTransition Item="_contextMenuOpen" ExitMs="90" RestoreFocus="true" OnEntered="FocusContextBackdropAsync" Context="ctx">
    <div class="turn-block__context-backdrop"
         tabindex="-1"
         @ref="_contextBackdropEl"
         @onclick="() => { if (!ctx.IsExiting) CloseContextMenu(); }"
         @onkeydown="OnContextBackdropKeyDown"></div>
    <div class="turn-block__context-menu dyson-pop @ctx.StateClass"
         role="menu"
         aria-label="Turn actions"
         style="left:@(_contextMenuX.ToString(System.Globalization.CultureInfo.InvariantCulture))px;top:@(_contextMenuY.ToString(System.Globalization.CultureInfo.InvariantCulture))px;--dyson-pop-origin:top left;"
         @onclick:stopPropagation="true">
        <button type="button"
                class="turn-block__context-menu-item"
                role="menuitem"
                disabled="@(ctx.IsExiting || !CanSummarizeTurn)"
                title="@SummarizeTurnTitle"
                @onclick="HandleSummarizeTurnAsync">
            Summarize turn
        </button>
        <button type="button"
                class="turn-block__context-menu-item"
                role="menuitem"
                disabled="@(ctx.IsExiting || !CanDropTurn)"
                title="@DropTurnTitle"
                @onclick="HandleDropTurnAsync">
            Drop turn
        </button>
    </div>
</DysonTransition>

@code {
    private ElementReference _stickySentinel;
    private ElementReference _headerEl;
    private ElementReference _contentEl;
    private ElementReference _resizerEl;
    private ElementReference _injectInput;
    private ElementReference _streamEl;
    private ElementReference _reasoningStreamEl;
    private DotNetObjectReference<TurnBlock>? _dotNetRef;
    private bool _stickyAttached;
    private bool _resizerAttached;
    private Guid _cachedSubagentTurnId;
    private int _cachedSubagentTrackedCount = -1;
    private int _cachedSubagentResultFingerprint;
    private List<Guid> _cachedSubagentIds = [];
    private readonly HashSet<string> _expandedKeys = new(StringComparer.Ordinal);
    private string? _expandPolicyFingerprint;
    private bool _segmentAnimate;
    private bool _streamTextUnavailable;
    private bool _streamed;
    private bool _contextMenuOpen;
    private ElementReference _contextBackdropEl;
    private double _contextMenuX;
    private double _contextMenuY;
    private Guid _injectTurnId;
    private bool _injectOpen;
    private bool _injectFocusPending;
    private string _injectText = "";

    [Parameter, EditorRequired] public DysonAgentTurn Turn { get; set; } = default!;

    /// <summary>True while the host is running a prompt on the active session.</summary>
    [Parameter] public bool SessionBusy { get; set; }

    /// <summary>True when this turn is the latest in the transcript (awaiting-model spinner).</summary>
    [Parameter] public bool IsLatestTurn { get; set; }

    /// <summary>When false, only the header chrome is shown.</summary>
    [Parameter] public bool IsExpanded { get; set; } = true;

    /// <summary>
    /// Plays the entrance fade. Set by <see cref="ChatPanel"/> for genuinely new turns only —
    /// never for a session-load batch or the empty-state swap.
    /// </summary>
    [Parameter] public bool Enter { get; set; }

    /// <summary>Toggles expand/collapse from the turn header.</summary>
    [Parameter] public EventCallback OnToggleExpand { get; set; }

    /// <summary>Halts the focused session tree (wired for the latest live turn).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Re-sends this turn's instruction as a new prompt when idle.</summary>
    [Parameter] public EventCallback<string> OnResubmit { get; set; }

    private bool IsUserTurn =>
        Turn.Kind is DysonAgentTurnKind.Normal or DysonAgentTurnKind.InitializeSession;

    /// <summary>
    /// Harness kinds (<see cref="DysonAgentTurnKind.BeginBuildPlan"/>, Continuation, …)
    /// use the muted instruction strip via <c>!IsUserTurn</c>.
    /// </summary>
    private bool IsHarnessInstructionTurn =>
        !IsUserTurn
        && Turn.Kind != DysonAgentTurnKind.PlanResult
        && Turn.Kind != DysonAgentTurnKind.DisplayInfo
        && Turn.Kind != DysonAgentTurnKind.ModeSwitch
        && Turn.Kind != DysonAgentTurnKind.WorktreeCreating;

    private bool CanCancel => Host.CanStopExecution() && IsLatestTurn && OnCancel.HasDelegate;

    private bool ShowResubmit =>
        OnResubmit.HasDelegate && !string.IsNullOrWhiteSpace(Turn.Instruction);

    /// <summary>
    /// Compact loader on the user prompt row until the assistant reply is finalized.
    /// </summary>
    private bool ShowPromptSpinner
    {
        get
        {
            // Final reply present and stream ended — done.
            if (!string.IsNullOrWhiteSpace(Turn.AssistantText) && !Turn.IsStreaming)
                return false;

            if (Turn.IsStreaming)
                return true;

            if (HasPendingTools)
                return true;

            // Awaiting model (before first token / between tool rounds) on the live turn.
            if (SessionBusy && IsLatestTurn && string.IsNullOrWhiteSpace(Turn.AssistantText))
                return true;

            return false;
        }
    }

    /// <summary>
    /// Animated idle dots under the thought column while the live turn is busy
    /// but neither reasoning nor reply text is currently streaming.
    /// </summary>
    private bool ShowThinkingIdleDots
    {
        get
        {
            if (!(SessionBusy && IsLatestTurn))
                return false;

            if (Turn.IsReasoningStreaming && !string.IsNullOrEmpty(Turn.ReasoningStreamingPreview))
                return false;

            if (Turn.IsStreaming && !string.IsNullOrEmpty(Turn.StreamingPreview))
                return false;

            if (!string.IsNullOrWhiteSpace(Turn.AssistantText))
                return false;

            return true;
        }
    }

    private bool HasAssistantBody =>
        (Turn.IsStreaming && !string.IsNullOrEmpty(Turn.StreamingPreview))
        || !string.IsNullOrWhiteSpace(Turn.AssistantText);

    private bool HasReasoning =>
        Turn.ReasoningLog.Count > 0
        || (Turn.IsReasoningStreaming && !string.IsNullOrEmpty(Turn.ReasoningStreamingPreview))
        || !string.IsNullOrWhiteSpace(Turn.ReasoningText);

    private bool HasTools =>
        Turn.TrackedToolCalls.Count > 0 || Turn.ToolCalls.Count > 0;

    private bool HasVisualizations => Turn.TrackedToolCalls.Any(call =>
        call.Status == DysonToolCallStatus.Completed && call.Result?.HtmlVisualization is not null);

    private bool HasGeneratedImages => Turn.TrackedToolCalls.Any(call =>
        call.Status == DysonToolCallStatus.Completed
        && call.Result is { IsError: false, GeneratedImageArtifacts.Count: > 0 });

    private bool HasPendingTools =>
        Turn.TrackedToolCalls.Any(t =>
            t.Status is DysonToolCallStatus.Queued or DysonToolCallStatus.Working)
        || (Turn.ToolCalls.Count > 0 && Turn.TrackedToolCalls.Count == 0);

    private bool CanInjectComment =>
        Host.Session?.IsTurnInFlight(Turn.Id) == true;

    /// <summary>Mirrors the content-column condition in the markup (also gates its JS attach).</summary>
    private bool ShowsContentColumn =>
        Turn.Kind != DysonAgentTurnKind.DisplayInfo
        && Turn.Kind != DysonAgentTurnKind.ModeSwitch
        && Turn.Kind != DysonAgentTurnKind.WorktreeCreating
        && (HasAssistantBody || HasReasoning || HasTools || HasVisualizations || HasGeneratedImages || ShowThinkingIdleDots);

    private bool ShowsAssistantStream =>
        ShowsContentColumn && Turn.IsStreaming && !string.IsNullOrEmpty(Turn.StreamingPreview);

    private bool ShowsReasoningStream =>
        ShowsContentColumn && HasReasoning && DysonReasoningHistoryUi.IsLiveReasoningStreaming(Turn);

    private string SegmentClass(string key) =>
        IsSegmentExpanded(key)
            ? "turn-block__reasoning turn-block__reasoning--open"
            : "turn-block__reasoning";

    /// <summary>
    /// Reasoning bodies are always mounted and animate height, but <see cref="ApplyExpandPolicy"/>
    /// rebuilds <c>_expandedKeys</c> wholesale on every reasoning transition — a whole batch of
    /// panels changes state in one frame. Only user toggles get the transition.
    /// </summary>
    private string SegmentBodyClass(string key) => string.Concat(
        "turn-block__reasoning-body",
        IsSegmentExpanded(key) ? "" : " turn-block__reasoning-body--collapsed",
        _segmentAnimate ? "" : " turn-block__reasoning-body--instant");

    protected override void OnParametersSet()
    {
        if (Turn.IsStreaming)
            _streamed = true;

        if (_injectTurnId != Turn.Id)
        {
            _injectTurnId = Turn.Id;
            _injectOpen = false;
            _injectText = "";
            _injectFocusPending = false;
        }

        var fingerprint = BuildExpandPolicyFingerprint();
        if (fingerprint == _expandPolicyFingerprint)
            return;

        _expandPolicyFingerprint = fingerprint;
        ApplyExpandPolicy();
    }

    private string BuildExpandPolicyFingerprint()
    {
        var liveStreaming = DysonReasoningHistoryUi.IsLiveReasoningStreaming(Turn);
        // Lengths only — preview growth must not clear user toggles every token.
        var parts = new List<string>(Turn.ReasoningLog.Count + 3)
        {
            HasAssistantBody ? "1" : "0",
            Turn.IsReasoningStreaming ? "1" : "0",
            liveStreaming ? "1" : "0",
        };
        foreach (var segment in Turn.ReasoningLog)
            parts.Add($"{(int)segment.Kind}:{segment.Text.Length}");

        if (Turn.ReasoningLog.Count == 0 && !string.IsNullOrWhiteSpace(Turn.ReasoningText))
            parts.Add($"legacy:{Turn.ReasoningText.Length}");

        return string.Join('|', parts);
    }

    private void ApplyExpandPolicy()
    {
        _segmentAnimate = false;
        _expandedKeys.Clear();

        var keys = new List<string>();
        var thoughtOrdinal = 0;
        var interimOrdinal = 0;
        var commentOrdinal = 0;
        foreach (var segment in Turn.ReasoningLog)
        {
            if (segment.Kind == DysonReasoningSegmentKind.Thought)
            {
                keys.Add($"t:{thoughtOrdinal}");
                thoughtOrdinal++;
            }
            else if (segment.Kind == DysonReasoningSegmentKind.InterimText
                     && !string.IsNullOrWhiteSpace(segment.Text))
            {
                keys.Add($"i:{interimOrdinal}");
                interimOrdinal++;
            }
            else if (segment.Kind == DysonReasoningSegmentKind.UserComment
                     && !string.IsNullOrWhiteSpace(segment.Text))
            {
                keys.Add($"c:{commentOrdinal}");
                commentOrdinal++;
            }
        }

        var liveStreaming = DysonReasoningHistoryUi.IsLiveReasoningStreaming(Turn);
        var expandSlotCount = liveStreaming ? keys.Count + 1 : keys.Count;
        var hasAssistantBody = HasAssistantBody;

        for (var i = 0; i < keys.Count; i++)
        {
            if (DysonReasoningHistoryUi.ShouldExpandSegment(
                    i, expandSlotCount, hasAssistantBody, Turn.IsReasoningStreaming))
            {
                _expandedKeys.Add(keys[i]);
            }
        }

        if (liveStreaming)
        {
            if (DysonReasoningHistoryUi.ShouldExpandSegment(
                    keys.Count, expandSlotCount, hasAssistantBody, Turn.IsReasoningStreaming))
            {
                _expandedKeys.Add("live");
            }
        }
        else if (keys.Count == 0 && !string.IsNullOrWhiteSpace(Turn.ReasoningText))
        {
            if (DysonReasoningHistoryUi.ShouldExpandSegment(
                    0, 1, hasAssistantBody, Turn.IsReasoningStreaming))
            {
                _expandedKeys.Add("legacy");
            }
        }
    }

    private bool IsSegmentExpanded(string key) => _expandedKeys.Contains(key);

    private void ToggleSegment(string key)
    {
        _segmentAnimate = true;
        if (!_expandedKeys.Remove(key))
            _expandedKeys.Add(key);
    }

    private Task HandleCancelAsync() => CanCancel ? OnCancel.InvokeAsync() : Task.CompletedTask;

    private Task HandleResubmitAsync() =>
        SessionBusy || !OnResubmit.HasDelegate
            ? Task.CompletedTask
            : OnResubmit.InvokeAsync(Turn.Instruction);

    private async Task HandleRestoreAsync()
    {
        var session = Host.Session;
        if (session is null)
            return;

        await Host.RestoreTurnContextAsync(session.PersistenceId, Turn.Id);
    }

    private bool CanDropTurn =>
        !Turn.IsExcludedFromContext && !(SessionBusy && IsLatestTurn);

    private bool IsSummarizing => Host.IsSummarizingTurn(Turn.Id);

    private bool CanSummarizeTurn =>
        !Turn.IsExcludedFromContext
        && Turn.Kind != DysonAgentTurnKind.DisplayInfo
        && Turn.Kind != DysonAgentTurnKind.WorktreeCreating
        && !IsSummarizing
        && !(SessionBusy && IsLatestTurn);

    private string DropTurnTitle =>
        Turn.IsExcludedFromContext
            ? "Turn is already dropped from model context"
            : SessionBusy && IsLatestTurn
                ? "Cannot drop the in-flight turn"
                : "Exclude this turn from model context";

    private string SummarizeTurnTitle =>
        Turn.IsExcludedFromContext
            ? "Turn is dropped from model context"
            : IsSummarizing
                ? "Summarizing…"
                : SessionBusy && IsLatestTurn
                    ? "Cannot summarize the in-flight turn"
                    : DysonTurnSummarizer.HasSummary(Turn)
                        ? "Re-summarize this turn for model context"
                        : "Compress this turn into a context stub";

    private void OnContextMenu(MouseEventArgs e)
    {
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuOpen = true;
    }

    private void CloseContextMenu() => _contextMenuOpen = false;

    private void OnContextBackdropKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseContextMenu();
    }

    /// <summary>Escape is handled on the backdrop, so focus has to land there when the menu opens.</summary>
    private async Task FocusContextBackdropAsync()
    {
        try
        {
            await _contextBackdropEl.FocusAsync();
        }
        catch
        {
            // Menu may already be gone.
        }
    }

    private async Task HandleDropTurnAsync()
    {
        CloseContextMenu();
        if (!CanDropTurn)
            return;

        var session = Host.Session;
        if (session is null)
            return;

        await Host.DropTurnContextAsync(session.PersistenceId, Turn.Id);
    }

    private Task HandleSummarizeTurnAsync()
    {
        CloseContextMenu();
        if (!CanSummarizeTurn)
            return Task.CompletedTask;

        var session = Host.Session;
        if (session is null)
            return Task.CompletedTask;

        // Fire-and-forget so the context menu closes without waiting on the summarizer.
        _ = Host.SummarizeTurnsAsync(
            session.PersistenceId,
            [Turn.Id],
            "Summarized from UI");
        return Task.CompletedTask;
    }

    private async Task HandleHeaderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or " "))
            return;
        await OnToggleExpand.InvokeAsync();
    }

    private void OpenInject()
    {
        _injectOpen = true;
        _injectFocusPending = true;
    }

    private void HandleInjectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _injectOpen = false;
            _injectText = "";
            _injectFocusPending = false;
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
            SubmitInjectComment();
    }

    private void SubmitInjectComment()
    {
        var text = _injectText.Trim();
        if (string.IsNullOrEmpty(text))
            return;

        var result = Host.InjectTurnComment(Turn.Id, text);
        if (result.IsError)
            return;

        _injectText = "";
        _injectOpen = false;
        _injectFocusPending = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureStickyHeaderAsync();
        await PaintStreamTextAsync();

        if (_injectOpen && _injectFocusPending)
        {
            _injectFocusPending = false;
            try
            {
                await _injectInput.FocusAsync();
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        // Collapse no longer unmounts the resizer, so it stays attached across a class flip.
        if (!ShowsContentColumn || !HasTools)
        {
            await DetachResizerAsync();
            return;
        }

        if (_resizerAttached)
            return;

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("dysonToolsCol.attach", _resizerEl, _contentEl, _dotNetRef);
            _resizerAttached = true;
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>
    /// Hands the current preview to <c>stream-text.js</c>, which appends only the new suffix as a
    /// fading span. On a hard JS failure (module never loaded) this switches the streaming divs to
    /// Blazor-rendered plain text for the rest of the circuit — the text always shows, only the
    /// per-chunk fade is lost.
    /// </summary>
    private async Task PaintStreamTextAsync()
    {
        if (_streamTextUnavailable)
            return;

        try
        {
            if (ShowsAssistantStream)
                await Js.InvokeVoidAsync("dysonStreamText.paint", _streamEl, Turn.StreamingPreview);

            if (ShowsReasoningStream)
                await Js.InvokeVoidAsync("dysonStreamText.paint", _reasoningStreamEl, Turn.ReasoningStreamingPreview);
        }
        catch (JSException)
        {
            _streamTextUnavailable = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerender: interop is unavailable, not broken. Keep the JS-owned path.
        }
    }

    private async Task EnsureStickyHeaderAsync()
    {
        if (_stickyAttached)
            return;

        try
        {
            await Js.InvokeVoidAsync("dysonStickyHeader.attach", _stickySentinel, _headerEl);
            _stickyAttached = true;
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task DetachStickyHeaderAsync()
    {
        if (!_stickyAttached)
            return;

        _stickyAttached = false;
        try
        {
            await Js.InvokeVoidAsync("dysonStickyHeader.detach", _headerEl);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException)
        {
        }
    }

    [JSInvokable]
    public Task OnToolsColWidth(double percent) =>
        Host.SetToolPanelWidthPercentAsync(percent);

    [JSInvokable]
    public Task OnToolsColResizeEnd() =>
        Host.FlushToolPanelWidthSaveAsync();

    private async Task DetachResizerAsync()
    {
        if (!_resizerAttached)
            return;

        _resizerAttached = false;
        try
        {
            await Js.InvokeVoidAsync("dysonToolsCol.detach", _resizerEl);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DetachStickyHeaderAsync();
        await DetachResizerAsync();
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private string FormatTurnTimes()
    {
        var start = FormatLocal(Turn.StartedUtc);
        return Turn.CompletedUtc is { } end
            ? $"{start} – {FormatLocal(end)}"
            : start;
    }

    private static string FormatLocal(DateTime utc) =>
        utc.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private List<Guid> CollectSubagentPersistenceIds()
    {
        var trackedCount = Turn.TrackedToolCalls.Count;
        // ponytail: count-only would miss StartSubagent Result landing (count stays put).
        // Fingerprint is content lengths so we skip JsonDocument.Parse until results change.
        var fingerprint = 0;
        foreach (var tracked in Turn.TrackedToolCalls)
        {
            if (!string.Equals(tracked.Call.ToolName, "StartSubagent", StringComparison.OrdinalIgnoreCase))
                continue;
            fingerprint = HashCode.Combine(fingerprint, tracked.Result?.Content?.Length ?? 0);
        }

        if (Turn.Id == _cachedSubagentTurnId
            && trackedCount == _cachedSubagentTrackedCount
            && fingerprint == _cachedSubagentResultFingerprint)
            return _cachedSubagentIds;

        var ids = new List<Guid>();
        foreach (var tracked in Turn.TrackedToolCalls)
        {
            if (!string.Equals(tracked.Call.ToolName, "StartSubagent", StringComparison.OrdinalIgnoreCase))
                continue;
            if (tracked.Result?.Content is not { Length: > 0 } content)
                continue;
            if (TryParsePersistenceId(content, out var id) && !ids.Contains(id))
                ids.Add(id);
        }

        _cachedSubagentTurnId = Turn.Id;
        _cachedSubagentTrackedCount = trackedCount;
        _cachedSubagentResultFingerprint = fingerprint;
        _cachedSubagentIds = ids;
        return ids;
    }

    private static bool TryParsePersistenceId(string content, out Guid persistenceId)
    {
        persistenceId = default;
        try
        {
            using var doc = JsonDocument.Parse(content);
            if (!doc.RootElement.TryGetProperty("persistenceId", out var prop))
                return false;

            return prop.ValueKind switch
            {
                JsonValueKind.String => Guid.TryParse(prop.GetString(), out persistenceId),
                _ => prop.TryGetGuid(out persistenceId),
            };
        }
        catch (JsonException)
        {
            return false;
        }
    }
