@namespace Harness.UI.Components.Chat
@using System.Text.Json
@using DysonHarness
@using Harness.UI.Components.Tools
@using Harness.UI.Demo
@using Harness.UI.Markdown
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject DysonUiHost Host

<article class="turn-block @(IsExpanded ? null : "turn-block--collapsed") @(Turn.IsExcludedFromContext ? "turn-block--dropped" : null)">
    <header class="turn-block__header"
            role="button"
            tabindex="0"
            aria-expanded="@IsExpanded"
            @onclick="OnToggleExpand"
            @onkeydown="HandleHeaderKeyDown">
        <div class="turn-block__header-main">
            <div class="turn-block__title-row">
                <div class="turn-block__title">@(Turn.AgentTitle ?? DysonAgentTurnKindDisplay.GetDisplayName(Turn.Kind))</div>
                @if (Turn.IsExcludedFromContext)
                {
                    <span class="turn-block__dropped-badge">Dropped</span>
                    <button type="button"
                            class="turn-block__restore"
                            title="Restore this turn to model context"
                            aria-label="Restore turn to context"
                            @onclick:stopPropagation="true"
                            @onclick="HandleRestoreAsync">
                        Restore
                    </button>
                }
            </div>
            <div class="turn-block__kind mono">@DysonAgentTurnKindDisplay.GetDisplayName(Turn.Kind) · @ShortId(Turn.Id)</div>
        </div>
        @if (Turn.StartedUtc != default)
        {
            <div class="turn-block__timestamp mono">@FormatTurnTimes()</div>
        }
    </header>
    @if (IsExpanded)
    {
        @if (IsUserTurn && !string.IsNullOrWhiteSpace(Turn.Instruction))
        {
            <div class="turn-block__user">
                <div class="turn-block__user-prompt">@MarkdownRenderer.ToHtml(Turn.Instruction)</div>
                @if (ShowPromptSpinner)
                {
                    <button type="button"
                            class="turn-block__user-spinner turn-block__cancel"
                            disabled="@(!CanCancel)"
                            title="Cancel"
                            aria-label="Cancel prompt"
                            @onclick="HandleCancelAsync">
                        <span class="turn-block__spinner" aria-hidden="true"></span>
                        <img class="turn-block__cancel-icon" src="icons/cancel.svg" alt="" />
                    </button>
                }
                else if (ShowResubmit)
                {
                    <button type="button"
                            class="turn-block__user-retry"
                            disabled="@SessionBusy"
                            title="Resubmit prompt"
                            aria-label="Resubmit prompt"
                            @onclick="HandleResubmitAsync">
                        <img class="turn-block__retry-icon" src="icons/retry.svg" alt="" />
                    </button>
                }
            </div>
        }
        else if (Turn.Kind == DysonAgentTurnKind.PlanResult)
        {
            <PlanResultBlock Turn="Turn" />
        }
        else if (IsHarnessInstructionTurn && !string.IsNullOrWhiteSpace(Turn.Instruction))
        {
            <div class="turn-block__instruction">@MarkdownRenderer.ToHtml(Turn.Instruction)</div>
        }

        @if (HasAssistantBody || HasReasoning || HasTools)
        {
            <div @ref="_contentEl" class="turn-block__content">
                <div class="turn-block__main">
                    @if (HasReasoning)
                    {
                        <div class="turn-block__thinking-history">
                            @{
                                var thoughtOrdinal = 0;
                                var thoughtCount = Turn.ReasoningLog.Count(s =>
                                    s.Kind == DysonReasoningSegmentKind.Thought);
                                var hasAssistant = !string.IsNullOrWhiteSpace(Turn.AssistantText);
                                var liveStreaming = Turn.IsReasoningStreaming
                                    && !string.IsNullOrEmpty(Turn.ReasoningStreamingPreview);
                                // While a trailing live Thought streams, treat it as the latest slot
                                // so prior committed Thoughts stay collapsed.
                                var expandSlotCount = liveStreaming ? thoughtCount + 1 : thoughtCount;
                            }
                            @foreach (var segment in Turn.ReasoningLog)
                            {
                                if (segment.Kind == DysonReasoningSegmentKind.Thought)
                                {
                                    var expand = DysonReasoningHistoryUi.ShouldExpandThought(
                                        thoughtOrdinal,
                                        expandSlotCount,
                                        hasAssistant,
                                        Turn.IsReasoningStreaming);
                                    var attrs = expand
                                        ? new Dictionary<string, object> { ["open"] = true }
                                        : null;
                                    <details class="turn-block__reasoning" @attributes="attrs">
                                        <summary class="turn-block__reasoning-summary">
                                            @(thoughtCount > 1 || liveStreaming ? $"Thinking {thoughtOrdinal + 1}" : "Thinking")
                                        </summary>
                                        <div class="turn-block__body">@MarkdownRenderer.ToHtml(segment.Text)</div>
                                    </details>
                                    thoughtOrdinal++;
                                }
                                else if (segment.Kind == DysonReasoningSegmentKind.InterimText
                                         && !string.IsNullOrWhiteSpace(segment.Text))
                                {
                                    <div class="turn-block__interim">@MarkdownRenderer.ToHtml(segment.Text)</div>
                                }
                            }

                            @if (liveStreaming)
                            {
                                <details class="turn-block__reasoning turn-block__reasoning--live" open="true">
                                    <summary class="turn-block__reasoning-summary">
                                        @(thoughtCount > 0 ? $"Thinking {thoughtCount + 1}" : "Thinking")
                                    </summary>
                                    <div class="turn-block__body turn-block__body--streaming">
                                        @Turn.ReasoningStreamingPreview<span class="turn-block__caret" aria-hidden="true"></span>
                                    </div>
                                </details>
                            }
                            else if (Turn.ReasoningLog.Count == 0 && !string.IsNullOrWhiteSpace(Turn.ReasoningText))
                            {
                                @* Legacy blob without ReasoningLog (should be rare after restore synthesis). *@
                                <details class="turn-block__reasoning">
                                    <summary class="turn-block__reasoning-summary">Thinking</summary>
                                    <div class="turn-block__body">@MarkdownRenderer.ToHtml(Turn.ReasoningText)</div>
                                </details>
                            }
                        </div>
                    }

                    @if (Turn.IsStreaming && !string.IsNullOrEmpty(Turn.StreamingPreview))
                    {
                        <div class="turn-block__body turn-block__body--streaming">
                            @Turn.StreamingPreview<span class="turn-block__caret" aria-hidden="true"></span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Turn.AssistantText))
                    {
                        <div class="turn-block__body">@MarkdownRenderer.ToHtml(Turn.AssistantText)</div>
                    }
                </div>

                @if (HasTools)
                {
                    <div @ref="_resizerEl"
                         class="turn-block__tools-resizer"
                         role="separator"
                         aria-orientation="vertical"
                         aria-label="Resize tools column"
                         tabindex="0"></div>
                    <div class="turn-block__tools">
                        <ToolCallPanel Turn="Turn" />
                    </div>
                }
            </div>
        }

        @if (CollectSubagentPersistenceIds() is { Count: > 0 } subagentIds)
        {
            <div class="turn-block__subagents">
                @foreach (var id in subagentIds)
                {
                    <SubagentCard PersistenceId="id" />
                }
            </div>
        }
    }
</article>

@code {
    private ElementReference _contentEl;
    private ElementReference _resizerEl;
    private DotNetObjectReference<TurnBlock>? _dotNetRef;
    private bool _resizerAttached;

    [Parameter, EditorRequired] public DysonAgentTurn Turn { get; set; } = default!;

    /// <summary>True while the host is running a prompt on the active session.</summary>
    [Parameter] public bool SessionBusy { get; set; }

    /// <summary>True when this turn is the latest in the transcript (awaiting-model spinner).</summary>
    [Parameter] public bool IsLatestTurn { get; set; }

    /// <summary>When false, only the header chrome is shown.</summary>
    [Parameter] public bool IsExpanded { get; set; } = true;

    /// <summary>Toggles expand/collapse from the turn header.</summary>
    [Parameter] public EventCallback OnToggleExpand { get; set; }

    /// <summary>Cancels the in-flight prompt (wired only for the latest busy turn).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Re-sends this turn's instruction as a new prompt when idle.</summary>
    [Parameter] public EventCallback<string> OnResubmit { get; set; }

    private bool IsUserTurn =>
        Turn.Kind is DysonAgentTurnKind.Normal or DysonAgentTurnKind.InitializeSession;

    /// <summary>
    /// Harness kinds (<see cref="DysonAgentTurnKind.BeginBuildPlan"/>, Continuation, …)
    /// use the muted instruction strip via <c>!IsUserTurn</c>.
    /// </summary>
    private bool IsHarnessInstructionTurn =>
        !IsUserTurn && Turn.Kind != DysonAgentTurnKind.PlanResult;

    private bool CanCancel => SessionBusy && IsLatestTurn && OnCancel.HasDelegate;

    private bool ShowResubmit =>
        OnResubmit.HasDelegate && !string.IsNullOrWhiteSpace(Turn.Instruction);

    /// <summary>
    /// Compact loader on the user prompt row until the assistant reply is finalized.
    /// </summary>
    private bool ShowPromptSpinner
    {
        get
        {
            // Final reply present and stream ended — done.
            if (!string.IsNullOrWhiteSpace(Turn.AssistantText) && !Turn.IsStreaming)
                return false;

            if (Turn.IsStreaming)
                return true;

            if (HasPendingTools)
                return true;

            // Awaiting model (before first token / between tool rounds) on the live turn.
            if (SessionBusy && IsLatestTurn && string.IsNullOrWhiteSpace(Turn.AssistantText))
                return true;

            return false;
        }
    }

    private bool HasAssistantBody =>
        (Turn.IsStreaming && !string.IsNullOrEmpty(Turn.StreamingPreview))
        || !string.IsNullOrWhiteSpace(Turn.AssistantText);

    private bool HasReasoning =>
        Turn.ReasoningLog.Count > 0
        || (Turn.IsReasoningStreaming && !string.IsNullOrEmpty(Turn.ReasoningStreamingPreview))
        || !string.IsNullOrWhiteSpace(Turn.ReasoningText);

    private bool HasTools =>
        Turn.TrackedToolCalls.Count > 0 || Turn.ToolCalls.Count > 0;

    private bool HasPendingTools =>
        Turn.TrackedToolCalls.Any(t =>
            t.Status is DysonToolCallStatus.Queued or DysonToolCallStatus.Working)
        || (Turn.ToolCalls.Count > 0 && Turn.TrackedToolCalls.Count == 0);

    private Task HandleCancelAsync() => CanCancel ? OnCancel.InvokeAsync() : Task.CompletedTask;

    private Task HandleResubmitAsync() =>
        SessionBusy || !OnResubmit.HasDelegate
            ? Task.CompletedTask
            : OnResubmit.InvokeAsync(Turn.Instruction);

    private async Task HandleRestoreAsync()
    {
        var session = Host.Session;
        if (session is null)
            return;

        await Host.RestoreTurnContextAsync(session.PersistenceId, Turn.Id);
    }

    private async Task HandleHeaderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or " "))
            return;
        await OnToggleExpand.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsExpanded || !HasTools)
        {
            await DetachResizerAsync();
            return;
        }

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("dysonToolsCol.attach", _resizerEl, _contentEl, _dotNetRef);
            _resizerAttached = true;
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    [JSInvokable]
    public Task OnToolsColWidth(double percent) =>
        Host.SetToolPanelWidthPercentAsync(percent);

    [JSInvokable]
    public Task OnToolsColResizeEnd() =>
        Host.FlushToolPanelWidthSaveAsync();

    private async Task DetachResizerAsync()
    {
        if (!_resizerAttached)
            return;

        _resizerAttached = false;
        try
        {
            await Js.InvokeVoidAsync("dysonToolsCol.detach", _resizerEl);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DetachResizerAsync();
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private string FormatTurnTimes()
    {
        var start = FormatLocal(Turn.StartedUtc);
        return Turn.CompletedUtc is { } end
            ? $"{start} – {FormatLocal(end)}"
            : start;
    }

    private static string FormatLocal(DateTime utc) =>
        utc.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private List<Guid> CollectSubagentPersistenceIds()
    {
        var ids = new List<Guid>();
        foreach (var tracked in Turn.TrackedToolCalls)
        {
            if (!string.Equals(tracked.Call.ToolName, "StartSubagent", StringComparison.OrdinalIgnoreCase))
                continue;
            if (tracked.Result?.Content is not { Length: > 0 } content)
                continue;
            if (TryParsePersistenceId(content, out var id) && !ids.Contains(id))
                ids.Add(id);
        }

        return ids;
    }

    private static bool TryParsePersistenceId(string content, out Guid persistenceId)
    {
        persistenceId = default;
        try
        {
            using var doc = JsonDocument.Parse(content);
            if (!doc.RootElement.TryGetProperty("persistenceId", out var prop))
                return false;

            return prop.ValueKind switch
            {
                JsonValueKind.String => Guid.TryParse(prop.GetString(), out persistenceId),
                _ => prop.TryGetGuid(out persistenceId),
            };
        }
        catch (JsonException)
        {
            return false;
        }
    }
}
