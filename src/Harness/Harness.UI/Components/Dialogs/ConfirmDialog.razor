@namespace Harness.UI.Components.Dialogs
@using Microsoft.AspNetCore.Components.Web
@using Harness.UI.Services
@inject ConfirmDialogService ConfirmDialogService
@implements IDisposable

<DysonTransition TItem="ConfirmDialogRequest" Item="ConfirmDialogService.Current" ExitMs="140" RestoreFocus="true"
                 OnEntered="FocusBackdropAsync" Context="ctx">
    <div class="confirm-dialog-backdrop dyson-fade-scale @ctx.StateClass"
         role="presentation"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => { if (!ctx.IsExiting) Cancel(); }"
         @onkeydown="args => { if (!ctx.IsExiting) OnKeyDown(args); }">
        <div class="confirm-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="confirm-dialog-title"
             @onclick:stopPropagation="true">
            <div class="confirm-dialog__header">
                <h3 id="confirm-dialog-title">@ctx.Item.Title</h3>
            </div>
            <div class="confirm-dialog__body">
                <p class="confirm-dialog__message">@ctx.Item.Message</p>
            </div>
            <div class="confirm-dialog__actions">
                <button type="button"
                        class="btn btn-ghost"
                        disabled="@_busy"
                        @onclick="() => { if (!ctx.IsExiting) Cancel(); }">
                    @ctx.Item.CancelLabel
                </button>
                <button type="button"
                        class="@(ctx.Item.Danger ? "btn btn-primary confirm-dialog__confirm--danger" : "btn btn-primary")"
                        disabled="@_busy"
                        @onclick="() => { if (!ctx.IsExiting) Confirm(); }">
                    @ctx.Item.ConfirmLabel
                </button>
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    private bool _busy;
    private ElementReference _backdropEl;

    protected override void OnInitialized() => ConfirmDialogService.Changed += OnConfirmDialogChanged;

    public void Dispose() => ConfirmDialogService.Changed -= OnConfirmDialogChanged;

    private void OnConfirmDialogChanged() => InvokeAsync(StateHasChanged);

    private async Task FocusBackdropAsync()
    {
        try { await _backdropEl.FocusAsync(); }
        catch { /* overlay may already be gone */ }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" && !_busy)
            Cancel();
    }

    private void Confirm() => Resolve(confirmed: true);

    private void Cancel() => Resolve(confirmed: false);

    private void Resolve(bool confirmed)
    {
        if (_busy)
            return;

        _busy = true;
        ConfirmDialogService.Resolve(confirmed);
        _busy = false;
    }
}
