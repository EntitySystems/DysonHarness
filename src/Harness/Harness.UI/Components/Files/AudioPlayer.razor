@namespace Harness.UI.Components.Files
@implements IAsyncDisposable
@inject IJSRuntime Js

@* Custom player over a hidden <audio> (no native controls). AudioPlayer.razor.js owns playback and
   DOM state so timeupdate never crosses the circuit; this component only mounts and tears it down. *@
<div class="audio-player" role="group" aria-label="@($"Audio player: {Title}")" @ref="_root">
    <audio preload="metadata" src="@Src"></audio>

    <button type="button"
            class="audio-player__btn audio-player__play"
            data-role="play"
            aria-label="Play"
            title="Play">
        <svg class="audio-player__icon audio-player__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" />
        </svg>
        <svg class="audio-player__icon audio-player__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="6.5" y="5" width="4" height="14" rx="1.2" />
            <rect x="13.5" y="5" width="4" height="14" rx="1.2" />
        </svg>
    </button>

    <div class="audio-player__timeline">
        <span class="audio-player__time mono" data-role="elapsed">0:00</span>
        <input type="range"
               class="audio-player__range audio-player__seek"
               data-role="seek"
               min="0"
               max="0"
               step="any"
               value="0"
               disabled
               aria-label="Seek"
               aria-valuetext="0:00" />
        <span class="audio-player__time mono" data-role="duration">--:--</span>
    </div>

    <button type="button"
            class="audio-player__btn audio-player__toggle"
            data-role="loop"
            aria-label="Loop"
            aria-pressed="false"
            title="Loop: off">
        <svg class="audio-player__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M17 2l4 4-4 4" />
            <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
            <path d="M7 22l-4-4 4-4" />
            <path d="M21 13v1a4 4 0 0 1-4 4H3" />
        </svg>
    </button>

    <div class="audio-player__volume">
        <button type="button"
                class="audio-player__btn audio-player__toggle"
                data-role="mute"
                aria-label="Mute"
                aria-pressed="false"
                title="Mute">
            <svg class="audio-player__icon audio-player__icon--sound" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path class="audio-player__fill" d="M4 9h3l5-4v14l-5-4H4z" />
                <path d="M16 9a4 4 0 0 1 0 6" />
                <path d="M18.5 6.5a7.5 7.5 0 0 1 0 11" />
            </svg>
            <svg class="audio-player__icon audio-player__icon--muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path class="audio-player__fill" d="M4 9h3l5-4v14l-5-4H4z" />
                <path d="M16 9.5l5 5" />
                <path d="M21 9.5l-5 5" />
            </svg>
        </button>
        <input type="range"
               class="audio-player__range audio-player__volume-range"
               data-role="volume"
               min="0"
               max="1"
               step="0.05"
               value="1"
               aria-label="Volume"
               aria-valuetext="100%" />
    </div>

    <div class="audio-player__error" data-role="error" role="alert" hidden></div>
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _player;
    private bool _disposed;

    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter] public string? Title { get; set; }

    // The JS module mutates this DOM (icons, aria, range values); a re-render must not reset it.
    // The parent @key's on Src, so a different file mounts a fresh player instead.
    protected override bool ShouldRender() => false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await DysonCircuitJs.InvokeAsync<IJSObjectReference>(
                Js,
                "import",
                "./" + Assets["Components/Files/AudioPlayer.razor.js"]);
            if (_module is not null && !_disposed)
                _player = await _module.InvokeAsync<IJSObjectReference>("init", _root);
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
            // Circuit gone or module failed: the player stays inert; nothing plays.
        }

        if (_disposed)
            await DisposeJsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DisposeJsAsync();
    }

    /// <summary>Pause and release the media (stop playback on close / file switch), then drop JS refs.</summary>
    private async Task DisposeJsAsync()
    {
        var player = _player;
        var module = _module;
        _player = null;
        _module = null;
        try
        {
            if (player is not null)
            {
                await DysonCircuitJs.InvokeVoidAsync(player, "dispose");
                await player.DisposeAsync();
            }

            if (module is not null)
                await module.DisposeAsync();
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
        }
    }
}
