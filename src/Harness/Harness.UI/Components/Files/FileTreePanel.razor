@namespace Harness.UI.Components.Files
@using DysonHarness
@using Harness.UI.Demo
@using Harness.UI.Files
@implements IDisposable
@inject DysonFileTreeService FileTree
@inject DysonUiHost Host
@inject IDysonSubjectContext Subject

<div class="file-tree">
    @if (ActiveWorkDirectoryId is null)
    {
        <div class="file-tree__empty">Select a work directory</div>
    }
    else if (FileTree.Active is null)
    {
        <div class="file-tree__empty">Loading…</div>
    }
    else if (FileTree.Active.Error is { } error && !FileTree.Active.SkeletonComplete)
    {
        <div class="file-tree__error">@error</div>
    }
    else
    {
        var state = FileTree.Active;
        @if (state.SkeletonRunning && !state.SkeletonComplete)
        {
            <div class="file-tree__status">Scanning folders…</div>
        }
        else if (state.Error is { } warn)
        {
            <div class="file-tree__status file-tree__status--warn">@warn</div>
        }
        else if (_status is { } status)
        {
            <div class="file-tree__status file-tree__status--warn">@status</div>
        }

        var rootChildren = state.SnapshotChildren(state.Root);
        <ul class="file-tree__list" role="tree">
            @foreach (var child in rootChildren)
            {
                <FileTreeNodeView Node="child"
                                  Depth="0"
                                  OnToggle="ToggleAsync"
                                  OnOpenFile="OpenFileAsync"
                                  OnFolderContextMenu="ShowContextMenu"
                                  RenamingRelativePath="_renamingRelativePath"
                                  RenameDraft="_renameDraft"
                                  RenameDraftChanged="OnRenameDraftChanged"
                                  OnRenameCommit="CommitRenameAsync"
                                  OnRenameCancel="CancelRename" />
            }
        </ul>

        @if (state.SkeletonComplete && rootChildren.Length == 0)
        {
            <div class="file-tree__empty">Empty folder</div>
        }
    }
</div>

@if (_contextMenuNode is not null)
{
    <div class="file-tree__context-backdrop"
         tabindex="-1"
         @onclick="CloseContextMenu"
         @onkeydown="OnContextBackdropKeyDown"></div>
    <div class="file-tree__context-menu"
         role="menu"
         aria-label="Folder actions"
         style="left:@(_contextMenuX.ToString(System.Globalization.CultureInfo.InvariantCulture))px;top:@(_contextMenuY.ToString(System.Globalization.CultureInfo.InvariantCulture))px;"
         @onclick:stopPropagation="true">
        <button type="button"
                class="file-tree__context-menu-item"
                role="menuitem"
                @onclick="BeginRenameFromMenu">
            Rename
        </button>
        <button type="button"
                class="file-tree__context-menu-item"
                role="menuitem"
                @onclick="OpenInFileManager">
            @OpenInFileManagerLabel
        </button>
        @if (IsComposerUploadsContextTarget)
        {
            <button type="button"
                    class="file-tree__context-menu-item"
                    role="menuitem"
                    @onclick="ClearComposerUploadsAsync">
                Clear composer uploads
            </button>
        }
    </div>
}

@code {
    private Guid? _boundWorkDirectoryId;
    private string? _boundWorkRootPath;
    private DysonFileTreeNode? _contextMenuNode;
    private double _contextMenuX;
    private double _contextMenuY;
    private string? _renamingRelativePath;
    private string _renameDraft = "";
    private bool _renameCommitting;
    private string? _status;

    [Parameter] public Guid? ActiveWorkDirectoryId { get; set; }
    [Parameter] public string? ActiveWorkRootPath { get; set; }

    private static string OpenInFileManagerLabel =>
        OperatingSystem.IsWindows()
            ? "Open in Explorer"
            : OperatingSystem.IsMacOS()
                ? "Open in Finder"
                : "Open in file manager";

    private bool IsComposerUploadsContextTarget =>
        _contextMenuNode is not null
        && DysonComposerUploads.IsComposerUploadsDirectory(_contextMenuNode.RelativePath);

    protected override void OnInitialized() => FileTree.Changed += OnTreeChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_boundWorkDirectoryId == ActiveWorkDirectoryId
            && ((_boundWorkRootPath is null && ActiveWorkRootPath is null)
                || DysonWorkspaceRootKey.SamePath(_boundWorkRootPath, ActiveWorkRootPath)))
        {
            return;
        }

        _boundWorkDirectoryId = ActiveWorkDirectoryId;
        _boundWorkRootPath = ActiveWorkRootPath;
        CloseContextMenu();
        CancelRename();
        _status = null;
        if (ActiveWorkDirectoryId is Guid id && !string.IsNullOrWhiteSpace(ActiveWorkRootPath))
            await FileTree.SetActiveAsync(id, ActiveWorkRootPath);
        else
            await FileTree.SetActiveAsync(ActiveWorkDirectoryId, Subject.SubjectId);
    }

    public void Dispose() => FileTree.Changed -= OnTreeChanged;

    private void OnTreeChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleAsync(DysonFileTreeNode node)
    {
        if (!node.IsDirectory || _renamingRelativePath is not null)
            return;

        if (node.IsExpanded)
        {
            FileTree.Collapse(node);
            return;
        }

        await FileTree.ExpandAsync(node);
    }

    private async Task OpenFileAsync(DysonFileTreeNode node)
    {
        if (node.IsDirectory || string.IsNullOrWhiteSpace(node.RelativePath))
            return;

        await Host.OpenFileViewerAsync(node.RelativePath, FileTree.Active?.AbsolutePath);
    }

    private void ShowContextMenu(FileTreeFolderContextMenuArgs args)
    {
        if (!args.Node.IsDirectory)
            return;

        CancelRename();
        _status = null;
        _contextMenuNode = args.Node;
        _contextMenuX = args.ClientX;
        _contextMenuY = args.ClientY;
    }

    private void CloseContextMenu() => _contextMenuNode = null;

    private void OnContextBackdropKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseContextMenu();
    }

    private void BeginRenameFromMenu()
    {
        var node = _contextMenuNode;
        CloseContextMenu();
        if (node is null || !node.IsDirectory)
            return;

        _status = null;
        _renamingRelativePath = node.RelativePath;
        _renameDraft = node.Name;
    }

    private Task OnRenameDraftChanged(string value)
    {
        _renameDraft = value;
        return Task.CompletedTask;
    }

    private void CancelRename()
    {
        _renamingRelativePath = null;
        _renameDraft = "";
        _renameCommitting = false;
    }

    private async Task CommitRenameAsync()
    {
        if (_renameCommitting)
            return;

        var sourceRel = _renamingRelativePath;
        if (sourceRel is null || FileTree.Active is null)
        {
            CancelRename();
            return;
        }

        var newName = _renameDraft.Trim();
        var currentName = Path.GetFileName(sourceRel.Replace('/', Path.DirectorySeparatorChar));
        if (string.IsNullOrEmpty(newName)
            || string.Equals(newName, currentName, StringComparison.Ordinal))
        {
            CancelRename();
            return;
        }

        if (!IsValidFolderName(newName))
        {
            _status = "Invalid folder name.";
            Host.ReportError(_status);
            CancelRename();
            return;
        }

        var parentRel = GetParentRelative(sourceRel);
        var destRel = string.IsNullOrEmpty(parentRel) ? newName : $"{parentRel}/{newName}";

        var node = FindNodeByRelativePath(sourceRel);
        if (node is { IsExpanded: true })
            FileTree.Collapse(node);

        var fileSystem = FileTree.Active.FileSystem;
        _renameCommitting = true;
        var moved = await fileSystem.MoveAsync(sourceRel, destRel);
        _renameCommitting = false;
        CancelRename();

        if (moved.IsError)
        {
            _status = moved.Error;
            Host.ReportError(moved.Error);
        }
        else
        {
            _status = null;
        }
    }

    private void OpenInFileManager()
    {
        var node = _contextMenuNode;
        CloseContextMenu();
        if (node is null || FileTree.Active is null)
            return;

        var absolute = ResolveAbsolutePath(node.RelativePath);
        if (absolute is null)
        {
            _status = "Could not resolve folder path.";
            Host.ReportError(_status);
            return;
        }

        var opened = Host.OpenFolderInFileManager(absolute);
        if (opened.IsError)
        {
            _status = opened.Error;
            Host.ReportError(opened.Error);
        }
        else
        {
            _status = null;
        }
    }

    private async Task ClearComposerUploadsAsync()
    {
        var node = _contextMenuNode;
        CloseContextMenu();
        if (node is null
            || !DysonComposerUploads.IsComposerUploadsDirectory(node.RelativePath))
            return;

        var cleared = await Host.ClearComposerUploadsAsync();
        if (cleared.IsError)
        {
            _status = cleared.Error;
            return;
        }

        // Force a shallow reload so the tree drops deleted children without waiting on the watcher.
        await FileTree.InvalidateDirectoryAsync(DysonComposerUploads.RelativeDirectory);

        _status = cleared.Value == 0
            ? "Composer uploads already empty."
            : $"Cleared {cleared.Value} composer upload(s).";
    }

    private string? ResolveAbsolutePath(string relativePath)
    {
        var state = FileTree.Active;
        if (state is null)
            return null;

        var resolved = state.FileSystem.ResolvePath(relativePath);
        if (resolved.IsSuccess)
            return resolved.Value;

        try
        {
            return Path.GetFullPath(Path.Combine(
                state.AbsolutePath,
                relativePath.Replace('/', Path.DirectorySeparatorChar)));
        }
        catch
        {
            return null;
        }
    }

    private static bool IsValidFolderName(string name) =>
        name is not ("." or "..")
        && !name.Contains('/')
        && !name.Contains('\\')
        && name.IndexOfAny(Path.GetInvalidFileNameChars()) < 0;

    private static string GetParentRelative(string relativePath)
    {
        var normalized = relativePath.Replace('\\', '/').Trim('/');
        var slash = normalized.LastIndexOf('/');
        return slash < 0 ? "" : normalized[..slash];
    }

    private DysonFileTreeNode? FindNodeByRelativePath(string relativePath)
    {
        var state = FileTree.Active;
        if (state is null)
            return null;

        return FindNode(state.Root, relativePath);
    }

    private static DysonFileTreeNode? FindNode(DysonFileTreeNode node, string relativePath)
    {
        if (string.Equals(node.RelativePath, relativePath, StringComparison.Ordinal))
            return node;

        foreach (var child in node.Children)
        {
            var found = FindNode(child, relativePath);
            if (found is not null)
                return found;
        }

        return null;
    }
}
