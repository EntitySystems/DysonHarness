@namespace Harness.UI.Components.Files
@using Harness.UI.Demo
@using Harness.UI.Markdown
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject DysonUiHost Host

@if (Host.FileViewer is { } viewer)
{
    <div class="file-viewer-modal-backdrop"
         @onclick="Close"
         @onkeydown="OnBackdropKeyDown">
        <div class="file-viewer-modal @(viewer.IsPdf ? "file-viewer-modal--pdf" : viewer.IsImage ? "file-viewer-modal--image" : null)"
             role="dialog"
             aria-modal="true"
             aria-labelledby="file-viewer-modal-title"
             @onclick:stopPropagation="true"
             @onkeydown="OnModalKeyDown">
            <div class="file-viewer-modal__header">
                <div class="file-viewer-modal__titles">
                    <h3 id="file-viewer-modal-title">@viewer.Title</h3>
                    <div class="file-viewer-modal__path mono">@viewer.RelativePath</div>
                </div>
                <div class="file-viewer-modal__actions">
                    @if (CanOpenInDefaultEditor(viewer))
                    {
                        <button type="button"
                                class="btn btn-ghost file-viewer-modal__open-editor"
                                title="Open in default editor"
                                @onclick="OpenInDefaultEditor">
                            Open in default editor
                        </button>
                    }
                    <button type="button"
                            class="btn btn-ghost file-viewer-modal__close"
                            @onclick="Close"
                            aria-label="Close">×</button>
                </div>
            </div>

            <div class="file-viewer-modal__body">
                @if (_comments.Count > 0)
                {
                    <div class="file-viewer-comments">
                        <div class="file-viewer-comments__heading">Comments (@_comments.Count)</div>
                        <ul class="file-viewer-comments__list">
                            @foreach (var comment in _comments)
                            {
                                <li class="file-viewer-comments__row">
                                    <div class="file-viewer-comments__excerpt mono">@comment.Excerpt</div>
                                    <div class="file-viewer-comments__text">@comment.Text</div>
                                    <div class="file-viewer-comments__actions">
                                        <button type="button"
                                                class="file-viewer-comments__edit"
                                                title="Edit comment"
                                                aria-label="Edit comment"
                                                @onclick="@(() => OpenEdit(comment))">✎</button>
                                        <button type="button"
                                                class="file-viewer-comments__delete"
                                                title="Delete comment"
                                                aria-label="Delete comment"
                                                @onclick="@(() => DeleteComment(comment))">×</button>
                                    </div>
                                </li>
                            }
                        </ul>
                        <button type="button"
                                class="btn btn-primary file-viewer-comments__submit"
                                disabled="@(_submitting || _comments.Count == 0)"
                                @onclick="SubmitCommentsAsync">
                            Submit comments
                        </button>
                    </div>
                }

                <div class="file-viewer-modal__content @(viewer.IsPdf ? "file-viewer-modal__content--pdf" : viewer.IsImage ? "file-viewer-modal__content--image" : null)">
                    @if (!string.IsNullOrEmpty(viewer.Error))
                    {
                        <div class="error-banner">@viewer.Error</div>
                    }
                    else if (viewer.IsPdf && !string.IsNullOrEmpty(viewer.PdfPreviewUrl))
                    {
                        <iframe class="file-viewer-modal__pdf"
                                title="@viewer.Title"
                                src="@viewer.PdfPreviewUrl"
                                type="application/pdf"></iframe>
                    }
                    else if (viewer.IsImage && !string.IsNullOrEmpty(viewer.ImagePreviewUrl))
                    {
                        <img class="file-viewer-modal__image"
                             src="@viewer.ImagePreviewUrl"
                             alt="@viewer.Title" />
                    }
                    else if (viewer.IsMarkdown)
                    {
                        @* ponytail: selection is paragraph/heading/pre blocks only (split on blank lines), not AST-precise; upgrade to Markdig block walker when comments persist. *@
                        var markdownBlocks = MarkdownBlocks(viewer.Content).ToArray();
                        var markdownLastLine = CountLogicalSourceLines(viewer.Content);
                        var markdownGutters = BuildGitDiffGutters(viewer.GitDiffAnnotations, markdownLastLine);
                        <div class="file-viewer-modal__markdown turn-block__body">
                            @for (var blockOrdinal = 0; blockOrdinal < markdownBlocks.Length; blockOrdinal++)
                            {
                                var (index, startLine, endLine, block) = markdownBlocks[blockOrdinal];
                                var selected = _selectedBlock == index;
                                var drafting = _draft is { } d && d.BlockIndex == index;
                                var deletionFrom = blockOrdinal == 0 ? 1 : markdownBlocks[blockOrdinal - 1].EndLine + 1;
                                var deletionTo = blockOrdinal == markdownBlocks.Length - 1 ? markdownLastLine : endLine;
                                var gutterClass = MarkdownGutterCssClass(markdownGutters, startLine, endLine, deletionFrom, deletionTo);
                                <div class="file-viewer-block @(selected ? "is-selected" : null) @(drafting ? "is-drafting" : null) @gutterClass"
                                     @onclick="@(() => SelectBlock(index))"
                                     @onclick:stopPropagation="true">
                                    @MarkdownRenderer.ToHtml(block)
                                    <button type="button"
                                            class="file-viewer-comment"
                                            title="Comment on this block"
                                            @onclick="@(() => OpenDraft(index, block))"
                                            @onclick:stopPropagation="true">
                                        Comment
                                    </button>
                                    @if (drafting)
                                    {
                                        @RenderCommentPopup(_draft!)
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        var codeLines = CodeLines(viewer.Content).ToArray();
                        var highlightedLines = ColorCodeHtml.TryHighlightSourceLines(viewer.RelativePath, viewer.Content);
                        if (highlightedLines?.Length != codeLines.Length)
                            highlightedLines = null;

                        var codeGutters = BuildGitDiffGutters(viewer.GitDiffAnnotations, codeLines.Length);
                        <pre class="file-viewer-modal__code mono">@foreach (var (index, sourceLine, line) in codeLines)
{
    var selected = _selectedBlock == index;
    var drafting = _draft is { } d && d.BlockIndex == index;
    var gutterClass = LineGutterCssClass(codeGutters, sourceLine);
    var highlightedLine = highlightedLines?[index];
    <code class="file-viewer-line @(selected ? "is-selected" : null) @(drafting ? "is-drafting" : null) @gutterClass"
          @onclick="@(() => SelectBlock(index))"
          @onclick:stopPropagation="true"><span class="file-viewer-line__content">@if (highlightedLine is not null)
{
    @((MarkupString)highlightedLine)
}
else
{
    @line
}</span>
<button type="button"
        class="file-viewer-comment"
        title="Comment on this line"
        @onclick="@(() => OpenDraft(index, line))"
        @onclick:stopPropagation="true">Comment</button>
@if (drafting)
{
    @RenderCommentPopup(_draft!)
}
</code>
}</pre>
                    }
                </div>
            </div>

            @if (viewer.Actions.Count > 0)
            {
                <div class="file-viewer-modal__footer">
                    @foreach (var action in viewer.Actions)
                    {
                        var showSpinner = _actionRunning && ReferenceEquals(_runningAction, action);
                        <button type="button"
                                class="btn @(action.IsPrimary ? "btn-primary" : "btn-ghost") file-viewer-modal__footer-action"
                                disabled="@_actionRunning"
                                @onclick="@(() => RunActionAsync(action))">
                            @if (showSpinner)
                            {
                                <span class="turn-block__spinner" aria-hidden="true"></span>
                            }
                            @action.Label
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private int? _selectedBlock;
    private readonly List<FileComment> _comments = [];
    private CommentDraft? _draft;
    private ElementReference _draftTextarea;
    private bool _focusDraft;
    private bool _submitting;
    private bool _actionRunning;
    private DysonFileViewerAction? _runningAction;

    private sealed class FileComment
    {
        public Guid Id { get; init; }
        public int BlockIndex { get; init; }
        public string Excerpt { get; init; } = "";
        public string Text { get; set; } = "";
    }

    private sealed class CommentDraft
    {
        public Guid? EditingId { get; init; }
        public int BlockIndex { get; init; }
        public string Excerpt { get; init; } = "";
        public string Text { get; set; } = "";
    }

    protected override void OnInitialized() => Host.Changed += OnHostChanged;

    protected override void OnParametersSet()
    {
        if (Host.FileViewer is null)
            ClearViewerState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDraft)
            return;

        _focusDraft = false;
        try
        {
            await _draftTextarea.FocusAsync();
        }
        catch
        {
            // Element may not be ready on first paint of the popup.
        }
    }

    private RenderFragment RenderCommentPopup(CommentDraft draft) => __builder =>
    {
        <div class="file-viewer-comment-popup" @onclick:stopPropagation="true">
            <textarea class="file-viewer-comment-popup__textarea"
                      @ref="_draftTextarea"
                      rows="3"
                      placeholder="Add a comment…"
                      @bind="draft.Text"
                      @bind:event="oninput"
                      @onkeydown="OnDraftKeyDown"></textarea>
            <div class="file-viewer-comment-popup__actions">
                <button type="button" class="btn btn-ghost" @onclick="CancelDraft">Cancel</button>
                <button type="button"
                        class="btn btn-primary"
                        disabled="@string.IsNullOrWhiteSpace(draft.Text)"
                        @onclick="AddOrSaveDraft">
                    @(draft.EditingId is null ? "Add" : "Save")
                </button>
            </div>
        </div>
    };

    private void OnHostChanged() => _ = InvokeAsync(StateHasChanged);

    private void ClearViewerState()
    {
        _selectedBlock = null;
        _comments.Clear();
        _draft = null;
        _focusDraft = false;
        _submitting = false;
        _actionRunning = false;
        _runningAction = null;
    }

    private void Close()
    {
        ClearViewerState();
        Host.CloseFileViewer();
    }

    private async Task RunActionAsync(DysonFileViewerAction action)
    {
        if (_actionRunning)
            return;

        _actionRunning = true;
        _runningAction = action;
        try
        {
            await action.Invoke();
        }
        finally
        {
            _actionRunning = false;
            _runningAction = null;
        }
    }

    private static bool CanOpenInDefaultEditor(DysonFileViewerState viewer) =>
        !string.IsNullOrWhiteSpace(viewer.AbsolutePath)
        && File.Exists(viewer.AbsolutePath);

    private void OpenInDefaultEditor()
    {
        if (Host.FileViewer is not { AbsolutePath: { } path } || !File.Exists(path))
            return;

        Host.OpenFileInDefaultEditor(path);
    }

    private void SelectBlock(int index)
    {
        if (_selectedBlock == index)
        {
            _selectedBlock = null;
            CancelDraft();
            return;
        }

        if (_draft is not null && _draft.BlockIndex != index)
            CancelDraft();

        _selectedBlock = index;
    }

    private void OpenDraft(int blockIndex, string blockOrLine)
    {
        _selectedBlock = blockIndex;
        _draft = new CommentDraft
        {
            BlockIndex = blockIndex,
            Excerpt = DysonFileViewerComments.FormatExcerpt(blockOrLine),
            Text = "",
        };
        _focusDraft = true;
    }

    private void OpenEdit(FileComment comment)
    {
        _selectedBlock = comment.BlockIndex;
        _draft = new CommentDraft
        {
            EditingId = comment.Id,
            BlockIndex = comment.BlockIndex,
            Excerpt = comment.Excerpt,
            Text = comment.Text,
        };
        _focusDraft = true;
    }

    private void DeleteComment(FileComment comment)
    {
        _comments.Remove(comment);
        if (_draft?.EditingId == comment.Id)
            CancelDraft();
    }

    private void CancelDraft()
    {
        _draft = null;
        _focusDraft = false;
    }

    private void AddOrSaveDraft()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.Text))
            return;

        var text = _draft.Text.Trim();
        if (_draft.EditingId is { } id)
        {
            var existing = _comments.FirstOrDefault(c => c.Id == id);
            if (existing is not null)
                existing.Text = text;
        }
        else
        {
            _comments.Add(new FileComment
            {
                Id = Guid.NewGuid(),
                BlockIndex = _draft.BlockIndex,
                Excerpt = _draft.Excerpt,
                Text = text,
            });
        }

        CancelDraft();
    }

    private async Task SubmitCommentsAsync()
    {
        if (_submitting || _comments.Count == 0 || Host.FileViewer is not { } viewer)
            return;

        _submitting = true;
        try
        {
            var prompt = DysonFileViewerComments.FormatPrompt(
                viewer.RelativePath,
                _comments.Select(c => (c.Excerpt, c.Text)));

            // PromptAsync sync-validates (and enqueues when busy) before awaiting the turn.
            // Close once issued — do not keep the modal open through generation.
            var issued = Host.PromptAsync(prompt);
            if (issued.IsCompleted)
            {
                var result = await issued;
                if (result.IsError)
                    return;
            }

            Close();
        }
        finally
        {
            _submitting = false;
        }
    }

    private void OnDraftKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CancelDraft();
    }

    private void OnBackdropKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;
        if (_draft is not null)
            CancelDraft();
        else
            Close();
    }

    private void OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;
        if (_draft is not null)
            CancelDraft();
        else
            Close();
    }

    [Flags]
    private enum GitDiffGutter
    {
        None = 0,
        Added = 1,
        Modified = 2,
        Deleted = 4,
    }

    private static IEnumerable<(int Index, int StartLine, int EndLine, string Block)> MarkdownBlocks(string content)
    {
        if (string.IsNullOrEmpty(content))
            yield break;

        var normalized = content.Replace("\r\n", "\n");
        var parts = normalized.Split("\n\n", StringSplitOptions.None);
        var index = 0;
        var pos = 0;
        for (var p = 0; p < parts.Length; p++)
        {
            var part = parts[p];
            var startLine = SourceLineAt(normalized, pos);
            var endLine = part.Length == 0
                ? startLine
                : SourceLineAt(normalized, pos + part.Length - 1);
            pos += part.Length;
            if (p < parts.Length - 1)
                pos += 2;

            if (string.IsNullOrWhiteSpace(part))
                continue;

            yield return (index++, startLine, endLine, part);
        }
    }

    private static IEnumerable<(int Index, int SourceLine, string Line)> CodeLines(string content)
    {
        var lines = content.Replace("\r\n", "\n").Split('\n');
        for (var i = 0; i < lines.Length; i++)
            yield return (i, i + 1, lines[i]);
    }

    private static int CountLogicalSourceLines(string content)
    {
        var normalized = content.Replace("\r\n", "\n");
        var count = 1;
        foreach (var ch in normalized)
        {
            if (ch == '\n')
                count++;
        }

        return count;
    }

    private static int SourceLineAt(string normalized, int position)
    {
        var line = 1;
        var limit = Math.Min(Math.Max(position, 0), normalized.Length);
        for (var i = 0; i < limit; i++)
        {
            if (normalized[i] == '\n')
                line++;
        }

        return line;
    }

    private static GitDiffGutter[]? BuildGitDiffGutters(
        IReadOnlyList<DysonGitDiffAnnotation> annotations,
        int lastLine)
    {
        if (annotations.Count == 0 || lastLine <= 0)
            return null;

        var flags = new GitDiffGutter[lastLine + 1];
        foreach (var annotation in annotations)
        {
            if (annotation.Kind == DysonGitDiffAnnotationKind.Deleted)
            {
                if (annotation.ModifiedLineCount != 0)
                    continue;

                // Zero-length working-tree range: next surviving line, clamped to EOF.
                var anchor = annotation.ModifiedStartLine;
                if (anchor < 1)
                    anchor = 1;
                if (anchor > lastLine)
                    anchor = lastLine;
                flags[anchor] |= GitDiffGutter.Deleted;
                continue;
            }

            if (annotation.ModifiedLineCount <= 0)
                continue;

            var start = annotation.ModifiedStartLine;
            var end = start + annotation.ModifiedLineCount - 1;
            if (start < 1)
                start = 1;
            if (end > lastLine)
                end = lastLine;
            if (start > end)
                continue;

            var kind = annotation.Kind == DysonGitDiffAnnotationKind.Added
                ? GitDiffGutter.Added
                : annotation.Kind == DysonGitDiffAnnotationKind.Modified
                    ? GitDiffGutter.Modified
                    : GitDiffGutter.None;
            if (kind == GitDiffGutter.None)
                continue;

            for (var line = start; line <= end; line++)
                flags[line] |= kind;
        }

        return flags;
    }

    private static string? LineGutterCssClass(GitDiffGutter[]? gutters, int sourceLine)
    {
        if (gutters is null || sourceLine < 1 || sourceLine >= gutters.Length)
            return null;
        return GutterCssClass(gutters[sourceLine]);
    }

    private static string? MarkdownGutterCssClass(
        GitDiffGutter[]? gutters,
        int startLine,
        int endLine,
        int deletionFrom,
        int deletionTo)
    {
        if (gutters is null)
            return null;

        var flags = GitDiffGutter.None;
        var addFrom = Math.Max(startLine, 1);
        var addTo = Math.Min(endLine, gutters.Length - 1);
        for (var line = addFrom; line <= addTo; line++)
            flags |= gutters[line] & (GitDiffGutter.Added | GitDiffGutter.Modified);

        var delFrom = Math.Max(deletionFrom, 1);
        var delTo = Math.Min(deletionTo, gutters.Length - 1);
        for (var line = delFrom; line <= delTo; line++)
        {
            if ((gutters[line] & GitDiffGutter.Deleted) != 0)
            {
                flags |= GitDiffGutter.Deleted;
                break;
            }
        }

        return GutterCssClass(flags);
    }

    private static string? GutterCssClass(GitDiffGutter flags)
    {
        if (flags == GitDiffGutter.None)
            return null;

        var css = (flags & GitDiffGutter.Added) != 0 ? "file-viewer-gutter--added" : null;
        if ((flags & GitDiffGutter.Modified) != 0)
            css = css is null ? "file-viewer-gutter--modified" : css + " file-viewer-gutter--modified";
        if ((flags & GitDiffGutter.Deleted) != 0)
            css = css is null ? "file-viewer-gutter--deleted" : css + " file-viewer-gutter--deleted";
        return css;
    }

    public void Dispose() => Host.Changed -= OnHostChanged;
}
