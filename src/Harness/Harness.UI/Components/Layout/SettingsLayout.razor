@inherits LayoutComponentBase
@layout MainLayout
@implements IDisposable
@using DysonHarness
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav

<div class="settings-shell">
    <aside class="settings-shell__nav">
        <div class="sidebar__brand">
            <div class="sidebar__title">Settings</div>
            <span class="badge mono">@DysonBuildInfo.Current</span>
        </div>

        <nav class="settings-shell__links">
            <NavLink class="settings-shell__link" href="/settings/general" Match="NavLinkMatch.All">General</NavLink>
            <NavLink class="settings-shell__link" href="/settings/system" Match="NavLinkMatch.All">System</NavLink>
            <NavLink class="settings-shell__link" href="/settings/analytics" Match="NavLinkMatch.All">Analytics</NavLink>
            <NavLink class="settings-shell__link" href="/settings/agent-behavior" Match="NavLinkMatch.All">Agent behavior</NavLink>
            <NavLink class="settings-shell__link" href="/settings/models" Match="NavLinkMatch.All">Models</NavLink>
            <NavLink class="settings-shell__link" href="/settings/file-storage" Match="NavLinkMatch.All">File storage</NavLink>
            <NavLink class="settings-shell__link" href="/settings/shells" Match="NavLinkMatch.All">Shells</NavLink>
            <NavLink class="settings-shell__link" href="/settings/plugins" Match="NavLinkMatch.All">Plugins</NavLink>
            <NavLink class="settings-shell__link" href="/settings/agent-modes" Match="NavLinkMatch.Prefix">Agent modes</NavLink>
        </nav>

        <div class="sidebar__footer">
            <a class="settings-shell__back" href="/">← Back to agent</a>
        </div>
    </aside>

    <main class="settings-shell__content @(_navEnter ? "settings-shell__content--enter" : null)">
        @Body
    </main>
</div>

@code {
    /// <summary>Matches --motion-base, so the class outlives the animation it triggers.</summary>
    private const int NavEnterMs = 200;

    private bool _navEnter;

    /// <summary>
    /// `/settings/*` → `/settings/*` keeps LayoutType identical, so this element and its MainLayout
    /// parent both persist and only <c>@Body</c> swaps — there is no insert for CSS to animate.
    /// Nothing in the app subscribed to <c>LocationChanged</c> before this.
    /// <para>
    /// <c>FocusOnNavigate Selector="h1"</c> in Routes.razor still lands correctly: the fade animates
    /// an element that is already in the DOM rather than delaying the content behind it.
    /// </para>
    /// </summary>
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = RunNavEnterAsync();

    /// <summary>
    /// Timed, not <c>animationend</c>-driven: reduced motion suppresses that event. It needs no
    /// reduced-motion check either — the class only carries an <c>animation</c>, which the blanket
    /// rule in <c>app.css</c> already neutralizes.
    /// ponytail: ceiling = a second navigation inside the window does not restart the animation
    /// (the class is already applied); upgrade path is alternating class names.
    /// </summary>
    private async Task RunNavEnterAsync()
    {
        try
        {
            _navEnter = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(NavEnterMs);
            _navEnter = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or TaskCanceledException)
        {
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
