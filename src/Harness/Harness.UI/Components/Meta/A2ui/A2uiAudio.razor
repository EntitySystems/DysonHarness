@namespace Harness.UI.Components.Meta.A2ui
@using System.Text.Json.Nodes
@using Harness.UI.Components.Files
@using DysonHarness
@implements IDisposable
@inject DysonUiHost Host
@inject DysonFilePreviewStore Previews

@* AudioPlayer: exactly one of path (work-directory file through the same-origin /__dyson/file-preview Range route) or url
   (remote http(s), the one network load a surface makes, and only after the user presses play: the player renders no src,
   the Files/AudioPlayer JS module sets it on the first click). Card data and the url rule are DysonA2uiAudio (Engine). *@
<figure class="a2ui-audio" @attributes="Aria">
    @if (_error is not null)
    {
        <div class="a2ui-audio__note">
            <span class="a2ui-audio__title">@TitleText()</span>
            <span class="a2ui-audio__text">@_error</span>
        </div>
    }
    else if (_card is not null && _src is not null)
    {
        <span class="a2ui-audio__title">@TitleText()</span>
        <div class="a2ui-audio__bar">
            <AudioPlayer @key="@(_src + TitleText())" Src="@_src" Compact="true" Title="@TitleText()"
                         ExternalLabel="Open in file viewer" OnOpenExternal="OpenFallback" />
        </div>
    }
    else if (_url is not null)
    {
        <span class="a2ui-audio__title">@TitleText()<span class="a2ui-audio__host">@HostHint()</span></span>
        <div class="a2ui-audio__bar">
            <AudioPlayer @key="@(_url + TitleText())" DeferredSrc="@_url" Compact="true" Title="@TitleText()"
                         PlayLabel="@($"Play (loads from {_host})")" ExternalLabel="Open link" OnOpenExternal="OpenFallback" />
        </div>
    }
    else
    {
        <span class="a2ui-audio__text">Loading audio…</span>
    }
    @if (Caption() is { Length: > 0 } caption)
    {
        <figcaption class="a2ui-audio__caption">@caption</figcaption>
    }
</figure>

@code {
    private DysonA2uiAudioCard? _card;
    private string? _error;
    private string? _path;
    private string? _url;
    private string? _host;
    private string? _previewId;
    private string? _src;
    private bool _disposed;

    [Parameter, EditorRequired] public A2uiSurfaceView View { get; set; } = default!;
    [Parameter, EditorRequired] public string? Id { get; set; }
    [Parameter, EditorRequired] public JsonObject Component { get; set; } = default!;
    [Parameter] public string Scope { get; set; } = "";
    [Parameter] public Dictionary<string, object>? Aria { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var path = A2uiProps.Str(Component["path"]);
        // A2uiMediaNode only mounts this for a path or a PlayableUrl, so the url is already vetted by the engine rule.
        var url = path is null ? DysonA2uiAudio.PlayableUrl(A2uiProps.Str(Component["url"])) : null;
        if (string.Equals(path, _path, StringComparison.Ordinal) && string.Equals(url, _url, StringComparison.Ordinal))
            return;

        _path = path;
        _url = url;
        _host = DysonA2uiLinks.Host(url);
        _card = null;
        _error = null;
        ReleasePreview();
        if (path is null)
            return;

        var loaded = await DysonA2uiAudio.LoadCardAsync(path, null, Host.FocusedSessionWorkRootPath);
        if (_disposed || !string.Equals(path, _path, StringComparison.Ordinal))
            return;

        if (loaded.IsError)
        {
            _error = loaded.Error;
            return;
        }

        // A slower earlier load may have registered an id already; free it before overwriting.
        ReleasePreview();
        _card = loaded.Value;
        _previewId = Previews.PutFile(_card.AbsolutePath, _card.ContentType);
        _src = DysonFilePreviewStore.UrlFor(_previewId);
    }

    // Title, else the file name or the host.
    private string TitleText()
    {
        var title = A2uiProps.String(View, Component["title"], Scope);
        if (!string.IsNullOrWhiteSpace(title))
            return title.Trim();
        return _card?.Title ?? (_path is null ? null : Path.GetFileName(_path)) ?? _host ?? "Audio";
    }

    // Names the remote host before the user presses play; skipped when the title already is the host.
    private string HostHint() => string.Equals(TitleText(), _host, StringComparison.Ordinal) ? "" : " · from " + _host;

    private string Caption() => A2uiProps.String(View, Component["caption"], Scope);

    // Decode / network failure fallback: the file viewer for a path, the OS browser for a url.
    private Task OpenFallback() =>
        _card is { } card ? View.OpenAsync(card.OpenFunc) : _url is null ? Task.CompletedTask : View.OpenAsync("open_url:" + _url);

    private void ReleasePreview()
    {
        Previews.Remove(_previewId);
        _previewId = null;
        _src = null;
    }

    public void Dispose()
    {
        _disposed = true;
        ReleasePreview();
    }
}
