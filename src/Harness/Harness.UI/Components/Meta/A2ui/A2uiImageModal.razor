@namespace Harness.UI.Components.Meta.A2ui
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using DysonHarness
@using Harness.UI.Components.Motion
@implements IAsyncDisposable
@inject IJSRuntime Js

@* Large Image view (app modal pattern: DysonTransition + confirm-dialog, same shell as A2uiModel3DModal). Owned by
   A2uiSurfaceView, outside the node tree, so a surface revision does not close or reload it. Slide URLs are the surface's own
   preview ids (path slides) or a consented remote URL. One slide = the old single-image view (no strip, no arrows).
   Zoom/pan: the math is DysonA2uiImageZoom (Engine); A2uiImageModal.razor.js measures and moves the image. *@
<DysonTransition Item="Item" ExitMs="140" RestoreFocus="true" OnEntered="OnEnteredAsync" Context="ctx">
    @{
        var item = ctx.Item!;
        var count = item.Slides.Count;
        var at = Math.Clamp(_index, 0, count - 1);
        var slide = item.Slides[at];
        var src = StageSrc(slide, at);
        var header = !string.IsNullOrWhiteSpace(item.Title) ? item.Title : slide.Title ?? slide.Alt;
        var pending = PendingRemote(item);
    }
    <div class="confirm-dialog-backdrop dyson-fade-scale @ctx.StateClass"
         role="presentation"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => ctx.IsExiting ? Task.CompletedTask : CloseAsync()"
         @onkeydown="args => ctx.IsExiting ? Task.CompletedTask : OnKeyDownAsync(args, item)">
        <div class="confirm-dialog a2ui-image-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             @onclick:stopPropagation="true">
            <div class="confirm-dialog__header">
                <h3 id="@_titleId">@header</h3>
                <button type="button"
                        class="btn btn-ghost"
                        @onclick="() => ctx.IsExiting ? Task.CompletedTask : CloseAsync()"
                        aria-label="Close">×</button>
            </div>
            <div class="a2ui-image-modal__frame">
                @* The stage and its img carry NO Razor style/class that holds the transform: the transform is JS-owned
                   (--a2ui-zoom/--a2ui-pan-x/--a2ui-pan-y, data-pannable, data-dragging), so a re-render mid-drag cannot reset the pan. *@
                <div class="a2ui-image-modal__stage"
                     @ref="_stage"
                     tabindex="0"
                     title="@slide.Title"
                     @ondblclick="DoubleClickAsync">
                    @if (src is not null)
                    {
                        <img class="a2ui-image-modal__img"
                             src="@src"
                             alt="@slide.Alt"
                             decoding="async"
                             referrerpolicy="@(slide.PreviewUrl is null ? "no-referrer" : null)"
                             @onerror="() => MarkFailed(at)" />
                    }
                    else
                    {
                        <div class="a2ui-image-modal__note">
                            <span>@(_failed.Contains(at) ? "Image could not be loaded" : slide.Note ?? slide.Alt)</span>
                            @if (slide.RemoteUrl is not null && !_remoteOk && !_failed.Contains(at))
                            {
                                <button type="button" class="btn" @onclick="ConsentAsync">@A2uiRemoteImages.Label(pending.Count, Hosts(pending))</button>
                            }
                        </div>
                    }
                    @if (src is not null && slide.Title is { Length: > 0 } band)
                    {
                        <div class="a2ui-image-modal__title-band" aria-hidden="@(band == slide.Alt ? "true" : null)">@band</div>
                    }
                </div>
                @if (count > 1)
                {
                    <button type="button" class="btn a2ui-image-modal__nav a2ui-image-modal__nav--prev" aria-label="Previous image" @onclick="() => StepAsync(-1, item)">‹</button>
                    <button type="button" class="btn a2ui-image-modal__nav a2ui-image-modal__nav--next" aria-label="Next image" @onclick="() => StepAsync(1, item)">›</button>
                }
            </div>
            <div class="a2ui-image-modal__toolbar" role="group" aria-label="Zoom">
                <button type="button" class="btn btn-ghost" aria-label="Zoom out" disabled="@(_zoom <= DysonA2uiImageZoom.MinPercent)" @onclick="() => ZoomStepAsync(-1)">−</button>
                <input type="range"
                       class="a2ui-image-modal__slider"
                       min="@DysonA2uiImageZoom.MinPercent"
                       max="@DysonA2uiImageZoom.MaxPercent"
                       step="@DysonA2uiImageZoom.StepPercent"
                       value="@_zoom"
                       aria-label="Zoom"
                       aria-valuetext="@DysonA2uiImageZoom.ValueText(_zoom)"
                       @oninput="OnSliderInputAsync"
                       @onkeydown="OnSliderKeyDown"
                       @onkeydown:stopPropagation="true" />
                <button type="button" class="btn btn-ghost" aria-label="Zoom in" disabled="@(_zoom >= DysonA2uiImageZoom.MaxPercent)" @onclick="() => ZoomStepAsync(1)">+</button>
                <span class="a2ui-image-modal__zoom-value mono">@DysonA2uiImageZoom.ValueText(_zoom)</span>
                <button type="button" class="btn btn-ghost" disabled="@(_zoom <= DysonA2uiImageZoom.MinPercent)" @onclick="ResetZoomAsync">Reset</button>
                @if (_zoom > DysonA2uiImageZoom.MinPercent)
                {
                    <span class="a2ui-image-modal__hint">Drag or use arrow keys to pan</span>
                }
            </div>
            @if (count > 1)
            {
                <div class="a2ui-image-modal__thumbs" @ref="_strip">
                    @for (var i = 0; i < count; i++)
                    {
                        var idx = i;
                        var thumbSlide = item.Slides[i];
                        var thumb = thumbSlide.PreviewUrl ?? (_remoteOk ? thumbSlide.RemoteUrl : null);
                        <button type="button"
                                class="a2ui-image-modal__thumb"
                                @key="idx"
                                aria-label="@($"Image {idx + 1} of {count}: {thumbSlide.Alt}")"
                                aria-current="@(idx == at ? "true" : null)"
                                @onclick="() => SelectAsync(idx)">
                            @if (thumb is not null)
                            {
                                <img src="@thumb" alt="" loading="lazy" decoding="async" referrerpolicy="@(thumbSlide.PreviewUrl is null ? "no-referrer" : null)" />
                            }
                            else
                            {
                                <span>@((idx + 1).ToString(CultureInfo.InvariantCulture))</span>
                            }
                        </button>
                    }
                </div>
            }
            <div class="a2ui-image-modal__footer">
                <span class="a2ui-image-modal__caption">@slide.Caption</span>
                @if (count > 1)
                {
                    <span class="a2ui-image-modal__count mono">@($"{at + 1} / {count}")</span>
                }
                @if (slide.OpenFunc is { } openFunc)
                {
                    <button type="button"
                            class="btn"
                            disabled="@View.OpenBusy"
                            @onclick="() => OpenInViewerAsync(openFunc)">Open in file viewer</button>
                }
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    private readonly string _titleId = "a2ui-image-" + Guid.NewGuid().ToString("N");
    private readonly HashSet<int> _failed = [];
    private ElementReference _backdropEl;
    private ElementReference _stage;
    private ElementReference _strip;
    private IJSObjectReference? _module;
    private DotNetObjectReference<A2uiImageModal>? _self;
    private A2uiImageOpen? _seen;
    private bool _attached;
    private bool _attaching;
    private bool _disposed;
    private bool _viewResetPending;
    private bool _scrollPending;
    private bool _remoteOk;
    private int _index;
    private int _zoom = DysonA2uiImageZoom.MinPercent;
    private double _natW;
    private double _natH;
    private double _viewW;
    private double _viewH;

    [Parameter, EditorRequired] public A2uiSurfaceView View { get; set; } = default!;

    /// <summary>Open gallery; null closes (DysonTransition keeps the markup for the exit window).</summary>
    [Parameter] public A2uiImageOpen? Item { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnParametersSet()
    {
        if (Item is not { } item || ReferenceEquals(item, _seen))
            return;

        _seen = item;
        _index = Math.Clamp(item.Index, 0, Math.Max(0, item.Slides.Count - 1));
        _zoom = DysonA2uiImageZoom.MinPercent;
        _remoteOk = item.RemoteConsented;
        _failed.Clear();
        _natW = _natH = 0;
        _viewResetPending = true;
        _scrollPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Item is null)
        {
            await DetachAsync();
            return;
        }

        await TryAttachAsync();
        if (!_attached || _module is null)
            return;

        if (_viewResetPending)
        {
            _viewResetPending = false;
            await DysonCircuitJs.InvokeVoidAsync(_module, "reset", _stage);
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await DysonCircuitJs.InvokeVoidAsync(_module, "scrollThumb", _strip, _index);
        }
    }

    private async Task TryAttachAsync()
    {
        if (_attached || _attaching || _disposed || Item is null || string.IsNullOrEmpty(_stage.Id))
            return;

        _attaching = true;
        try
        {
            _module ??= await DysonCircuitJs.InvokeAsync<IJSObjectReference>(
                Js, "import", "./" + Assets["Components/Meta/A2ui/A2uiImageModal.razor.js"]);
            if (_module is null || _disposed || Item is null)
                return;

            _self ??= DotNetObjectReference.Create(this);
            if (await DysonCircuitJs.InvokeVoidAsync(_module, "attach", _stage, _self, DysonA2uiImageZoom.KeyPanPx) is null)
                _attached = true;
        }
        finally
        {
            _attaching = false;
        }
    }

    private async Task DetachAsync()
    {
        if (!_attached)
            return;

        _attached = false;
        var stage = _stage;
        _stage = default;
        if (_module is not null)
            await DysonCircuitJs.InvokeVoidAsync(_module, "detach", stage);
        _self?.Dispose();
        _self = null;
    }

    /// <summary>JS callback: image natural size and stage size. Engine computes the fit and pan bounds; JS gets the result.</summary>
    [JSInvokable]
    public async Task Measured(double naturalW, double naturalH, double viewW, double viewH)
    {
        _natW = naturalW;
        _natH = naturalH;
        _viewW = viewW;
        _viewH = viewH;
        await ApplyViewAsync();
    }

    private async Task ApplyViewAsync()
    {
        if (!_attached || _module is null)
            return;

        var (fitW, fitH) = DysonA2uiImageZoom.Fit(_natW, _natH, _viewW, _viewH);
        var (maxX, maxY) = DysonA2uiImageZoom.PanBounds(fitW, fitH, _viewW, _viewH, _zoom);
        await DysonCircuitJs.InvokeVoidAsync(_module, "setView", _stage, _zoom / 100.0, maxX, maxY);
    }

    private async Task SetZoomAsync(int percent)
    {
        _zoom = DysonA2uiImageZoom.ClampPercent(percent);
        await ApplyViewAsync();
    }

    private Task ZoomStepAsync(int direction) => SetZoomAsync(DysonA2uiImageZoom.Step(_zoom, direction));

    private Task DoubleClickAsync() => SetZoomAsync(DysonA2uiImageZoom.DoubleClick(_zoom));

    private async Task ResetZoomAsync()
    {
        _zoom = DysonA2uiImageZoom.Reset().Percent;
        if (_attached && _module is not null)
            await DysonCircuitJs.InvokeVoidAsync(_module, "reset", _stage);
    }

    private Task OnSliderInputAsync(ChangeEventArgs args) =>
        int.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), NumberStyles.Integer, CultureInfo.InvariantCulture, out var percent)
            ? SetZoomAsync(percent)
            : Task.CompletedTask;

    // The slider keeps its own arrow/Home/End keys and +/-/0 do nothing there (stopPropagation); Esc still closes.
    private void OnSliderKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            _ = CloseAsync();
    }

    private async Task GoToAsync(int index)
    {
        _index = index;
        _natW = _natH = 0;
        _zoom = DysonA2uiImageZoom.MinPercent;
        _scrollPending = true;
        if (_attached && _module is not null)
            await DysonCircuitJs.InvokeVoidAsync(_module, "reset", _stage);
    }

    private Task StepAsync(int delta, A2uiImageOpen item) =>
        GoToAsync(DysonA2uiImageGallery.Step(_index, delta, item.Slides.Count, wrap: true));

    private Task SelectAsync(int index) => GoToAsync(index);

    private Task OnKeyDownAsync(KeyboardEventArgs args, A2uiImageOpen item)
    {
        if (args.CtrlKey || args.MetaKey || args.AltKey)
            return Task.CompletedTask;
        return args.Key switch
        {
            "Escape" => CloseAsync(),
            "ArrowLeft" => StepAsync(-1, item),
            "ArrowRight" => StepAsync(1, item),
            "Home" => GoToAsync(0),
            "End" => GoToAsync(Math.Max(0, item.Slides.Count - 1)),
            "+" or "=" => ZoomStepAsync(1),
            "-" or "_" => ZoomStepAsync(-1),
            "0" => ResetZoomAsync(),
            _ => Task.CompletedTask,
        };
    }

    private string? StageSrc(A2uiImageSlide slide, int at) =>
        _failed.Contains(at) ? null : slide.PreviewUrl ?? (_remoteOk ? slide.RemoteUrl : null);

    private void MarkFailed(int at) => _failed.Add(at);

    private List<A2uiImageSlide> PendingRemote(A2uiImageOpen item) =>
        _remoteOk ? [] : item.Slides.Where(s => s.RemoteUrl is not null).ToList();

    private static IReadOnlyList<string> Hosts(List<A2uiImageSlide> slides) =>
        slides.Select(s => DysonA2uiLinks.Host(s.RemoteUrl)).OfType<string>().Distinct(StringComparer.Ordinal).ToList();

    private Task ConsentAsync()
    {
        _remoteOk = true;
        return Task.CompletedTask;
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task OpenInViewerAsync(string func)
    {
        await CloseAsync();
        await View.OpenAsync(func);
    }

    private async Task OnEnteredAsync()
    {
        try { await _backdropEl.FocusAsync(); }
        catch { /* overlay may already be gone */ }
        await TryAttachAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await DetachAsync();
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
        }

        _module = null;
        _self?.Dispose();
        _self = null;
    }
}
