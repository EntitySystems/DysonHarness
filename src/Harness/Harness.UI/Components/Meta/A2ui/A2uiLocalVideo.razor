@namespace Harness.UI.Components.Meta.A2ui
@using System.Text.Json.Nodes
@using DysonHarness
@implements IAsyncDisposable
@inject DysonUiHost Host
@inject DysonFilePreviewStore Previews
@inject IJSRuntime Js

@* LocalVideo card: title, first-frame thumbnail and duration pill from the browser's own <video preload="metadata">
   (no server-side media dependency). Card data is DysonA2uiLocalVideo (Engine); a click dispatches open_file: to the
   existing file viewer. A bad file renders as card text. *@
@if (_card is { } card)
{
    <button type="button"
            class="a2ui-video"
            disabled="@View.OpenBusy"
            title="@card.RelativePath"
            @attributes="Aria"
            @onclick="() => View.OpenAsync(card.OpenFunc)">
        <span class="a2ui-video__thumb" @ref="_thumb">
            <video preload="metadata" muted playsinline tabindex="-1" aria-hidden="true" src="@_src"></video>
            <span class="a2ui-video__pill mono" data-role="duration">--:--</span>
        </span>
        <span class="a2ui-video__title">@Title(card)</span>
    </button>
}
else
{
    <div class="a2ui-video a2ui-video--error" @attributes="Aria">
        <span class="a2ui-video__title">@Title(null)</span>
        <span class="a2ui-video__note">@(_error ?? "Loading video…")</span>
    </div>
}

@code {
    private DysonA2uiLocalVideoCard? _card;
    private string? _error;
    private string? _path;
    private string? _previewId;
    private string? _src;
    private ElementReference _thumb;
    private IJSObjectReference? _module;
    private bool _wired;
    private bool _disposed;

    [Parameter, EditorRequired] public A2uiSurfaceView View { get; set; } = default!;
    [Parameter, EditorRequired] public JsonObject Component { get; set; } = default!;
    [Parameter] public string Scope { get; set; } = "";
    [Parameter] public Dictionary<string, object>? Aria { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var path = Component["path"] is JsonValue v && v.TryGetValue<string>(out var s) ? s : null;
        if (string.Equals(path, _path, StringComparison.Ordinal))
            return;

        _path = path;
        _card = null;
        _error = null;
        ReleasePreview();
        var loaded = await DysonA2uiLocalVideo.LoadCardAsync(path, null, Host.FocusedSessionWorkRootPath);
        if (_disposed || !string.Equals(path, _path, StringComparison.Ordinal))
            return;

        if (loaded.IsError)
        {
            _error = loaded.Error;
            return;
        }

        _card = loaded.Value;
        _previewId = Previews.PutFile(_card.AbsolutePath, _card.ContentType);
        // #t: seek to a frame just past 0 so the first frame paints as the thumbnail.
        _src = DysonFilePreviewStore.UrlFor(_previewId) + "#t=0.1";
        _wired = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_card is null || _wired)
            return;

        _wired = true;
        try
        {
            _module ??= await DysonCircuitJs.InvokeAsync<IJSObjectReference>(
                Js, "import", "./" + Assets["Components/Meta/A2ui/A2uiLocalVideo.razor.js"]);
            if (_module is not null && !_disposed)
                await DysonCircuitJs.InvokeVoidAsync(_module, "init", _thumb);
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
            // No duration pill; the card still opens the viewer.
        }
    }

    private string Title(DysonA2uiLocalVideoCard? card)
    {
        var title = Component.ContainsKey("title") ? DysonA2uiBinding.ResolveString(Component["title"], View.Model, Scope) : "";
        if (!string.IsNullOrWhiteSpace(title))
            return title;
        return card?.Title ?? Path.GetFileName(_path ?? "") ?? "Video";
    }

    private void ReleasePreview()
    {
        Previews.Remove(_previewId);
        _previewId = null;
        _src = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ReleasePreview();
        var module = _module;
        _module = null;
        try
        {
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
        }
    }
}
