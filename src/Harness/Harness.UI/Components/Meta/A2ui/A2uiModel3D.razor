@namespace Harness.UI.Components.Meta.A2ui
@using System.Globalization
@using System.Text.Json.Nodes
@using DysonHarness
@implements IAsyncDisposable
@inject DysonUiHost Host
@inject DysonFilePreviewStore Previews
@inject IJSRuntime Js

@* Model3D card: header (title + expand) and a Blazor-owned viewport slot. The three.js iframe is JS-owned and lives in
   MetaChatFeed's model3d layer, positioned over the slot, so surface re-renders never reload it (A2uiModel3D.razor.js).
   Card data is DysonA2uiModel3D (Engine); bytes come from the existing /__dyson/file-preview route. *@
<div class="a2ui-model3d" @attributes="Aria">
    <div class="a2ui-model3d__header">
        <span class="a2ui-model3d__title" title="@_card?.RelativePath">@Title()</span>
        @if (_card is not null)
        {
            <button type="button"
                    class="btn btn-ghost a2ui-model3d__expand"
                    aria-label="Expand 3D model"
                    title="Expand"
                    @onclick="Expand">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                    <path d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
            </button>
        }
    </div>
    <div class="a2ui-model3d__slot" style="@SlotStyle" @ref="_slot">
        <span class="a2ui-model3d__note">@(_error ?? (_overCap ? "Too many 3D viewers on screen (limit 8). Use expand." : "Loading 3D model…"))</span>
    </div>
</div>

@code {
    private DysonA2uiModel3DCard? _card;
    private string? _error;
    private string? _path;
    private string? _previewId;
    private bool _overCap;
    private bool _disposed;
    private ElementReference _slot;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired] public A2uiSurfaceView View { get; set; } = default!;
    [Parameter, EditorRequired] public string? Id { get; set; }
    [Parameter, EditorRequired] public JsonObject Component { get; set; } = default!;
    [Parameter] public string Scope { get; set; } = "";
    [Parameter] public Dictionary<string, object>? Aria { get; set; }

    private string Key => $"{View.TurnId:N}/{View.Surface.SurfaceId}/{Id}{Scope}";

    private string? PreviewUrl => _previewId is null ? null : DysonFilePreviewStore.UrlFor(_previewId);

    // Clamped int formatted invariant: no agent string reaches style.
    private string SlotStyle
    {
        get
        {
            var h = Component["height"] is JsonValue v && v.TryGetValue<double>(out var d) ? (int)Math.Clamp(d, 160, 800) : DysonA2uiModel3D.DefaultHeight;
            return string.Create(CultureInfo.InvariantCulture, $"height: {h}px");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var path = Component["path"] is JsonValue v && v.TryGetValue<string>(out var s) ? s : null;
        if (string.Equals(path, _path, StringComparison.Ordinal))
            return;

        _path = path;
        _card = null;
        _error = null;
        var loaded = await DysonA2uiModel3D.LoadCardAsync(path, null, Host.FocusedSessionWorkRootPath);
        if (_disposed || !string.Equals(path, _path, StringComparison.Ordinal))
            return;

        // The old preview id stays valid until the new one exists: the live iframe may still be fetching it.
        var old = _previewId;
        _previewId = null;
        if (loaded.IsError)
            _error = loaded.Error;
        else
        {
            _card = loaded.Value;
            _previewId = Previews.PutFile(_card.AbsolutePath, _card.ContentType);
        }

        Previews.Remove(old);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;
        if (_card is null || PreviewUrl is not { } url)
        {
            // Path changed to an error: drop the old model's host so it does not sit over the error text.
            try
            {
                if (_module is not null)
                    await DysonCircuitJs.InvokeVoidAsync(_module, "dispose", Key);
            }
            catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
            {
            }
            return;
        }

        try
        {
            _module ??= await DysonCircuitJs.InvokeAsync<IJSObjectReference>(
                Js, "import", "./" + Assets["Components/Meta/A2ui/A2uiModel3D.razor.js"]);
            if (_module is null || _disposed)
                return;
            using var timeout = new CancellationTokenSource(DysonCircuitJs.Timeout);
            var attached = await _module.InvokeAsync<bool>(
                "attach", timeout.Token, Key, _slot, url, _card.Format, _card.RelativePath,
                Assets[ThreeAsset], Assets[ViewerAsset]);
            View.UsesModel3D = true;
            if (attached == _overCap)
            {
                _overCap = !attached;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
            // No inline viewer; expand still works.
        }
    }

    internal const string ThreeAsset = "lib/three/dyson-three-0.170.0.min.js";
    internal const string ViewerAsset = "lib/three/model3d-viewer.js";

    private void Expand()
    {
        if (_card is { } card && Id is not null)
            View.OpenModel3D(Id, Title(), card);
    }

    private string Title()
    {
        var title = Component.ContainsKey("title") ? DysonA2uiBinding.ResolveString(Component["title"], View.Model, Scope) : "";
        if (!string.IsNullOrWhiteSpace(title))
            return title;
        return _card?.Title ?? Path.GetFileName(_path ?? "") ?? "3D model";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var module = _module;
        _module = null;
        // Still a Model3D under this id: only re-rendered (new instance attaches to the same host). Else unload.
        var stillThere = View.Component(Id) is { } c && A2uiProps.Str(c["component"]) == DysonA2uiModel3D.ComponentName;
        try
        {
            if (module is not null)
            {
                if (stillThere)
                    await DysonCircuitJs.InvokeVoidAsync(module, "release", Key, _slot);
                else
                    await DysonCircuitJs.InvokeVoidAsync(module, "dispose", Key);
                await module.DisposeAsync();
            }
        }
        catch (Exception ex) when (DysonCircuitJs.IsBenign(ex))
        {
        }

        // The modal (owned by the surface view) registers its own preview id.
        Previews.Remove(_previewId);
        _previewId = null;
    }
}
