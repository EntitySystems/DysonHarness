@namespace Harness.UI.Components.Meta.A2ui
@using System.Text.Json.Nodes
@using DysonHarness
@inject DysonUiHost Host

@* SubagentTasks: the row for one direct child of the Meta session; the row, its expand list and the live watch are
   A2uiSubagentRow (Engine data: DysonA2uiSubagentTasks). *@
<A2uiSubagentRow Owner="Host.Session" AgentId="AgentId" Aria="Aria" />

@code {
    [Parameter, EditorRequired] public A2uiSurfaceView View { get; set; } = default!;
    [Parameter, EditorRequired] public JsonObject Component { get; set; } = default!;
    [Parameter] public Dictionary<string, object>? Aria { get; set; }

    private int AgentId => Component["agentId"] is JsonValue v && v.TryGetValue<int>(out var n) ? n : 0;
}
