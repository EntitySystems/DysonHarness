@namespace Harness.UI.Components.Meta.A2ui
@using System.Text.Json.Nodes
@using DysonHarness
@using Harness.UI.Components.Meta

@* Renders one validated A2UI surface. Owns the local data model; all binding logic is DysonA2uiBinding (Engine). *@
<div class="a2ui-surface">
    @if (!string.IsNullOrWhiteSpace(Surface.LastError))
    {
        <div class="a2ui-error" role="alert">@Surface.LastError</div>
    }
    @if (Surface.Components.ContainsKey("root"))
    {
        <A2uiNode View="this" Id="root" Scope="" Depth="1" />
    }
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="a2ui-error" role="alert">@Error</div>
    }
</div>

@code {
    private JsonObject _model = [];
    private string? _surfaceId;
    private int _revision = -1;
    private bool _render = true;
    private DysonA2uiSurface? _lastSurface;
    private (bool Locked, bool Busy, string? Error, bool OpenBusy, DysonUserQuestion? Question, int StateVersion) _last;
    private IReadOnlyDictionary<Guid, DysonUserQuestion?>? _lastEmbedded;
    private readonly A2uiEnter _enter = new();

    [Parameter, EditorRequired] public DysonA2uiSurface Surface { get; set; } = default!;

    /// <summary>Turn that holds the surface. Ignored by the host for derived <c>dyson_question_*</c> cards.</summary>
    [Parameter] public Guid TurnId { get; set; }

    /// <summary>Answered question: inputs and Buttons disabled. ActionButtons stay enabled.</summary>
    [Parameter] public bool Locked { get; set; }

    /// <summary>An action on this surface is in flight.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Host error for the last action on this surface.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Bound question, when any: drives the question-bound Button's disabled state.</summary>
    [Parameter] public DysonUserQuestion? Question { get; set; }

    [Parameter] public EventCallback<MetaChatA2uiAction> OnAction { get; set; }

    /// <summary>ActionButton click with its built-in func key.</summary>
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    [Parameter] public bool OpenBusy { get; set; }

    /// <summary>Appended while the feed is on screen (the row's <c>--live</c> signal): components appear in sequence. Else static.</summary>
    [Parameter] public bool Live { get; set; }

    [Parameter] public IReadOnlyDictionary<Guid, DysonUserQuestion?> EmbeddedQuestions { get; set; } = MetaChatItems.NoEmbeddedQuestions;

    /// <summary>Feed busy/error map for cards embedded by QuestionSlots.</summary>
    [Parameter] public MetaChatA2uiState? State { get; set; }

    internal JsonObject Model => _model;

    /// <summary>True after a local edit since the last agent revision.</summary>
    internal bool Dirty { get; private set; }

    /// <summary>Entrance style for the node wrapper; null when this surface is not live or the node does not animate.</summary>
    internal string? EnterStyle(string? id) => Live ? _enter.Style(id) : null;

    internal JsonObject? Component(string? id) =>
        id is not null && Surface.Components.TryGetValue(id, out var component) ? component : null;

    /// <summary>
    /// Two-way binding: writes <paramref name="value"/> at the input's <c>@path</c> (relative paths under
    /// <paramref name="scope"/>). A literal value is not bound and is not written.
    /// </summary>
    internal void Write(JsonNode? binding, string scope, JsonNode? value)
    {
        if (value is null || Locked || Busy
            || binding is not JsonObject o
            || o["@path"] is not JsonValue pathValue
            || !pathValue.TryGetValue<string>(out var path))
        {
            return;
        }

        var pointer = path.StartsWith('/') ? path : $"{scope.TrimEnd('/')}/{path}";
        var written = DysonA2uiBinding.Write(_model, pointer, value);
        if (written.IsError)
            return;

        _model = written.Value;
        if (Question is { } bound && Surface.QuestionId == bound.Id)
            _model = DysonA2uiQuestionBridge.ClearSelectionForCustom(bound, Surface, _model, pointer, value);
        Dirty = true;
        _render = true;
        StateHasChanged();
    }

    internal Task ClickAsync(string componentId)
    {
        if (Locked || Busy)
            return Task.CompletedTask;
        return OnAction.InvokeAsync(new MetaChatA2uiAction(TurnId, Surface.SurfaceId, componentId, (JsonObject)_model.DeepClone()));
    }

    internal Task OpenAsync(string func) => OpenBusy ? Task.CompletedTask : OnOpen.InvokeAsync(func);

    protected override void OnParametersSet()
    {
        // An agent update (new revision) wins over local edits.
        if (!string.Equals(Surface.SurfaceId, _surfaceId, StringComparison.Ordinal) || Surface.Revision != _revision)
        {
            _model = (JsonObject)Surface.DataModel.DeepClone();
            _surfaceId = Surface.SurfaceId;
            _revision = Surface.Revision;
            Dirty = false;
            _render = true;
            if (Live)
                _enter.Schedule(Surface, Environment.TickCount64);
        }

        var current = (Locked, Busy, Error, OpenBusy, Question, State?.Version ?? 0);
        if (!ReferenceEquals(Surface, _lastSurface) || current != _last || !SameEmbedded(EmbeddedQuestions, _lastEmbedded))
            _render = true;
        _lastSurface = Surface;
        _last = current;
        _lastEmbedded = EmbeddedQuestions;
    }

    protected override bool ShouldRender() => _render;

    protected override void OnAfterRender(bool firstRender) => _render = false;

    private static bool SameEmbedded(
        IReadOnlyDictionary<Guid, DysonUserQuestion?> next,
        IReadOnlyDictionary<Guid, DysonUserQuestion?>? previous)
    {
        if (previous is null || next.Count != previous.Count)
            return false;
        foreach (var (id, question) in next)
        {
            if (!previous.TryGetValue(id, out var old) || !ReferenceEquals(old, question))
                return false;
        }

        return true;
    }
}
