@namespace Harness.UI.Components.Meta
@using DysonHarness
@using Harness.UI.Components.Chat
@using Harness.UI.Components.Meta.A2ui
@using Harness.UI.Demo
@using Harness.UI.Markdown
@inject IJSRuntime Js

<div @ref="_feedEl" class="meta-chat-feed" role="log" aria-label="Meta agent transcript" aria-live="polite">
    @if (_items.Count == 0 && !SessionBusy)
    {
        <div class="empty-state">
            <p class="empty-state__message">@EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="meta-chat-feed__list">
            @foreach (var item in _items)
            {
                <div @key="item.Key"
                     class="meta-chat__msg @(item.Role == MetaChatRole.User ? "meta-chat__msg--user" : "meta-chat__msg--agent") @(item.Pending ? "meta-chat__msg--pending" : null) @(_live.Contains(item.Key) ? "meta-chat__msg--live" : null) @(_reveal.Contains(item.Key) ? "meta-chat__msg--reveal" : null)">
                    <div class="meta-chat__msg-bar">
                        <span class="meta-chat__avatar" aria-hidden="true"></span>
                        <span class="meta-chat__msg-role">@(item.Role == MetaChatRole.User ? "You" : "Meta agent")</span>
                        @if (item.Pending)
                        {
                            <span class="subagent-card__spinner" title="Queued" aria-label="Queued"></span>
                            @if (item.QueuedId is Guid queuedId && OnRemoveQueued.HasDelegate)
                            {
                                <button type="button"
                                        class="meta-chat__unsend"
                                        title="Remove from queue"
                                        aria-label="Remove queued message"
                                        @onclick="() => OnRemoveQueued.InvokeAsync(queuedId)">
                                    ×
                                </button>
                            }
                        }
                    </div>
                    @if (item.Thumbs.Count > 0 || item.FileNames.Count > 0)
                    {
                        <div class="meta-chat__attachments">
                            @foreach (var thumb in item.Thumbs)
                            {
                                <img class="meta-chat__thumb" src="@thumb.Src" alt="@thumb.Alt" />
                            }
                            @foreach (var fileName in item.FileNames)
                            {
                                <span class="meta-chat__file">@fileName</span>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Text))
                    {
                        <div class="meta-chat__body turn-block__body"
                             @ref="_bodies[item.Key]">@MarkdownRenderer.ToHtml(item.Text)</div>
                    }
                    @{
                        var surface = item.A2uiSurface;
                        var rendered = surface is { Components.Count: > 0 };
                        var onOpen = EventCallback.Factory.Create<string>(this, func => OpenFuncAsync(item, func));
                        var openBusy = _actionBusy.Contains(item.Key);
                    }
                    @if (item.UserQuestion is { } question)
                    {
                        @* Every meta question card is A2UI. A rendered question-bound surface (forwarding) replaces
                           the derived card in the same frame; a stub or deleted surface falls back to it. *@
                        var forwarded = rendered && surface!.QuestionId == question.Id ? surface : null;
                        var cardSurfaceId = forwarded?.SurfaceId ?? DysonA2uiQuestionCard.SurfaceIdFor(question.Id);
                        <div class="meta-chat__a2ui">
                        @if (surface is { Components.Count: 0, LastError: not null })
                        {
                            <A2uiSurfaceView @key="surface.SurfaceId" Surface="surface" TurnId="item.TurnId!.Value" />
                        }
                        <A2uiQuestionCard Question="question"
                                          Forwarded="forwarded"
                                          TurnId="item.TurnId!.Value"
                                          OnAction="RaiseA2uiActionAsync"
                                          Busy="_a2ui.IsBusy(cardSurfaceId)"
                                          Error="@_a2ui.ErrorFor(cardSurfaceId)"
                                          OnOpen="onOpen"
                                          OpenBusy="openBusy"
                                          EmbeddedQuestions="item.EmbeddedQuestions"
                                          State="_a2ui" />
                        @if (rendered && forwarded is null)
                        {
                            <A2uiSurfaceView @key="surface!.SurfaceId"
                                             Surface="surface"
                                             TurnId="item.TurnId!.Value"
                                             Live="_live.Contains(item.Key)"
                                             Busy="_a2ui.IsBusy(surface.SurfaceId)"
                                             Error="@_a2ui.ErrorFor(surface.SurfaceId)"
                                             OnAction="RaiseA2uiActionAsync"
                                             OnOpen="onOpen"
                                             OpenBusy="openBusy"
                                             EmbeddedQuestions="item.EmbeddedQuestions"
                                             State="_a2ui" />
                        }
                        </div>
                    }
                    else if (surface is not null && item.TurnId is Guid surfaceTurnId)
                    {
                        <div class="meta-chat__a2ui">
                        <A2uiSurfaceView @key="surface.SurfaceId"
                                         Surface="surface"
                                         TurnId="surfaceTurnId"
                                         Live="_live.Contains(item.Key)"
                                         Busy="_a2ui.IsBusy(surface.SurfaceId)"
                                         Error="@_a2ui.ErrorFor(surface.SurfaceId)"
                                         OnAction="RaiseA2uiActionAsync"
                                         OnOpen="onOpen"
                                         OpenBusy="openBusy"
                                         EmbeddedQuestions="item.EmbeddedQuestions"
                                         State="_a2ui" />
                        </div>
                    }
                    @if (item.SecureDataRequest is { } secure)
                    {
                        <SecureDataRequestCard RequestId="secure.Id"
                                               Fields="secure.Fields"
                                               Outcome="secure.Outcome" />
                    }
                    @if (item.Actions.Count > 0 || item.VisualizationId is not null)
                    {
                        var busy = _actionBusy.Contains(item.Key);
                        <div class="meta-chat__actions">
                            @for (var i = 0; i < item.Actions.Count; i++)
                            {
                                var index = i;
                                <button type="button"
                                        class="btn"
                                        disabled="@busy"
                                        @onclick="() => InvokeActionAsync(item, index)">@item.Actions[index].Name</button>
                            }
                            @if (item.VisualizationId is Guid visualizationId)
                            {
                                <button type="button"
                                        class="btn"
                                        @onclick="() => OnOpenVisualization.InvokeAsync(visualizationId)">View visualization</button>
                            }
                        </div>
                    }
                    @if ((item.Actions.Count > 0 || rendered) && _actionResults.TryGetValue(item.Key, out var actionText))
                    {
                        <div class="meta-chat__action-result">@actionText</div>
                    }
                </div>
            }
            @if (SessionBusy)
            {
                <div class="meta-chat__working" aria-live="polite">
                    <span class="meta-chat__avatar" aria-hidden="true"></span>
                    <span class="subagent-card__spinner" aria-hidden="true"></span>
                    <span>Working…</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private ElementReference _feedEl;
    private bool _attached;
    private bool _entryScroll = true;
    private string _entryAnchor = "";
    private int _renderVersion;
    private int _lastScrolledRenderVersion = -1;
    private IReadOnlyList<MetaChatItem> _items = [];
    private readonly HashSet<string> _seen = new(StringComparer.Ordinal);
    private readonly HashSet<string> _live = new(StringComparer.Ordinal);
    private readonly HashSet<string> _reveal = new(StringComparer.Ordinal);
    private readonly Dictionary<string, ElementReference> _bodies = new(StringComparer.Ordinal);
    private readonly HashSet<string> _actionBusy = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _actionResults = new(StringComparer.Ordinal);
    private readonly MetaChatA2uiState _a2ui = new();

    [Parameter] public IReadOnlyList<DysonAgentTurn> Turns { get; set; } = [];
    [Parameter] public IReadOnlyList<QueuedPrompt> Queued { get; set; } = [];
    [Parameter] public bool SessionBusy { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "Tell the meta agent what to orchestrate.";
    [Parameter] public EventCallback<Guid> OnRemoveQueued { get; set; }
    [Parameter] public EventCallback<MetaChatActionClick> OnConversationAction { get; set; }
    [Parameter] public EventCallback<MetaChatA2uiAction> OnA2uiAction { get; set; }
    [Parameter] public EventCallback<MetaChatFuncClick> OnConversationFunc { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenVisualization { get; set; }

    /// <summary>
    /// Host error for an A2UI surface action (question cards use <c>dyson_question_{id:N}</c>). Empty clears it.
    /// The surface stays unlocked.
    /// </summary>
    public void NoteA2uiError(string surfaceId, string? error) => _a2ui.NoteError(surfaceId, error);

    /// <summary>
    /// Last click text for a bubble, keyed by item key. Ephemeral: a reload restores buttons, not this.
    /// </summary>
    public void NoteConversationActionResult(Guid turnId, Result<string, string> result)
    {
        var key = $"a:{turnId:D}";
        if (result.IsError)
            _actionResults[key] = result.Error ?? "";
        else if (!string.IsNullOrWhiteSpace(result.Value))
            _actionResults[key] = result.Value;
        else
            _actionResults.Remove(key);
    }

    private async Task RaiseA2uiActionAsync(MetaChatA2uiAction action)
    {
        if (!_a2ui.TryBegin(action.SurfaceId))
            return;

        StateHasChanged();
        try
        {
            await OnA2uiAction.InvokeAsync(action);
        }
        finally
        {
            _a2ui.End(action.SurfaceId);
        }
    }

    private async Task OpenFuncAsync(MetaChatItem item, string func)
    {
        if (item.TurnId is not Guid turnId || _actionBusy.Contains(item.Key))
            return;

        _actionBusy.Add(item.Key);
        StateHasChanged();
        try
        {
            await OnConversationFunc.InvokeAsync(new MetaChatFuncClick(turnId, func));
        }
        finally
        {
            _actionBusy.Remove(item.Key);
        }
    }

    private async Task InvokeActionAsync(MetaChatItem item, int index)
    {
        if (item.TurnId is not Guid turnId || _actionBusy.Contains(item.Key))
            return;

        _actionBusy.Add(item.Key);
        StateHasChanged();
        try
        {
            await OnConversationAction.InvokeAsync(new MetaChatActionClick(turnId, index));
        }
        finally
        {
            _actionBusy.Remove(item.Key);
        }
    }

    protected override void OnParametersSet()
    {
        var previous = _items.Select(i => i.Key);
        _items = MetaChatItems.Build(Turns, Queued);
        var keys = new string[_items.Count];
        for (var i = 0; i < _items.Count; i++)
            keys[i] = _items[i].Key;

        // Only ids appended to a conversation already on screen are live. A load, a late history
        // arrival or a session switch is a reload: reset, so existing messages stay static.
        var primed = MetaChatReveal.Continues(previous, keys);
        if (!primed)
        {
            _seen.Clear();
            _live.Clear();
            _reveal.Clear();
        }

        foreach (var key in MetaChatReveal.LiveKeys(keys, _seen, primed))
        {
            _live.Add(key);
            if (key.StartsWith("a:", StringComparison.Ordinal))
                _reveal.Add(key);
        }

        // First loaded history, or a different first item (navigate back, reload,
        // workdir/session switch): jump to the newest message. A live append keeps
        // the stick-gated scroll. Empty stays unpinned so the first load still jumps.
        var anchor = _items.Count == 0 ? "" : _items[0].Key;
        if (anchor.Length > 0 && anchor != _entryAnchor)
            _entryScroll = true;
        if (anchor.Length > 0)
            _entryAnchor = anchor;
        _renderVersion++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var attached = _attached;
        if (!_attached && await DysonCircuitJs.InvokeVoidAsync(Js, "dysonChat.attach", _feedEl) is null)
        {
            _attached = true;
            attached = true;
        }

        if (_reveal.Count > 0)
        {
            foreach (var item in _items)
            {
                if (!_reveal.Contains(item.Key) || !_bodies.TryGetValue(item.Key, out var body))
                    continue;
                var failure = await DysonCircuitJs.InvokeVoidAsync(
                    Js, "dysonMetaReveal.paint", body, item.Text);
                if (failure is JSException)
                    _reveal.Remove(item.Key);
            }
        }

        if (attached && _renderVersion != _lastScrolledRenderVersion)
        {
            _lastScrolledRenderVersion = _renderVersion;
            // instant on entry / session change: history is already in the DOM, but layout
            // (markdown, images) may still grow. Live updates stay the stick-gated jump.
            var entry = _entryScroll;
            _entryScroll = false;
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonChat.scrollToBottom", _feedEl, entry);
        }
    }

}
