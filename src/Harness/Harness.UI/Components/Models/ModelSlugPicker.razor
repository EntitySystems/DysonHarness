@namespace Harness.UI.Components.Models
@using DysonHarness
@using Microsoft.AspNetCore.Components.Web
@inject IDysonModelRepository ModelStore

<div class="model-slug-picker">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner" style="margin:0 0 8px;">@_error</div>
    }

    @if (_loader.Options.Count == 0)
    {
        <div class="empty-state" style="padding:8px 0;">
            @NoEligibleOptionsLabel
            <a href="/settings/models">Add models</a>
        </div>
    }
    else
    {
    <div class="field" style="margin-bottom:0;">
            <button id="model-slug-picker"
                    type="button"
                    class="model-slug-picker__trigger"
                    @onclick="OpenModal">
                <span class="model-slug-picker__trigger-label">@CurrentLabel</span>
                <span class="model-slug-picker__trigger-caret" aria-hidden="true">▾</span>
            </button>
        </div>
    }
</div>

<DysonTransition Item="_modalOpen" ExitMs="140" RestoreFocus="true" OnEntered="FocusSearchAsync" Context="ctx">
    <div class="model-slug-modal-backdrop dyson-fade-scale @ctx.StateClass"
         tabindex="-1"
         @ref="_backdropEl"
         @onclick="() => { if (!ctx.IsExiting) CloseModal(); }"
         @onkeydown="OnBackdropKeyDown">
        <div class="model-slug-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="model-slug-modal-title"
             @onclick:stopPropagation="true">
            <div class="model-slug-modal__header">
                <h3 id="model-slug-modal-title">Select model</h3>
                <button type="button" class="btn btn-ghost model-slug-modal__close" @onclick="() => { if (!ctx.IsExiting) CloseModal(); }" aria-label="Close">×</button>
            </div>

            <div class="model-slug-modal__search">
                <input @ref="_searchInput"
                       type="search"
                       placeholder="Search alias, provider, or slug…"
                       value="@_search"
                       @oninput="OnSearchInput"
                       autofocus />
            </div>

            <div class="model-slug-modal__list" role="listbox">
                @if (AllowEmpty)
                {
                    var emptySelected = SelectedSlugId is null;
                    <div class="model-slug-modal__row @(emptySelected ? "is-selected" : null)" role="option" aria-selected="@emptySelected">
                        <button type="button"
                                class="model-slug-modal__option"
                                @onclick="() => ctx.IsExiting ? Task.CompletedTask : ClearAsync()">
                            <span class="model-slug-modal__option-label">@EmptyLabel</span>
                        </button>
                    </div>
                }
                @if (FilteredOptions.Count == 0)
                {
                    <div class="model-slug-modal__empty">No matching models.</div>
                }
                else
                {
                    @foreach (var option in FilteredOptions)
                    {
                        var selected = SelectedSlugId == option.Id;
                        <div @key="option.Id" class="model-slug-modal__row @(selected ? "is-selected" : null)" role="option" aria-selected="@selected">
                            <button type="button"
                                    class="model-slug-modal__option"
                                    disabled="@(!option.IsEligible)"
                                    @onclick="() => ctx.IsExiting ? Task.CompletedTask : SelectAsync(option.Id)">
                                <span class="model-slug-modal__option-label">@option.Label</span>
                                @if (!option.IsEligible)
                                {
                                    <span class="model-slug-modal__badge">@IneligibleLabel</span>
                                }
                                else if (option.IsFavorite)
                                {
                                    <span class="model-slug-modal__badge">Favorite</span>
                                }
                            </button>
                            <button type="button"
                                    class="model-slug-modal__star @(option.IsFavorite ? "is-favorite" : null)"
                                    title="@(option.IsFavorite ? "Remove favorite" : "Add favorite")"
                                    aria-label="@(option.IsFavorite ? "Remove favorite" : "Add favorite")"
                                    @onclick="() => ctx.IsExiting ? Task.CompletedTask : ToggleFavoriteAsync(option)"
                                    @onclick:stopPropagation="true">
                                @(option.IsFavorite ? "★" : "☆")
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</DysonTransition>

@code {
    private readonly ModelSlugOptionsLoader _loader = null!;
    private string? _error;
    private bool _modalOpen;
    private string _search = "";
    private ElementReference _searchInput;
    private ElementReference _backdropEl;

    [Parameter] public Guid? SelectedSlugId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedSlugIdChanged { get; set; }
    /// <summary>When true, null means “no selection” and is not replaced with a default slug.</summary>
    [Parameter] public bool AllowEmpty { get; set; }
    /// <summary>Label when <see cref="AllowEmpty"/> and <see cref="SelectedSlugId"/> is null.</summary>
    [Parameter] public string EmptyLabel { get; set; } = "Use session model";
    /// <summary>Optional setting-specific eligibility filter. The current selection remains visible for recovery.</summary>
    [Parameter] public Func<DysonModelSlugEntity, DysonModelProviderEntity, bool>? IsEligible { get; set; }
    /// <summary>Shown when no selectable model satisfies <see cref="IsEligible"/>.</summary>
    [Parameter] public string NoEligibleOptionsLabel { get; set; } = "No registered slugs.";
    /// <summary>Suffix and badge for a retained selection that is no longer eligible.</summary>
    [Parameter] public string IneligibleLabel { get; set; } = "Unavailable for this setting";

    public ModelSlugPicker()
    {
        _loader = new ModelSlugOptionsLoader(
            () => ModelStore.ListProvidersAsync(),
            () => ModelStore.ListFavoriteSlugIdsAsync());
    }

    private string CurrentLabel
    {
        get
        {
            if (SelectedSlugId is not Guid id)
                return AllowEmpty ? EmptyLabel : "Select model\u2026";

            var option = _loader.Options.FirstOrDefault(o => o.Id == id);
            if (option is null)
                return "Select model\u2026";

            return option.IsEligible ? option.Label : $"{option.Label} ({IneligibleLabel})";
        }
    }

    private IReadOnlyList<SlugOption> FilteredOptions
    {
        get
        {
            IEnumerable<SlugOption> query = _loader.Options;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                query = query.Where(o =>
                    o.DisplayAlias.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.ProviderName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Slug.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Label.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(o => o.IsFavorite)
                .ThenBy(o => o.DisplayAlias, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task FocusSearchAsync()
    {
        try { await _searchInput.FocusAsync(); }
        catch { /* overlay may already be gone */ }
    }

    public async Task RefreshAsync()
    {
        _error = null;
        var result = await _loader.RefreshAsync(SelectedSlugId, IsEligible);
        if (result.IsError)
        {
            _error = result.Error;
            return;
        }

        var selectedIsListed = SelectedSlugId is Guid selected && _loader.Options.Any(o => o.Id == selected);
        if (ModelSlugPickerSelection.TryGetAutoWrite(SelectedSlugId, AllowEmpty, selectedIsListed, out var write))
            await SelectedSlugIdChanged.InvokeAsync(write);
    }

    private void OpenModal()
    {
        _search = "";
        _modalOpen = true;
    }

    /// <summary>Public entry for empty-state / external open (same as trigger click).</summary>
    public void Open()
    {
        OpenModal();
        StateHasChanged();
    }

    private void CloseModal() => _modalOpen = false;

    private void OnSearchInput(ChangeEventArgs args) =>
        _search = args.Value?.ToString() ?? "";

    private void OnBackdropKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            CloseModal();
    }

    private async Task SelectAsync(Guid id)
    {
        await SelectedSlugIdChanged.InvokeAsync(id);
        CloseModal();
    }

    private async Task ClearAsync()
    {
        await SelectedSlugIdChanged.InvokeAsync(null);
        CloseModal();
    }

    private async Task ToggleFavoriteAsync(SlugOption option)
    {
        _error = null;
        VoidResult<string> result;
        if (option.IsFavorite)
            result = await ModelStore.RemoveFavoriteAsync(option.Id);
        else
            result = await ModelStore.AddFavoriteAsync(option.Id);

        if (result.IsError)
        {
            _error = result.Error;
            return;
        }

        _loader.Replace(option.Id, current => current with { IsFavorite = !option.IsFavorite });
    }
}
