@namespace Harness.UI.Components.Models
@using DysonHarness
@using Harness.UI.Services
@implements IDisposable
@inject IDysonModelRepository ModelStore
@inject DysonCliProxyHost CliProxy
@inject ManagedInferenceProviderCatalog ManagedCatalog
@inject ConfirmDialogService ConfirmDialog

<div class="models-panel panel">
    <div class="tool-panel__title">Providers &amp; slugs</div>

    <StatusToast Status="@_status"
                 Error="@_error"
                 OnStatusCleared="ClearStatus"
                 OnErrorCleared="ClearError" />

    <div class="models-panel__toolbar">
        <input class="models-panel__search"
               @bind="_searchText"
               @bind:event="oninput"
               placeholder="Filter providers or slugs…" />
        <button type="button" class="btn btn-primary btn--sm" @onclick="OpenAddProviderModal">
            Add provider
        </button>
        <button type="button" class="btn btn-ghost btn--sm" @onclick="RepairMisTaggedProvidersAsync">
            Repair mis-tagged providers
        </button>
        <button type="button" class="btn btn-ghost btn--sm" disabled="@_busy" @onclick="ResetCliProxyAsync">
            Reset CLI proxy
        </button>
        <button type="button" class="btn btn-ghost btn--sm" disabled="@_busy" @onclick="ReinstallCliProxyAsync">
            Reinstall CLI proxy
        </button>
    </div>

    <div class="models-panel__managed" style="margin:10px 0 12px;padding:8px 0;border-bottom:1px solid var(--border, #333);">
        <div class="tool-panel__title" style="font-size:12px;">Third-party managed providers</div>
        <div class="list-item__meta" style="margin:4px 0 8px;">
            Grok Build (xAI) signs in natively (device code, no CLIProxy). ChatGPT Codex, Antigravity, Kimi, Claude Code, Meta Muse and the legacy Grok Build (CLIProxy) row use local CLIProxyAPI (OAuth). Rows are view-only; use Connect / Verify to sync models.
        </div>

        @if (!_cliProxyInstalled)
        {
            <div class="error-banner" style="margin:0 0 8px;">
                CLIProxyAPI is not installed locally (expected under <span class="mono">external/cliproxy/@DysonThirdPartyResources.CliProxyApi.Version</span>).
                Import downloads it automatically before creating a managed provider.
            </div>
        }

        @if (_downloadProgress is { } prog && _connectingSource is null && _verifyingSource is null)
        {
            <div style="margin:6px 0 10px;">
                <div class="list-item__meta mono" style="margin-bottom:4px;">
                    Downloading CLIProxyAPI…
                    @if (prog.TotalBytes is long total && total > 0)
                    {
                        <text>@FormatBytes(prog.BytesReceived) / @FormatBytes(total)</text>
                    }
                    else
                    {
                        <text>@FormatBytes(prog.BytesReceived)</text>
                    }
                </div>
                @if (prog.Fraction is double frac)
                {
                    <progress value="@frac" max="1" style="width:100%;height:8px;"></progress>
                }
                else
                {
                    <progress style="width:100%;height:8px;"></progress>
                }
            </div>
        }

        <div class="btn-row" style="margin:0 0 8px;flex-wrap:wrap;gap:6px;">
            @foreach (var managed in ManagedCatalog.All)
            {
                var source = managed.ManagedSource;
                var already = _providers.Any(p => string.Equals(p.ManagedSource, source, StringComparison.Ordinal));
                <button type="button"
                        class="btn btn--sm"
                        disabled="@(already || _busy)"
                        @onclick="() => ImportManagedAsync(managed)">
                    @(already ? $"Imported: {managed.DisplayName}" : $"Import {managed.DisplayName}")
                </button>
            }
        </div>
        <div class="list-item__meta" style="margin:8px 0 8px;">
            OpenRouter and OrcaRouter are direct API-key providers (not CLIProxy). Import stores the key; use Browse models to enable slugs.
        </div>
        <div class="btn-row" style="margin:0 0 8px;flex-wrap:wrap;gap:6px;">
            @foreach (var direct in ManagedCatalog.Direct)
            {
                var source = direct.ManagedSource;
                var already = _providers.Any(p => string.Equals(p.ManagedSource, source, StringComparison.Ordinal));
                <button type="button"
                        class="btn btn--sm"
                        disabled="@(already || _busy)"
                        @onclick="() => OpenDirectImport(direct)">
                    @(already ? $"Imported: {direct.DisplayName}" : $"Import {direct.DisplayName}")
                </button>
            }
        </div>
    </div>

    <div class="models-panel__list list" style="max-height:none;">
        @if (_providers.Count == 0)
        {
            <div class="empty-state" style="padding:8px 0;">No providers</div>
        }
        else
        {
            var filtered = FilteredProviders.ToList();
            @if (filtered.Count == 0)
            {
                <div class="empty-state" style="padding:8px 0;">No providers match "@_searchText"</div>
            }
            @foreach (var provider in filtered)
            {
                var p = provider;
                <ProviderCard Provider="p"
                              CliProxyInstalled="_cliProxyInstalled"
                              AuthPending="IsAuthPending(p)"
                              ConnectBusy="IsConnectBusy(p)"
                              VerifyBusy="IsVerifyBusy(p)"
                              PendingUserCode="PendingAuth(p)?.UserCode"
                              PendingAuthUrl="PendingAuth(p)?.AuthUrl"
                              XaiSummary="_xaiSummary"
                              DownloadProgress="CardDownloadProgress(p)"
                              ContextStepBusySlugId="_contextStepBusySlugId"
                              OnConnect="() => ConnectManagedAsync(p)"
                              OnComplete="() => CompleteManagedAsync(p)"
                              OnVerify="() => VerifyManagedAsync(p)"
                              OnDisconnect="() => DisconnectManagedAsync(p)"
                              OnCancelConnect="CancelNativeConnect"
                              OnDelete="() => ConfirmDeleteProviderAsync(p)"
                              OnBrowseModels="() => OpenDirectBrowse(p)"
                              OnUpdateApiKey="() => OpenDirectUpdateKey(p)"
                              OnEditProvider="() => OpenEditProviderModal(p)"
                              OnDeleteProvider="() => ConfirmDeleteProviderAsync(p)"
                              OnAddSlug="() => OpenAddSlugModal(p.Id)"
                              OnSetDefault="slug => SetDefaultAsync(slug.Id)"
                              OnToggleEnabled="slug => ToggleSlugEnabledAsync(slug)"
                              OnEditSlug="slug => OpenEditSlugModal(slug)"
                              OnRemoveSlug="slug => ConfirmRemoveSlugAsync(p, slug)"
                              OnSetEffort="args => SetManagedSlugEffortAsync(args.slug, string.IsNullOrWhiteSpace(args.effort) ? null : args.effort)"
                              OnModesChanged="args => SetSlugModesAsync(args.slug, args.modes)"
                              OnStepContext="args => StepManagedSlugContextAsync(args.slug, args.delta)" />
            }
        }
    </div>
</div>

<ProviderFormModal IsOpen="_providerModalOpen"
                   ProviderToEdit="_providerDraft"
                   OnClose="CloseProviderModal"
                   OnSubmit="OnProviderFormSubmitAsync" />

<SlugFormModal IsOpen="_slugModalOpen"
               SlugToEdit="_slugDraft"
               OnClose="CloseSlugModal"
               OnSubmit="OnSlugFormSubmitAsync" />

<OpenRouterApiKeyModal IsOpen="_directKeyOpen"
                       Title="@_directKeyTitle"
                       OnClose="CloseDirectKeyModal"
                       OnSubmit="OnDirectKeySubmitAsync" />

<OpenRouterModelsModal IsOpen="_directModelsOpen"
                       Provider="_directBrowseProvider"
                       Direct="_directProvider"
                       OnClose="CloseDirectModelsModal"
                       OnChanged="OnDirectModelsChangedAsync" />

@code {
    private List<DysonModelProviderEntity> _providers = [];
    private string? _error;
    private string? _status;
    private string _searchText = "";
    private bool _cliProxyInstalled;
    private bool _busy;
    private CliProxyDownloadProgress? _downloadProgress;
    private readonly Dictionary<string, ManagedConnectionBegin> _pendingAuth = new(StringComparer.Ordinal);
    private XaiGrokAccountSummary? _xaiSummary;
    private CancellationTokenSource? _pollCts;

    // Per-source busy tracking so Connect/Verify spinners don't freeze the whole panel.
    private string? _connectingSource;
    private string? _verifyingSource;
    private string? _importingSource;
    private Guid? _contextStepBusySlugId;

    // Provider modal state (null draft = add mode).
    private bool _providerModalOpen;
    private ProviderFormModal.ProviderFormDraft? _providerDraft;
    private Guid? _editingProviderId;

    // Slug modal state (null draft = add mode).
    private bool _slugModalOpen;
    private SlugFormModal.SlugFormDraft? _slugDraft;
    private Guid? _addSlugProviderId;
    private DysonModelSlugEntity? _editingSlug;

    // Direct-managed import / key / browse (OpenRouter, OrcaRouter).
    private IManagedInferenceProvider? _directProvider;
    private bool _directKeyOpen;
    private bool _directKeyIsUpdate;
    private string _directKeyTitle = "Import provider";
    private bool _directModelsOpen;
    private DysonModelProviderEntity? _directBrowseProvider;

    [Parameter] public EventCallback OnChanged { get; set; }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        _error = null;
        _cliProxyInstalled = CliProxy.IsInstalled;
        var result = await ModelStore.ListProvidersAsync();
        if (result.IsError)
        {
            _error = result.Error;
            return;
        }

        _providers = result.Value.ToList();

        _xaiSummary = null;
        if (_providers.Any(p => DysonManagedSources.IsXaiGrok(p.ManagedSource)))
        {
            var summary = await ManagedCatalog.XaiGrok.GetAccountSummaryAsync();
            if (summary.IsSuccess)
                _xaiSummary = summary.Value;
        }
    }

    public void Dispose()
    {
        // Stops the native device-code poll loop when the panel goes away.
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }

    private void ClearStatus() => _status = null;

    private void ClearError() => _error = null;

    private IEnumerable<DysonModelProviderEntity> FilteredProviders
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchText))
                return _providers;

            // NOTE: a slug-only match still shows the whole provider card
            // (ProviderCard renders all slugs); no slug-level filtering.
            return _providers.Where(p =>
                p.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || p.Slugs.Any(s =>
                    s.Slug.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                    || s.DisplayAlias.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private bool IsAuthPending(DysonModelProviderEntity provider) =>
        provider.ManagedSource is not null && _pendingAuth.ContainsKey(provider.ManagedSource);

    private ManagedConnectionBegin? PendingAuth(DysonModelProviderEntity provider) =>
        provider.ManagedSource is not null
        && _pendingAuth.TryGetValue(provider.ManagedSource, out var pending)
            ? pending
            : null;

    private bool IsConnectBusy(DysonModelProviderEntity provider) =>
        provider.ManagedSource is not null && _connectingSource == provider.ManagedSource;

    private bool IsVerifyBusy(DysonModelProviderEntity provider) =>
        provider.ManagedSource is not null && _verifyingSource == provider.ManagedSource;

    private CliProxyDownloadProgress? CardDownloadProgress(DysonModelProviderEntity provider) =>
        provider.ManagedSource is not null
        && (_connectingSource == provider.ManagedSource || _verifyingSource == provider.ManagedSource)
            ? _downloadProgress
            : null;

    private Progress<CliProxyDownloadProgress> CreateDownloadProgress() =>
        new(p =>
        {
            _downloadProgress = p;
            _ = InvokeAsync(StateHasChanged);
        });

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.##} MB";
    }

    private static IEnumerable<string> ProviderKindOptions(string current)
    {
        if (!string.IsNullOrWhiteSpace(current)
            && !DysonProviderKinds.All.Contains(current, StringComparer.Ordinal))
        {
            yield return current;
        }

        foreach (var kind in DysonProviderKinds.All)
            yield return kind;
    }

    // --- Managed provider flow ---

    private async Task ImportManagedAsync(IManagedConnectionProvider managed)
    {
        _error = null;
        _status = null;
        _busy = true;
        _importingSource = managed.ManagedSource;
        _downloadProgress = null;
        try
        {
            var progress = CreateDownloadProgress();
            var import = await managed.ImportAsync(progress);
            if (import.IsError)
            {
                _error = import.Error;
                _cliProxyInstalled = CliProxy.IsInstalled;
                return;
            }

            _status = $"Imported {managed.DisplayName}. Use Connect to sign in, then Verify / Refresh models.";
            _cliProxyInstalled = CliProxy.IsInstalled;
            await RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
            _importingSource = null;
            _downloadProgress = null;
        }
    }

    private async Task ConnectManagedAsync(DysonModelProviderEntity provider)
    {
        var managed = ManagedCatalog.FindBySource(provider.ManagedSource);
        if (managed is null)
        {
            _error = $"Unknown managed source '{provider.ManagedSource}'.";
            return;
        }

        var native = DysonManagedSources.IsXaiGrok(managed.ManagedSource);
        if (native && !await EnsureXaiConsentAsync())
            return;

        _error = null;
        _status = null;
        _connectingSource = managed.ManagedSource;
        _downloadProgress = null;
        try
        {
            // Native: the engine never opens a browser; the card renders the verification link.
            var begin = await managed.BeginConnectionAsync(openBrowser: !native, CreateDownloadProgress());
            if (begin.IsError)
            {
                _error = begin.Error;
                _cliProxyInstalled = CliProxy.IsInstalled;
                return;
            }

            _pendingAuth[managed.ManagedSource] = begin.Value;
            if (native)
            {
                // Cancel button takes over from the busy spinner while the user approves in the browser.
                _connectingSource = null;
                await PollNativeAsync(managed, begin.Value);
                return;
            }

            _status = string.IsNullOrWhiteSpace(begin.Value.UserCode)
                ? $"Browser opened for {managed.DisplayName}. Click Complete when finished signing in."
                : $"Enter device code {begin.Value.UserCode} in the browser, then Complete.";
            _cliProxyInstalled = CliProxy.IsInstalled;

            // Auto-poll a few times so Grok/Codex complete without an extra click when possible.
            for (var i = 0; i < 8; i++)
            {
                await Task.Delay(1500);
                var complete = await managed.CompleteConnectionAsync(begin.Value.State);
                if (complete.IsError)
                    break;
                if (!complete.Value.IsComplete)
                    continue;

                _pendingAuth.Remove(managed.ManagedSource);
                _status = $"{managed.DisplayName} connected. Refreshing models…";
                var verify = await managed.VerifyConnectionAsync();
                if (verify.IsError)
                {
                    _error = verify.Error;
                    break;
                }

                _status = VerifyStatus(managed, verify.Value);
                await RefreshAsync();
                await OnChanged.InvokeAsync();
                return;
            }
        }
        finally
        {
            _connectingSource = null;
            _downloadProgress = null;
        }
    }

    private async Task CompleteManagedAsync(DysonModelProviderEntity provider)
    {
        var managed = ManagedCatalog.FindBySource(provider.ManagedSource);
        if (managed is null)
        {
            _error = $"Unknown managed source '{provider.ManagedSource}'.";
            return;
        }

        if (!_pendingAuth.TryGetValue(managed.ManagedSource, out var pending))
        {
            _error = "No pending Connect session — click Connect first.";
            return;
        }

        _error = null;
        _connectingSource = managed.ManagedSource;
        try
        {
            var complete = await managed.CompleteConnectionAsync(pending.State);
            if (complete.IsError)
            {
                _error = complete.Error;
                return;
            }

            if (!complete.Value.IsComplete)
            {
                _status = $"Auth status: {complete.Value.Status}"
                    + (string.IsNullOrWhiteSpace(complete.Value.Message) ? "" : $" — {complete.Value.Message}");
                return;
            }

            _pendingAuth.Remove(managed.ManagedSource);
            _status = $"{managed.DisplayName} connected. Refreshing models…";
            var verify = await managed.VerifyConnectionAsync();
            if (verify.IsError)
            {
                _error = verify.Error;
                return;
            }

            _status = VerifyStatus(managed, verify.Value);
            await RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _connectingSource = null;
        }
    }

    private async Task VerifyManagedAsync(DysonModelProviderEntity provider)
    {
        var managed = ManagedCatalog.FindBySource(provider.ManagedSource);
        if (managed is null)
        {
            _error = $"Unknown managed source '{provider.ManagedSource}'.";
            return;
        }

        _error = null;
        _verifyingSource = managed.ManagedSource;
        _downloadProgress = null;
        try
        {
            var verify = await managed.VerifyConnectionAsync(CreateDownloadProgress());
            if (verify.IsError)
            {
                _error = verify.Error;
                _cliProxyInstalled = CliProxy.IsInstalled;
                return;
            }

            _status = VerifyStatus(managed, verify.Value);
            _cliProxyInstalled = CliProxy.IsInstalled;
            await RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _verifyingSource = null;
            _downloadProgress = null;
        }
    }

    private async Task DisconnectManagedAsync(DysonModelProviderEntity provider)
    {
        if (!string.IsNullOrWhiteSpace(provider.ManagedSource))
            _pendingAuth.Remove(provider.ManagedSource);

        if (DysonManagedSources.IsXaiGrok(provider.ManagedSource))
        {
            _pollCts?.Cancel();
            var signOut = await ManagedCatalog.XaiGrok.DisconnectAsync();
            if (signOut.IsError)
            {
                _error = signOut.Error;
                return;
            }

            _status = $"{provider.DisplayName}: signed out (stored credential deleted). Slugs are kept — Connect to sign in again.";
            await RefreshAsync();
            return;
        }

        _status = $"{provider.DisplayName}: disconnected local auth session tracking. Proxy credentials are kept — use Connect to sign in again.";
    }

    private void CancelNativeConnect() => _pollCts?.Cancel();

    private async Task<bool> EnsureXaiConsentAsync()
    {
        if (await ManagedCatalog.XaiGrok.HasConsentAsync())
            return true;

        var confirmed = await ConfirmDialog.ConfirmAsync(
            title: "Sign in to xAI (unofficial)",
            message: "Dyson will identify itself to xAI as the Grok CLI, using the public Grok CLI OAuth client id. "
                + "This is unofficial and may violate xAI's terms or be blocked. "
                + "Your sign-in tokens are stored unencrypted in Dyson's local database on this machine (like other provider API keys).",
            confirmLabel: "I understand",
            cancelLabel: "Cancel",
            danger: false);
        if (!confirmed)
            return false;

        var saved = await ManagedCatalog.XaiGrok.AcceptConsentAsync();
        if (saved.IsError)
        {
            _error = saved.Error;
            return false;
        }

        return true;
    }

    /// <summary>Async device-code poll at xAI's interval; Task.Delay only, never blocks the circuit.</summary>
    private async Task PollNativeAsync(IManagedConnectionProvider managed, ManagedConnectionBegin begin)
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        var cts = _pollCts = new CancellationTokenSource();
        var ct = cts.Token;
        var delay = TimeSpan.FromSeconds(Math.Max(1, begin.PollIntervalSeconds ?? 5));
        var completed = false;
        _status = $"Enter code {begin.UserCode} on the xAI page and approve — waiting…";
        await InvokeAsync(StateHasChanged);

        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(delay, ct);
                var complete = await managed.CompleteConnectionAsync(begin.State, ct);
                if (complete.IsError)
                {
                    _error = complete.Error;
                    return;
                }

                if (!complete.Value.IsComplete)
                {
                    if (string.Equals(complete.Value.Status, "slow_down", StringComparison.Ordinal))
                        delay += TimeSpan.FromSeconds(5);
                    continue;
                }

                completed = true;
                _pendingAuth.Remove(managed.ManagedSource);
                _status = $"{managed.DisplayName} connected. Refreshing models…";
                await InvokeAsync(StateHasChanged);
                var verify = await managed.VerifyConnectionAsync(cancellationToken: ct);
                if (verify.IsError)
                {
                    _error = verify.Error;
                    return;
                }

                _status = VerifyStatus(managed, verify.Value);
                await RefreshAsync();
                await OnChanged.InvokeAsync();
                return;
            }
        }
        catch (OperationCanceledException)
        {
            _status = "xAI sign-in cancelled.";
        }
        finally
        {
            if (!completed)
            {
                _pendingAuth.Remove(managed.ManagedSource);
                ManagedCatalog.XaiGrok.CancelConnection(begin.State);
            }

            if (ReferenceEquals(_pollCts, cts))
                _pollCts = null;
            cts.Dispose();
        }
    }

    private static string VerifyStatus(IManagedConnectionProvider managed, ManagedConnectionVerify verify) =>
        $"{managed.DisplayName}: synced {verify.SlugCount} model slug(s)"
        + (string.IsNullOrWhiteSpace(verify.Note) ? "." : $" ({verify.Note}).");

    private void OpenDirectImport(IManagedInferenceProvider direct)
    {
        _directProvider = direct;
        _directKeyIsUpdate = false;
        _directKeyTitle = $"Import {direct.DisplayName}";
        _directKeyOpen = true;
    }

    private void OpenDirectUpdateKey(DysonModelProviderEntity provider)
    {
        var direct = ManagedCatalog.FindDirectBySource(provider.ManagedSource);
        if (direct is null)
        {
            _error = $"Unknown direct managed source '{provider.ManagedSource}'.";
            return;
        }

        _directProvider = direct;
        _directKeyIsUpdate = true;
        _directKeyTitle = $"Update {direct.DisplayName} API key";
        _directKeyOpen = true;
    }

    private void CloseDirectKeyModal() => _directKeyOpen = false;

    private async Task OnDirectKeySubmitAsync(string apiKey)
    {
        if (_directProvider is null)
        {
            _error = "Direct managed provider is not available.";
            return;
        }

        _error = null;
        _status = null;
        _busy = true;
        try
        {
            if (_directKeyIsUpdate)
            {
                var update = await _directProvider.UpdateApiKeyAsync(apiKey);
                if (update.IsError)
                {
                    _error = update.Error;
                    return;
                }

                _status = $"{_directProvider.DisplayName} API key updated.";
            }
            else
            {
                var import = await _directProvider.ImportAsync(apiKey);
                if (import.IsError)
                {
                    _error = import.Error;
                    return;
                }

                _status = $"Imported {_directProvider.DisplayName}. Browse models to enable slugs.";
            }

            _directKeyOpen = false;
            await RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenDirectBrowse(DysonModelProviderEntity provider)
    {
        var direct = ManagedCatalog.FindDirectBySource(provider.ManagedSource);
        if (direct is null)
        {
            _error = $"Unknown direct managed source '{provider.ManagedSource}'.";
            return;
        }

        _directProvider = direct;
        _directBrowseProvider = provider;
        _directModelsOpen = true;
    }

    private void CloseDirectModelsModal() => _directModelsOpen = false;

    private async Task OnDirectModelsChangedAsync()
    {
        await RefreshAsync();
        if (_directBrowseProvider is { } current)
            _directBrowseProvider = _providers.FirstOrDefault(p => p.Id == current.Id) ?? current;
        await OnChanged.InvokeAsync();
    }

    // --- Provider add/edit/delete (modal-driven) ---

    private void OpenAddProviderModal()
    {
        _editingProviderId = null;
        _providerDraft = null;
        _providerModalOpen = true;
    }

    private void OpenEditProviderModal(DysonModelProviderEntity provider)
    {
        _editingProviderId = provider.Id;
        _providerDraft = new ProviderFormModal.ProviderFormDraft
        {
            DisplayName = provider.DisplayName,
            ProviderKind = provider.ProviderKind,
            BaseUrl = provider.BaseUrl,
            ApiKey = provider.ApiKey,
            OpenAiApiMode = provider.OpenAiApiMode,
        };
        _providerModalOpen = true;
    }

    private void CloseProviderModal() => _providerModalOpen = false;

    private async Task OnProviderFormSubmitAsync(ProviderFormModal.ProviderFormResult result)
    {
        if (_editingProviderId is Guid editId)
            await SaveEditProviderAsync(editId, result);
        else
            await CreateProviderAsync(result);

        if (_error is null)
            _providerModalOpen = false;
    }

    private async Task CreateProviderAsync(ProviderFormModal.ProviderFormResult result)
    {
        _error = null;
        _status = null;
        if (string.IsNullOrWhiteSpace(result.DisplayName))
        {
            _error = "Display name is required.";
            return;
        }

        var baseUrl = string.IsNullOrWhiteSpace(result.BaseUrl) ? null : result.BaseUrl.Trim();
        var apiKey = string.IsNullOrWhiteSpace(result.ApiKey) ? null : result.ApiKey;
        var rawKind = string.IsNullOrWhiteSpace(result.ProviderKind) ? DysonProviderKinds.Demo : result.ProviderKind.Trim();
        var kind = DysonProviderKinds.EffectiveKind(rawKind, baseUrl, apiKey);
        if (!string.Equals(rawKind, kind, StringComparison.Ordinal))
            _status = "Provider kind set to OpenAICompatible (credentials require a real provider).";

        var slug = result.InitialSlug.Trim();
        var alias = string.IsNullOrWhiteSpace(result.InitialAlias) ? result.DisplayName.Trim() : result.InitialAlias.Trim();
        var makeDefault = !_providers.Any(p => p.Slugs.Any(s => s.IsDefault));

        var create = await ModelStore.CreateProviderAsync(new DysonModelProviderEntity
        {
            DisplayName = result.DisplayName.Trim(),
            ProviderKind = kind,
            BaseUrl = baseUrl,
            ApiKey = apiKey,
            OpenAiApiMode = DysonOpenAiApiModes.Normalize(result.OpenAiApiMode),
        });

        if (create.IsError)
        {
            _error = create.Error;
            return;
        }

        var addSlug = await ModelStore.AddSlugAsync(
            create.Value,
            slug,
            alias,
            makeDefault,
            string.IsNullOrWhiteSpace(result.InitialEffort) ? null : result.InitialEffort.Trim(),
            result.InitialModes);
        if (addSlug.IsError)
        {
            _error = addSlug.Error;
            return;
        }

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task SaveEditProviderAsync(Guid id, ProviderFormModal.ProviderFormResult result)
    {
        _error = null;
        _status = null;
        if (string.IsNullOrWhiteSpace(result.DisplayName))
        {
            _error = "Display name is required.";
            return;
        }

        var baseUrl = string.IsNullOrWhiteSpace(result.BaseUrl) ? null : result.BaseUrl.Trim();
        var apiKey = string.IsNullOrWhiteSpace(result.ApiKey) ? null : result.ApiKey;
        var rawKind = string.IsNullOrWhiteSpace(result.ProviderKind) ? DysonProviderKinds.Demo : result.ProviderKind.Trim();
        var kind = DysonProviderKinds.EffectiveKind(rawKind, baseUrl, apiKey);
        if (!string.Equals(rawKind, kind, StringComparison.Ordinal))
            _status = "Provider kind set to OpenAICompatible (credentials require a real provider).";

        var update = await ModelStore.UpdateProviderAsync(new DysonModelProviderEntity
        {
            Id = id,
            DisplayName = result.DisplayName.Trim(),
            ProviderKind = kind,
            BaseUrl = baseUrl,
            ApiKey = apiKey,
            OpenAiApiMode = DysonOpenAiApiModes.Normalize(result.OpenAiApiMode),
        });

        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _editingProviderId = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task ConfirmDeleteProviderAsync(DysonModelProviderEntity provider)
    {
        var nativeXai = DysonManagedSources.IsXaiGrok(provider.ManagedSource);
        var confirmed = await ConfirmDialog.ConfirmAsync(
            title: "Delete provider",
            message: $"Delete provider '{provider.DisplayName}' and all its slugs? This cannot be undone.",
            confirmLabel: "Delete",
            cancelLabel: "Cancel",
            danger: true);
        if (!confirmed)
            return;

        _busy = true;
        try
        {
            // Native xAI: also drop the stored sign-in so no orphaned token row is left behind.
            if (nativeXai)
            {
                _pollCts?.Cancel();
                await ManagedCatalog.XaiGrok.DisconnectAsync();
            }

            await DeleteProviderAsync(provider.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteProviderAsync(Guid id)
    {
        var del = await ModelStore.DeleteProviderAsync(id);
        if (del.IsError)
        {
            _error = del.Error;
            return;
        }

        if (_editingProviderId == id)
            _editingProviderId = null;
        if (_addSlugProviderId == id)
            _addSlugProviderId = null;

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    // --- Slug add/edit/remove (modal-driven) ---

    private void OpenAddSlugModal(Guid providerId)
    {
        _addSlugProviderId = providerId;
        _editingSlug = null;
        _slugDraft = null;
        _slugModalOpen = true;
    }

    private void OpenEditSlugModal(DysonModelSlugEntity slug)
    {
        _addSlugProviderId = null;
        _editingSlug = slug;
        _slugDraft = new SlugFormModal.SlugFormDraft
        {
            Slug = slug.Slug,
            DisplayAlias = slug.DisplayAlias,
            DefaultReasoningEffort = slug.DefaultReasoningEffort,
            IsDefault = slug.IsDefault,
            Modes = [..slug.ReasoningModes],
        };
        _slugModalOpen = true;
    }

    private void CloseSlugModal() => _slugModalOpen = false;

    private async Task OnSlugFormSubmitAsync(SlugFormModal.SlugFormResult result)
    {
        if (_editingSlug is not null)
            await SaveSlugAsync(result);
        else if (_addSlugProviderId is Guid providerId)
            await AddSlugAsync(providerId, result);

        if (_error is null)
            _slugModalOpen = false;
    }

    private async Task SaveSlugAsync(SlugFormModal.SlugFormResult result)
    {
        _error = null;
        if (_editingSlug is not { } slug)
            return;

        var update = await ModelStore.UpdateSlugAsync(new DysonModelSlugEntity
        {
            Id = slug.Id,
            ProviderId = slug.ProviderId,
            Slug = result.Slug,
            DisplayAlias = result.DisplayAlias,
            IsDefault = result.IsDefault,
            DefaultReasoningEffort = result.DefaultReasoningEffort,
            ReasoningModes = [..result.Modes],
        });

        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _editingSlug = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task AddSlugAsync(Guid providerId, SlugFormModal.SlugFormResult result)
    {
        _error = null;

        var add = await ModelStore.AddSlugAsync(
            providerId,
            result.Slug,
            result.DisplayAlias,
            result.IsDefault,
            result.DefaultReasoningEffort,
            result.Modes);

        if (add.IsError)
        {
            _error = add.Error;
            return;
        }

        _addSlugProviderId = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task ConfirmRemoveSlugAsync(DysonModelProviderEntity provider, DysonModelSlugEntity slug)
    {
        var confirmed = await ConfirmDialog.ConfirmAsync(
            "Remove slug",
            $"Remove slug '{slug.Slug}' from '{provider.DisplayName}'? This cannot be undone.",
            "Remove",
            "Cancel",
            true);
        if (!confirmed)
            return;

        await RemoveSlugAsync(slug.Id);
    }

    private async Task RemoveSlugAsync(Guid slugId)
    {
        var del = await ModelStore.RemoveSlugAsync(slugId);
        if (del.IsError)
        {
            _error = del.Error;
            return;
        }

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

