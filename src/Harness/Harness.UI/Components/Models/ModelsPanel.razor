        {
            _error = "Slug and display alias are required.";
            return;
        }

        var update = await ModelStore.UpdateSlugAsync(new DysonModelSlugEntity
        {
            Id = slug.Id,
            ProviderId = slug.ProviderId,
            Slug = _editSlugValue.Trim(),
            DisplayAlias = _editSlugAlias.Trim(),
            IsDefault = _editSlugIsDefault,
            DefaultReasoningEffort = string.IsNullOrWhiteSpace(_editSlugEffort)
                ? null
                : _editSlugEffort.Trim(),
            ReasoningModes = [.._editSlugReasoningModes],
        });

        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _editingSlugId = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

