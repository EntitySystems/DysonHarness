    private async Task ToggleSlugEnabledAsync(DysonModelSlugEntity slug)
    {
        _error = null;
        _status = null;
        var set = await ModelStore.SetSlugEnabledAsync(slug.Id, !slug.IsEnabled);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _status = slug.IsEnabled ? "Disabled." : "Enabled.";
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task SetManagedSlugEffortAsync(DysonModelSlugEntity slug, string? effort)
    {
        _error = null;
        _status = null;
        var set = await ModelStore.SetSlugDefaultReasoningEffortAsync(slug.Id, effort);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _status = "Default effort updated.";
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task SetSlugModesAsync(DysonModelSlugEntity slug, List<string> modes)
    {
        // Custom providers only: replace modes, normalize effort if it fell out of the set.
        var provider = _providers.FirstOrDefault(p => p.Id == slug.ProviderId);
        if (provider?.ManagedSource is not null)
            return;

        _error = null;
        _status = null;
        slug.ReasoningModes = modes.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (!string.IsNullOrWhiteSpace(slug.DefaultReasoningEffort)
            && slug.ReasoningModes.Count > 0
            && !slug.ReasoningModes.Contains(slug.DefaultReasoningEffort, StringComparer.OrdinalIgnoreCase))
        {
            slug.DefaultReasoningEffort = null; // effort no longer offered → clear
        }

        var update = await ModelStore.UpdateSlugAsync(slug, CancellationToken.None);
        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task StepManagedSlugContextAsync(DysonModelSlugEntity slug, int delta)
    {
        _contextStepBusySlugId = slug.Id;
        try
        {
            var current = slug.DefaultMaxTargetContextTokens ?? DysonMaxTargetContextTokens.HarnessDefault;
            var next = Math.Clamp(current + delta, 0, DysonMaxTargetContextTokens.Ceiling);
            await SetManagedSlugContextAsync(slug, next);
        }
        finally
        {
            _contextStepBusySlugId = null;
        }
    }

    private async Task SetManagedSlugContextAsync(DysonModelSlugEntity slug, int? maxTarget)
    {
        _error = null;
        _status = null;
        var set = await ModelStore.SetSlugDefaultMaxTargetContextTokensAsync(slug.Id, maxTarget);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _status = maxTarget is null
            ? "Default context cleared (harness 100K)."
            : "Default context updated.";
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task ResetCliProxyAsync()
    {
        var confirmed = await ConfirmDialog.ConfirmAsync(
            title: "Reset CLI proxy",
            message: "Restart the local CLIProxyAPI process and rewrite its config? In-flight requests will fail; signed-in OAuth sessions are kept.",
            confirmLabel: "Reset",
            cancelLabel: "Cancel",
            danger: false);
        if (!confirmed)
            return;

        _error = null;
        _status = null;
        _busy = true;
        try
        {
            var reset = await CliProxy.RestartAsync(CreateDownloadProgress());
            if (reset.IsError)
            {
                _error = reset.Error;
                return;
            }

            _status = "CLI proxy restarted with fresh config. Use Connect / Verify to re-sync managed providers.";
            _cliProxyInstalled = CliProxy.IsInstalled;
            await RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
            _downloadProgress = null;
        }
    }

    private async Task RepairMisTaggedProvidersAsync()
    {
        _error = null;
        _status = null;

        var repair = await ModelStore.RepairMisTaggedProvidersAsync();
        if (repair.IsError)
        {
            _error = repair.Error;
            return;
        }

        _status = repair.Value == 0
            ? "No mis-tagged providers found."
            : $"Repaired {repair.Value} provider{(repair.Value == 1 ? "" : "s")} (demo → OpenAICompatible).";

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
