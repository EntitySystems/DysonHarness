@namespace Harness.UI.Components.Models
@using DysonHarness
@inject DysonModelStore ModelStore

<div class="models-panel panel">
    <div class="tool-panel__title">Providers &amp; slugs</div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner" style="margin:0;">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="list-item__meta" style="margin:4px 0 0;">@_status</div>
    }

    <div class="btn-row" style="margin:8px 0;">
        <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="RepairMisTaggedProvidersAsync">
            Repair mis-tagged providers
        </button>
    </div>

    <div class="models-panel__body">
        <div class="models-panel__list list">
            @if (_providers.Count == 0)
            {
                <div class="empty-state" style="padding:8px 0;">No providers</div>
            }
            else
            {
                @foreach (var provider in _providers)
                {
                    <div class="list-item" style="cursor:default;">
                        @if (_editingProviderId == provider.Id)
                        {
                            <div class="field">
                                <label>Display name</label>
                                <input @bind="_editDisplayName" />
                            </div>
                            <div class="field">
                                <label>Provider kind</label>
                                <select @bind="_editProviderKind">
                                    @foreach (var kind in ProviderKindOptions(_editProviderKind))
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Base URL</label>
                                <input @bind="_editBaseUrl" />
                            </div>
                            <div class="field">
                                <label>API key</label>
                                <input @bind="_editApiKey" type="password" autocomplete="off" />
                            </div>
                            @if (string.Equals(_editProviderKind, DysonProviderKinds.OpenAICompatible, StringComparison.Ordinal))
                            {
                                <div class="field">
                                    <label>API mode</label>
                                    <select @bind="_editOpenAiApiMode">
                                        @foreach (var mode in DysonOpenAiApiModes.All)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="btn-row" style="margin-top:4px;">
                                <button type="button" class="btn btn-primary" style="padding:3px 7px;font-size:11px;" @onclick="() => SaveProviderAsync(provider.Id)">Save</button>
                                <button type="button" class="btn btn-ghost" style="padding:3px 7px;font-size:11px;" @onclick="CancelEditProvider">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <span class="list-item__title">@provider.DisplayName</span>
                            <span class="list-item__meta mono">
                                @provider.ProviderKind
                                @if (string.Equals(provider.ProviderKind, DysonProviderKinds.OpenAICompatible, StringComparison.Ordinal))
                                {
                                    <text> · @DysonOpenAiApiModes.Normalize(provider.OpenAiApiMode)</text>
                                }
                                @if (!string.IsNullOrEmpty(provider.BaseUrl))
                                {
                                    <text> · @provider.BaseUrl</text>
                                }
                                @(string.IsNullOrEmpty(provider.ApiKey) ? "" : " · key set")
                            </span>
                            <div class="btn-row" style="margin-top:4px;">
                                <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="() => BeginEditProvider(provider)">Edit</button>
                                <button type="button" class="btn btn-ghost" style="padding:3px 7px;font-size:11px;" @onclick="() => DeleteProviderAsync(provider.Id)">Delete</button>
                            </div>
                        }

                        <div class="models-panel__slugs">
                            @if (provider.Slugs.Count == 0)
                            {
                                <div class="list-item__meta" style="padding:4px 0;">No slugs</div>
                            }
                            else
                            {
                                @foreach (var slug in provider.Slugs)
                                {
                                    @if (_editingSlugId == slug.Id)
                                    {
                                        <div class="models-panel__slug" style="margin-top:4px;">
                                            <div class="field">
                                                <label>Display alias</label>
                                                <input @bind="_editSlugAlias" />
                                            </div>
                                            <div class="field">
                                                <label>Slug</label>
                                                <input @bind="_editSlugValue" />
                                            </div>
                                            <div class="field">
                                                <label>Default reasoning effort</label>
                                                <input @bind="_editSlugEffort" placeholder="blank = omit" />
                                            </div>
                                            <div class="field">
                                                <label>Reasoning modes</label>
                                                <div class="models-panel__modes">
                                                    @foreach (var mode in _editSlugReasoningModes)
                                                    {
                                                        var m = mode;
                                                        <span class="models-panel__mode-chip">
                                                            <span class="mono">@m</span>
                                                            <button type="button" class="btn btn-ghost" style="padding:0 4px;font-size:10px;" @onclick="() => RemoveEditSlugMode(m)" title="Remove">×</button>
                                                        </span>
                                                    }
                                                </div>
                                                <div class="btn-row" style="margin-top:4px;align-items:center;">
                                                    <input @bind="_editSlugModeDraft" @bind:event="oninput" placeholder="e.g. high" style="flex:1;min-width:0;"
                                                           @onkeydown="OnEditSlugModeKeyDown" />
                                                    <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="AddEditSlugMode">Add</button>
                                                </div>
                                            </div>
                                            <label class="checkbox-row">
                                                <input type="checkbox" @bind="_editSlugIsDefault" />
                                                Set as default
                                            </label>
                                            <div class="btn-row" style="margin-top:2px;">
                                                <button type="button" class="btn btn-primary" style="padding:2px 6px;font-size:10px;" @onclick="() => SaveSlugAsync(slug)">Save</button>
                                                <button type="button" class="btn btn-ghost" style="padding:2px 6px;font-size:10px;" @onclick="CancelEditSlug">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="models-panel__slug @(slug.IsDefault ? "is-active" : null)">
                                            <span class="list-item__title">@slug.DisplayAlias</span>
                                            <span class="list-item__meta mono">
                                                @slug.Slug
                                                @(slug.IsDefault ? " · default" : "")
                                                @if (!string.IsNullOrWhiteSpace(slug.DefaultReasoningEffort))
                                                {
                                                    <text> · effort @slug.DefaultReasoningEffort</text>
                                                }
                                            </span>
                                            <div class="btn-row" style="margin-top:2px;">
                                                <button type="button" class="btn" style="padding:2px 6px;font-size:10px;" @onclick="() => BeginEditSlug(slug)">Edit</button>
                                                @if (!slug.IsDefault)
                                                {
                                                    <button type="button" class="btn" style="padding:2px 6px;font-size:10px;" @onclick="() => SetDefaultAsync(slug.Id)">Default</button>
                                                }
                                                <button type="button" class="btn btn-ghost" style="padding:2px 6px;font-size:10px;" @onclick="() => RemoveSlugAsync(slug.Id)">Remove</button>
                                            </div>
                                        </div>
                                    }
                                }
                            }

                            @if (_addSlugProviderId == provider.Id)
                            {
                                <div style="margin-top:6px;">
                                    <div class="field">
                                        <label>Display alias</label>
                                        <input @bind="_slugAlias" />
                                    </div>
                                    <div class="field">
                                        <label>Slug</label>
                                        <input @bind="_slugValue" placeholder="gpt-4o" />
                                    </div>
                                    <div class="field">
                                        <label>Default reasoning effort</label>
                                        <input @bind="_slugEffort" placeholder="blank = omit" />
                                    </div>
                                    <div class="field">
                                        <label>Reasoning modes</label>
                                        <div class="models-panel__modes">
                                            @foreach (var mode in _addSlugReasoningModes)
                                            {
                                                var m = mode;
                                                <span class="models-panel__mode-chip">
                                                    <span class="mono">@m</span>
                                                    <button type="button" class="btn btn-ghost" style="padding:0 4px;font-size:10px;" @onclick="() => RemoveAddSlugMode(m)" title="Remove">×</button>
                                                </span>
                                            }
                                        </div>
                                        <div class="btn-row" style="margin-top:4px;align-items:center;">
                                            <input @bind="_addSlugModeDraft" @bind:event="oninput" placeholder="e.g. high" style="flex:1;min-width:0;"
                                                   @onkeydown="OnAddSlugModeKeyDown" />
                                            <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="AddAddSlugMode">Add</button>
                                        </div>
                                    </div>
                                    <label class="checkbox-row">
                                        <input type="checkbox" @bind="_slugIsDefault" />
                                        Set as default
                                    </label>
                                    <div class="btn-row">
                                        <button type="button" class="btn btn-primary" style="padding:3px 7px;font-size:11px;" @onclick="() => AddSlugAsync(provider.Id)">Add</button>
                                        <button type="button" class="btn btn-ghost" style="padding:3px 7px;font-size:11px;" @onclick="CancelAddSlug">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn" style="margin-top:6px;padding:3px 7px;font-size:11px;" @onclick="() => BeginAddSlug(provider.Id)">Add slug</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <details class="models-panel__add" open="@_providerFormOpen">
            <summary @onclick:preventDefault="false">Add provider</summary>
            <div class="models-panel__add-form">
                <div class="field">
                    <label>Display name</label>
                    <input @bind="_displayName" />
                </div>
                <div class="field">
                    <label>Provider kind</label>
                    <select @bind="_providerKind">
                        @foreach (var kind in DysonProviderKinds.All)
                        {
                            <option value="@kind">@kind</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Base URL (optional)</label>
                    <input @bind="_baseUrl" />
                </div>
                <div class="field">
                    <label>API key (optional, plaintext local)</label>
                    <input @bind="_apiKey" type="password" autocomplete="off" />
                </div>
                @if (string.Equals(_providerKind, DysonProviderKinds.OpenAICompatible, StringComparison.Ordinal))
                {
                    <div class="field">
                        <label>API mode</label>
                        <select @bind="_openAiApiMode">
                            @foreach (var mode in DysonOpenAiApiModes.All)
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                    </div>
                }
                <div class="field">
                    <label>Initial slug</label>
                    <input @bind="_initialSlug" placeholder="demo-mock" />
                </div>
                <div class="field">
                    <label>Initial display alias</label>
                    <input @bind="_initialAlias" placeholder="Demo Mock" />
                </div>
                <div class="field">
                    <label>Default reasoning effort (optional)</label>
                    <input @bind="_initialEffort" placeholder="blank = omit" />
                </div>
                <div class="field">
                    <label>Reasoning modes</label>
                    <div class="models-panel__modes">
                        @foreach (var mode in _initialReasoningModes)
                        {
                            var m = mode;
                            <span class="models-panel__mode-chip">
                                <span class="mono">@m</span>
                                <button type="button" class="btn btn-ghost" style="padding:0 4px;font-size:10px;" @onclick="() => RemoveInitialMode(m)" title="Remove">×</button>
                            </span>
                        }
                    </div>
                    <div class="btn-row" style="margin-top:4px;align-items:center;">
                        <input @bind="_initialModeDraft" @bind:event="oninput" placeholder="e.g. high" style="flex:1;min-width:0;"
                               @onkeydown="OnInitialModeKeyDown" />
                        <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="AddInitialMode">Add</button>
                    </div>
                </div>
                <label class="checkbox-row">
                    <input type="checkbox" @bind="_initialIsDefault" />
                    Set slug as default
                </label>
                <button type="button" class="btn btn-primary" @onclick="CreateProviderAsync">Create</button>
            </div>
        </details>
    </div>
</div>

@code {
    private List<DysonModelProviderEntity> _providers = [];
    private string? _error;
    private string? _status;
    private bool _providerFormOpen = true;

    private string _displayName = "";
    private string _providerKind = DysonProviderKinds.OpenAICompatible;
    private string? _baseUrl;
    private string? _apiKey;
    private string _openAiApiMode = DysonOpenAiApiModes.Completions;
    private string _initialSlug = "";
    private string _initialAlias = "";
    private string _initialEffort = "high";
    private bool _initialIsDefault;
    private List<string> _initialReasoningModes = [];
    private string _initialModeDraft = "";

    private Guid? _editingProviderId;
    private string _editDisplayName = "";
    private string _editProviderKind = DysonProviderKinds.Demo;
    private string? _editBaseUrl;
    private string? _editApiKey;
    private string _editOpenAiApiMode = DysonOpenAiApiModes.Completions;

    private Guid? _addSlugProviderId;
    private string _slugAlias = "";
    private string _slugValue = "";
    private string _slugEffort = "high";
    private bool _slugIsDefault;
    private List<string> _addSlugReasoningModes = [];
    private string _addSlugModeDraft = "";

    private Guid? _editingSlugId;
    private string _editSlugAlias = "";
    private string _editSlugValue = "";
    private string _editSlugEffort = "";
    private bool _editSlugIsDefault;
    private List<string> _editSlugReasoningModes = [];
    private string _editSlugModeDraft = "";

    [Parameter] public EventCallback OnChanged { get; set; }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        _error = null;
        var result = await ModelStore.ListProvidersAsync();
        if (result.IsError)
        {
            _error = result.Error;
            return;
        }

        _providers = result.Value.ToList();
    }

    private async Task CreateProviderAsync()
    {
        _error = null;
        _status = null;
        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _error = "Display name is required.";
            return;
        }

        var baseUrl = string.IsNullOrWhiteSpace(_baseUrl) ? null : _baseUrl.Trim();
        var apiKey = string.IsNullOrWhiteSpace(_apiKey) ? null : _apiKey;
        var rawKind = string.IsNullOrWhiteSpace(_providerKind) ? DysonProviderKinds.Demo : _providerKind.Trim();
        var kind = DysonProviderKinds.EffectiveKind(rawKind, baseUrl, apiKey);
        if (!string.Equals(rawKind, kind, StringComparison.Ordinal))
            _status = "Provider kind set to OpenAICompatible (credentials require a real provider).";

        var slug = string.IsNullOrWhiteSpace(_initialSlug) ? "demo-mock" : _initialSlug.Trim();
        var alias = string.IsNullOrWhiteSpace(_initialAlias) ? _displayName.Trim() : _initialAlias.Trim();
        var makeDefault = _initialIsDefault || !_providers.Any(p => p.Slugs.Any(s => s.IsDefault));

        var create = await ModelStore.CreateProviderAsync(new DysonModelProviderEntity
        {
            DisplayName = _displayName.Trim(),
            ProviderKind = kind,
            BaseUrl = baseUrl,
            ApiKey = apiKey,
            OpenAiApiMode = DysonOpenAiApiModes.Normalize(_openAiApiMode),
        });

        if (create.IsError)
        {
            _error = create.Error;
            return;
        }

        var addSlug = await ModelStore.AddSlugAsync(
            create.Value,
            slug,
            alias,
            makeDefault,
            string.IsNullOrWhiteSpace(_initialEffort) ? null : _initialEffort.Trim(),
            _initialReasoningModes);
        if (addSlug.IsError)
        {
            _error = addSlug.Error;
            return;
        }

        _displayName = "";
        _providerKind = DysonProviderKinds.OpenAICompatible;
        _baseUrl = null;
        _apiKey = null;
        _openAiApiMode = DysonOpenAiApiModes.Completions;
        _initialReasoningModes = [];
        _initialModeDraft = "";
        _initialSlug = "";
        _initialAlias = "";
        _initialEffort = "high";
        _initialIsDefault = false;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private void BeginEditProvider(DysonModelProviderEntity provider)
    {
        _editingProviderId = provider.Id;
        _editDisplayName = provider.DisplayName;
        _editProviderKind = string.IsNullOrWhiteSpace(provider.ProviderKind)
            ? DysonProviderKinds.Demo
            : provider.ProviderKind;
        _editBaseUrl = provider.BaseUrl;
        _editApiKey = provider.ApiKey;
        _editOpenAiApiMode = DysonOpenAiApiModes.Normalize(provider.OpenAiApiMode);
    }

    private void CancelEditProvider()
    {
        _editingProviderId = null;
    }

    private void AddInitialMode()
    {
        if (!TryAddMode(_initialReasoningModes, _initialModeDraft))
            return;
        _initialModeDraft = "";
    }

    private void RemoveInitialMode(string mode) => _initialReasoningModes.Remove(mode);

    private void OnInitialModeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddInitialMode();
    }

    private void AddAddSlugMode()
    {
        if (!TryAddMode(_addSlugReasoningModes, _addSlugModeDraft))
            return;
        _addSlugModeDraft = "";
    }

    private void RemoveAddSlugMode(string mode) => _addSlugReasoningModes.Remove(mode);

    private void OnAddSlugModeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddAddSlugMode();
    }

    private void AddEditSlugMode()
    {
        if (!TryAddMode(_editSlugReasoningModes, _editSlugModeDraft))
            return;
        _editSlugModeDraft = "";
    }

    private void RemoveEditSlugMode(string mode) => _editSlugReasoningModes.Remove(mode);

    private void OnEditSlugModeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddEditSlugMode();
    }

    private static bool TryAddMode(List<string> modes, string? draft)
    {
        if (string.IsNullOrWhiteSpace(draft))
            return false;

        var trimmed = draft.Trim();
        if (modes.Contains(trimmed, StringComparer.Ordinal))
            return false;

        modes.Add(trimmed);
        return true;
    }

    private static IEnumerable<string> ProviderKindOptions(string current)
    {
        if (!string.IsNullOrWhiteSpace(current)
            && !DysonProviderKinds.All.Contains(current, StringComparer.Ordinal))
        {
            yield return current;
        }

        foreach (var kind in DysonProviderKinds.All)
            yield return kind;
    }

    private async Task SaveProviderAsync(Guid id)
    {
        _error = null;
        _status = null;
        if (string.IsNullOrWhiteSpace(_editDisplayName))
        {
            _error = "Display name is required.";
            return;
        }

        var baseUrl = string.IsNullOrWhiteSpace(_editBaseUrl) ? null : _editBaseUrl.Trim();
        var apiKey = string.IsNullOrWhiteSpace(_editApiKey) ? null : _editApiKey;
        var rawKind = string.IsNullOrWhiteSpace(_editProviderKind) ? DysonProviderKinds.Demo : _editProviderKind.Trim();
        var kind = DysonProviderKinds.EffectiveKind(rawKind, baseUrl, apiKey);
        if (!string.Equals(rawKind, kind, StringComparison.Ordinal))
            _status = "Provider kind set to OpenAICompatible (credentials require a real provider).";

        var update = await ModelStore.UpdateProviderAsync(new DysonModelProviderEntity
        {
            Id = id,
            DisplayName = _editDisplayName.Trim(),
            ProviderKind = kind,
            BaseUrl = baseUrl,
            ApiKey = apiKey,
            OpenAiApiMode = DysonOpenAiApiModes.Normalize(_editOpenAiApiMode),
        });

        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _editingProviderId = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteProviderAsync(Guid id)
    {
        var del = await ModelStore.DeleteProviderAsync(id);
        if (del.IsError)
        {
            _error = del.Error;
            return;
        }

        if (_editingProviderId == id)
            _editingProviderId = null;
        if (_addSlugProviderId == id)
            _addSlugProviderId = null;

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private void BeginAddSlug(Guid providerId)
    {
        _addSlugProviderId = providerId;
        _editingSlugId = null;
        _slugAlias = "";
        _slugValue = "";
        _slugEffort = "high";
        _slugIsDefault = false;
        _addSlugReasoningModes = [];
        _addSlugModeDraft = "";
    }

    private void CancelAddSlug()
    {
        _addSlugProviderId = null;
        _addSlugModeDraft = "";
    }

    private void BeginEditSlug(DysonModelSlugEntity slug)
    {
        _addSlugProviderId = null;
        _editingSlugId = slug.Id;
        _editSlugAlias = slug.DisplayAlias;
        _editSlugValue = slug.Slug;
        _editSlugEffort = slug.DefaultReasoningEffort ?? "";
        _editSlugIsDefault = slug.IsDefault;
        _editSlugReasoningModes = [..slug.ReasoningModes];
        _editSlugModeDraft = "";
    }

    private void CancelEditSlug()
    {
        _editingSlugId = null;
        _editSlugModeDraft = "";
    }

    private async Task SaveSlugAsync(DysonModelSlugEntity slug)
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_editSlugValue) || string.IsNullOrWhiteSpace(_editSlugAlias))
        {
            _error = "Slug and display alias are required.";
            return;
        }

        var update = await ModelStore.UpdateSlugAsync(new DysonModelSlugEntity
        {
            Id = slug.Id,
            ProviderId = slug.ProviderId,
            Slug = _editSlugValue.Trim(),
            DisplayAlias = _editSlugAlias.Trim(),
            IsDefault = _editSlugIsDefault,
            DefaultReasoningEffort = string.IsNullOrWhiteSpace(_editSlugEffort)
                ? null
                : _editSlugEffort.Trim(),
            ReasoningModes = [.._editSlugReasoningModes],
        });

        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _editingSlugId = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task AddSlugAsync(Guid providerId)
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_slugValue) || string.IsNullOrWhiteSpace(_slugAlias))
        {
            _error = "Slug and display alias are required.";
            return;
        }

        var add = await ModelStore.AddSlugAsync(
            providerId,
            _slugValue.Trim(),
            _slugAlias.Trim(),
            _slugIsDefault,
            string.IsNullOrWhiteSpace(_slugEffort) ? null : _slugEffort.Trim(),
            _addSlugReasoningModes);

        if (add.IsError)
        {
            _error = add.Error;
            return;
        }

        _addSlugProviderId = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task SetDefaultAsync(Guid slugId)
    {
        var set = await ModelStore.SetDefaultSlugAsync(slugId);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task RepairMisTaggedProvidersAsync()
    {
        _error = null;
        _status = null;

        var repair = await ModelStore.RepairMisTaggedProvidersAsync();
        if (repair.IsError)
        {
            _error = repair.Error;
            return;
        }

        _status = repair.Value == 0
            ? "No mis-tagged providers found."
            : $"Repaired {repair.Value} provider{(repair.Value == 1 ? "" : "s")} (demo → OpenAICompatible).";

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveSlugAsync(Guid slugId)
    {
        var del = await ModelStore.RemoveSlugAsync(slugId);
        if (del.IsError)
        {
            _error = del.Error;
            return;
        }

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}
