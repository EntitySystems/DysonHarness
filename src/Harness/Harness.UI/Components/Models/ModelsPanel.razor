    private async Task RepairMisTaggedProvidersAsync()
    {
        _error = null;
        _status = null;

        var repair = await ModelStore.RepairMisTaggedProvidersAsync();
        if (repair.IsError)
        {
            _error = repair.Error;
            return;
        }

        _status = repair.Value == 0
            ? "No mis-tagged providers found."
            : $"Repaired {repair.Value} provider{(repair.Value == 1 ? "" : "s")} (demo → OpenAICompatible).";

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }

