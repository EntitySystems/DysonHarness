@page "/"
@using DysonHarness
@using Harness.UI.Components.Chat
@using Harness.UI.Components.Files
@using Harness.UI.Demo
@implements IAsyncDisposable
@inject DysonUiHost Host
@inject IDysonWorkDirectoryRepository WorkDirs
@inject ThemeService Theme
@inject IJSRuntime Js

<AppShell>
    <Sidebar>
        <Sidebar>
            <WorkDirectory>
                <WorkDirectorySwitcher @ref="_workdirSwitcher"
                                       ActiveWorkDirectoryId="_activeWorkDirectoryId"
                                       ActiveWorkDirectoryIdChanged="OnWorkDirectoryChangedAsync"
                                       Busy="Host.IsBusy"
                                       OnChanged="OnWorkDirectoryListChangedAsync" />
            </WorkDirectory>
            <SessionList>
                <SessionList Sessions="_sessions"
                             ActiveSessionId="Host.ActiveSessionId"
                             Busy="Host.IsBusy"
                             CanCreate="_activeWorkDirectoryId is not null"
                             Error="@_listError"
                             OnNew="StartNewAsync"
                             OnResume="ResumeAsync"
                             OnDelete="DeleteAsync"
                             OnRefresh="RefreshSessionsAsync" />
            </SessionList>
        </Sidebar>
    </Sidebar>
    <Main>
        <SessionHeader Session="Host.Session"
                       Title="@_activeTitle"
                       GitBranch="@_gitBranch"
                       ShowBackToParent="Host.ActiveParentSessionId is not null"
                       OnBackToParent="NavigateToParentAsync" />
        <SessionTodoOverview Session="Host.Session" />
        <SessionSubagentOverview Session="Host.Session" />
        @if (!string.IsNullOrEmpty(Host.LastError))
        {
            <ErrorToast @key="Host.LastError" Message="@Host.LastError" />
        }
        <ChatPanel Turns="@(Host.Session?.Turns ?? Array.Empty<DysonAgentTurn>())"
                   Disabled="@(Host.Session is null)"
                   SessionBusy="Host.IsBusy"
                   CanCreateSession="_activeWorkDirectoryId is not null"
                   OnCancelPrompt="CancelPrompt"
                   SelectedSlugId="_selectedSlugId"
                   SelectedSlugIdChanged="OnSelectedSlugIdChangedAsync"
                   ReasoningEffort="@_reasoningEffort"
                   ReasoningEffortChanged="OnReasoningEffortChangedAsync"
                   SelectedAgentMode="@_selectedAgentMode"
                   SelectedAgentModeChanged="OnAgentModeChanged"
                   GitBranch="@_gitBranch"
                   OnSubmit="PromptAsync"
                   OnNewSession="StartNewAsync" />
    </Main>
    <Rail>
        <RailSidePanel ActiveWorkDirectoryId="_activeWorkDirectoryId" />
        <div class="tool-panel" style="border-top:1px solid var(--border);">
            <div class="tool-panel__title">Session log</div>
            <div class="list" style="max-height:240px;">
                @if (Host.Session is null)
                {
                    <div class="empty-state" style="padding:8px 0;">—</div>
                }
                else
                {
                    @foreach (var line in Host.Session.SnapshotLog(40).Reverse())
                    {
                        <div class="list-item__meta mono" style="padding:2px 0;">@line</div>
                    }
                }
            </div>
        </div>
    </Rail>
</AppShell>

<FileViewerOverlay />
<SkillViewerOverlay />

@code {
    private IReadOnlyList<DysonSessionSummary> _sessions = [];
    private string? _listError;
    private string? _activeTitle;
    private Guid? _selectedSlugId;
    private string? _reasoningEffort;
    private string _selectedAgentMode = DysonAgentModes.Work;
    private Guid? _activeWorkDirectoryId;
    private string? _gitBranch;
    private bool _workdirHydrated;
    private WorkDirectorySwitcher? _workdirSwitcher;
    private DotNetObjectReference<DysonUiHost>? _chatLinksRef;

    protected override async Task OnInitializedAsync()
    {
        Host.Changed += OnHostChanged;
        Theme.Changed += OnThemeChanged;

        await Host.EnsureDefaultModelAsync();
        await RefreshSessionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            await InstallChatExternalLinksAsync();
        }

        if (!_workdirHydrated)
        {
            _workdirHydrated = true;
            await HydrateWorkDirectoryAsync();
        }
    }

    private async Task InstallChatExternalLinksAsync()
    {
        _chatLinksRef ??= DotNetObjectReference.Create(Host);
        try
        {
            await Js.InvokeVoidAsync("dysonChatLinks.install", _chatLinksRef);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task HydrateWorkDirectoryAsync()
    {
        try
        {
            var stored = await Js.InvokeAsync<string?>("dysonWorkdir.get");
            if (!string.IsNullOrWhiteSpace(stored) && Guid.TryParse(stored, out var id))
            {
                var get = await WorkDirs.GetAsync(id);
                if (get.IsSuccess)
                {
                    _activeWorkDirectoryId = id;
                    Host.SetComposerWorkDirectoryId(id);
                    await WorkDirs.TouchOpenedAsync(id);
                    await RefreshGitBranchAsync(get.Value.AbsolutePath);
                    await RefreshSessionsAsync();
                    StateHasChanged();
                    return;
                }
            }
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        var list = await WorkDirs.ListAsync();
        if (list.IsSuccess && list.Value.Count > 0)
        {
            var first = list.Value[0];
            await SetActiveWorkDirectoryAsync(first.Id, first.AbsolutePath);
        }
        else
        {
            await RefreshGitBranchAsync(null);
            await RefreshSessionsAsync();
        }

        StateHasChanged();
    }

    private void OnHostChanged() => _ = InvokeAsync(async () =>
    {
        SyncSelectedSlugFromSession();
        SyncReasoningEffortFromHost();
        SyncSelectedAgentModeFromSession();
        UpdateActiveTitle();
        try
        {
            StateHasChanged();
            await RefreshSessionsQuietAsync();
        }
        finally
        {
            StateHasChanged();
        }
    });

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnSelectedSlugIdChangedAsync(Guid? id)
    {
        var result = await Host.SetSessionModelSlugAsync(id);
        if (result.IsError)
        {
            SyncSelectedSlugFromSession();
            SyncReasoningEffortFromHost();
            return;
        }

        SyncSelectedSlugFromSession();
        if (Host.Session is null)
            _selectedSlugId = id;
        SyncReasoningEffortFromHost();
    }

    private async Task OnReasoningEffortChangedAsync(string? effort)
    {
        _reasoningEffort = effort;
        await Host.SetSessionReasoningEffortAsync(effort);
        SyncReasoningEffortFromHost();
    }

    private void SyncSelectedSlugFromSession()
    {
        if (Host.Session?.Provider is OpenAiCompatibleAgentProvider oai)
            _selectedSlugId = oai.SlugId;
        else if (Host.Session?.Provider is DemoDysonAgentProvider demo)
            _selectedSlugId = demo.SlugId;
    }

    private void SyncReasoningEffortFromHost()
    {
        _reasoningEffort = Host.SessionReasoningEffort;
    }

    private void SyncSelectedAgentModeFromSession()
    {
        if (Host.Session is { } session)
            _selectedAgentMode = session.Mode;
    }

    private Task OnAgentModeChanged(string mode)
    {
        _selectedAgentMode = mode;
        return Task.CompletedTask;
    }

    private async Task OnWorkDirectoryChangedAsync(Guid? id)
    {
        _listError = null;
        if (id is Guid wd)
        {
            var get = await WorkDirs.GetAsync(wd);
            if (get.IsError)
            {
                _listError = get.Error;
                return;
            }

            await SetActiveWorkDirectoryAsync(wd, get.Value.AbsolutePath);
        }
        else
        {
            _activeWorkDirectoryId = null;
            Host.SetComposerWorkDirectoryId(null);
            await RefreshGitBranchAsync(null);
            await PersistWorkDirectoryAsync(null);
            await RefreshSessionsAsync();
        }
    }

    private async Task OnWorkDirectoryListChangedAsync()
    {
        if (_workdirSwitcher is not null)
            await _workdirSwitcher.RefreshAsync();
        await RefreshSessionsAsync();
    }

    private async Task SetActiveWorkDirectoryAsync(Guid id, string absolutePath)
    {
        _activeWorkDirectoryId = id;
        Host.SetComposerWorkDirectoryId(id);
        await RefreshGitBranchAsync(absolutePath);
        await PersistWorkDirectoryAsync(id);
        await RefreshSessionsAsync();
    }

    private async Task RefreshGitBranchAsync(string? absolutePath)
    {
        if (string.IsNullOrWhiteSpace(absolutePath))
        {
            _gitBranch = null;
            return;
        }

        var fs = await DysonWorkspaceFileSystems
            .CreateLocalAsync(absolutePath)
            .ConfigureAwait(false);
        var branch = fs.IsError
            ? DysonGitInfo.TryGetBranch(absolutePath)
            : DysonGitInfo.TryGetBranch(fs.Value);
        _gitBranch = branch.IsSuccess ? branch.Value : null;
    }

    private async Task PersistWorkDirectoryAsync(Guid? id)
    {
        try
        {
            await Js.InvokeVoidAsync("dysonWorkdir.set", id?.ToString());
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task RefreshSessionsAsync()
    {
        _listError = null;
        if (_activeWorkDirectoryId is null)
        {
            _sessions = [];
            UpdateActiveTitle();
            return;
        }

        var list = await Host.ListSessionsAsync(_activeWorkDirectoryId);
        if (list.IsError)
        {
            _listError = list.Error;
            return;
        }

        _sessions = OverlayLiveTitle(list.Value);
        UpdateActiveTitle();
    }

    private async Task RefreshSessionsQuietAsync()
    {
        if (_activeWorkDirectoryId is null)
        {
            _sessions = [];
            UpdateActiveTitle();
            return;
        }

        var list = await Host.ListSessionsAsync(_activeWorkDirectoryId);
        if (list.IsSuccess)
        {
            _sessions = OverlayLiveTitle(list.Value);
            UpdateActiveTitle();
        }
    }

    private IReadOnlyList<DysonSessionSummary> OverlayLiveTitle(
        IReadOnlyList<DysonSessionSummary> list)
    {
        if (Host.Session?.PersistenceId is not Guid pid || Host.Session.DisplayTitle is null)
            return list;

        return list
            .Select(s => s.Id == pid
                ? new DysonSessionSummary
                {
                    Id = s.Id,
                    RuntimeId = s.RuntimeId,
                    ParentSessionId = s.ParentSessionId,
                    AgentMode = s.AgentMode,
                    Status = s.Status,
                    Title = Host.Session.DisplayTitle,
                    ModelSlugId = s.ModelSlugId,
                    WorkDirectoryId = s.WorkDirectoryId,
                    CreatedUtc = s.CreatedUtc,
                    LastActivityUtc = s.LastActivityUtc,
                }
                : s)
            .ToList();
    }

    private void UpdateActiveTitle()
    {
        if (Host.Session?.DisplayTitle is { } live)
        {
            _activeTitle = live;
            return;
        }

        if (Host.ActiveSessionId is Guid id)
            _activeTitle = _sessions.FirstOrDefault(s => s.Id == id)?.Title;
        else
            _activeTitle = null;
    }

    private async Task StartNewAsync()
    {
        var result = await Host.StartNewSessionAsync(
            _selectedAgentMode,
            _selectedSlugId,
            _activeWorkDirectoryId);
        if (result.IsError)
            _listError = result.Error;
        SyncSelectedSlugFromSession();
        SyncReasoningEffortFromHost();
        SyncSelectedAgentModeFromSession();
        await RefreshSessionsAsync();
    }

    private async Task ResumeAsync(Guid sessionId)
    {
        var result = await Host.ResumeSessionAsync(sessionId);
        if (result.IsError)
            _listError = result.Error;
        SyncSelectedSlugFromSession();
        SyncReasoningEffortFromHost();
        SyncSelectedAgentModeFromSession();
        await RefreshSessionsAsync();
    }

    private async Task DeleteAsync(Guid sessionId)
    {
        var result = await Host.DeleteSessionAsync(sessionId);
        if (result.IsError)
            _listError = result.Error;
        await RefreshSessionsAsync();
    }

    private async Task PromptAsync(string prompt)
    {
        await Host.PromptAsync(prompt, _selectedAgentMode);
        SyncSelectedAgentModeFromSession();
        await RefreshSessionsAsync();
    }

    private async Task NavigateToParentAsync()
    {
        var result = await Host.NavigateToParentAsync();
        if (result.IsError)
            _listError = result.Error;
        SyncSelectedSlugFromSession();
        SyncReasoningEffortFromHost();
        SyncSelectedAgentModeFromSession();
        await RefreshSessionsAsync();
    }

    private void CancelPrompt() => Host.CancelPrompt();

    public async ValueTask DisposeAsync()
    {
        Host.Changed -= OnHostChanged;
        Theme.Changed -= OnThemeChanged;
        try
        {
            await Js.InvokeVoidAsync("dysonChatLinks.uninstall");
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        _chatLinksRef?.Dispose();
        _chatLinksRef = null;
    }
}
