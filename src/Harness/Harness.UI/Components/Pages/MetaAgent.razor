@page "/meta/{WorkDirectoryId:guid}"
@using DysonHarness
@using Harness.UI.Components.Files
@using Harness.UI.Components.Meta
@using Harness.UI.Demo
@implements IAsyncDisposable
@inject DysonUiHost Host
@inject DysonMessageBus Bus
@inject IDysonWorkDirectoryRepository WorkDirs
@inject IDysonModelRepository ModelStore
@inject IJSRuntime Js
@inject Harness.UI.Services.ConfirmDialogService ConfirmDialog

<PageTitle>Meta agent — @(_workDirectoryName ?? "DysonHarness")</PageTitle>

<AppShell>
    <Sidebar>
        <Sidebar>
            <WorkDirectory>
                <WorkDirectorySwitcher @ref="_workdirSwitcher"
                                       ActiveWorkDirectoryId="_activeWorkDirectoryId"
                                       ActiveWorkDirectoryIdChanged="OnWorkDirectoryChanged" />
            </WorkDirectory>
            <SessionList>
                <SessionList Sessions="_sessions"
                             ActiveSessionId="Host.ActiveSessionId"
                             Error="@_error"
                             OnNew="StartNewAsync"
                             OnResume="ResumeAsync"
                             OnDelete="DeleteAsync"
                             OnDeleteInactive="DeleteInactiveAsync"
                             OnRefresh="RefreshSessionsAsync" />
            </SessionList>
        </Sidebar>
    </Sidebar>
    <Main>
        <div class="meta-stage">
            <header class="meta-stage__header">
                <div class="meta-stage__heading">
                    <span class="meta-stage__mark" aria-hidden="true"></span>
                    <h1 class="meta-stage__title">Meta agent</h1>
                    <span class="meta-stage__subtitle mono" title="@(_workDirectoryName ?? WorkDirectoryId.ToString())">@(_workDirectoryName ?? WorkDirectoryId.ToString())</span>
                </div>
                <div class="meta-stage__actions">
                    <button type="button"
                            class="btn"
                            disabled="@(!IsMetaFocused)"
                            @onclick="ToggleTasks">
                        <span class="meta-stage__icon meta-stage__icon--tasks" aria-hidden="true"></span>
                        <span class="meta-stage__label">Tasks</span>
                    </button>
                    <button type="button" class="btn" disabled="@(!IsMetaFocused)" @onclick="OpenVisualizations">
                        <span class="meta-stage__icon meta-stage__icon--viz" aria-hidden="true"></span>
                        <span class="meta-stage__label">Visualizations</span>
                    </button>
                    <button type="button"
                            class="btn"
                            disabled="@(!CanOpenFullSession)"
                            title="Open this Meta Agent session in the full chat UI"
                            @onclick="OpenFullSessionAsync">
                        <span class="meta-stage__icon meta-stage__icon--open" aria-hidden="true"></span>
                        <span class="meta-stage__label">Open full session</span>
                    </button>
                    <span class="meta-stage__divider" aria-hidden="true"></span>
                    <a class="btn" href="/" @onclick="LeaveMetaAsync" @onclick:preventDefault="true"><span class="meta-stage__icon meta-stage__icon--back" aria-hidden="true"></span><span class="meta-stage__label">Back to agent</span></a>
                </div>
            </header>

            @if (_unknownWorkDirectory)
            {
                <div class="error-banner">Unknown work directory.</div>
            }
            else
            {
                <div class="meta-stage__body">
                    <aside class="meta-plans" aria-label="Plans">
                        <MetaPlanList @ref="_planList"
                                      WorkDirectoryId="WorkDirectoryId"
                                      CanBuildPlans="IsMetaFocused" />
                    </aside>

                    <div class="meta-main">
                        <DysonTransition TItem="string" Item="BannerError" ExitMs="140" Context="errorToast">
                            <ErrorToast @key="errorToast.Item"
                                        Message="@errorToast.Item"
                                        MotionClass="@errorToast.StateClass"
                                        PageError="@_error"
                                        OnPageErrorCleared="ClearPageError" />
                        </DysonTransition>

                        <div class="meta-chat">
                            <MetaChatFeed @ref="_chatFeed"
                                          Turns="ChatTurns"
                                          Queued="ChatQueued"
                                          SessionBusy="IsMetaFocused && Host.IsBusy"
                                          OnRemoveQueued="RemoveQueuedAsync"
                                          OnConversationAction="OnConversationActionAsync"
                                          OnUserQuestion="OnUserQuestionAsync"
                                          OnOpenVisualization="OpenFocusedVisualization" />
                        </div>

                        <div class="composer meta-composer">
                            <div @ref="_shell"
                                 class="composer-shell @(_dragOver ? "is-drop-target" : null)">
                                @if (Host.PendingImages.Count > 0 || Host.PendingFilePaths.Count > 0)
                                {
                                    <div class="composer-context" aria-label="Pending attachments">
                                        @foreach (var filePath in Host.PendingFilePaths)
                                        {
                                            if (IsPathAttachedToPendingImage(filePath))
                                                continue;
                                            var path = filePath;
                                            var fileLabel = System.IO.Path.GetFileName(path.Replace('/', System.IO.Path.DirectorySeparatorChar));
                                            if (string.IsNullOrWhiteSpace(fileLabel))
                                                fileLabel = path;
                                            <span class="composer-context__chip" title="@fileLabel">
                                                <span class="composer-context__label">@fileLabel</span>
                                                <button type="button"
                                                        class="composer-context__remove"
                                                        title="Remove pending file"
                                                        aria-label="@($"Remove pending file {fileLabel}")"
                                                        @onclick="() => Host.RemovePendingFilePath(path)">
                                                    ×
                                                </button>
                                            </span>
                                        }
                                        @foreach (var image in Host.PendingImages)
                                        {
                                            var pending = image;
                                            <span class="composer-context__thumb" title="@pending.FileName">
                                                <img src="@pending.DataUrl" alt="@pending.FileName" />
                                                <button type="button"
                                                        class="composer-context__remove"
                                                        title="Remove image"
                                                        aria-label="@($"Remove image {pending.FileName}")"
                                                        @onclick="() => Host.RemovePendingImage(pending.Id)">
                                                    ×
                                                </button>
                                            </span>
                                        }
                                    </div>
                                }
                                <textarea @ref="_prompt"
                                          class="meta-composer__prompt"
                                          rows="3"
                                          placeholder="Message the meta agent…"
                                          disabled="@ComposerDisabled"
                                          @bind="_draft"
                                          @bind:event="oninput"
                                          @onkeydown="OnComposerKeyDown"></textarea>
                                <InputFile @key="_fileInputKey"
                                           OnChange="OnFilesSelectedAsync"
                                           multiple
                                           class="composer-attach__input"
                                           disabled="@ComposerDisabled" />
                            </div>
                            <div class="btn-row meta-composer__actions">
                                <div class="meta-composer__pickers">
                                    <button type="button"
                                            class="composer-attach"
                                            title="Attach files or images"
                                            aria-label="Attach files or images"
                                            disabled="@ComposerDisabled"
                                            @onclick="OpenFilePickerAsync">
                                        <span class="composer-attach__icon" aria-hidden="true"></span>
                                    </button>
                                    <PushToTalkButton AgentMode="@DysonAgentModes.MetaAgent"
                                                      Disabled="@(ComposerDisabled || _voiceOn)"
                                                      Textarea="_prompt"
                                                      @bind-Text="_draft"
                                                      OnError="Host.ReportError" />
                                    <VoiceModeButton OnChanged="OnVoiceModeChanged" />
                                    <ModelSlugPicker @ref="_modelPicker"
                                                     SelectedSlugId="_selectedSlugId"
                                                     SelectedSlugIdChanged="OnSelectedSlugIdChangedAsync" />
                                    <ComposerEffortPicker Options="EffortOptions"
                                                          Value="@_reasoningEffort"
                                                          Disabled="@ComposerDisabled"
                                                          OnPick="OnReasoningEffortChangedAsync" />
                                </div>
                                <ComposerStopMenu />
                                <button type="button"
                                        class="btn btn-primary meta-composer__send"
                                        disabled="@(ComposerDisabled || !CanSend)"
                                        @onclick="SendAsync">
                                    <span class="meta-composer__send-icon" aria-hidden="true"></span>
                                    <span class="meta-composer__send-label">Send</span>
                                </button>
                            </div>
                        </div>
                        <span class="list-item__meta meta-composer__hint">Ctrl+Enter to send · paste/drop files or images · hold Ctrl+M to talk · voice mode: say the agent name</span>
                    </div>

                    <section class="meta-agents" aria-label="Agents and files">
                        <div class="tool-panel rail-tabs">
                            <div class="rail-tabs__tabs" role="tablist" aria-label="Agents and files">
                                <button type="button" role="tab"
                                        class="rail-tabs__tab@(_metaRailTab == MetaRailTab.Agents ? " rail-tabs__tab--active" : null)"
                                        aria-selected="@(_metaRailTab == MetaRailTab.Agents)"
                                        @onclick="() => SelectMetaRail(MetaRailTab.Agents)">
                                    Agents
                                </button>
                                <button type="button" role="tab"
                                        class="rail-tabs__tab@(_metaRailTab == MetaRailTab.Files ? " rail-tabs__tab--active" : null)"
                                        aria-selected="@(_metaRailTab == MetaRailTab.Files)"
                                        @onclick="() => SelectMetaRail(MetaRailTab.Files)">
                                    Files
                                </button>
                            </div>
                            <div class="rail-tabs__body@(MetaRailBodyClass)" role="tabpanel">
                                @if (_metaRailTab == MetaRailTab.Agents)
                                {
                                    <div class="meta-agents__list">
                                        @{
                                            var childIds = ChildIds;
                                        }
                                        @if (childIds.Count == 0)
                                        {
                                            <div class="meta-agents__empty">
                                                <span class="meta-agents__empty-icon" aria-hidden="true"></span>
                                                <p class="meta-agents__empty-title">No agents yet</p>
                                                <p class="meta-agents__empty-hint">Drones and explores appear here when the meta agent dispatches them.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var id in childIds)
                                            {
                                                <div class="meta-agents__item" @key="id">
                                                    <SubagentCard PersistenceId="id"
                                                                  AfterNavigate="InspectChildAsync" />
                                                    <MetaAgentChildRows ParentPersistenceId="id"
                                                                        AfterNavigate="InspectChildAsync" />
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <FileTreePanel ActiveWorkDirectoryId="WorkDirectoryId" />
                                }
                            </div>
                        </div>
                    </section>
                </div>
            }
        </div>
    </Main>
</AppShell>

<FileViewerOverlay />

<SessionTodosModal IsOpen="_tasksOpen"
                   Todos="MetaTodos"
                   CompleteCount="MetaTodoCompleteCount"
                   OnClose="CloseTasks" />

<SessionVisualizationsModal IsOpen="_vizOpen"
                             Session="@(IsMetaFocused ? Host.Session : null)"
                             FocusId="_vizFocusId"
                             OnClose="CloseVisualizations" />

@code {
    [Parameter] public Guid WorkDirectoryId { get; set; }

    private IReadOnlyList<DysonSessionSummary> _sessions = [];
    private Guid? _activeWorkDirectoryId;
    private MetaRailTab _metaRailTab = MetaRailTab.Agents;
    private string? _error;
    private string? _workDirectoryName;
    private bool _unknownWorkDirectory;
    private Guid _loadedWorkDirectoryId;
    private Guid? _metaSessionId;
    private bool _sessionReady;
    private string _draft = "";
    private Guid? _selectedSlugId;
    private string? _reasoningEffort;
    private ModelSlugPicker? _modelPicker;
    private IReadOnlyList<string> _effortModes = [];
    private Guid? _effortModesSlugId;
    private MetaPlanList? _planList;
    private MetaChatFeed? _chatFeed;
    private IDisposable? _hostSub;
    private Guid? _agentsListBoundId;
    private IDisposable? _agentsSpawnedSub;
    private IDisposable? _agentsStatusSub;
    private DotNetObjectReference<DysonUiHost>? _chatLinksRef;
    private bool _tasksOpen;
    private bool _vizOpen;
    private Guid? _vizFocusId;
    private ElementReference _shell;
    private ElementReference _prompt;
    private WorkDirectorySwitcher? _workdirSwitcher;
    private Func<Task>? _openPanelHook;
    private Func<Guid, Task>? _switchHook;
    private bool _voiceOn;
    private bool _imageCaptureBound;
    private bool _dragOver;
    private int _fileInputKey;
    private DotNetObjectReference<MetaAgent>? _imageCaptureRef;

    /// <summary>Toast gate. Null (not empty) is what clears <c>DysonTransition</c>.</summary>
    private string? BannerError =>
        !string.IsNullOrEmpty(_error) ? _error
        : string.IsNullOrEmpty(Host.LastError) ? null
        : Host.LastError;

    private void ClearPageError() => _error = null;

    private bool IsMetaFocused =>
        _sessionReady
        && _metaSessionId is Guid id
        && Host.Session is { } session
        && session.PersistenceId == id
        && string.Equals(session.Mode, DysonAgentModes.MetaAgent, StringComparison.OrdinalIgnoreCase);

    private bool CanOpenFullSession => _metaSessionId is Guid id && id != Guid.Empty;

    private bool ComposerDisabled => _unknownWorkDirectory || !IsMetaFocused;

    private bool CanSend =>
        !string.IsNullOrWhiteSpace(_draft)
        || Host.PendingImages.Count > 0
        || Host.PendingFilePaths.Count > 0;

    private IEnumerable<string> EffortOptions =>
        ComposerEffortOptions.Build(_effortModes, _reasoningEffort);

    private IReadOnlyList<DysonAgentTurn> ChatTurns =>
        IsMetaFocused && Host.Session is { } session ? session.Turns : [];

    private IReadOnlyList<QueuedPrompt> ChatQueued =>
        IsMetaFocused ? Host.QueuedPrompts : [];

    private IReadOnlyList<DysonSessionTodo> MetaTodos =>
        IsMetaFocused && Host.Session?.Todos is { Count: > 0 } todos
            ? todos.OrderByDescending(t => t.Sequence).ToArray()
            : [];

    private int MetaTodoCompleteCount =>
        MetaTodos.Count(t => t.Status == DysonSessionTodoStatus.Complete);

    private IReadOnlyList<Guid> ChildIds =>
        IsMetaFocused ? OrderedDirectChildIds(Host.Session) : [];

    internal static IReadOnlyList<Guid> OrderedDirectChildIds(DysonAgentSession? session)
    {
        if (session is null)
            return [];

        return session.SubSessions
            .Where(child => child is not null && child.PersistenceId != Guid.Empty)
            .OrderByDescending(child => child.Id)
            .Select(child => child.PersistenceId)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        var sub = Bus.Subscribe<DysonHostStateChangedEvent>(Host.BusScopeKey, OnHostChanged);
        if (sub.IsSuccess)
            _hostSub = sub.Value;

        var attached = await Host.EnsureRuntimeAttachedAsync();
        if (attached.IsError)
            _error = attached.Error;

        await Host.EnsureDefaultModelAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chatLinksRef ??= DotNetObjectReference.Create(Host);
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonChatLinks.install", _chatLinksRef);
            BindFocusHooks();
        }

        if (_imageCaptureBound || _unknownWorkDirectory)
            return;

        _imageCaptureRef ??= DotNetObjectReference.Create(this);
        if (await DysonCircuitJs.InvokeVoidAsync(Js, "dysonComposer.attachImageCapture", _shell, _imageCaptureRef) is null)
            _imageCaptureBound = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        _activeWorkDirectoryId = WorkDirectoryId;
        if (_loadedWorkDirectoryId == WorkDirectoryId)
            return;

        Host.Focus?.SetActive(WorkDirectoryId);
        _loadedWorkDirectoryId = WorkDirectoryId;
        _tasksOpen = false;
        _vizOpen = false;

        var get = await WorkDirs.GetAsync(WorkDirectoryId);
        _unknownWorkDirectory = get.IsError;
        _workDirectoryName = get.IsSuccess ? get.Value.Name : null;
        if (_unknownWorkDirectory)
        {
            Host.Focus?.SetActive(null);
            _sessions = [];
            _sessionReady = false;
            _metaSessionId = null;
            BindAgentsListSubscriptions();
            return;
        }

        Host.SetComposerWorkDirectoryId(WorkDirectoryId);
        await RefreshSessionsAsync();
        await EnsureMetaSessionAsync();
        await SyncModelFromHostAsync();
    }

    /// <summary>
    /// Mirror the focused meta session's provider into the pickers. The host owns the value:
    /// a rejected or deferred switch must not leave the picker showing a model that is not in use.
    /// </summary>
    private async Task SyncModelFromHostAsync()
    {
        if (!IsMetaFocused)
            return;

        _selectedSlugId = Host.Session?.Provider switch
        {
            OpenAiCompatibleAgentProvider oai => oai.SlugId,
            DemoDysonAgentProvider demo => demo.SlugId,
            _ => _selectedSlugId,
        };
        _reasoningEffort = Host.SessionReasoningEffort;

        if (_selectedSlugId is not Guid slugId)
        {
            _effortModes = [];
            _effortModesSlugId = null;
            return;
        }

        // Effort modes only change with the slug; this runs on every host event.
        if (_effortModesSlugId == slugId)
            return;

        var slug = await ModelStore.GetSlugAsync(slugId);
        _effortModes = slug.IsSuccess ? slug.Value.ReasoningModes : [];
        var firstSlug = _effortModesSlugId is null;
        _effortModesSlugId = slugId;

        // The picker builds its option list once, on init — before this page has resolved the
        // session. A slug that is disabled is only listed when it is the current selection, so
        // without this refresh a session pinned to a disabled model renders as "Select model…".
        if (firstSlug && _modelPicker is not null)
            await _modelPicker.RefreshAsync();
    }

    private async Task OnSelectedSlugIdChangedAsync(Guid? id)
    {
        // ModelSlugPicker auto-writes a default on load; the host is shared, so only the
        // page that owns the focused meta session may repoint it.
        if (!IsMetaFocused)
            return;

        var result = await Host.ProviderConversionTargetAsync(id) is { } target
            ? await ModelSlugConversion.ConfirmAndConvertAsync(Host, ConfirmDialog, id!.Value, target)
            : await Host.SetSessionModelSlugAsync(id);
        _error = result.IsError ? result.Error : null;
        await SyncModelFromHostAsync();
    }

    private async Task OnReasoningEffortChangedAsync(string? effort)
    {
        if (!IsMetaFocused)
            return;

        // Rejected while a prompt is in flight — say so instead of silently snapping back.
        var result = await Host.SetSessionReasoningEffortAsync(effort);
        _error = result.IsError ? result.Error : null;
        await SyncModelFromHostAsync();
    }

    private async Task EnsureMetaSessionAsync()
    {
        _sessionReady = false;

        if (Host.Session is { } live
            && string.Equals(live.Mode, DysonAgentModes.MetaAgent, StringComparison.OrdinalIgnoreCase)
            && Host.ActiveWorkDirectoryId == WorkDirectoryId
            && live.PersistenceId != Guid.Empty)
        {
            _metaSessionId = live.PersistenceId;
            BindAgentsListSubscriptions();
            _sessionReady = true;
            return;
        }

        var found = await Host.FindExistingMetaAgentSessionAsync(WorkDirectoryId);
        if (found.IsError)
        {
            _error = found.Error;
            return;
        }

        var existing = found.Value;
        if (existing is not null)
        {
            var resume = await Host.ResumeSessionAsync(existing.Id);
            if (resume.IsError)
            {
                _error = resume.Error;
                return;
            }

            _metaSessionId = existing.Id;
            BindAgentsListSubscriptions();
        }
        else
        {
            var started = await Host.StartNewSessionAsync(
                DysonAgentModes.MetaAgent,
                null,
                WorkDirectoryId);
            if (started.IsError)
            {
                _error = started.Error;
                return;
            }

            _metaSessionId = Host.ActiveSessionId;
            BindAgentsListSubscriptions();
        }

        if (_metaSessionId is not Guid metaId
            || Host.Session is not { } session
            || session.PersistenceId != metaId
            || !string.Equals(session.Mode, DysonAgentModes.MetaAgent, StringComparison.OrdinalIgnoreCase))
        {
            _error = "Could not open the Meta Agent session.";
            return;
        }

        _sessionReady = true;
        await RefreshSessionsAsync();
    }

    private async Task RefreshSessionsAsync()
    {
        _error = null;
        var list = await Host.ListSessionsAsync(WorkDirectoryId);
        if (list.IsError)
        {
            _error = list.Error;
            return;
        }

        _sessions = OverlayLiveTitle(list.Value);
    }

    private IReadOnlyList<DysonSessionSummary> OverlayLiveTitle(
        IReadOnlyList<DysonSessionSummary> list)
    {
        if (Host.Session?.PersistenceId is not Guid pid)
            return list;

        var liveTitle = Host.Session.DisplayTitle;
        var lastTurn = Host.Session.Turns.Count > 0 ? Host.Session.Turns[^1] : null;
        var liveActivity = lastTurn?.CompletedUtc ?? lastTurn?.StartedUtc;

        return list
            .Select(s => s.Id == pid
                ? new DysonSessionSummary
                {
                    Id = s.Id,
                    RuntimeId = s.RuntimeId,
                    ParentSessionId = s.ParentSessionId,
                    AgentMode = s.AgentMode,
                    Status = s.Status,
                    Title = liveTitle ?? s.Title,
                    ModelSlugId = s.ModelSlugId,
                    WorkDirectoryId = s.WorkDirectoryId,
                    CreatedUtc = s.CreatedUtc,
                    LastActivityUtc = liveActivity ?? s.LastActivityUtc,
                    WorktreeEnabled = s.WorktreeEnabled,
                    HasWorktree = s.HasWorktree,
                }
                : s)
            .ToList();
    }

    private const DysonHostChangeKind PlanRefreshMask =
        DysonHostChangeKind.Transcript | DysonHostChangeKind.SessionGraph | DysonHostChangeKind.Busy;

    private void OnHostChanged(DysonHostStateChangedEvent evt) => _ = InvokeAsync(async () =>
    {
        _sessions = OverlayLiveTitle(_sessions);
        if ((evt.Kind & PlanRefreshMask) != 0 && _planList is not null)
            await _planList.RefreshAsync();
        await SyncModelFromHostAsync();
        StateHasChanged();
    });

    private void BindAgentsListSubscriptions()
    {
        if (_metaSessionId == _agentsListBoundId)
            return;

        DisposeAgentsListSubscriptions();
        _agentsListBoundId = _metaSessionId;
        if (_metaSessionId is not Guid id || id == Guid.Empty)
            return;

        var scope = DysonBusScopes.Session(id);
        var spawnedSub = Bus.Subscribe<DysonSubagentSpawnedEvent>(scope, OnAgentsSpawned);
        if (spawnedSub.IsSuccess)
            _agentsSpawnedSub = spawnedSub.Value;

        var statusSub = Bus.Subscribe<DysonSubagentStatusChangedEvent>(scope, OnAgentsStatus);
        if (statusSub.IsSuccess)
            _agentsStatusSub = statusSub.Value;
    }

    private void OnAgentsSpawned(DysonSubagentSpawnedEvent evt) => _ = InvokeAsync(() =>
    {
        if (_metaSessionId is not Guid parent
            || !DysonSubagentHostLogic.AffectsAgentsList(parent, evt))
            return;
        StateHasChanged();
    });

    private void OnAgentsStatus(DysonSubagentStatusChangedEvent evt) => _ = InvokeAsync(() =>
    {
        if (_metaSessionId is not Guid parent
            || !DysonSubagentHostLogic.AffectsAgentsList(parent, evt))
            return;
        StateHasChanged();
    });

    private void DisposeAgentsListSubscriptions()
    {
        _agentsSpawnedSub?.Dispose();
        _agentsSpawnedSub = null;
        _agentsStatusSub?.Dispose();
        _agentsStatusSub = null;
    }

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        var hasAttachments = Host.PendingImages.Count > 0 || Host.PendingFilePaths.Count > 0;
        if ((string.IsNullOrWhiteSpace(text) && !hasAttachments) || !IsMetaFocused || Host.Session is null)
            return;

        _error = null;
        _draft = "";
        // Attachments must stay on the same turn as the words, so enqueue via PromptAsync
        // even while a prompt is in flight. Text-only still injects a comment when busy.
        var result = hasAttachments
            ? await Host.PromptAsync(text, DysonAgentModes.MetaAgent)
            : await Host.PromptOrInjectAsync(text, DysonAgentModes.MetaAgent);
        if (result.IsError)
        {
            _error = result.Error;
            _draft = text;
        }
    }

    private Task OpenFilePickerAsync() =>
        DysonCircuitJs.InvokeVoidAsync(Js, "dysonComposer.openFileInput", _shell).AsTask();

    private bool IsPathAttachedToPendingImage(string filePath)
    {
        foreach (var image in Host.PendingImages)
        {
            if (image.AttachedRelativePath is { } attached
                && string.Equals(attached, filePath, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (ComposerDisabled)
        {
            Host.ReportError("Cannot attach files while the composer is busy.");
            _fileInputKey++;
            return;
        }

        var maxCount = Math.Max(DysonUserImageFactory.MaxPendingImages, DysonComposerUploads.MaxPendingFiles);
        foreach (var file in e.GetMultipleFiles(maxCount))
        {
            try
            {
                await using var stream = file.OpenReadStream(DysonComposerUploads.MaxRawBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                if (DysonComposerUploads.LooksLikeImage(file.ContentType, file.Name))
                    await Host.QueuePendingImageFromBytesAsync(file.Name, bytes);
                else
                    await Host.QueuePendingFileFromBytesAsync(file.Name, bytes);
            }
            catch (Exception ex)
            {
                Host.ReportError($"Could not read file: {ex.Message}");
            }
        }

        _fileInputKey++;
    }

    [JSInvokable]
    public Task SetDragOver(bool value)
    {
        if (_dragOver == value)
            return Task.CompletedTask;
        _dragOver = value;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey)
            return SendAsync();
        return Task.CompletedTask;
    }

    private Task RemoveQueuedAsync(Guid queuedId)
    {
        Host.RemoveQueuedPrompt(queuedId);
        return Task.CompletedTask;
    }

    private async Task OnConversationActionAsync(MetaChatActionClick click)
    {
        var result = await Host.InvokeMetaConversationActionAsync(click.TurnId, click.Index);
        _chatFeed?.NoteConversationActionResult(click.TurnId, result);
    }

    private async Task OnUserQuestionAsync(MetaChatQuestionSubmit submit)
    {
        var result = await Host.SubmitMetaUserQuestionAnswerAsync(
            submit.QuestionId,
            submit.Selected,
            submit.CustomText);
        if (result.IsError)
            _chatFeed?.NoteUserQuestionError(submit.QuestionId, result.Error);
    }

    private void ToggleTasks() => _tasksOpen = !_tasksOpen;

    private void CloseTasks() => _tasksOpen = false;

    private void OpenVisualizations()
    {
        _vizFocusId = null;
        _vizOpen = true;
    }

    private void CloseVisualizations() => _vizOpen = false;

    private void OpenFocusedVisualization(Guid id)
    {
        _vizFocusId = id;
        _vizOpen = true;
    }

    private async Task OpenFullSessionAsync()
    {
        if (_metaSessionId is not Guid id)
            return;

        if (Host.ActiveSessionId != id)
        {
            var resume = await Host.ResumeSessionAsync(id);
            if (resume.IsError)
            {
                _error = resume.Error;
                return;
            }
        }

        await DysonCircuitJs.NavigateAsync(Js, "/");
    }

    private Task InspectChildAsync() =>
        DysonCircuitJs.NavigateAsync(Js, "/").AsTask();

    // Acting on a session is a session-shell concern — do it, then hand off to "/".
    private async Task StartNewAsync()
    {
        var result = await Host.StartNewSessionAsync(DysonAgentModes.Work, null, WorkDirectoryId);
        if (result.IsError)
        {
            _error = result.Error;
            return;
        }

        await DysonCircuitJs.NavigateAsync(Js, "/");
    }

    private async Task ResumeAsync(Guid sessionId)
    {
        var result = await Host.ResumeSessionAsync(sessionId);
        if (result.IsError)
        {
            _error = result.Error;
            return;
        }

        await DysonCircuitJs.NavigateAsync(Js, "/");
    }

    private async Task DeleteAsync(Guid sessionId)
    {
        var result = await Host.DeleteSessionAsync(sessionId);
        if (result.IsError)
            _error = result.Error;
        await RefreshSessionsAsync();
    }

    private async Task DeleteInactiveAsync()
    {
        var result = await Host.DeleteInactiveSessionsAsync(WorkDirectoryId);
        if (result.IsError)
            _error = result.Error;
        await RefreshSessionsAsync();
    }

    private enum MetaRailTab { Agents, Files }

    private void SelectMetaRail(MetaRailTab tab) => _metaRailTab = tab;

    private string MetaRailBodyClass =>
        _metaRailTab == MetaRailTab.Files ? " rail-tabs__body--files" : " rail-tabs__body--agents";

    // The switcher re-reads ActiveWorkDirectoryId after the callback and reports
    // "Could not switch work directory" when it did not change; the route Guid only
    // updates once navigation lands, so hold the selection locally first.
    private async Task OnWorkDirectoryChanged(Guid? id)
    {
        Host.Focus?.SetActive(id);
        if (id is Guid wd && wd == WorkDirectoryId)
            return;

        await PersistWorkDirectoryAsync(id);

        if (id is not Guid next)
        {
            _activeWorkDirectoryId = null;
            return;
        }

        _activeWorkDirectoryId = next;
        await DysonCircuitJs.NavigateAsync(Js, $"/meta/{next}");
    }

    private Task PersistWorkDirectoryAsync(Guid? id) =>
        DysonCircuitJs.InvokeVoidAsync(Js, "dysonWorkdir.set", id?.ToString()).AsTask();

    private void OnVoiceModeChanged(bool on) => _voiceOn = on;

    private async Task LeaveMetaAsync() =>
        await DysonCircuitJs.NavigateAsync(Js, "/");

    private void BindFocusHooks()
    {
        var focus = Host.Focus;
        if (focus is null)
            return;

        _openPanelHook ??= () => InvokeAsync(() => _workdirSwitcher?.Open());
        _switchHook ??= id => InvokeAsync(async () =>
        {
            if (_workdirSwitcher is not null)
                await _workdirSwitcher.SelectAsync(id);
        });
        focus.OpenPanel = _openPanelHook;
        focus.SwitchTo = _switchHook;
    }

    private void UnbindFocusHooks()
    {
        var focus = Host.Focus;
        if (focus is null)
            return;
        if (ReferenceEquals(focus.OpenPanel, _openPanelHook))
            focus.OpenPanel = null;
        if (ReferenceEquals(focus.SwitchTo, _switchHook))
            focus.SwitchTo = null;
    }

    public async ValueTask DisposeAsync()
    {
        UnbindFocusHooks();
        _hostSub?.Dispose();
        _hostSub = null;
        DisposeAgentsListSubscriptions();
        _agentsListBoundId = null;
        if (_imageCaptureBound)
            await DysonCircuitJs.InvokeVoidAsync(Js, "dysonComposer.detachImageCapture", _shell);

        _imageCaptureRef?.Dispose();
        _imageCaptureRef = null;
        await DysonCircuitJs.InvokeVoidAsync(Js, "dysonChatLinks.uninstall");

        _chatLinksRef?.Dispose();
        _chatLinksRef = null;
    }
}
