@page "/settings/agent-behavior"
@layout SettingsLayout
@using DysonHarness
@using Harness.UI.Components.Models
@inject IDysonSubjectSettingsRepository AppSettings
@inject IDysonModelRepository Models

<PageTitle>Agent behavior — Settings</PageTitle>

<div class="settings-page">
    <h1 class="settings-page__title">Agent behavior</h1>
    <p class="settings-page__copy">
        Preferences that change how agents finish work. Stored in the local app database.
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">@_error</div>
    }

    <div class="settings-page__panel panel">
        <div class="field">
            <label for="automatic-code-review">Automatic code review</label>
            <select id="automatic-code-review"
                    value="@_automaticCodeReview"
                    @onchange="OnAutomaticCodeReviewChangedAsync">
                <option value="@DysonAutomaticCodeReviewSetting.None">None</option>
                <option value="@DysonAutomaticCodeReviewSetting.Low">Low</option>
                <option value="@DysonAutomaticCodeReviewSetting.Medium">Medium</option>
                <option value="@DysonAutomaticCodeReviewSetting.High" disabled>High</option>
            </select>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            After the root task passes completion confirmation and the report-summary turn,
            a Bug Review subagent runs and reports findings (uses more tokens).
            Low reviews modified files and their behavior.
            Medium also reviews related APIs and external interactions.
            High is not available.
        </p>

        <div class="field" style="margin-top:16px;">
            <label for="automatic-code-review-action">Automatic code review action</label>
            <select id="automatic-code-review-action"
                    value="@_automaticCodeReviewAction"
                    @onchange="OnAutomaticCodeReviewActionChangedAsync">
                <option value="@DysonAutomaticCodeReviewSetting.ReportOnly">Report only</option>
                <option value="@DysonAutomaticCodeReviewSetting.AutomaticallyFix">Automatically fix confirmed bugs</option>
            </select>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Report only leaves the worktree untouched. Automatically fix validates review findings,
            fixes confirmed bugs once, verifies them, and reports anything unresolved.
        </p>

        <div class="field" style="margin-top:16px;">
            <div class="settings-page__picker-row">
                <div class="settings-page__picker-row-model">
                    <label>Turn summarizer model</label>
                    <ModelSlugPicker SelectedSlugId="_turnSummarizerSlugId"
                                     SelectedSlugIdChanged="OnTurnSummarizerSlugChangedAsync"
                                     AllowEmpty="true"
                                     EmptyLabel="Use session model" />
                </div>
                <div class="settings-page__picker-row-effort">
                    <label for="turn-summarizer-effort">Effort</label>
                    <select id="turn-summarizer-effort"
                            value="@_turnSummarizerEffort"
                            disabled="@(_turnSummarizerSlugId is null)"
                            @onchange="OnTurnSummarizerEffortChangedAsync">
                        <option value="">Default</option>
                        @foreach (var mode in EffortModesFor(_turnSummarizerSlugId))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Model used by SummarizeTurns / the turn context menu to compress older turns into transcript stubs.
            Leave as “Use session model” to reuse the chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <div class="settings-page__picker-row">
                <div class="settings-page__picker-row-model">
                    <label>Web search summarizer</label>
                    <ModelSlugPicker SelectedSlugId="_webSearchSummarizerSlugId"
                                     SelectedSlugIdChanged="OnWebSearchSummarizerSlugChangedAsync"
                                     AllowEmpty="true"
                                     EmptyLabel="Use session model" />
                </div>
                <div class="settings-page__picker-row-effort">
                    <label for="web-search-summarizer-effort">Effort</label>
                    <select id="web-search-summarizer-effort"
                            value="@_webSearchSummarizerEffort"
                            disabled="@(_webSearchSummarizerSlugId is null)"
                            @onchange="OnWebSearchSummarizerEffortChangedAsync">
                        <option value="">Default</option>
                        @foreach (var mode in EffortModesFor(_webSearchSummarizerSlugId))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Model used to compress FreeSearch / WebFetch / extract tool results before they enter the agent transcript.
            Leave as “Use session model” to reuse the chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <div class="settings-page__picker-row">
                <div class="settings-page__picker-row-model">
                    <label>Explore default model</label>
                    <ModelSlugPicker SelectedSlugId="_exploreSlugId"
                                     SelectedSlugIdChanged="OnExploreSlugChangedAsync"
                                     AllowEmpty="true"
                                     EmptyLabel="Use session model" />
                </div>
                <div class="settings-page__picker-row-effort">
                    <label for="explore-effort">Effort</label>
                    <select id="explore-effort"
                            value="@_exploreEffort"
                            disabled="@(_exploreSlugId is null)"
                            @onchange="OnExploreEffortChangedAsync">
                        <option value="">Default</option>
                        @foreach (var mode in EffortModesFor(_exploreSlugId))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Explore subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <div class="settings-page__picker-row">
                <div class="settings-page__picker-row-model">
                    <label>Drone default model</label>
                    <ModelSlugPicker SelectedSlugId="_droneSlugId"
                                     SelectedSlugIdChanged="OnDroneSlugChangedAsync"
                                     AllowEmpty="true"
                                     EmptyLabel="Use session model" />
                </div>
                <div class="settings-page__picker-row-effort">
                    <label for="drone-effort">Effort</label>
                    <select id="drone-effort"
                            value="@_droneEffort"
                            disabled="@(_droneSlugId is null)"
                            @onchange="OnDroneEffortChangedAsync">
                        <option value="">Default</option>
                        @foreach (var mode in EffortModesFor(_droneSlugId))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Drone subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <div class="settings-page__picker-row">
                <div class="settings-page__picker-row-model">
                    <label>Security Review default model</label>
                    <ModelSlugPicker SelectedSlugId="_securityReviewSlugId"
                                     SelectedSlugIdChanged="OnSecurityReviewSlugChangedAsync"
                                     AllowEmpty="true"
                                     EmptyLabel="Use session model" />
                </div>
                <div class="settings-page__picker-row-effort">
                    <label for="security-review-effort">Effort</label>
                    <select id="security-review-effort"
                            value="@_securityReviewEffort"
                            disabled="@(_securityReviewSlugId is null)"
                            @onchange="OnSecurityReviewEffortChangedAsync">
                        <option value="">Default</option>
                        @foreach (var mode in EffortModesFor(_securityReviewSlugId))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Security Review subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <div class="settings-page__picker-row">
                <div class="settings-page__picker-row-model">
                    <label>Bug Review default model</label>
                    <ModelSlugPicker SelectedSlugId="_bugReviewSlugId"
                                     SelectedSlugIdChanged="OnBugReviewSlugChangedAsync"
                                     AllowEmpty="true"
                                     EmptyLabel="Use session model" />
                </div>
                <div class="settings-page__picker-row-effort">
                    <label for="bug-review-effort">Effort</label>
                    <select id="bug-review-effort"
                            value="@_bugReviewEffort"
                            disabled="@(_bugReviewSlugId is null)"
                            @onchange="OnBugReviewEffortChangedAsync">
                        <option value="">Default</option>
                        @foreach (var mode in EffortModesFor(_bugReviewSlugId))
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Bug Review subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        @if (_saved)
        {
            <p class="settings-page__copy" style="margin:8px 0 0;">Saved.</p>
        }
    </div>
</div>

@code {
    private readonly Dictionary<Guid, IReadOnlyList<string>> _slugReasoningModes = new();
    private string _automaticCodeReview = DysonAutomaticCodeReviewSetting.None;
    private string _automaticCodeReviewAction = DysonAutomaticCodeReviewSetting.ReportOnly;
    private Guid? _turnSummarizerSlugId;
    private Guid? _webSearchSummarizerSlugId;
    private Guid? _exploreSlugId;
    private Guid? _droneSlugId;
    private Guid? _securityReviewSlugId;
    private Guid? _bugReviewSlugId;
    private string _turnSummarizerEffort = "";
    private string _webSearchSummarizerEffort = "";
    private string _exploreEffort = "";
    private string _droneEffort = "";
    private string _securityReviewEffort = "";
    private string _bugReviewEffort = "";
    private string? _error;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        var review = await DysonAutomaticCodeReviewSetting.ResolveAsync(AppSettings);
        if (review.IsError)
        {
            _error = review.Error;
            return;
        }

        _automaticCodeReview = review.Value;

        var action = await DysonAutomaticCodeReviewSetting.ResolveActionAsync(AppSettings);
        if (action.IsError)
        {
            _error = action.Error;
            return;
        }

        _automaticCodeReviewAction = action.Value;

        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.TurnSummarizerModelSlugId, v => _turnSummarizerSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.WebSearchSummarizerModelSlugId, v => _webSearchSummarizerSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.ExploreModelSlugId, v => _exploreSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.DroneModelSlugId, v => _droneSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.SecurityReviewModelSlugId, v => _securityReviewSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.BugReviewModelSlugId, v => _bugReviewSlugId = v))
            return;

        if (!await TryLoadSlugModesAsync())
            return;

        if (!await TryLoadEffortSettingAsync(_turnSummarizerSlugId, DysonAppSettingKeys.TurnSummarizerReasoningEffort, v => _turnSummarizerEffort = v))
            return;
        if (!await TryLoadEffortSettingAsync(_webSearchSummarizerSlugId, DysonAppSettingKeys.WebSearchSummarizerReasoningEffort, v => _webSearchSummarizerEffort = v))
            return;
        if (!await TryLoadEffortSettingAsync(_exploreSlugId, DysonAppSettingKeys.ExploreReasoningEffort, v => _exploreEffort = v))
            return;
        if (!await TryLoadEffortSettingAsync(_droneSlugId, DysonAppSettingKeys.DroneReasoningEffort, v => _droneEffort = v))
            return;
        if (!await TryLoadEffortSettingAsync(_securityReviewSlugId, DysonAppSettingKeys.SecurityReviewReasoningEffort, v => _securityReviewEffort = v))
            return;
        if (!await TryLoadEffortSettingAsync(_bugReviewSlugId, DysonAppSettingKeys.BugReviewReasoningEffort, v => _bugReviewEffort = v))
            return;
    }

    private async Task<bool> TryLoadSlugSettingAsync(string key, Action<Guid?> assign)
    {
        var setting = await AppSettings.GetSettingAsync(key);
        if (setting.IsError)
        {
            _error = setting.Error;
            return false;
        }

        if (Guid.TryParse(setting.Value, out var id) && id != Guid.Empty)
            assign(id);
        else
            assign(null);
        return true;
    }

    private async Task<bool> TryLoadSlugModesAsync()
    {
        var result = await Models.ListProvidersAsync();
        if (result.IsError)
        {
            _error = result.Error;
            return false;
        }

        _slugReasoningModes.Clear();
        foreach (var provider in result.Value)
        {
            foreach (var slug in provider.Slugs)
                _slugReasoningModes[slug.Id] = slug.ReasoningModes;
        }

        return true;
    }

    private async Task<bool> TryLoadEffortSettingAsync(Guid? slugId, string effortKey, Action<string> assign)
    {
        var setting = await AppSettings.GetSettingAsync(effortKey);
        if (setting.IsError)
        {
            _error = setting.Error;
            return false;
        }

        var effort = setting.Value?.Trim() ?? "";
        if (string.IsNullOrEmpty(effort) || slugId is null || !EffortModesFor(slugId).Contains(effort, StringComparer.OrdinalIgnoreCase))
        {
            assign("");
            if (!string.IsNullOrEmpty(effort))
            {
                var cleared = await AppSettings.SetSettingAsync(effortKey, null);
                if (cleared.IsError)
                {
                    _error = cleared.Error;
                    return false;
                }
            }

            return true;
        }

        assign(effort);
        return true;
    }

    private IReadOnlyList<string> EffortModesFor(Guid? slugId)
    {
        if (slugId is not Guid id)
            return [];

        if (_slugReasoningModes.TryGetValue(id, out var modes) && modes.Count > 0)
            return modes;

        return EffortPickerPopup.FallbackEffortModes;
    }

    private async Task OnAutomaticCodeReviewChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _saved = false;

        // high is display-only — refuse to persist it.
        if (!DysonAutomaticCodeReviewSetting.TrySelect(e.Value?.ToString(), out var next))
            return;

        _automaticCodeReview = next;

        var set = await AppSettings.SetSettingAsync(
            DysonAppSettingKeys.AutomaticCodeReview,
            _automaticCodeReview);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _saved = true;
    }

    private async Task OnAutomaticCodeReviewActionChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _saved = false;

        if (!DysonAutomaticCodeReviewSetting.TrySelectAction(e.Value?.ToString(), out var next))
            return;

        _automaticCodeReviewAction = next;
        var set = await AppSettings.SetSettingAsync(
            DysonAppSettingKeys.AutomaticCodeReviewAction,
            _automaticCodeReviewAction);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _saved = true;
    }

    private Task OnTurnSummarizerSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            _turnSummarizerSlugId,
            v => _turnSummarizerSlugId = v,
            v => _turnSummarizerEffort = v,
            DysonAppSettingKeys.TurnSummarizerModelSlugId,
            DysonAppSettingKeys.TurnSummarizerReasoningEffort);

    private Task OnWebSearchSummarizerSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            _webSearchSummarizerSlugId,
            v => _webSearchSummarizerSlugId = v,
            v => _webSearchSummarizerEffort = v,
            DysonAppSettingKeys.WebSearchSummarizerModelSlugId,
            DysonAppSettingKeys.WebSearchSummarizerReasoningEffort);

    private Task OnExploreSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            _exploreSlugId,
            v => _exploreSlugId = v,
            v => _exploreEffort = v,
            DysonAppSettingKeys.ExploreModelSlugId,
            DysonAppSettingKeys.ExploreReasoningEffort);

    private Task OnDroneSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            _droneSlugId,
            v => _droneSlugId = v,
            v => _droneEffort = v,
            DysonAppSettingKeys.DroneModelSlugId,
            DysonAppSettingKeys.DroneReasoningEffort);

    private Task OnSecurityReviewSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            _securityReviewSlugId,
            v => _securityReviewSlugId = v,
            v => _securityReviewEffort = v,
            DysonAppSettingKeys.SecurityReviewModelSlugId,
            DysonAppSettingKeys.SecurityReviewReasoningEffort);

    private Task OnBugReviewSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            _bugReviewSlugId,
            v => _bugReviewSlugId = v,
            v => _bugReviewEffort = v,
            DysonAppSettingKeys.BugReviewModelSlugId,
            DysonAppSettingKeys.BugReviewReasoningEffort);

    private Task OnTurnSummarizerEffortChangedAsync(ChangeEventArgs e) =>
        SaveEffortSettingAsync(e, v => _turnSummarizerEffort = v, DysonAppSettingKeys.TurnSummarizerReasoningEffort);

    private Task OnWebSearchSummarizerEffortChangedAsync(ChangeEventArgs e) =>
        SaveEffortSettingAsync(e, v => _webSearchSummarizerEffort = v, DysonAppSettingKeys.WebSearchSummarizerReasoningEffort);

    private Task OnExploreEffortChangedAsync(ChangeEventArgs e) =>
        SaveEffortSettingAsync(e, v => _exploreEffort = v, DysonAppSettingKeys.ExploreReasoningEffort);

    private Task OnDroneEffortChangedAsync(ChangeEventArgs e) =>
        SaveEffortSettingAsync(e, v => _droneEffort = v, DysonAppSettingKeys.DroneReasoningEffort);

    private Task OnSecurityReviewEffortChangedAsync(ChangeEventArgs e) =>
        SaveEffortSettingAsync(e, v => _securityReviewEffort = v, DysonAppSettingKeys.SecurityReviewReasoningEffort);

    private Task OnBugReviewEffortChangedAsync(ChangeEventArgs e) =>
        SaveEffortSettingAsync(e, v => _bugReviewEffort = v, DysonAppSettingKeys.BugReviewReasoningEffort);

    private async Task SaveSlugSettingAsync(
        Guid? id,
        Guid? currentId,
        Action<Guid?> assignSlug,
        Action<string> assignEffort,
        string slugKey,
        string effortKey)
    {
        if (id == currentId)
            return;

        _error = null;
        _saved = false;
        assignSlug(id);
        assignEffort("");

        var value = id is Guid g && g != Guid.Empty ? g.ToString("D") : null;
        var set = await AppSettings.SetSettingAsync(slugKey, value);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        var clearEffort = await AppSettings.SetSettingAsync(effortKey, null);
        if (clearEffort.IsError)
        {
            _error = clearEffort.Error;
            return;
        }

        _saved = true;
    }

    private async Task SaveEffortSettingAsync(ChangeEventArgs e, Action<string> assign, string effortKey)
    {
        _error = null;
        _saved = false;

        var next = e.Value?.ToString()?.Trim() ?? "";
        assign(next);

        var set = await AppSettings.SetSettingAsync(effortKey, string.IsNullOrEmpty(next) ? null : next);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _saved = true;
    }
}
