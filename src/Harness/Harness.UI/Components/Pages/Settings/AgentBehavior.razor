@page "/settings/agent-behavior"
@layout SettingsLayout
@using DysonHarness
@using Harness.UI.Components.Models
@inject IDysonSubjectSettingsRepository AppSettings

<PageTitle>Agent behavior — Settings</PageTitle>

<div class="settings-page">
    <h1 class="settings-page__title">Agent behavior</h1>
    <p class="settings-page__copy">
        Preferences that change how agents finish work. Stored in the local app database.
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">@_error</div>
    }

    <div class="settings-page__panel panel">
        <div class="field">
            <label for="automatic-code-review">Automatic code review</label>
            <select id="automatic-code-review"
                    value="@_automaticCodeReview"
                    @onchange="OnAutomaticCodeReviewChangedAsync">
                <option value="@DysonAutomaticCodeReviewSetting.None">None</option>
                <option value="@DysonAutomaticCodeReviewSetting.Low">Low</option>
                <option value="@DysonAutomaticCodeReviewSetting.Medium">Medium</option>
                <option value="@DysonAutomaticCodeReviewSetting.High" disabled>High</option>
            </select>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            After the root task passes completion confirmation and the report-summary turn,
            a Bug Review subagent runs and reports findings (uses more tokens).
            Low reviews modified files and their behavior.
            Medium also reviews related APIs and external interactions.
            High is not available.
        </p>

        <div class="field" style="margin-top:16px;">
            <label for="automatic-code-review-action">Automatic code review action</label>
            <select id="automatic-code-review-action"
                    value="@_automaticCodeReviewAction"
                    @onchange="OnAutomaticCodeReviewActionChangedAsync">
                <option value="@DysonAutomaticCodeReviewSetting.ReportOnly">Report only</option>
                <option value="@DysonAutomaticCodeReviewSetting.AutomaticallyFix">Automatically fix confirmed bugs</option>
            </select>
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Report only leaves the worktree untouched. Automatically fix validates review findings,
            fixes confirmed bugs once, verifies them, and reports anything unresolved.
        </p>

        <div class="field" style="margin-top:16px;">
            <label>Turn summarizer model</label>
            <ModelSlugPicker SelectedSlugId="_turnSummarizerSlugId"
                             SelectedSlugIdChanged="OnTurnSummarizerSlugChangedAsync"
                             AllowEmpty="true"
                             EmptyLabel="Use session model" />
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Model used by SummarizeTurns / the turn context menu to compress older turns into transcript stubs.
            Leave as “Use session model” to reuse the chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <label>Web search summarizer</label>
            <ModelSlugPicker SelectedSlugId="_webSearchSummarizerSlugId"
                             SelectedSlugIdChanged="OnWebSearchSummarizerSlugChangedAsync"
                             AllowEmpty="true"
                             EmptyLabel="Use session model" />
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Model used to compress FreeSearch / WebFetch / extract tool results before they enter the agent transcript.
            Leave as “Use session model” to reuse the chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <label>Explore default model</label>
            <ModelSlugPicker SelectedSlugId="_exploreSlugId"
                             SelectedSlugIdChanged="OnExploreSlugChangedAsync"
                             AllowEmpty="true"
                             EmptyLabel="Use session model" />
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Explore subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <label>Drone default model</label>
            <ModelSlugPicker SelectedSlugId="_droneSlugId"
                             SelectedSlugIdChanged="OnDroneSlugChangedAsync"
                             AllowEmpty="true"
                             EmptyLabel="Use session model" />
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Drone subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <label>Security Review default model</label>
            <ModelSlugPicker SelectedSlugId="_securityReviewSlugId"
                             SelectedSlugIdChanged="OnSecurityReviewSlugChangedAsync"
                             AllowEmpty="true"
                             EmptyLabel="Use session model" />
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Security Review subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        <div class="field" style="margin-top:16px;">
            <label>Bug Review default model</label>
            <ModelSlugPicker SelectedSlugId="_bugReviewSlugId"
                             SelectedSlugIdChanged="OnBugReviewSlugChangedAsync"
                             AllowEmpty="true"
                             EmptyLabel="Use session model" />
        </div>
        <p class="settings-page__copy" style="margin:0;">
            Default model for Bug Review subagents when StartSubagent omits modelSlug.
            Leave as “Use session model” to inherit the parent chat model.
        </p>

        @if (_saved)
        {
            <p class="settings-page__copy" style="margin:8px 0 0;">Saved.</p>
        }
    </div>
</div>

@code {
    private string _automaticCodeReview = DysonAutomaticCodeReviewSetting.None;
    private string _automaticCodeReviewAction = DysonAutomaticCodeReviewSetting.ReportOnly;
    private Guid? _turnSummarizerSlugId;
    private Guid? _webSearchSummarizerSlugId;
    private Guid? _exploreSlugId;
    private Guid? _droneSlugId;
    private Guid? _securityReviewSlugId;
    private Guid? _bugReviewSlugId;
    private string? _error;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        var review = await DysonAutomaticCodeReviewSetting.ResolveAsync(AppSettings);
        if (review.IsError)
        {
            _error = review.Error;
            return;
        }

        _automaticCodeReview = review.Value;

        var action = await DysonAutomaticCodeReviewSetting.ResolveActionAsync(AppSettings);
        if (action.IsError)
        {
            _error = action.Error;
            return;
        }

        _automaticCodeReviewAction = action.Value;

        var summarizer = await AppSettings.GetSettingAsync(DysonAppSettingKeys.TurnSummarizerModelSlugId);
        if (summarizer.IsError)
        {
            _error = summarizer.Error;
            return;
        }

        if (Guid.TryParse(summarizer.Value, out var id) && id != Guid.Empty)
            _turnSummarizerSlugId = id;

        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.WebSearchSummarizerModelSlugId, v => _webSearchSummarizerSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.ExploreModelSlugId, v => _exploreSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.DroneModelSlugId, v => _droneSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.SecurityReviewModelSlugId, v => _securityReviewSlugId = v))
            return;
        if (!await TryLoadSlugSettingAsync(DysonAppSettingKeys.BugReviewModelSlugId, v => _bugReviewSlugId = v))
            return;
    }

    private async Task<bool> TryLoadSlugSettingAsync(string key, Action<Guid?> assign)
    {
        var setting = await AppSettings.GetSettingAsync(key);
        if (setting.IsError)
        {
            _error = setting.Error;
            return false;
        }

        if (Guid.TryParse(setting.Value, out var id) && id != Guid.Empty)
            assign(id);
        else
            assign(null);
        return true;
    }

    private async Task OnAutomaticCodeReviewChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _saved = false;

        // high is display-only — refuse to persist it.
        if (!DysonAutomaticCodeReviewSetting.TrySelect(e.Value?.ToString(), out var next))
            return;

        _automaticCodeReview = next;

        var set = await AppSettings.SetSettingAsync(
            DysonAppSettingKeys.AutomaticCodeReview,
            _automaticCodeReview);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _saved = true;
    }

    private async Task OnAutomaticCodeReviewActionChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _saved = false;

        if (!DysonAutomaticCodeReviewSetting.TrySelectAction(e.Value?.ToString(), out var next))
            return;

        _automaticCodeReviewAction = next;
        var set = await AppSettings.SetSettingAsync(
            DysonAppSettingKeys.AutomaticCodeReviewAction,
            _automaticCodeReviewAction);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _saved = true;
    }

    private Task OnTurnSummarizerSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            v => _turnSummarizerSlugId = v,
            DysonAppSettingKeys.TurnSummarizerModelSlugId);

    private Task OnWebSearchSummarizerSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            v => _webSearchSummarizerSlugId = v,
            DysonAppSettingKeys.WebSearchSummarizerModelSlugId);

    private Task OnExploreSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            v => _exploreSlugId = v,
            DysonAppSettingKeys.ExploreModelSlugId);

    private Task OnDroneSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            v => _droneSlugId = v,
            DysonAppSettingKeys.DroneModelSlugId);

    private Task OnSecurityReviewSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            v => _securityReviewSlugId = v,
            DysonAppSettingKeys.SecurityReviewModelSlugId);

    private Task OnBugReviewSlugChangedAsync(Guid? id) =>
        SaveSlugSettingAsync(
            id,
            v => _bugReviewSlugId = v,
            DysonAppSettingKeys.BugReviewModelSlugId);

    private async Task SaveSlugSettingAsync(Guid? id, Action<Guid?> assign, string key)
    {
        _error = null;
        _saved = false;
        assign(id);

        var value = id is Guid g && g != Guid.Empty ? g.ToString("D") : null;
        var set = await AppSettings.SetSettingAsync(key, value);
        if (set.IsError)
        {
            _error = set.Error;
            return;
        }

        _saved = true;
    }
}
