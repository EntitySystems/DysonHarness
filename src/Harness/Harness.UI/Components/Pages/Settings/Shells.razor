@page "/settings/shells"
@layout SettingsLayout
@using DysonHarness
@implements IDisposable
@inject IDysonConfiguredShellRepository ShellStore
@inject DysonEmbeddedRuntimeInstaller Runtimes

<PageTitle>Shells — Settings</PageTitle>

<div class="settings-page">
    <h1 class="settings-page__title">Shells</h1>
    <p class="settings-page__copy">
        Register shells available to agents via ShellExecute and long-running shell tools.
        Only enabled shells appear in the MCP enum. New and resumed sessions pick up changes.
        Leave Fixed args blank to use basename heuristics (pwsh/powershell/cmd/bash/sh/zsh/git-bash; python/python3 → -c, node/nodejs → -e).
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="settings-page__copy" style="margin:0 0 8px;">@_status</p>
    }

    <div class="settings-page__panel panel">
        @if (_shells.Count == 0)
        {
            <div class="empty-state" style="padding:8px 0;">No shells configured.</div>
        }
        else
        {
            <div class="list">
                @foreach (var shell in _shells)
                {
                    <div class="list-item" style="cursor:default;">
                        @if (_editingId == shell.Id)
                        {
                            <div class="field">
                                <label>Name</label>
                                <input @bind="_editName" />
                            </div>
                            <div class="field">
                                <label>Executable path</label>
                                <div class="btn-row" style="align-items:center;">
                                    <input @bind="_editPath" style="flex:1;min-width:0;" />
                                    <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="BrowseEditPathAsync">Browse</button>
                                </div>
                            </div>
                            <div class="field">
                                <label>Fixed args (optional)</label>
                                <input @bind="_editFixedArgs" placeholder="e.g. -c or -NoProfile -NonInteractive -Command" />
                            </div>
                            <label class="checkbox-row">
                                <input type="checkbox" @bind="_editEnabled" />
                                Enabled
                            </label>
                            <div class="btn-row" style="margin-top:4px;">
                                <button type="button" class="btn btn-primary" style="padding:3px 7px;font-size:11px;" @onclick="() => SaveEditAsync(shell.Id)">Save</button>
                                <button type="button" class="btn btn-ghost" style="padding:3px 7px;font-size:11px;" @onclick="CancelEdit">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <span class="list-item__title">@shell.Name</span>
                            <span class="list-item__meta mono">
                                @(shell.IsEnabled ? "enabled" : "disabled") · @shell.ExecutablePath
                                @if (!string.IsNullOrWhiteSpace(shell.FixedArgsJson))
                                {
                                    <text> · fixed @DysonConfiguredShellRepository.FixedArgsToText(shell.FixedArgsJson)</text>
                                }
                            </span>
                            <div class="btn-row" style="margin-top:4px;">
                                <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="() => BeginEdit(shell)">Edit</button>
                                <button type="button" class="btn btn-ghost" style="padding:3px 7px;font-size:11px;" @onclick="() => ToggleEnabledAsync(shell)">
                                    @(shell.IsEnabled ? "Disable" : "Enable")
                                </button>
                                <button type="button" class="btn btn-ghost" style="padding:3px 7px;font-size:11px;" @onclick="() => DeleteAsync(shell.Id)">Remove</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div style="margin-top:1rem;border-top:1px solid var(--border, #333);padding-top:0.75rem;">
            <div class="tool-panel__title" style="margin-bottom:8px;">Embedded runtimes</div>
            <p class="settings-page__copy">
                Downloads land under the app-data <span class="mono">runtimes/</span> folder next to the database; new and resumed sessions pick up enabled shells.
            </p>
            <div class="list">
                @foreach (var runtime in _runtimes)
                {
                    var busy = IsRuntimeBusy(runtime.Kind);
                    var downloading = _runtimeCancels.ContainsKey(runtime.Kind);
                    <div class="list-item" style="cursor:default;">
                        <span class="list-item__title">@runtime.DisplayName @runtime.PinnedVersion</span>
                        @if (runtime.DownloadSupported && runtime.IsInstalled && !string.IsNullOrWhiteSpace(runtime.ExecutablePath))
                        {
                            <span class="list-item__meta mono">@runtime.ExecutablePath</span>
                        }
                        else if (!runtime.DownloadSupported && !string.IsNullOrWhiteSpace(runtime.Note))
                        {
                            <span class="list-item__meta">@runtime.Note</span>
                        }
                        <div class="btn-row" style="margin-top:4px;">
                            @if (runtime.DownloadSupported)
                            {
                                @if (runtime.IsInstalled)
                                {
                                    <button type="button"
                                            class="btn"
                                            style="padding:3px 7px;font-size:11px;"
                                            disabled="@busy"
                                            @onclick="() => DownloadRuntimeAsync(runtime.Kind, force: true)">
                                        Reinstall
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-primary"
                                            style="padding:3px 7px;font-size:11px;"
                                            disabled="@busy"
                                            @onclick="() => DownloadRuntimeAsync(runtime.Kind, force: false)">
                                        Download
                                    </button>
                                }
                            }
                            else if (runtime.Kind == DysonEmbeddedRuntimeKind.Python && runtime.IsInstalled)
                            {
                                <button type="button"
                                        class="btn btn-primary"
                                        style="padding:3px 7px;font-size:11px;"
                                        disabled="@busy"
                                        @onclick="RegisterSystemPythonAsync">
                                    Register system Python
                                </button>
                            }
                            @if (downloading)
                            {
                                <button type="button"
                                        class="btn btn-ghost"
                                        style="padding:3px 7px;font-size:11px;"
                                        @onclick="() => CancelRuntime(runtime.Kind)">
                                    Cancel
                                </button>
                            }
                        </div>
                        @if (downloading)
                        {
                            <span class="list-item__meta">
                                @if (_runtimeProgress.TryGetValue(runtime.Kind, out var progress) && progress is not null)
                                {
                                    @FormatProgress(progress)
                                }
                                else
                                {
                                    <text>Downloading…</text>
                                }
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div style="margin-top:1rem;border-top:1px solid var(--border, #333);padding-top:0.75rem;">
            <div class="tool-panel__title" style="margin-bottom:8px;">Add shell</div>
            <div class="field">
                <label>Name</label>
                <input @bind="_addName" placeholder="e.g. MyPwsh" />
            </div>
            <div class="field">
                <label>Executable path</label>
                <div class="btn-row" style="align-items:center;">
                    <input @bind="_addPath" placeholder="pwsh or C:\…\pwsh.exe" style="flex:1;min-width:0;" />
                    <button type="button" class="btn" style="padding:3px 7px;font-size:11px;" @onclick="BrowseAddPathAsync">Browse</button>
                </div>
            </div>
            <div class="field">
                <label>Fixed args (optional)</label>
                <input @bind="_addFixedArgs" placeholder="blank = basename heuristics" />
            </div>
            <div class="btn-row" style="margin-top:4px;">
                <button type="button" class="btn btn-primary" style="padding:3px 7px;font-size:11px;" @onclick="AddAsync">Add</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DysonConfiguredShellEntity> _shells = [];
    private List<DysonEmbeddedRuntimeStatus> _runtimes = [];
    private readonly Dictionary<DysonEmbeddedRuntimeKind, CancellationTokenSource> _runtimeCancels = [];
    private readonly Dictionary<DysonEmbeddedRuntimeKind, DysonDownloadProgress?> _runtimeProgress = [];
    private readonly HashSet<DysonEmbeddedRuntimeKind> _runtimeBusy = [];
    private bool _disposed;
    private string? _error;
    private string? _status;

    private Guid? _editingId;
    private string _editName = "";
    private string _editPath = "";
    private string _editFixedArgs = "";
    private bool _editEnabled = true;

    private string _addName = "";
    private string _addPath = "";
    private string _addFixedArgs = "";

    protected override async Task OnInitializedAsync()
    {
        var ensure = await ShellStore.EnsureDefaultsAsync();
        if (ensure.IsError)
        {
            _error = ensure.Error;
            return;
        }

        await ReloadAsync();
        RefreshRuntimes();
    }

    private void RefreshRuntimes()
    {
        _runtimes = Runtimes.ProbeAll(DysonBuildInfo.Current).ToList();
    }

    private bool IsRuntimeBusy(DysonEmbeddedRuntimeKind kind) => _runtimeBusy.Contains(kind);

    private void CancelRuntime(DysonEmbeddedRuntimeKind kind)
    {
        if (_runtimeCancels.TryGetValue(kind, out var cts))
            cts.Cancel();
    }

    private async Task DownloadRuntimeAsync(DysonEmbeddedRuntimeKind kind, bool force)
    {
        _error = null;
        _status = null;
        ReplaceRuntimeCancel(kind);
        var cts = _runtimeCancels[kind];
        _runtimeBusy.Add(kind);
        _runtimeProgress[kind] = null;

        var progress = new Progress<DysonDownloadProgress>(p =>
        {
            if (_disposed)
                return;
            _runtimeProgress[kind] = p;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var installed = await Runtimes.EnsureInstalledAsync(
                kind,
                DysonBuildInfo.Current,
                progress,
                force,
                cts.Token);
            if (installed.IsError)
            {
                _error = installed.Error;
                return;
            }

            var registered = await Runtimes.RegisterAsShellAsync(kind, ShellStore, cts.Token);
            if (registered.IsError)
            {
                _error = registered.Error;
                return;
            }

            _status = $"{DysonEmbeddedRuntimeInstaller.GetShellName(kind)} registered.";
            await ReloadAsync();
        }
        finally
        {
            _runtimeBusy.Remove(kind);
            _runtimeProgress.Remove(kind);
            RemoveRuntimeCancel(kind, cts);
            RefreshRuntimes();
        }
    }

    private async Task RegisterSystemPythonAsync()
    {
        _error = null;
        _status = null;
        _runtimeBusy.Add(DysonEmbeddedRuntimeKind.Python);
        try
        {
            var registered = await Runtimes.RegisterAsShellAsync(DysonEmbeddedRuntimeKind.Python, ShellStore);
            if (registered.IsError)
            {
                _error = registered.Error;
                return;
            }

            _status = "Python registered.";
            await ReloadAsync();
        }
        finally
        {
            _runtimeBusy.Remove(DysonEmbeddedRuntimeKind.Python);
            RefreshRuntimes();
        }
    }

    private void ReplaceRuntimeCancel(DysonEmbeddedRuntimeKind kind)
    {
        if (_runtimeCancels.Remove(kind, out var existing))
        {
            existing.Cancel();
            existing.Dispose();
        }

        _runtimeCancels[kind] = new CancellationTokenSource();
    }

    private void RemoveRuntimeCancel(DysonEmbeddedRuntimeKind kind, CancellationTokenSource cts)
    {
        if (_runtimeCancels.TryGetValue(kind, out var current) && ReferenceEquals(current, cts))
            _runtimeCancels.Remove(kind);
        cts.Dispose();
    }

    private static string FormatProgress(DysonDownloadProgress progress)
    {
        var received = FormatBytes(progress.BytesReceived);
        if (progress.TotalBytes is long total && total > 0)
        {
            var percent = progress.Fraction is double fraction
                ? $" ({fraction * 100:0}%)"
                : "";
            return $"{received} / {FormatBytes(total)}{percent}";
        }

        return received;
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:0.0} KB";
        return $"{bytes / (1024.0 * 1024.0):0.0} MB";
    }

    public void Dispose()
    {
        _disposed = true;
        foreach (var cts in _runtimeCancels.Values)
        {
            cts.Cancel();
            cts.Dispose();
        }

        _runtimeCancels.Clear();
    }

    private async Task ReloadAsync()
    {
        var list = await ShellStore.ListAsync();
        if (list.IsError)
        {
            _error = list.Error;
            return;
        }

        _shells = list.Value.ToList();
    }

    private void BeginEdit(DysonConfiguredShellEntity shell)
    {
        _error = null;
        _status = null;
        _editingId = shell.Id;
        _editName = shell.Name;
        _editPath = shell.ExecutablePath;
        _editFixedArgs = DysonConfiguredShellRepository.FixedArgsToText(shell.FixedArgsJson);
        _editEnabled = shell.IsEnabled;
    }

    private void CancelEdit()
    {
        _editingId = null;
    }

    private async Task SaveEditAsync(Guid id)
    {
        _error = null;
        _status = null;
        var update = await ShellStore.UpdateAsync(
            id,
            _editName,
            _editPath,
            _editEnabled,
            DysonConfiguredShellRepository.ParseFixedArgsText(_editFixedArgs));
        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _editingId = null;
        _status = "Saved.";
        await ReloadAsync();
    }

    private async Task ToggleEnabledAsync(DysonConfiguredShellEntity shell)
    {
        _error = null;
        _status = null;
        var update = await ShellStore.UpdateAsync(
            shell.Id,
            shell.Name,
            shell.ExecutablePath,
            !shell.IsEnabled,
            DysonConfiguredShellRepository.ParseFixedArgs(shell.FixedArgsJson));
        if (update.IsError)
        {
            _error = update.Error;
            return;
        }

        _status = shell.IsEnabled ? "Disabled." : "Enabled.";
        await ReloadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        _error = null;
        _status = null;
        var del = await ShellStore.DeleteAsync(id);
        if (del.IsError)
        {
            _error = del.Error;
            return;
        }

        if (_editingId == id)
            _editingId = null;
        _status = "Removed.";
        await ReloadAsync();
    }

    private async Task AddAsync()
    {
        _error = null;
        _status = null;
        var create = await ShellStore.CreateAsync(
            _addName,
            _addPath,
            isEnabled: true,
            DysonConfiguredShellRepository.ParseFixedArgsText(_addFixedArgs));
        if (create.IsError)
        {
            _error = create.Error;
            return;
        }

        _addName = "";
        _addPath = "";
        _addFixedArgs = "";
        _status = "Added.";
        await ReloadAsync();
    }

    private async Task BrowseAddPathAsync()
    {
        _error = null;
        var pick = await DysonNativeFolderPicker.PickFileAsync();
        if (pick.IsError)
        {
            if (!pick.Error.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
                _error = pick.Error;
            return;
        }

        _addPath = pick.Value;
        if (string.IsNullOrWhiteSpace(_addName))
            _addName = Path.GetFileNameWithoutExtension(pick.Value);
    }

    private async Task BrowseEditPathAsync()
    {
        _error = null;
        var pick = await DysonNativeFolderPicker.PickFileAsync();
        if (pick.IsError)
        {
            if (!pick.Error.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
                _error = pick.Error;
            return;
        }

        _editPath = pick.Value;
    }
}
