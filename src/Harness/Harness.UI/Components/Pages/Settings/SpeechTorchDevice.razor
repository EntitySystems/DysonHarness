@inject IDysonSubjectSettingsRepository Settings

<div class="speech-torch">
    <div class="speech-torch__title">PyTorch</div>
    <div class="speech-torch__options" role="radiogroup" aria-label="PyTorch device">
        <label class="speech-torch__option">
            <input type="radio" name="speech-torch-device" value="cpu" checked="@(!_rocm)"
                   disabled="@_busy" @onchange="() => SaveAsync(false)" />
            <span>CPU</span>
        </label>
        <label class="speech-torch__option">
            <input type="radio" name="speech-torch-device" value="rocm" checked="@_rocm"
                   disabled="@_busy" @onchange="() => SaveAsync(true)" />
            <span>ROCm</span>
        </label>
        <label class="speech-torch__option speech-torch__option--disabled">
            <input type="radio" name="speech-torch-device" value="cuda" disabled="disabled" />
            <span>CUDA <span class="speech-torch__soon">coming soon</span></span>
        </label>
    </div>
    <p class="speech-torch__note">ROCm installs AMD's Windows PyTorch beside the CPU build the next time a Python speech model is installed.</p>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="speech-torch__error" role="alert">@_error</div>
    }
</div>

@code {
    private bool _rocm;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var stored = await Settings.GetSettingAsync(DysonAppSettingKeys.SpeechTorchDevice);
        if (stored.IsError)
            _error = stored.Error;
        else
            _rocm = DysonSpeechTorchDevice.IsRocm(stored.Value);
    }

    private async Task SaveAsync(bool rocm)
    {
        _busy = true;
        _error = null;
        var saved = await DysonSpeechTorchDevice.SaveAsync(
            Settings, rocm ? DysonSpeechTorchDevice.RocmValue : DysonSpeechTorchDevice.CpuValue);
        _busy = false;
        if (saved.IsError)
            _error = saved.Error;
        else
            _rocm = rocm;
    }
}
