@page "/settings/voice"
@layout SettingsLayout
@using DysonHarness
@using Harness.UI.Services
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject DysonSpeechInstaller Installer
@inject IDysonSpeechModelRepository SpeechModels
@inject DysonActiveTextToSpeech Tts
@inject IDysonSubjectSettingsRepository Settings
@inject ConfirmDialogService ConfirmDialog

<PageTitle>Voice — Settings</PageTitle>

<div class="settings-page">
    <h1 class="settings-page__title">Voice</h1>
    <p class="settings-page__copy">
        Local speech to text (Phonon 2, push-to-talk in the Meta Agent composer) and text to speech (Pocket TTS,
        Qwen3-TTS 0.6B Base, Chatterbox Turbo). Each model installs on its own into the app-data folder below,
        outside the app install directory, on one shared private Python and CPU PyTorch. Qwen3-TTS downloads about
        2.5 GB of weights and is slower than Pocket. Chatterbox Turbo is English only and downloads about 3.0 GB.
        Windows x64 only in this release.
    </p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="error-banner" role="alert">@_error</div>
    }

    <div class="settings-page__panel panel">
        <ul class="voice-models">
            @foreach (var row in OrderedRows)
            {
                var id = row.RuntimeId;
                <li class="voice-model">
                    @if (row.IsInstalled)
                    {
                        <span class="voice-model__check" aria-hidden="true"></span>
                    }
                    else
                    {
                        <input id="voice-model-@id"
                               class="voice-model__check"
                               type="checkbox"
                               checked="@_selected.Contains(id)"
                               disabled="@_busy"
                               @onchange="e => Toggle(id, e.Value is true)" />
                    }
                    <label class="voice-model__name" for="voice-model-@id">@row.DisplayName</label>
                    <span class="voice-model__state">
                        @(row.Capability == DysonSpeechCapability.Input ? "Speech to text" : "Text to speech")
                        · @(row.IsInstalled ? "installed" : "not installed")
                    </span>
                    @if (row.IsInstalled)
                    {
                        <button type="button" class="btn btn-ghost voice-model__action" disabled="@_busy"
                                @onclick="() => UninstallModelAsync(row)">Uninstall</button>
                    }
                </li>
            }
        </ul>

        <ul class="settings-facts">
            <li class="settings-facts__row">
                <span class="settings-facts__label">Folder</span>
                <span class="settings-facts__value mono">@Installer.InstallRoot</span>
            </li>
        </ul>

        @if (!string.IsNullOrWhiteSpace(_probe?.Note) && !_busy && AnyInstalled)
        {
            <p class="settings-page__copy voice__note">@_probe.Note</p>
        }

        <div class="btn-row">
            <button type="button"
                    class="btn btn-primary"
                    disabled="@(_busy || _selected.Count == 0)"
                    aria-busy="@_installing"
                    @onclick="InstallAsync">
                @(_installing ? "Installing…" : "Install selected")
            </button>
            @if (_installing)
            {
                <button type="button" class="btn btn-ghost" @onclick="Cancel">Cancel</button>
            }
            else if (AnyInstalled)
            {
                <button type="button" class="btn btn-ghost" disabled="@_busy" @onclick="UninstallAsync">Uninstall everything</button>
            }
        </div>

        @if (_steps.Count > 0)
        {
            <ol class="voice-steps" aria-live="polite">
                @foreach (var id in DysonSpeechInstaller.StepIds)
                {
                    if (!_steps.TryGetValue(id, out var step))
                        continue;
                    <li class="voice-step voice-step--@step.State.ToString().ToLowerInvariant()">
                        <span class="voice-step__id mono">@id</span>
                        <span class="voice-step__state">@StateLabel(step)</span>
                        @if (!string.IsNullOrWhiteSpace(step.Detail))
                        {
                            <span class="voice-step__detail">@step.Detail</span>
                        }
                    </li>
                }
            </ol>
        }
    </div>

    @if (InstalledTts.Count > 0 || _activeError is not null)
    {
        <div class="settings-page__panel panel voice-active">
            <div class="tool-panel__title">Active text-to-speech</div>
            <div class="voice-active__options" role="radiogroup" aria-label="Active text-to-speech model">
                @foreach (var row in InstalledTts)
                {
                    var id = row.RuntimeId;
                    <label class="voice-active__option">
                        <input type="radio" name="voice-active" value="@id" checked="@(id == _activeId)"
                               disabled="@_busy" @onchange="() => SetActiveAsync(id)" />
                        <span>@row.DisplayName</span>
                    </label>
                }
                @if (StaleActive is { } stale)
                {
                    <label class="voice-active__option">
                        <input type="radio" name="voice-active" checked disabled />
                        <span>@stale (not installed)</span>
                    </label>
                }
            </div>
            @if (_activeError is not null)
            {
                <p class="settings-page__copy voice__note">@_activeError</p>
            }
        </div>
    }

    @if (ActiveRow is { SupportsVoicePrompt: true } active)
    {
        <div class="settings-page__panel panel voice-train">
            <div class="tool-panel__title">Train TTS model · @active.DisplayName</div>
            <p class="settings-page__copy">@TrainCopy(active.RuntimeId)</p>
            <InputFile accept=".mp3,audio/mpeg" OnChange="OnTrainFileAsync" disabled="@_busy" />
            @if (_training)
            {
                <p class="settings-page__copy voice__note" role="status">Making the voice…</p>
            }
            @if (!string.IsNullOrWhiteSpace(_trainResult))
            {
                <div class="@(_trainOk ? "voice-train__result" : "error-banner voice-train__result")" role="status">@_trainResult</div>
            }
        </div>
    }
</div>

@code {
    private readonly Dictionary<string, DysonSpeechInstallStep> _steps = [];
    private readonly HashSet<string> _selected = [];
    private List<DysonSpeechModelEntity> _rows = [];
    private DysonSpeechInstallStatus? _probe;
    private string? _activeId;
    private string? _activeSetting;
    private string? _activeError;
    private CancellationTokenSource? _cts;
    private bool _busy;
    private bool _installing;
    private bool _training;
    private bool _disposed;
    private string? _error;
    private string? _trainResult;
    private bool _trainOk;

    private IEnumerable<DysonSpeechModelEntity> OrderedRows =>
        _rows.OrderBy(r => DysonSpeechInstaller.ModelIds.Contains(r.RuntimeId)
            ? DysonSpeechInstaller.ModelIds.TakeWhile(id => id != r.RuntimeId).Count()
            : int.MaxValue);

    private List<DysonSpeechModelEntity> InstalledTts =>
        OrderedRows.Where(r => r.IsInstalled && r.IsEnabled && r.Capability.HasFlag(DysonSpeechCapability.Output)).ToList();

    private DysonSpeechModelEntity? ActiveRow => _rows.FirstOrDefault(r => r.RuntimeId == _activeId);

    /// <summary>The saved active model when it is no longer installed (shown, never silently replaced).</summary>
    private string? StaleActive => _activeId is null && !string.IsNullOrWhiteSpace(_activeSetting)
        ? _rows.FirstOrDefault(r => r.RuntimeId == _activeSetting)?.DisplayName ?? _activeSetting
        : null;

    private bool AnyInstalled => _rows.Any(r => r.IsInstalled) || _probe?.RuntimeInstalled == true;

    protected override async Task OnInitializedAsync()
    {
        var ensure = await SpeechModels.EnsureBuiltInAsync();
        if (ensure.IsError)
            _error = ensure.Error;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var list = await SpeechModels.ListAsync();
        if (list.IsError)
            _error = list.Error;
        else
            _rows = list.Value.ToList();
        _probe = await Installer.ProbeAsync();
        _selected.RemoveWhere(id => _rows.Any(r => r.RuntimeId == id && r.IsInstalled));

        var setting = await Settings.GetSettingAsync(DysonAppSettingKeys.SpeechOutputModelId);
        _activeSetting = setting.IsSuccess ? setting.Value : null;
        var active = await Tts.ResolveActiveAsync();
        _activeId = active.IsSuccess ? active.Value : null;
        var anyTts = _rows.Any(r => r.IsInstalled && r.Capability.HasFlag(DysonSpeechCapability.Output));
        _activeError = active.IsError && (anyTts || !string.IsNullOrWhiteSpace(_activeSetting)) ? active.Error : null;
    }

    private void Toggle(string id, bool on)
    {
        if (on)
            _selected.Add(id);
        else
            _selected.Remove(id);
    }

    private async Task InstallAsync()
    {
        _error = null;
        _trainResult = null;
        _steps.Clear();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _busy = _installing = true;
        try
        {
            await foreach (var step in Installer.InstallAsync(SpeechModels, Settings, _selected.ToList(), _cts.Token))
            {
                if (_disposed)
                    continue;
                _steps[step.StepId] = step;
                if (step.State == DysonSpeechStepState.Failed)
                    _error = step.Detail;
                StateHasChanged();
            }
        }
        finally
        {
            _busy = _installing = false;
            if (!_disposed)
                await ReloadAsync();
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task UninstallModelAsync(DysonSpeechModelEntity row)
    {
        var ok = await ConfirmDialog.ConfirmAsync(
            $"Uninstall {row.DisplayName}",
            $"Delete {row.DisplayName} files? Python, torch and other models stay.",
            confirmLabel: "Uninstall");
        if (!ok)
            return;

        await RunAsync(() => Installer.UninstallModelAsync(SpeechModels, row.RuntimeId));
    }

    private async Task UninstallAsync()
    {
        var ok = await ConfirmDialog.ConfirmAsync(
            "Uninstall everything",
            $"Delete {Installer.InstallRoot} (Python, torch, every model, and voices)? Install selected downloads it again.",
            confirmLabel: "Uninstall");
        if (!ok)
            return;

        await RunAsync(() => Installer.UninstallAsync(SpeechModels));
    }

    private async Task SetActiveAsync(string id) => await RunAsync(() => Tts.SetActiveAsync(id));

    private async Task RunAsync(Func<Task<VoidResult<string>>> action)
    {
        _error = null;
        _trainResult = null;
        _busy = true;
        try
        {
            var result = await action();
            if (result.IsError)
                _error = result.Error;
            _steps.Clear();
        }
        finally
        {
            _busy = false;
            await ReloadAsync();
        }
    }

    private async Task OnTrainFileAsync(InputFileChangeEventArgs e)
    {
        _trainResult = null;
        _busy = _training = true;
        try
        {
            var file = e.File;
            await using var clip = file.OpenReadStream(DysonPhononSpeech.MaxAudioBytes);
            var result = await Tts.PrepareVoiceAsync(clip, file.Name);
            _trainOk = result.IsSuccess;
            _trainResult = result.IsError ? result.Error : $"Voice {result.Value.DisplayName} saved and selected.";
        }
        finally
        {
            _busy = _training = false;
        }
    }

    private static string TrainCopy(string runtimeId) => runtimeId switch
    {
        DysonQwenSpeech.Id =>
            "Qwen3-TTS makes a voice from one short .mp3 of clear speech (about 5–15 s). This saves a speaker embedding "
            + "(voice prompt); it does not retrain the model. The clip is not kept.",
        DysonChatterboxSpeech.Id =>
            "Chatterbox Turbo (English only) makes a voice from one .mp3 of clear English speech longer than 5 seconds "
            + "(it uses up to 15 s). This saves a voice prompt (speaker embedding and speech tokens); it does not retrain "
            + "the model. The clip is not kept. Output carries Resemble's Perth watermark.",
        _ =>
            "Pocket TTS takes one .mp3 clip. The installed public weights cannot make a voice from audio, "
            + "so this reports why and saves nothing; speech keeps using the alba voice.",
    };

    private static string StateLabel(DysonSpeechInstallStep step) => step.State switch
    {
        DysonSpeechStepState.Done => "done",
        DysonSpeechStepState.Failed => "failed",
        _ when step.Download is { } d && d.TotalBytes is > 0 =>
            $"{FormatBytes(d.BytesReceived)} / {FormatBytes(d.TotalBytes.Value)} ({(d.Fraction ?? 0) * 100:0}%)",
        _ => "running…",
    };

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 * 1024 => $"{bytes / 1024.0:0.0} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.0} MB",
        _ => $"{bytes / (1024.0 * 1024.0 * 1024.0):0.00} GB",
    };

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
