    {
        "pocket-tts" =>
            "Pocket TTS GGUF clones a voice from one short .wav clip (enrollment, not a fine-tune). "
            + "The safetensors Pocket install cannot clone. Output keeps CrispASR's AI watermark.",
        "qwen3-tts" =>
            "Qwen3-TTS GGUF clones a voice from one .wav clip plus its exact transcript "
            + "(in-context voice prompt, not a fine-tune). Output keeps CrispASR's AI watermark.",
        "chatterbox-turbo" =>
            "Chatterbox Turbo GGUF clones a voice from one .wav clip (enrollment, not a fine-tune). "
            + "Output keeps CrispASR's AI watermark.",
        _ => runtimeId switch
        {
            DysonQwenSpeech.Id =>
                "Qwen3-TTS makes a voice from one short clip of clear speech (about 5\u201315 s): Record 10 seconds, or one .mp3. "
                + "This saves a speaker embedding (voice prompt); it does not retrain the model. The clip is not kept.",
            DysonChatterboxSpeech.Id =>
                "Chatterbox Turbo (English only) makes a voice from one .mp3 of clear English speech longer than 5 seconds "
                + "(it uses up to 15 s). This saves a voice prompt (speaker embedding and speech tokens); it does not retrain "
                + "the model. The clip is not kept. Output carries Resemble's Perth watermark.",
            _ =>
                "Pocket TTS takes one .mp3 clip. The installed public weights cannot make a voice from audio, "
                + "so this reports why and saves nothing; speech keeps using the alba voice.",
        },
    };


    private static string StateLabel(DysonSpeechInstallStep step) => step.State switch
    {
        DysonSpeechStepState.Done => "done",
        DysonSpeechStepState.Failed => "failed",
        _ when step.Download is { } d && d.TotalBytes is > 0 =>
            $"{FormatBytes(d.BytesReceived)} / {FormatBytes(d.TotalBytes.Value)} ({(d.Fraction ?? 0) * 100:0}%)",
        _ => "running…",
    };

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 * 1024 => $"{bytes / 1024.0:0.0} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.0} MB",
        _ => $"{bytes / (1024.0 * 1024.0 * 1024.0):0.00} GB",
    };

    private async Task LoadMicsAsync()
    {
        var listed = await _tryout!.ListMicrophonesAsync();
        if (listed.IsError)
        {
            _micNote = listed.Error;
            _mics = [];
            _micId = null;
            return;
        }

        _mics = listed.Value.ToList();
        var saved = await Settings.GetSettingAsync(DysonAppSettingKeys.SpeechInputDeviceId);
        var savedId = saved.IsSuccess ? saved.Value : null;
        if (string.IsNullOrWhiteSpace(savedId))
        {
            var first = DysonSpeechInputDevice.Resolve(_mics, null);
            _micId = first.IsSuccess ? first.Value.Id : null;
            _micNote = first.IsError ? first.Error : null;
            return;
        }

        var resolved = DysonSpeechInputDevice.Resolve(_mics, savedId);
        if (resolved.IsError)
        {
            _micId = null;
            _micNote = resolved.Error;
            return;
        }

        _micId = resolved.Value.Id;
        _micNote = null;
    }

    private async Task OnMicChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(id))
            return;
        var saved = await DysonSpeechInputDevice.SaveAsync(Settings, _mics, id);
        if (saved.IsError)
        {
            _error = saved.Error;
            return;
        }

        _micId = id;
        _micNote = null;
    }

    private async Task PlaySpeechAsync()
    {
        if (_tryout is null || _disposed)
            return;
        _error = null;
        var generation = ++_playGeneration;
        _playing = true;
        try
        {
            var result = await _tryout.PlayAsync(_speakText, outputInstalled: _activeId is not null, CancellationToken.None);
            if (_disposed || generation != _playGeneration)
                return;
            if (result.IsError)
                _error = result.Error;
        }
        finally
        {
            if (generation == _playGeneration)
                _playing = false;
        }
    }

    private async Task ToggleRecordAsync()
    {
        if (_tryout is null || _disposed)
            return;
        if (_recording)
        {
            _recordCts?.Cancel();
            _tryout.StopRecording();
            return;
        }

        _error = null;
        _transcript = "";
        _recordCts?.Dispose();
        _recordCts = new CancellationTokenSource();
        _recording = true;
        try
        {
            await foreach (var update in _tryout.RecordAsync(_micId, _inputId is not null, _recordCts.Token))
            {
                if (_disposed)
                    return;
                if (update.IsError)
                {
                    _error = update.Error;
                    break;
                }

                _transcript = update.Value;
                StateHasChanged();
            }
        }
        finally
        {
            _recording = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _recordCts?.Cancel();
        _recordCts?.Dispose();
        _trainCountdownCts?.Cancel();
        _trainCountdownCts?.Dispose();
        _tryout?.StopPlayback();
        _tryout?.StopRecording();
    }
}
