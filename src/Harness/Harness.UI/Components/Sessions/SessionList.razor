@namespace Harness.UI.Components.Sessions
@using DysonHarness
@using Harness.UI.Demo
@using Harness.UI.Services
@inject ConfirmDialogService ConfirmDialog
@inject DysonUiHost Host

<div class="session-list">
    <div class="session-list__header">
        <div class="sidebar__section-label">Sessions</div>
        <button type="button"
                class="btn btn-ghost btn-icon session-list__clear"
                title="Delete inactive sessions"
                aria-label="Delete inactive sessions"
                disabled="@(!HasDeletableSessions)"
                @onclick="OnDeleteInactiveClickAsync">
            <img src="icons/trash.svg" alt="" />
        </button>
    </div>
    <div class="btn-row" style="margin-bottom:8px;">
        <button type="button"
                class="btn btn-primary btn-icon"
                title="New session"
                aria-label="New session"
                @onclick="OnNewAsync">
            <img src="icons/plus.svg" alt="" />
        </button>
        <button type="button"
                class="btn btn-ghost btn-icon"
                title="Refresh"
                aria-label="Refresh"
                @onclick="OnRefreshAsync">
            <img src="icons/refresh.svg" alt="" />
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="error-banner" style="margin:0 0 8px;">@Error</div>
    }

    <div class="list">
        @if (Sessions.Count == 0)
        {
            <div class="empty-state" style="padding:12px 4px;">No sessions yet</div>
        }
        else
        {
            @foreach (var session in Sessions)
            {
                var active = session.Id == ActiveSessionId;
                var title = session.Title ?? "Untitled";
                <div class="list-item @(active ? "is-active" : null)">
                    <button type="button"
                            class="list-item__main"
                            @onclick="() => OnResumeAsync(session.Id)">
                        <span class="list-item__title">
                            @if (Host.IsSessionBusy(session.Id))
                            {
                                <span class="turn-block__spinner" aria-hidden="true"></span>
                            }
                            @title
                        </span>
                        <span class="list-item__meta mono">
                            @session.AgentMode · @session.Status · @session.LastActivityUtc.ToLocalTime().ToString("g")
                        </span>
                    </button>
                    <button type="button"
                            class="btn btn-ghost btn-icon list-item__delete"
                            title="Delete session"
                            aria-label="Delete @title"
                            @onclick="() => OnDeleteClickAsync(session.Id, title)"
                            @onclick:stopPropagation="true">
                        <img src="icons/trash.svg" alt="" />
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<DysonSessionSummary> Sessions { get; set; } = [];
    [Parameter] public Guid? ActiveSessionId { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback<Guid> OnResume { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback OnDeleteInactive { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool HasDeletableSessions =>
        Sessions.Any(s =>
            s.ParentSessionId is null
            && s.Id != ActiveSessionId
            && (DysonSessionInactiveDelete.IsDead(s.Status) || !Host.IsSessionBusy(s.Id)));

    private Task OnNewAsync() => OnNew.InvokeAsync();

    private Task OnResumeAsync(Guid id) => OnResume.InvokeAsync(id);

    private Task OnRefreshAsync() => OnRefresh.InvokeAsync();

    private async Task OnDeleteClickAsync(Guid id, string title)
    {
        var ok = await ConfirmDialog.ConfirmAsync(
            title: "Delete session",
            message: $"Delete session '{title}'? This removes the session and its history. This cannot be undone.",
            confirmLabel: "Delete",
            cancelLabel: "Cancel",
            danger: true);
        if (ok)
            await OnDelete.InvokeAsync(id);
    }

    private async Task OnDeleteInactiveClickAsync()
    {
        var ok = await ConfirmDialog.ConfirmAsync(
            title: "Delete inactive sessions",
            message: "Delete all sessions in this work directory that are not running? The current session and any session that is still working (including idle parents with running subagents) will be kept. This cannot be undone.",
            confirmLabel: "Delete",
            cancelLabel: "Cancel",
            danger: true);
        if (ok)
            await OnDeleteInactive.InvokeAsync();
    }
}
