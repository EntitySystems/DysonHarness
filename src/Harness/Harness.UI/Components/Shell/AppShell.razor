@namespace Harness.UI.Components.Shell
@inject IJSRuntime Js
@inject IDysonSubjectSettingsRepository AppSettings
@implements IAsyncDisposable

<CascadingValue Value="this" IsFixed="true">
    <div class="@ShellClass">
        <aside id="app-shell-sidebar"
               class="app-shell__sidebar"
               aria-label="Sidebar">
            @Sidebar
        </aside>
        <main class="app-shell__main">
            @Main
        </main>
        @if (ShowRailBackdrop)
        {
            <div class="app-shell__rail-backdrop"
                 tabindex="-1"
                 @onclick="CloseRail"
                 @onkeydown="OnBackdropKeyDown"></div>
        }
        <aside id="app-shell-rail"
               class="app-shell__rail"
               aria-hidden="@(!RailOpen)">
            @Rail
        </aside>
    </div>
</CascadingValue>

@code {
    /// <summary>Viewport width at/below which the rail is a closed-by-default drawer.</summary>
    public const int NarrowBreakpointPx = 1100;

    [Parameter] public RenderFragment? Sidebar { get; set; }
    [Parameter] public RenderFragment? Main { get; set; }
    [Parameter] public RenderFragment? Rail { get; set; }

    private bool _railOpen = true;
    private bool _sidebarOpen = true;
    /// <summary>Last loaded/saved rail preference; used when leaving the narrow drawer.</summary>
    private bool _savedRailOpen = true;
    private bool _hydrated;
    private bool _narrow;
    private DotNetObjectReference<AppShell>? _selfRef;
    private IJSObjectReference? _viewport;

    public bool RailOpen => _railOpen;

    public bool SidebarOpen => _sidebarOpen;

    public bool IsNarrow => _narrow;

    private bool ShowRailBackdrop => _hydrated && _narrow && _railOpen;

    private string ShellClass
    {
        get
        {
            var css = "app-shell";
            if (_hydrated)
                css += " app-shell--rail-hydrated";
            css += _railOpen ? " app-shell--rail-open" : " app-shell--rail-closed";
            css += _sidebarOpen ? " app-shell--sidebar-open" : " app-shell--sidebar-collapsed";
            return css;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydrated)
            return;

        try
        {
            _narrow = await Js.InvokeAsync<bool>("dysonUi.isNarrow", NarrowBreakpointPx);
            await LoadChromePrefsAsync();
            // Desktop: restore saved rail. Narrow: closed drawer (avoid overlay flash).
            _railOpen = _narrow ? false : _savedRailOpen;
            _selfRef = DotNetObjectReference.Create(this);
            _viewport = await Js.InvokeAsync<IJSObjectReference>(
                "dysonUi.watchNarrow",
                NarrowBreakpointPx,
                _selfRef);
        }
        catch (JSException)
        {
            // Keep desktop-expanded defaults if JS is unavailable.
            _narrow = false;
            await LoadChromePrefsAsync();
            _railOpen = _savedRailOpen;
        }

        _hydrated = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnNarrowChanged(bool narrow)
    {
        if (_narrow == narrow)
            return;

        _narrow = narrow;
        if (narrow)
        {
            // Drawer default: close without overwriting the saved desktop preference.
            _railOpen = false;
        }
        else
        {
            _railOpen = _savedRailOpen;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void ToggleRail()
    {
        _railOpen = !_railOpen;
        _savedRailOpen = _railOpen;
        _ = PersistBoolSettingAsync(DysonAppSettingKeys.UiRailOpen, _railOpen);
        _ = InvokeAsync(StateHasChanged);
    }

    public void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
        _ = PersistBoolSettingAsync(DysonAppSettingKeys.UiSidebarOpen, _sidebarOpen);
        _ = InvokeAsync(StateHasChanged);
    }

    public void CloseRail()
    {
        if (!_railOpen)
            return;
        _railOpen = false;
        _savedRailOpen = false;
        _ = PersistBoolSettingAsync(DysonAppSettingKeys.UiRailOpen, false);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadChromePrefsAsync()
    {
        var rail = await AppSettings.GetSettingAsync(DysonAppSettingKeys.UiRailOpen);
        if (!rail.IsError)
            _savedRailOpen = ParseBoolSetting(rail.Value, defaultValue: true);

        var sidebar = await AppSettings.GetSettingAsync(DysonAppSettingKeys.UiSidebarOpen);
        if (!sidebar.IsError)
            _sidebarOpen = ParseBoolSetting(sidebar.Value, defaultValue: true);
    }

    private async Task PersistBoolSettingAsync(string key, bool value)
    {
        await AppSettings.SetSettingAsync(key, value ? "true" : "false");
    }

    private static bool ParseBoolSetting(string? value, bool defaultValue) =>
        string.IsNullOrWhiteSpace(value)
            ? defaultValue
            : string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);

    private void OnBackdropKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseRail();
    }

    public async ValueTask DisposeAsync()
    {
        if (_viewport is not null)
        {
            try { await _viewport.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            try { await _viewport.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            _viewport = null;
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
