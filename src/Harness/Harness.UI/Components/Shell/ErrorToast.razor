@namespace Harness.UI.Components.Shell
@implements IDisposable
@inject DysonUiHost Host

<div class="error-banner error-banner--toast dyson-fade @MotionClass" role="alert">
    <span class="error-banner__text">@Message</span>
    <button type="button"
            class="error-banner__dismiss"
            title="Dismiss"
            aria-label="Dismiss error"
            @onclick="Dismiss">
        <img class="error-banner__dismiss-icon" src="icons/cancel.svg" alt="" />
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Message { get; set; } = "";

    /// <summary>DysonTransition state class — the owner gates this component, so it cannot self-animate.</summary>
    [Parameter] public string? MotionClass { get; set; }

    /// <summary>
    /// Page-owned error (Meta <c>_error</c>). When it matches <see cref="Message"/>, dismiss and
    /// expiry clear it instead of <see cref="DysonUiHost.LastError"/>. Home leaves this unset.
    /// </summary>
    [Parameter] public string? PageError { get; set; }

    [Parameter] public EventCallback OnPageErrorCleared { get; set; }

    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _ = ExpireAsync(_cts.Token);
    }

    private async Task ExpireAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(ErrorToastLifetime.Duration, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(Clear);
    }

    private void Dismiss() => Clear();

    private void Clear()
    {
        if (string.Equals(PageError, Message, StringComparison.Ordinal))
        {
            _ = OnPageErrorCleared.InvokeAsync();
            return;
        }

        if (string.Equals(Host.LastError, Message, StringComparison.Ordinal))
            Host.ClearLastError();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
