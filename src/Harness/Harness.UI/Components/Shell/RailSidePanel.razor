@namespace Harness.UI.Components.Shell
@using DysonHarness
@using Harness.UI.Components.Files
@using Harness.UI.Files
@inject DysonFileTreeService FileTree
@inject DysonGitChangesService GitChanges
@inject IDysonSubjectContext Subject

<div class="tool-panel rail-tabs">
    <div class="rail-tabs__tabs" role="tablist" aria-label="Rail panels">
        <button type="button"
                role="tab"
                class="rail-tabs__tab@(_activeTab == RailTab.Files ? " rail-tabs__tab--active" : null)"
                aria-selected="@(_activeTab == RailTab.Files)"
                @onclick="() => Select(RailTab.Files)">
            Files
        </button>
        <button type="button"
                role="tab"
                class="rail-tabs__tab@(_activeTab == RailTab.Git ? " rail-tabs__tab--active" : null)"
                aria-selected="@(_activeTab == RailTab.Git)"
                @onclick="() => Select(RailTab.Git)">
            Git
        </button>
        <button type="button"
                role="tab"
                class="rail-tabs__tab@(_activeTab == RailTab.Usage ? " rail-tabs__tab--active" : null)"
                aria-selected="@(_activeTab == RailTab.Usage)"
                @onclick="() => Select(RailTab.Usage)">
            Usage
        </button>
    </div>
    <div class="rail-tabs__body@(BodyModifierClass)" role="tabpanel">
        @if (_activeTab == RailTab.Files)
        {
            <FileTreePanel ActiveWorkDirectoryId="ActiveWorkDirectoryId" ActiveWorkRootPath="ActiveWorkRootPath" />
        }
        else if (_activeTab == RailTab.Git)
        {
            <GitChangesPanel ActiveWorkDirectoryId="ActiveWorkDirectoryId" />
        }
        else
        {
            <UsagePanel ActiveSessionId="ActiveSessionId" />
        }
    </div>
</div>

@code {
    private enum RailTab
    {
        Files,
        Git,
        Usage,
    }

    private RailTab _activeTab = RailTab.Files;
    private Guid? _boundWorkDirectoryId;
    private string? _boundWorkRootPath;

    [Parameter] public Guid? ActiveWorkDirectoryId { get; set; }
    [Parameter] public Guid? ActiveSessionId { get; set; }
    [Parameter] public string? ActiveWorkRootPath { get; set; }

    private string? BodyModifierClass => _activeTab switch
    {
        RailTab.Files => " rail-tabs__body--files",
        RailTab.Git => " rail-tabs__body--git",
        RailTab.Usage => " rail-tabs__body--usage",
        _ => null,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_boundWorkDirectoryId == ActiveWorkDirectoryId
            && DysonWorkspaceRootKey.SamePath(_boundWorkRootPath, ActiveWorkRootPath)
            && FileTree.Active?.WorkDirectoryId == ActiveWorkDirectoryId
            && DysonWorkspaceRootKey.SamePath(FileTree.Active?.AbsolutePath, ActiveWorkRootPath))
        {
            return;
        }

        _boundWorkDirectoryId = ActiveWorkDirectoryId;
        _boundWorkRootPath = ActiveWorkRootPath;
        // Always keep the workdir watcher + git status alive regardless of active tab.
        // Home already activates with the session path; skip the duplicate refresh when it matches.
        if (ActiveWorkDirectoryId is Guid id && !string.IsNullOrWhiteSpace(ActiveWorkRootPath))
        {
            if (FileTree.Active is not { } tree
                || tree.WorkDirectoryId != id
                || !DysonWorkspaceRootKey.SamePath(tree.AbsolutePath, ActiveWorkRootPath))
            {
                await FileTree.SetActiveAsync(id, ActiveWorkRootPath);
            }

            if (GitChanges.Active is not { } git
                || git.WorkDirectoryId != id
                || !DysonWorkspaceRootKey.SamePath(git.WorkAbsolutePath, ActiveWorkRootPath))
            {
                await GitChanges.SetActiveAsync(id, ActiveWorkRootPath);
            }
        }
        else
        {
            if (FileTree.Active?.WorkDirectoryId != ActiveWorkDirectoryId)
                await FileTree.SetActiveAsync(ActiveWorkDirectoryId, Subject.SubjectId);
            if (GitChanges.Active?.WorkDirectoryId != ActiveWorkDirectoryId)
                await GitChanges.SetActiveAsync(ActiveWorkDirectoryId, Subject.SubjectId);
        }
    }

    private void Select(RailTab tab) => _activeTab = tab;
}
