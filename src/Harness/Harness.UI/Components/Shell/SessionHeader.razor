@namespace Harness.UI.Components.Shell
@using DysonHarness
@using Harness.UI.Files
@implements IDisposable
@inject DysonUiHost Host
@inject DysonFileTreeService FileTree

<div class="session-header">
    @if (Session is null)
    {
        <span class="empty-state" style="padding:0;text-align:left;">No active session</span>
    }
    else
    {
        @if (ShowBackToParent)
        {
            <button type="button"
                    class="btn btn-ghost session-header__back"
                    title="Back to parent session"
                    @onclick="OnBackToParent">
                ← Parent
            </button>
        }
        <strong>@(Title ?? Session.DisplayTitle ?? "Session")</strong>
        <div class="session-header__meta">
            <span>Mode @Session.Mode</span>
            @if (!string.IsNullOrEmpty(GitBranch))
            {
                <span class="mono" title="Active work directory branch">⎇ @GitBranch</span>
            }
            <button type="button"
                    class="session-header__meta-pill"
                    title="Long-running shells in this work directory"
                    @onclick="OpenShellsModal">
                Shells @Host.LongRunningShellRunningCount
            </button>
            <div class="session-header__tools @(_toolsMenuOpen ? "is-open" : null)">
                <button type="button"
                        class="session-header__meta-pill @(_toolsMenuOpen ? "is-open" : null)"
                        title="Tools"
                        aria-haspopup="menu"
                        aria-expanded="@_toolsMenuOpen"
                        @onclick="ToggleToolsMenu"
                        @onclick:stopPropagation="true">
                    Tools ▾
                </button>
                @if (_toolsMenuOpen)
                {
                    <div class="session-header__tools-menu"
                         role="menu"
                         aria-label="Tools"
                         @onclick:stopPropagation="true">
                        <button type="button"
                                class="session-header__tools-menu-item"
                                role="menuitem"
                                @onclick="ClearComposerUploadsAsync">
                            Clear composer uploads
                        </button>
                        @if (Host.IsBrowserControlAvailable)
                        {
                            <button type="button"
                                    class="session-header__tools-menu-item"
                                    role="menuitem"
                                    @onclick="OpenBrowserAsync">
                                Open Browser
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (Shell is not null)
    {
        <button type="button"
                class="session-header__rail-toggle btn btn-icon btn-ghost @(Shell.RailOpen ? "is-open" : null)"
                title="@(Shell.RailOpen ? "Collapse panel" : "Expand panel")"
                aria-label="@(Shell.RailOpen ? "Collapse files and git panel" : "Expand files and git panel")"
                aria-controls="app-shell-rail"
                aria-expanded="@Shell.RailOpen"
                @onclick="ToggleRail">
            <svg class="session-header__rail-icon"
                 viewBox="0 0 16 16"
                 width="16"
                 height="16"
                 aria-hidden="true"
                 focusable="false">
                <rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5"
                      fill="none" stroke="currentColor" stroke-width="1.25" />
                <path d="M6.25 2.25v11.5"
                      fill="none" stroke="currentColor" stroke-width="1.25" />
                <path d="M10.25 5.75 8 8l2.25 2.25"
                      fill="none" stroke="currentColor" stroke-width="1.25"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    }
</div>

@if (_toolsMenuOpen)
{
    <div class="session-header__tools-backdrop"
         tabindex="-1"
         @onclick="CloseToolsMenu"
         @onkeydown="OnToolsBackdropKeyDown"></div>
}

@if (Host.LongRunningShellsModalOpen)
{
    <div class="shells-modal-backdrop"
         @onclick="CloseShellsModal">
        <div class="shells-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="shells-modal-title"
             @onclick:stopPropagation="true">
            <div class="shells-modal__header">
                <h3 id="shells-modal-title">
                    @if (Host.SelectedLongRunningShellId is int selectedId)
                    {
                        <text>Shell #@selectedId</text>
                    }
                    else
                    {
                        <text>Long-running shells</text>
                    }
                </h3>
                <div class="shells-modal__header-actions">
                    @if (Host.SelectedLongRunningShellId is not null)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="BackToList">← List</button>
                    }
                    <button type="button" class="btn btn-ghost shells-modal__close" @onclick="CloseShellsModal" aria-label="Close">×</button>
                </div>
            </div>

            @if (Host.SelectedLongRunningShellId is int shellId)
            {
                var info = Host.ListLongRunningShells().FirstOrDefault(s => s.Id == shellId);
                <div class="shells-modal__log-meta">
                    <span class="mono">@info?.Status</span>
                    @if (info?.ExitCode is int exitCode)
                    {
                        <span class="mono">exit @exitCode</span>
                    }
                    <span class="mono" title="@info?.Command">@ShortCommand(info?.Command)</span>
                    @if (info is not null
                         && info.Status is DysonLongRunningShellStatus.Running or DysonLongRunningShellStatus.CancelRequested)
                    {
                        <button type="button" class="btn btn-ghost shells-modal__force-stop" @onclick="() => ForceStopAsync(shellId)">Force stop</button>
                    }
                </div>
                <pre class="shells-modal__log mono">@(_logText ?? "(no output)")</pre>
            }
            else
            {
                var shells = Host.ListLongRunningShells();
                <div class="shells-modal__list" role="listbox">
                    @if (shells.Count == 0)
                    {
                        <div class="shells-modal__empty">No long-running shells in this work directory.</div>
                    }
                    else
                    {
                        @foreach (var shell in shells)
                        {
                            <button type="button"
                                    class="shells-modal__row"
                                    role="option"
                                    @onclick="() => SelectShellAsync(shell.Id)">
                                <span class="mono shells-modal__id">#@shell.Id</span>
                                <span class="shells-modal__status">@shell.Status</span>
                                <span class="mono shells-modal__cmd" title="@shell.Command">@ShortCommand(shell.Command)</span>
                            </button>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] public AppShell? Shell { get; set; }

    [Parameter] public DysonAgentSession? Session { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? GitBranch { get; set; }
    [Parameter] public bool ShowBackToParent { get; set; }
    [Parameter] public EventCallback OnBackToParent { get; set; }

    private string? _logText;
    private CancellationTokenSource? _pollCts;
    private bool _hostHooked;
    private bool _toolsMenuOpen;

    private void ToggleRail() => Shell?.ToggleRail();

    protected override void OnInitialized()
    {
        Host.Changed += OnHostChanged;
        _hostHooked = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Host.LongRunningShellsModalOpen && Host.SelectedLongRunningShellId is not null)
            await RefreshLogAsync();
    }

    private void OnHostChanged() => _ = InvokeAsync(StateHasChanged);

    private void OpenShellsModal() => Host.OpenLongRunningShellsModal();

    private void CloseShellsModal()
    {
        StopPoll();
        Host.CloseLongRunningShellsModal();
        _logText = null;
    }

    private void ToggleToolsMenu() => _toolsMenuOpen = !_toolsMenuOpen;

    private void CloseToolsMenu() => _toolsMenuOpen = false;

    private void OnToolsBackdropKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseToolsMenu();
    }

    private async Task OpenBrowserAsync()
    {
        await Host.OpenBrowserAsync();
        if (Host.LastError is null)
            CloseToolsMenu();
    }

    private async Task ClearComposerUploadsAsync()
    {
        var cleared = await Host.ClearComposerUploadsAsync();
        if (cleared.IsError)
            return;

        await FileTree.InvalidateDirectoryAsync(DysonComposerUploads.RelativeDirectory);
        CloseToolsMenu();
    }

    private void BackToList()
    {
        StopPoll();
        Host.SelectLongRunningShell(null);
        _logText = null;
    }

    private async Task SelectShellAsync(int id)
    {
        Host.SelectLongRunningShell(id);
        await RefreshLogAsync();
        StartPoll();
    }

    private async Task ForceStopAsync(int id)
    {
        await Host.AbortLongRunningShellAsync(id);
        await RefreshLogAsync();
    }

    private async Task RefreshLogAsync()
    {
        if (Host.SelectedLongRunningShellId is null)
            return;
        _logText = await Host.ReadSelectedLongRunningShellTailAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void StartPoll()
    {
        StopPoll();
        // ponytail: 500ms UI poll while log pane open; upgrade to buffer-append events if needed.
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(500, token);
                    if (token.IsCancellationRequested)
                        break;
                    await InvokeAsync(RefreshLogAsync);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        }, token);
    }

    private void StopPoll()
    {
        try { _pollCts?.Cancel(); } catch { /* ignore */ }
        try { _pollCts?.Dispose(); } catch { /* ignore */ }
        _pollCts = null;
    }

    public void Dispose()
    {
        StopPoll();
        if (_hostHooked)
        {
            Host.Changed -= OnHostChanged;
            _hostHooked = false;
        }
    }

    private static string ShortCommand(string? command)
    {
        if (string.IsNullOrWhiteSpace(command))
            return "—";
        var line = command.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n')[0].Trim();
        return line.Length <= 64 ? line : line[..61] + "…";
    }
}
