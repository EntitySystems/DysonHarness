@namespace Harness.UI.Components.Shell
@using Harness.UI.Services

<div class="sidebar__brand">
    <div class="sidebar__brand-start">
        <div class="sidebar__title">DysonHarness</div>
        @if (_channelBadge is not null)
        {
            <span class="badge mono">@_channelBadge</span>
        }
    </div>
    @if (Shell is not null)
    {
        <button type="button"
                class="sidebar__collapse-toggle btn btn-icon btn-ghost"
                title="@(Shell.SidebarOpen ? "Collapse sidebar" : "Expand sidebar")"
                aria-label="@(Shell.SidebarOpen ? "Collapse sidebar" : "Expand sidebar")"
                aria-controls="app-shell-sidebar"
                aria-expanded="@Shell.SidebarOpen"
                @onclick="ToggleSidebar">
            <svg class="sidebar__collapse-icon"
                 viewBox="0 0 16 16"
                 width="16"
                 height="16"
                 aria-hidden="true"
                 focusable="false">
                <rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5"
                      fill="none" stroke="currentColor" stroke-width="1.25" />
                <path d="M6.25 2.25v11.5"
                      fill="none" stroke="currentColor" stroke-width="1.25" />
                <path d="M10.25 5.75 8 8l2.25 2.25"
                      fill="none" stroke="currentColor" stroke-width="1.25"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    }
</div>

<div class="sidebar__section">
    @WorkDirectory
</div>

<div class="sidebar__section sidebar__section--sessions">
    @SessionList
</div>

<div class="sidebar__footer">
    <a class="sidebar__settings-link" href="/settings/general">Settings</a>
</div>

@code {
    [CascadingParameter] public AppShell? Shell { get; set; }
    [Parameter] public RenderFragment? WorkDirectory { get; set; }
    [Parameter] public RenderFragment? SessionList { get; set; }

    private readonly string? _channelBadge = DysonAppVersionInfo.Local.ChannelBadge;

    private void ToggleSidebar() => Shell?.ToggleSidebar();
}
