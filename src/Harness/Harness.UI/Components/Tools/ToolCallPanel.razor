@namespace Harness.UI.Components.Tools
@using DysonHarness

<div class="tool-panel" style="padding:0;">
    <div class="tool-panel__title">Tools</div>
    @foreach (var row in Rows)
    {
        <ToolCallRow @key="row.Call"
                     Tracked="row"
                     SessionBusy="SessionBusy"
                     IsLatestTurn="IsLatestTurn"
                     OnCancel="OnCancel" />
    }
</div>

@code {
    [Parameter, EditorRequired] public DysonAgentTurn Turn { get; set; } = default!;

    /// <summary>True while the host is running a prompt on the active session.</summary>
    [Parameter] public bool SessionBusy { get; set; }

    /// <summary>True when this turn is the latest in the transcript.</summary>
    [Parameter] public bool IsLatestTurn { get; set; }

    /// <summary>Cancels the in-flight prompt (wired only for the latest busy turn).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// One row list for both phases: tracked rows once the engine has them, otherwise Queued
    /// placeholders over <see cref="DysonAgentTurn.ToolCalls"/>. Keyed on the shared
    /// <see cref="DysonToolCall"/> instance (CallId may be empty), so the swap to real tracked rows
    /// reuses the same <c>ToolCallRow</c> DOM instead of remounting and re-firing the enter animation.
    /// </summary>
    private IReadOnlyList<DysonTrackedToolCall> Rows => Turn.TrackedToolCalls.Count > 0
        ? Turn.TrackedToolCalls
        : [.. Turn.ToolCalls.Select(call => new DysonTrackedToolCall { Call = call })];
}
