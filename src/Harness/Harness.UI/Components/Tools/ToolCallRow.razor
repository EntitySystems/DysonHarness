@namespace Harness.UI.Components.Tools
@using DysonHarness
@using Harness.UI.Components.Tools.Variants
@using Harness.UI.Demo

<div class="tool-row @(_expanded ? "tool-row--expanded" : null)">
    <button type="button"
            class="tool-row__header"
            aria-expanded="@(_expanded ? "true" : "false")"
            @onclick="ToggleExpanded">
        <span class="tool-row__lead">
            <span class="tool-row__name mono">@Tracked.Call.ToolName</span>
            @if (_summary.HasLineDelta)
            {
                <span class="tool-row__summary">
                    @if (_summary.LinesAdded is int added)
                    {
                        <span class="tool-delta tool-delta--add">+@added</span>
                    }
                    @if (_summary.LinesRemoved is int removed)
                    {
                        <span class="tool-delta tool-delta--del">−@removed</span>
                    }
                </span>
            }
            else if (!string.IsNullOrEmpty(_summary.Text))
            {
                <span class="tool-row__summary mono">@_summary.Text</span>
            }
        </span>
        <span class="tool-status @StatusClass" data-status-short="@StatusShort">@Tracked.Status</span>
    </button>
    @if (_expanded)
    {
        <div class="tool-row__body">
            @if (Tracked.Status == DysonToolCallStatus.Working && CanCancel)
            {
                <button type="button"
                        class="turn-block__cancel"
                        title="Cancel"
                        aria-label="Cancel prompt"
                        @onclick:stopPropagation="true"
                        @onclick="HandleCancelAsync">
                    <span class="turn-block__spinner" aria-hidden="true"></span>
                    <img class="turn-block__cancel-icon" src="icons/cancel.svg" alt="" />
                </button>
            }
            <ToolCallExpandedBody ToolName="@Tracked.Call.ToolName"
                                  CallId="@Tracked.Call.CallId"
                                  Stage="@Tracked.Call.Stage"
                                  ArgumentsJson="@Tracked.Call.ArgumentsJson"
                                  ResultContent="@(Tracked.Result?.Content)"
                                  BinaryAttachment="@(Tracked.Result?.BinaryAttachment)"
                                  IsError="@(Tracked.Result?.IsError == true || Tracked.Status == DysonToolCallStatus.Failed)"
                                  ArgsOnly="false" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DysonTrackedToolCall Tracked { get; set; } = default!;

    /// <summary>True while the host is running a prompt on the active session.</summary>
    [Parameter] public bool SessionBusy { get; set; }

    /// <summary>True when this turn is the latest in the transcript.</summary>
    [Parameter] public bool IsLatestTurn { get; set; }

    /// <summary>Cancels the in-flight prompt (same chain as turn-header cancel).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool _expanded;
    private DysonToolCallUi.CollapsedSummary _summary = new();

    private bool CanCancel => SessionBusy && IsLatestTurn && OnCancel.HasDelegate;

    protected override void OnParametersSet()
    {
        _summary = DysonToolCallUi.GetCollapsedSummary(
            Tracked.Call.ToolName,
            Tracked.Call.ArgumentsJson,
            Tracked.Result?.Content,
            hasResult: Tracked.Result is not null);
    }

    private void ToggleExpanded() => _expanded = !_expanded;

    private Task HandleCancelAsync() => CanCancel ? OnCancel.InvokeAsync() : Task.CompletedTask;

    private string StatusClass => Tracked.Status switch
    {
        DysonToolCallStatus.Queued => "queued",
        DysonToolCallStatus.Working => "working",
        DysonToolCallStatus.Completed => "completed",
        DysonToolCallStatus.Failed => "failed",
        _ => "queued",
    };

    private string StatusShort => Tracked.Status switch
    {
        DysonToolCallStatus.Queued => "QUE",
        DysonToolCallStatus.Working => "WORK",
        DysonToolCallStatus.Completed => "COMP",
        DysonToolCallStatus.Failed => "FAIL",
        _ => "QUE",
    };
}
