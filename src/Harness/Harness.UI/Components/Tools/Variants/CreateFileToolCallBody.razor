@namespace Harness.UI.Components.Tools.Variants
@using Harness.UI.Demo

@{
    var path = DysonToolCallUi.GetString(ArgumentsJson, "path");
    var content = DysonToolCallUi.GetString(ArgumentsJson, "content") ?? "";
    var overwrite = DysonToolCallUi.GetBool(ArgumentsJson, "overwrite");
    var lines = DysonToolCallUi.CountLines(content);
}

<div class="tool-section">
    <div class="tool-section__label">File</div>
    <ToolPathLink Path="@path" />
    <div class="tool-section__meta mono">
        @lines lines · @content.Length chars
        @if (overwrite)
        {
            <text> · overwrite</text>
        }
    </div>
</div>
@if (content.Length > 0 && content.Length <= 400)
{
    <div class="tool-section">
        <div class="tool-section__label">Content preview</div>
        <pre class="tool-scroll mono">@content</pre>
    </div>
}
@if (!ArgsOnly && ResultContent is not null)
{
    <div class="tool-section">
        <div class="tool-section__label">Result</div>
        <pre class="tool-result mono @(IsError ? "tool-result--danger" : null)">@ResultContent</pre>
    </div>
}

@code {
    [Parameter] public string? ArgumentsJson { get; set; }
    [Parameter] public string? ResultContent { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public bool ArgsOnly { get; set; }
}
