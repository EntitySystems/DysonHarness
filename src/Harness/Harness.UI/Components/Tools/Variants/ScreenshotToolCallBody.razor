@namespace Harness.UI.Components.Tools.Variants
@using DysonHarness
@using Harness.UI.Demo

@{
    var parsed = DysonToolCallUi.TryParseScreenshotAck(ResultContent);
    var dataUrl = BinaryAttachment is { IsImage: true, Base64Data: { Length: > 0 } } att
        ? $"data:{att.MimeType};base64,{att.Base64Data}"
        : null;
}

<div class="tool-section">
    <div class="tool-section__label">Screenshot</div>
    @if (!string.IsNullOrEmpty(dataUrl))
    {
        <img class="tool-screenshot-thumb" src="@dataUrl" alt="Screenshot thumbnail" />
    }
    else if (!ArgsOnly && !IsError)
    {
        <div class="tool-section__meta mono">screenshot (viewed)</div>
    }

    @if (parsed is not null)
    {
        <div class="tool-section__meta mono">
            @if (parsed.Width is int w && parsed.Height is int h)
            {
                <text>@w×@h</text>
            }
            @if (parsed.ByteLength is int bytes)
            {
                <text>@(parsed.Width is null ? null : " · ")@DysonToolCallUi.FormatByteSize(bytes)</text>
            }
            @if (!string.IsNullOrEmpty(parsed.MimeType))
            {
                <text> · @parsed.MimeType</text>
            }
        </div>
    }
</div>
@if (!string.IsNullOrWhiteSpace(ArgumentsJson))
{
    <div class="tool-section">
        <div class="tool-section__label">Args</div>
        <pre class="tool-scroll mono">@ArgumentsJson</pre>
    </div>
}
@if (!ArgsOnly && IsError && ResultContent is not null)
{
    <div class="tool-section">
        <div class="tool-section__label">Result</div>
        <pre class="tool-scroll mono tool-scroll--danger">@ResultContent</pre>
    </div>
}

@code {
    [Parameter] public string? ArgumentsJson { get; set; }
    [Parameter] public string? ResultContent { get; set; }
    [Parameter] public DysonBinaryAttachment? BinaryAttachment { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public bool ArgsOnly { get; set; }
}
