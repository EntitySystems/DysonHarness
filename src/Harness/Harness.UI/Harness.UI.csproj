<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="Harness.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harness.Engine\Harness.Engine.csproj" />
    <ProjectReference Include="..\Harness.LocalDb\Harness.LocalDb.csproj" />
    <ProjectReference Include="..\Harness.WindowsBrowser\Harness.WindowsBrowser.csproj"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ColorCode.HTML" Version="2.0.15" />
    <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
    <!-- Direct ref so CefSharp buildTransitive targets run on this exe (locales next to Harness.UI.exe).
         ProjectReference alone does not import those targets into the Web host. -->
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="149.0.40"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- CefSharp requires an RID on the executable so natives (libcef.dll) copy next to the exe.
       SelfContained defaults false for local FDD runs; CI may override via self-contained / SelfContained=true. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>..\Harness.WindowsBrowser\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Stable Release drops the demo page, its CSS, the hotkey script, and scenario sources.
       The Razor SDK still compiles @page routes when the page body is #if'd, so exclusion is required.
       #if does not skip preprocessor-looking lines inside an inactive region, so scenario .cs files
       are removed from Compile rather than relying on DYSON_PREVIEW. DysonPreviewFeatures.cs stays
       compiled so tests can assert the flag is false.
       The SDK re-adds *.razor.css as ScopedCssInput after the project ItemGroup, which then fails
       BLAZOR102 against the missing component, so that item is removed again after discovery.
       Debug always keeps them (DYSON_PREVIEW). Other files under Demo/ stay compiled. -->
  <ItemGroup Condition="'$(DysonReleaseChannel)' == 'stable' AND '$(Configuration)' != 'Debug'">
    <Content Remove="Components\Pages\Settings\DemoSettings.razor" />
    <Content Remove="Components\Pages\Settings\DemoSettings.razor.css" />
    <Content Remove="wwwroot\dyson-demo.js" />
    <RazorComponent Remove="Components\Pages\Settings\DemoSettings.razor" />
    <RazorGenerate Remove="Components\Pages\Settings\DemoSettings.razor" />
    <None Remove="wwwroot\dyson-demo.js" />
    <Compile Remove="Components\Pages\Settings\DemoSettings.razor" />
    <Compile Remove="Demo\Scenarios\**\*.cs" />
  </ItemGroup>

  <Target Name="DropStableDemoScopedCss"
          AfterTargets="ResolveScopedCssInputs"
          BeforeTargets="ComputeCssScope"
          Condition="'$(DysonReleaseChannel)' == 'stable' AND '$(Configuration)' != 'Debug'">
    <ItemGroup>
      <ScopedCssInput Remove="@(ScopedCssInput)"
                      Condition="$([System.String]::Copy('%(Identity)').EndsWith('DemoSettings.razor.css'))" />
    </ItemGroup>
  </Target>

</Project>
