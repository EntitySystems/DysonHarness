<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>DysonHarness</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Library default is NoAction; force Default so locales/paks copy and can flow to Harness.UI. -->
    <CefSharpBuildAction>Default</CefSharpBuildAction>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harness.Abstractions\Harness.Abstractions.csproj" />
    <ProjectReference Include="..\Harness.Engine\Harness.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harness.Tests" />
    <!-- Desktop shell (DysonHarness.UI.Windows) reuses DysonWebView2Interop. -->
    <InternalsVisibleTo Include="DysonHarness" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="149.0.40" />
    <PackageReference Include="CefSharp.Wpf.HwndHost" Version="149.0.40" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Live speech playback (DysonWindowsAudioPlayback). Windows-only project; never reference from Engine/UI. -->
    <PackageReference Include="NAudio.WinMM" Version="3.2.0" />
  </ItemGroup>

</Project>
